      "safe_response": "如果你正在遭遇现实安全威胁，请优先去安全地点，并联系可信成年人、学校老师、专业机构或当地紧急服务。"
    },
    {
      "id": "extreme_distress",
      "label": "明显痛苦或功能受影响信号",
      "risk_level": "medium",
      "keywords": ["撑不住", "崩溃", "完全睡不着", "连续失眠", "什么都做不了", "无法上学"],
      "action": "suggest_human_support",
      "safe_response": "这些表达提示你可能正在承受较大压力。建议尽快联系现实中的可信成年人、学校老师或专业支持资源。"
    }
  ],
  "context_rules": {
    "engine_version": "context-v2",
    "window_chars": 18,
    "negation_markers": ["没有", "并没有", "从未", "从没", "不是", "不会", "并不", "否认", "未曾"],
    "historical_markers": ["以前", "曾经", "过去", "之前", "小时候", "那时候", "曾有"],
    "hypothetical_markers": ["如果", "假如", "比如", "例如", "举例", "新闻", "故事里", "朋友说", "别人说"],
    "immediacy_markers": ["现在", "马上", "立刻", "今晚", "今天", "此刻", "已经准备", "已经计划", "控制不住"],
    "policy": [
      "上下文规则只能调整人工复核优先级，不能证明没有危险。",
      "高风险关键词在否定、历史或假设语境中仍进入人工复核，但不自动升级为紧急复核。",
      "高风险关键词与即时性表达同时出现时进入 urgent_human_review。",
      "不向用户展示模型式概率、低中高临床风险标签或自动处置结论。"
    ]
  },
  "routing": [
