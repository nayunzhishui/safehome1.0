{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "safehome.rc0810.wechat-external-evidence.v1",
  "title": "SafeHome WeChat RC external evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidence_id",
    "evidence_class",
    "status",
    "synthetic",
    "scenario_id",
    "device_slot_id",
    "test_account_role",
    "binding",
    "dependency_snapshot",
    "dependency_snapshot_source",
    "environment",
    "operator",
    "artifacts",
    "steps",
    "transitions",
    "human_conclusion",
    "validity"
  ],
  "properties": {
    "schema": {"const": "safehome.rc0810.wechat-external-evidence.v1"},
    "evidence_id": {"type": "string", "minLength": 1},
    "evidence_class": {"type": "string", "pattern": "^E(0[1-9]|10)$"},
    "status": {
      "enum": ["machine_pass", "evidence_ready", "human_verified", "platform_approved"]
    },
    "synthetic": {"type": "boolean"},
    "scenario_id": {"type": "string", "minLength": 1},
    "device_slot_id": {"type": "string", "minLength": 1},
    "test_account_role": {"type": "string", "minLength": 1},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "source_tree",
        "package_sha256",
        "appid_fingerprint",
        "cloudbase_env_id",
        "cloudbase_service"
      ],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "appid_fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "cloudbase_env_id": {"type": "string", "minLength": 1},
        "cloudbase_service": {"type": "string", "minLength": 1}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "base_library_version",
        "devtools_version",
        "device_model",
        "os_version",
        "wechat_version"
      ],
      "properties": {
        "platform": {"enum": ["iOS", "Android"]},
        "base_library_version": {"type": "string", "minLength": 1},
        "devtools_version": {"type": "string", "minLength": 1},
        "device_model": {"type": "string", "minLength": 1},
        "os_version": {"type": "string", "minLength": 1},
        "wechat_version": {"type": "string", "minLength": 1}
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "observed_at"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "path",
          "sha256",
          "captured_at",
          "package_sha256",
          "request_id",
          "account_role"
        ],
        "properties": {
          "kind": {"enum": ["screenshot", "log", "report", "platform_receipt"]},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "captured_at": {"type": "string", "format": "date-time"},
          "package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "request_id": {"type": "string", "minLength": 1},
          "account_role": {"type": "string", "minLength": 1}
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "expected", "result", "started_at", "finished_at", "request_id"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "expected": {"type": "string", "minLength": 1},
          "result": {"type": "string", "minLength": 1},
          "started_at": {"type": "string", "format": "date-time"},
          "finished_at": {"type": "string", "format": "date-time"},
          "request_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "dependency_snapshot": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "dependency_snapshot_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256"],
      "properties": {
        "kind": {"enum": ["synthetic_fixture", "rc_manifest"]},
        "path": {"type": ["string", "null"]},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state",
          "previous_transition_sha256",
          "evidence_core_sha256",
          "challenge_nonce",
          "actor_id",
          "identity_source",
          "transitioned_at",
          "attestation_path",
          "attestation_sha256"
        ],
        "properties": {
          "state": {
            "enum": ["machine_pass", "evidence_ready", "human_verified", "platform_approved"]
          },
          "previous_transition_sha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          },
          "evidence_core_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "challenge_nonce": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
          "actor_id": {"type": "string", "minLength": 1},
          "identity_source": {
            "enum": ["machine_registry", "reviewer_registry", "external_gate_registry"]
          },
          "transitioned_at": {"type": "string", "format": "date-time"},
          "attestation_path": {"type": ["string", "null"]},
          "attestation_sha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "state": {"enum": ["human_verified", "platform_approved"]}
              },
              "required": ["state"]
            },
            "then": {
              "properties": {
                "attestation_path": {"type": "string", "minLength": 1},
                "attestation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          }
        ]
      }
    },
    "human_conclusion": {"type": ["string", "null"]},
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid_from", "valid_until", "invalidated_at", "invalidation_reasons"],
      "properties": {
        "valid_from": {"type": "string", "format": "date-time"},
        "valid_until": {"type": "string", "format": "date-time"},
        "invalidated_at": {"type": ["string", "null"], "format": "date-time"},
        "invalidation_reasons": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
