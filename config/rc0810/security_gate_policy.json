{
  "schema": "safehome.rc0810.security-policy.v1",
  "phase": "F22-B",
  "tools": {
    "bandit": "1.9.4",
    "detect-secrets": "1.5.0",
    "npm-audit": "11.13.0",
    "pip-audit": "2.10.1",
    "pip-licenses": "5.5.5",
    "trivy": "0.72.0"
  },
  "tool_sources": {
    "bandit": "https://pypi.org/project/bandit/1.9.4/",
    "detect-secrets": "https://pypi.org/project/detect-secrets/1.5.0/",
    "pip-audit": "https://pypi.org/project/pip-audit/2.10.1/",
    "pip-licenses": "https://pypi.org/project/pip-licenses/5.5.5/",
    "trivy": "https://github.com/aquasecurity/trivy/releases/tag/v0.72.0"
  },
  "tool_images": {
    "trivy": "sha256:cffe3f5161a47a6823fbd23d985795b3ed72a4c806da4c4df16266c02accdd6f"
  },
  "action_commits": {
    "actions/checkout": "d23441a48e516b6c34aea4fa41551a30e30af803",
    "actions/setup-node": "249970729cb0ef3589644e2896645e5dc5ba9c38",
    "actions/setup-python": "5fda3b95a4ea91299a34e894583c3862153e4b97",
    "actions/upload-artifact": "ea165f8d65b6e75b540449e92b4886f43607fa02"
  },
  "scans": [
    {"id": "secret", "tool": "detect-secrets", "scope": ["source_tree"], "timeout_seconds": 300, "phase_b_status": "active"},
    {"id": "sast", "tool": "bandit", "scope": ["backend", "scripts", "analysis"], "timeout_seconds": 600, "phase_b_status": "active"},
    {"id": "python_dependency", "tool": "pip-audit", "scope": ["backend/requirements.txt", "analysis/profiling/requirements.txt", "analysis/text_analysis/requirements.txt"], "timeout_seconds": 600, "phase_b_status": "active"},
    {"id": "node_dependency", "tool": "npm-audit", "scope": ["apps/web/package-lock.json"], "timeout_seconds": 600, "phase_b_status": "active"},
    {"id": "container", "tool": "trivy", "scope": ["built_image"], "timeout_seconds": 1800, "phase_b_status": "active"},
    {"id": "sbom", "tool": "trivy", "scope": ["built_image"], "timeout_seconds": 1800, "phase_b_status": "active"},
    {"id": "license", "tool": "trivy", "scope": ["source_tree", "dependency_lockfiles"], "timeout_seconds": 1800, "phase_b_status": "active"}
  ],
  "excluded_paths": [
    ".codex_tmp/",
    ".git/",
    ".venv/",
    "__pycache__/",
    "dist/",
    "node_modules/"
  ],
  "exclusion_reasons": {
    ".codex_tmp/": "runtime evidence and tool cache; scanned source comes from the bound Git tree",
    ".git/": "repository metadata is not application source",
    ".venv/": "local dependency installation; dependency manifests are scanned separately",
    "__pycache__/": "generated Python bytecode",
    "dist/": "generated build output; final staged artifact is scanned in F22-B",
    "node_modules/": "installed dependencies; package-lock is scanned and final tree is scanned in F22-B"
  },
  "severity_gate": {
    "secret": ["unknown", "low", "medium", "high", "critical"],
    "sast": ["high", "critical", "unknown"],
    "dependency": ["high", "critical", "unknown"],
    "forbidden_licenses": ["AGPL-3.0", "GPL-3.0-only", "SSPL-1.0"]
  },
  "exception_policy": {
    "automation_may_approve": false,
    "maximum_days": 30,
    "required_review_status": "approved",
    "trusted_exception_reviewers": [],
    "reviewer_registry_status": "pending_external",
    "stale_on": ["finding_fingerprint", "owner", "expiry", "source_tree", "lockfile"]
  },
  "production_release_approved": false
}
