# SafeHome production feature activation profile (no secrets).
#
# Copy the reviewed values into the deployment environment. Do not upload this
# file as proof of platform, ethics, privacy, provider, or production approval.
APP_ENV=production
PRODUCTION_FEATURES_UNLOCKED=1

# Keep authentication and object-scope authorization active. CloudBase headers
# are not trusted by default; WeChat login uses the server-side code exchange.
TRUST_CLOUDBASE_IDENTITY_HEADERS=0

# Content, privacy, research operations and therapeutic-assessment interfaces.
CONTENT_GOVERNANCE_ENFORCED=1
CONTENT_GOVERNANCE_PUBLISH_ENABLED=1
PRIVACY_EXECUTION_ENABLED=1
PRIVACY_RETENTION_POLICY_APPROVED=1
PRIVACY_PRODUCTION_EXECUTION_ENABLED=1
PRIVACY_TOMBSTONE_SECRET=__FROM_CLOUDBASE_SECRET_STORE_MIN_32_CHARS__
RESEARCH_OPERATIONS_WRITE_ENABLED=1
THERAPEUTIC_ASSESSMENT_LIFECYCLE_ENABLED=1

# Participant support assistant. A real approved provider and server-side secret
# are still required; fake is rejected in production.
AI_QA_ENABLED=1
AI_QA_SANDBOX_ENABLED=1
AI_QA_PROVIDER=deepseek
AI_QA_REAL_PROVIDER_ENABLED=1
DEEPSEEK_API_KEY=__FROM_CLOUDBASE_SECRET_STORE__
DEEPSEEK_MODEL=deepseek-chat
AI_QA_REQUESTS_PER_HOUR=30
AI_QA_DAILY_BUDGET_MICROS=1000000

# Research, analysis and operational workbenches.
OFFLINE_BENCHMARK_ENABLED=1
RESEARCH_METHODOLOGY_WORKBENCH_ENABLED=1
RESEARCH_METHODOLOGY_FORMAL_FREEZE_ALLOWED=1
RESEARCH_OUTCOME_ANALYSIS_ALLOWED=1
RESEARCH_ANALYSIS_JOB_EXECUTION_ENABLED=1
SECURITY_SCAN_EXECUTION_ENABLED=1
RELIABILITY_WORKBENCH_ENABLED=1
RELIABILITY_JOB_EXECUTION_ENABLED=1
UX_GOVERNANCE_WORKBENCH_ENABLED=1
OPERATIONS_GOVERNANCE_WORKBENCH_ENABLED=1
OPERATIONS_LOCAL_RELEASE_ENABLED=1

# Reliability and governed release controls.
RELIABILITY_GRADUAL_RELEASE_ENABLED=1
RELIABILITY_PRODUCTION_SLO_FROZEN=1
OPERATIONS_PRODUCTION_RELEASE_ENABLED=1

# These are destructive automation switches rather than API availability
# switches. Keep them closed even in the all-interface validation package.
OFFLINE_EXTERNAL_INGEST_ENABLED=0
OFFLINE_PRODUCTION_REPLACEMENT_ALLOWED=0
RELIABILITY_FAULT_INJECTION_ENABLED=0

# WeChat subscription delivery becomes active only after every value below is
# replaced in the CloudBase environment. Do not put the real secret in this file.
WECHAT_SUBSCRIBE_SEND_ENABLED=1
WECHAT_APPID=wxd548597e78862269
WECHAT_SECRET=__FROM_CLOUDBASE_SECRET_STORE__
WECHAT_TRAINING_DUE_TEMPLATE_ID=__FROM_WECHAT_TEMPLATE_CONFIGURATION__
WECHAT_TRAINING_DUE_TEMPLATE_FIELDS=__FROM_WECHAT_TEMPLATE_CONFIGURATION__
NOTIFICATION_SCHEDULER_TOKEN=__FROM_CLOUDBASE_SECRET_STORE__
