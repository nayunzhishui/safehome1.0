# SafeHome engineering / AI runtime example. Never commit real secrets.

# --- Application ---
APP_ENV=production
PORT=5050
LOG_LEVEL=INFO
MAX_REQUEST_BODY_BYTES=1048576

# --- Gunicorn ---
WEB_CONCURRENCY=2
WEB_THREADS=4
GUNICORN_WORKER_CLASS=gthread
GUNICORN_TIMEOUT_SECONDS=30
GUNICORN_GRACEFUL_TIMEOUT_SECONDS=30
GUNICORN_KEEPALIVE_SECONDS=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
# Only set this to your actual trusted reverse proxy addresses/networks.
FORWARDED_ALLOW_IPS=127.0.0.1
# 0 for direct CloudBase/Gunicorn deployment; set only when a known proxy hop exists.
TRUST_PROXY_HOPS=0

# --- MySQL ---
DB_PROVIDER=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=safehome_app_rw
MYSQL_PASSWORD=__FROM_SECRET_STORE__
MYSQL_DATABASE=safehome
MYSQL_POOL_ENABLED=1
MYSQL_POOL_MIN_CACHED=1
MYSQL_POOL_MAX_CACHED=5
MYSQL_POOL_MAX_CONNECTIONS=7
MYSQL_CONNECT_TIMEOUT_SECONDS=5
MYSQL_READ_TIMEOUT_SECONDS=10
MYSQL_WRITE_TIMEOUT_SECONDS=10
# Optional TLS; CA path must be mounted/injected by deployment.
MYSQL_SSL_CA=
MYSQL_SSL_VERIFY_IDENTITY=1

# --- Redis (optional cache/coordination only) ---
REDIS_ENABLED=0
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_NAMESPACE=safehome
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_CACHE_TTL_SECONDS=300
REDIS_LOGIN_RATE_LIMIT_PER_MINUTE=20
REDIS_AI_RATE_LIMIT_PER_MINUTE=60

# --- Governed RAG v2 ---
RAG_V2_ENABLED=1
RAG_LEXICAL_TOP_K=20
RAG_VECTOR_TOP_K=30
RAG_FINAL_CONTEXT_K=6
RAG_RRF_K=60
RAG_MAX_CHUNKS_PER_DOCUMENT=1
RAG_CACHE_TTL_SECONDS=300

# Deterministic offline fallback (default).
RAG_EMBEDDING_PROVIDER=hash
# For an approved OpenAI-compatible embedding endpoint, set all four below
# through deployment secrets/config and run rebuild_rag_embeddings.py.
RAG_EMBEDDING_BASE_URL=
RAG_EMBEDDING_API_KEY=__FROM_SECRET_STORE__
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_TIMEOUT_SECONDS=10

# --- Agent v1 ---
# Agent remains internal, synthetic-data-only and read-only by policy.
AGENT_MAX_TOOL_CALLS=3

# --- Existing AI QA sandbox ---
# Participant AI remains disabled until separate approval.
AI_QA_ENABLED=0
AI_QA_SANDBOX_ENABLED=0
AI_QA_PROVIDER=fake
AI_QA_REAL_PROVIDER_ENABLED=0
AI_QA_REQUESTS_PER_HOUR=30
AI_QA_DAILY_BUDGET_MICROS=0
AI_QA_CONNECT_TIMEOUT_MS=1000
AI_QA_READ_TIMEOUT_MS=2000
AI_QA_TIMEOUT_MS=3000
AI_QA_PROVIDER_RETRIES=1
