:root {
  color-scheme: light;
  --bg: #f5f7f2;
  --surface: #ffffff;
  --surface-soft: #eef4ec;
  --ink: #18221c;
  --muted: #657268;
  --line: #d9e1d7;
  --accent: #2f7d4e;
  --accent-dark: #1f5c39;
  --accent-soft: #dfeee2;
  --accent-blue: #406f8d;
  --gold: #b88746;
  --panel-ink: #10211a;
  --warning: #b34e24;
  --shadow: 0 18px 50px rgba(31, 58, 42, 0.12);
  --radius: 8px;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.9), rgba(236, 242, 232, 0.76) 42%, rgba(245, 247, 242, 0.94)),
    linear-gradient(90deg, rgba(31, 92, 57, 0.055) 1px, transparent 1px),
    linear-gradient(180deg, rgba(31, 92, 57, 0.045) 1px, transparent 1px),
    var(--bg);
  background-size: auto, 44px 44px, 44px 44px, auto;
  color: var(--ink);
  font-family: "Microsoft YaHei", "PingFang SC", "Noto Sans CJK SC", Arial, sans-serif;
  font-size: 16px;
  line-height: 1.65;
}

a {
  color: var(--accent-dark);
  text-decoration: none;
}

button,
input,
select,
textarea {
  font: inherit;
}

.site-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  max-width: 1180px;
  margin: 0 auto;
  padding: 24px;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  color: var(--ink);
}

.brand-mark {
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  border-radius: 8px;
  background: linear-gradient(135deg, var(--accent-dark), var(--accent-blue));
  color: #fff;
  font-weight: 700;
  box-shadow: 0 12px 24px rgba(16, 33, 26, 0.16);
}

.brand strong,
.brand small {
  display: block;
  line-height: 1.2;
}

.brand small {
  margin-top: 2px;
  color: var(--muted);
  font-size: 12px;
}

.nav {
  display: flex;
  align-items: center;
  gap: 18px;
  font-size: 14px;
  font-weight: 600;
}

.site-footer {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  max-width: 1180px;
  margin: 0 auto;
  padding: 20px 24px 34px;
  color: var(--muted);
  font-size: 13px;
}

main {
  max-width: 1180px;
  margin: 0 auto;
  padding: 8px 24px 56px;
}

.hero {
  display: grid;
  grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.9fr);
  gap: 36px;
  align-items: center;
  min-height: calc(100vh - 140px);
}

.research-entry {
  position: relative;
  grid-template-columns: minmax(0, 1.02fr) minmax(360px, 0.98fr);
  gap: 48px;
  padding: 18px 0 56px;
}

.research-entry::before {
  content: "";
  position: absolute;
  inset: 20px -24px auto auto;
  width: min(520px, 48vw);
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(184, 135, 70, 0.58), transparent);
}

.hero-copy h1,
.page-heading h1,
.report-hero h1 {
  margin: 0;
  max-width: 760px;
  font-size: clamp(38px, 6.4vw, 72px);
  line-height: 1.08;
  font-weight: 800;
  letter-spacing: 0;
}

.hero-copy p,
.page-heading p,
.report-hero p {
  max-width: 720px;
  margin: 22px 0 0;
  color: var(--muted);
  font-size: 18px;
}

.research-entry .hero-copy p {
  max-width: 650px;
  font-size: 19px;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 34px;
}

.study-brief {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(260px, 0.35fr);
  gap: 16px;
  margin-bottom: 16px;
}

.study-brief-main,
.study-brief-side,
.study-info-grid article,
.study-actions,
.pilot-summary,
.report-interpretation article {
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--surface);
  box-shadow: 0 10px 28px rgba(31, 58, 42, 0.06);
}

.study-brief-main,
.study-brief-side,
.study-info-grid article,
.pilot-summary {
  padding: 24px;
}

.study-brief-side {
  display: grid;
  align-content: center;
  gap: 8px;
  background: linear-gradient(135deg, var(--accent-dark), var(--accent-blue));
  color: #fff;
}

.study-brief-side span {
  font-size: 13px;
  font-weight: 900;
  opacity: 0.78;
}

.study-brief-side strong {
  font-size: 28px;
  line-height: 1.1;
}

.study-brief-side p {
  margin: 0;
  color: rgba(255, 255, 255, 0.82);
}

.study-info-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
}

.study-info-grid p,
.study-brief-main p {
  margin: 0 0 10px;
  color: var(--muted);
}

.study-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 16px;
  padding: 18px;
}

.hero-notes {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 18px;
}

.hero-notes span {
  padding: 6px 10px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.72);
  color: var(--accent-dark);
  font-size: 13px;
  font-weight: 700;
}

.research-entry .hero-notes span {
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.84);
  color: var(--panel-ink);
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 46px;
  padding: 10px 18px;
  border: 1px solid transparent;
  border-radius: var(--radius);
  cursor: pointer;
  font-size: 15px;
  font-weight: 700;
  line-height: 1.2;
  transition: transform 0.16s ease, background 0.16s ease, border-color 0.16s ease;
}

.button:hover {
  transform: translateY(-1px);
}

.button.primary {
  background: linear-gradient(135deg, var(--accent-dark), var(--accent));
  color: #fff;
  box-shadow: 0 10px 26px rgba(47, 125, 78, 0.22);
}

.button.primary:hover {
  background: var(--accent-dark);
}

.button.secondary,
.button.ghost {
  background: #fff;
  color: var(--accent-dark);
  border-color: var(--line);
}

html.entry-loader-active,
html.entry-loader-active body {
  overflow: hidden;
}

.entry-loader {
  --loader-x: 50%;
  --loader-y: 48%;
  --loader-primary: 47, 125, 78;
  --loader-secondary: 64, 111, 141;
  --loader-accent: 184, 135, 70;
  --loader-dx: 0px;
  --loader-dy: 0px;
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: none;
  place-items: center;
  padding: 24px;
  background:
    radial-gradient(circle at var(--loader-x) var(--loader-y), rgba(var(--loader-primary), 0.22), transparent 18rem),
    linear-gradient(135deg, rgba(247, 250, 245, 0.98), rgba(229, 239, 231, 0.96) 48%, rgba(239, 244, 241, 0.98)),
    linear-gradient(90deg, rgba(31, 92, 57, 0.08) 1px, transparent 1px),
    linear-gradient(180deg, rgba(31, 92, 57, 0.06) 1px, transparent 1px);
  background-size: auto, auto, 46px 46px, 46px 46px;
  opacity: 0;
  pointer-events: none;
}

.entry-loader.is-visible {
  display: grid;
  opacity: 1;
  pointer-events: auto;
  animation: loaderFadeIn 0.7s ease forwards;
}

.entry-loader.is-leaving {
  animation: loaderFadeOut 0.9s ease forwards;
  pointer-events: none;
}

.entry-loader[data-theme="care"] {
  --loader-primary: 47, 125, 78;
  --loader-secondary: 101, 148, 107;
  --loader-accent: 184, 135, 70;
}

.entry-loader[data-theme="uncertainty"] {
  --loader-primary: 64, 111, 141;
  --loader-secondary: 47, 125, 78;
  --loader-accent: 123, 161, 183;
}

.entry-loader[data-theme="report"] {
  --loader-primary: 184, 135, 70;
  --loader-secondary: 47, 125, 78;
  --loader-accent: 64, 111, 141;
}

.entry-loader-shell {
  display: grid;
  grid-template-columns: minmax(0, 0.92fr) minmax(360px, 1.08fr);
  gap: 44px;
  align-items: center;
  width: min(100%, 1060px);
  min-height: min(680px, calc(100vh - 48px));
  padding: clamp(24px, 4vw, 44px);
  border: 1px solid rgba(217, 225, 215, 0.9);
  border-radius: 8px;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.86), rgba(250, 252, 248, 0.76)),
    linear-gradient(135deg, rgba(var(--loader-secondary), 0.08), rgba(var(--loader-accent), 0.08));
  box-shadow: 0 32px 86px rgba(16, 33, 26, 0.2);
  transform: translateY(10px);
  animation: loaderShellIn 0.9s ease 0.12s forwards;
}

.entry-loader-copy {
  max-width: 480px;
}

.entry-loader-mark {
  display: inline-block;
  margin-bottom: 18px;
  padding: 7px 10px;
  border: 1px solid rgba(var(--loader-accent), 0.42);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.68);
  color: rgb(var(--loader-primary));
  font-size: 13px;
  font-weight: 900;
}

.entry-loader-copy h1 {
  margin: 0;
  font-size: clamp(36px, 5vw, 62px);
  line-height: 1.08;
  letter-spacing: 0;
}

.entry-loader-copy p {
  min-height: 72px;
  margin: 20px 0 0;
  color: var(--muted);
  font-size: 18px;
}

.entry-skip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42px;
  margin-top: 28px;
  padding: 9px 14px;
  border: 1px solid rgba(var(--loader-primary), 0.28);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.78);
  color: rgb(var(--loader-primary));
  cursor: pointer;
  font-size: 14px;
  font-weight: 800;
}

.emotion-stage {
  display: grid;
  gap: 22px;
  justify-items: center;
}

.emotion-ring {
  position: relative;
  display: grid;
  place-items: center;
  width: min(72vw, 390px);
  aspect-ratio: 1;
  border-radius: 50%;
  background:
    radial-gradient(circle, rgba(255, 255, 255, 0.92) 0 28%, rgba(var(--loader-primary), 0.12) 29% 30%, transparent 31%),
    conic-gradient(from 150deg, rgba(var(--loader-primary), 0.06), rgba(var(--loader-accent), 0.36), rgba(var(--loader-secondary), 0.14), rgba(var(--loader-primary), 0.06));
  box-shadow: inset 0 0 0 1px rgba(217, 225, 215, 0.9), 0 28px 70px rgba(16, 33, 26, 0.18);
  overflow: hidden;
}

.emotion-ring::before,
.emotion-ring::after,
.temperature-ring,
.temperature-wave {
  content: "";
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.emotion-ring::before {
  inset: 10%;
  border: 1px solid rgba(var(--loader-primary), 0.18);
}

.emotion-ring::after {
  inset: 23%;
  border: 1px dashed rgba(var(--loader-secondary), 0.24);
}

.temperature-ring {
  inset: 4%;
  border: 2px solid rgba(var(--loader-accent), 0.42);
  clip-path: polygon(0 0, 78% 0, 100% 52%, 48% 100%, 0 78%);
}

.temperature-wave {
  inset: 31%;
  border: 1px solid rgba(var(--loader-primary), 0.3);
  opacity: 0;
}

.temperature-wave.two {
  animation-delay: 0.82s;
  border-color: rgba(var(--loader-secondary), 0.24);
}

.entry-loader.is-engaged .emotion-ring::after,
.entry-loader:focus-within .emotion-ring::after {
  animation: loaderSpin 42s linear infinite;
}

.entry-loader.is-engaged .temperature-ring,
.entry-loader:focus-within .temperature-ring {
  animation: loaderPulse 9.5s ease-in-out infinite;
}

.entry-loader.is-engaged .temperature-wave,
.entry-loader:focus-within .temperature-wave {
  animation: loaderWave 10.5s ease-out infinite;
}

.emotion-ring strong {
  position: relative;
  z-index: 1;
  color: rgb(var(--loader-primary));
  font-size: 25px;
  line-height: 1.2;
  text-align: center;
}

.ring-node {
  position: absolute;
  width: 16px;
  height: 16px;
  border: 3px solid #fff;
  border-radius: 50%;
  background: rgb(var(--loader-primary));
  box-shadow: 0 12px 24px rgba(16, 33, 26, 0.18);
  transform: translate(var(--loader-dx), var(--loader-dy));
  transition: background 0.55s ease, transform 0.55s ease;
}

.ring-node.care {
  top: 18%;
  left: 25%;
}

.ring-node.uncertainty {
  top: 28%;
  right: 17%;
  background: rgb(var(--loader-secondary));
}

.ring-node.report {
  right: 29%;
  bottom: 16%;
  background: rgb(var(--loader-accent));
}

.entry-zones {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
  width: min(100%, 520px);
}

.entry-zone {
  min-height: 54px;
  padding: 10px 12px;
  border: 1px solid rgba(217, 225, 215, 0.95);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.74);
  color: var(--panel-ink);
  cursor: pointer;
  font-size: 14px;
  font-weight: 900;
  transition: border-color 0.32s ease, background 0.32s ease, color 0.32s ease, transform 0.32s ease;
}

.entry-zone:hover,
.entry-zone:focus-visible {
  border-color: rgba(var(--loader-primary), 0.46);
  background: rgba(255, 255, 255, 0.96);
  color: rgb(var(--loader-primary));
  transform: translateY(-2px);
}

.hero-panel {
  background: rgba(255, 255, 255, 0.82);
  border: 1px solid var(--line);
  border-radius: 8px;
  box-shadow: var(--shadow);
  padding: 24px;
}

.research-console {
  --console-primary: 47, 125, 78;
  --console-secondary: 64, 111, 141;
  --console-accent: 184, 135, 70;
  --console-dx: 0px;
  --console-dy: 0px;
  position: relative;
  display: grid;
  gap: 16px;
  padding: 22px;
  overflow: hidden;
  border: 1px solid rgba(217, 225, 215, 0.88);
  border-radius: 8px;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.94), rgba(249, 251, 248, 0.88)),
    linear-gradient(135deg, rgba(64, 111, 141, 0.08), transparent 42%);
  box-shadow: 0 28px 70px rgba(16, 33, 26, 0.16);
}

.research-console[data-theme="care"] {
  --console-primary: 47, 125, 78;
  --console-secondary: 101, 148, 107;
  --console-accent: 184, 135, 70;
}

.research-console[data-theme="uncertainty"] {
  --console-primary: 64, 111, 141;
  --console-secondary: 47, 125, 78;
  --console-accent: 123, 161, 183;
}

.research-console[data-theme="report"] {
  --console-primary: 184, 135, 70;
  --console-secondary: 47, 125, 78;
  --console-accent: 64, 111, 141;
}

.research-console::before {
  content: "";
  position: absolute;
  inset: 0;
  border-top: 3px solid rgba(184, 135, 70, 0.72);
  pointer-events: none;
}

.research-console::after {
  content: "";
  position: absolute;
  right: -80px;
  top: -80px;
  width: 220px;
  aspect-ratio: 1;
  border: 1px solid rgba(64, 111, 141, 0.16);
  border-radius: 50%;
  box-shadow: inset 0 0 0 34px rgba(47, 125, 78, 0.035), inset 0 0 0 70px rgba(184, 135, 70, 0.035);
  pointer-events: none;
}

.console-top,
.scale-preview-head,
.console-insights {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
}

.console-top {
  padding-bottom: 14px;
  border-bottom: 1px solid var(--line);
}

.console-top strong,
.console-top span,
.scale-preview-head span,
.scale-preview-head strong,
.console-insights span,
.console-insights strong {
  display: block;
}

.console-top strong {
  color: rgb(var(--console-primary));
  font-size: 20px;
  line-height: 1.2;
  transition: color 0.2s ease;
}

.console-top span,
.console-insights span {
  color: var(--muted);
  font-size: 12px;
  font-weight: 800;
}

.console-status {
  flex: 0 0 auto;
  padding: 7px 10px;
  border: 1px solid rgba(184, 135, 70, 0.38);
  border-radius: 8px;
  background: rgba(255, 250, 241, 0.82);
  color: #7d5c30 !important;
}

.scale-preview {
  display: grid;
  gap: 10px;
  width: 100%;
  padding: 18px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.82);
  color: inherit;
  cursor: pointer;
  text-align: left;
  transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease, box-shadow 0.18s ease;
}

.scale-preview.featured {
  background: linear-gradient(135deg, rgba(223, 238, 226, 0.78), rgba(255, 255, 255, 0.9));
}

.scale-preview:hover,
.scale-preview:focus-visible {
  border-color: rgba(var(--console-primary), 0.42);
  background: linear-gradient(135deg, rgba(var(--console-primary), 0.1), rgba(255, 255, 255, 0.94));
  box-shadow: 0 14px 30px rgba(16, 33, 26, 0.1);
  transform: translateY(-2px);
}

.scale-preview-head span {
  color: var(--ink);
  font-size: 17px;
  font-weight: 800;
}

.scale-preview-head strong {
  color: var(--accent-dark);
  font-size: 13px;
}

.scale-preview p {
  margin: 0;
  color: var(--muted);
  font-size: 14px;
}

.preview-meter {
  height: 9px;
  overflow: hidden;
  border-radius: 999px;
  background: #e3e9df;
}

.preview-meter span {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--accent-dark), var(--accent));
}

.preview-meter.blue span {
  background: linear-gradient(90deg, var(--accent-blue), #7ba1b7);
}

.console-insights {
  align-items: stretch;
}

.research-console > * {
  position: relative;
  z-index: 1;
}

.console-insights button {
  flex: 1;
  padding: 14px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.72);
  color: inherit;
  cursor: pointer;
  text-align: left;
  transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease;
}

.console-insights strong {
  margin-top: 4px;
  color: var(--panel-ink);
  font-size: 14px;
  line-height: 1.35;
}

.console-insights button:hover,
.console-insights button:focus-visible {
  border-color: rgba(var(--console-primary), 0.42);
  background: rgba(255, 255, 255, 0.96);
  transform: translateY(-2px);
}

.console-emotion-map {
  display: grid;
  place-items: center;
  min-height: 210px;
  padding: 6px 0;
}

.console-ring {
  position: relative;
  display: grid;
  place-items: center;
  width: min(100%, 230px);
  aspect-ratio: 1;
  border-radius: 50%;
  background:
    radial-gradient(circle, rgba(255, 255, 255, 0.95) 0 32%, rgba(var(--console-primary), 0.12) 33% 34%, transparent 35%),
    conic-gradient(from 140deg, rgba(var(--console-primary), 0.08), rgba(var(--console-accent), 0.4), rgba(var(--console-secondary), 0.16), rgba(var(--console-primary), 0.08));
  box-shadow: inset 0 0 0 1px rgba(217, 225, 215, 0.9), 0 22px 54px rgba(16, 33, 26, 0.13);
  overflow: hidden;
}

.console-ring::before,
.console-ring::after,
.console-ring-track,
.console-ring-wave {
  content: "";
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.console-ring::before {
  inset: 9%;
  border: 1px solid rgba(var(--console-primary), 0.18);
}

.console-ring::after {
  inset: 24%;
  border: 1px dashed rgba(var(--console-secondary), 0.28);
}

.console-ring-track {
  inset: 4%;
  border: 2px solid rgba(var(--console-accent), 0.44);
  clip-path: polygon(0 0, 78% 0, 100% 52%, 48% 100%, 0 78%);
}

.console-ring-wave {
  inset: 31%;
  border: 1px solid rgba(var(--console-primary), 0.34);
  opacity: 0;
}

.console-ring-wave.two {
  animation-delay: 0.78s;
  border-color: rgba(var(--console-secondary), 0.26);
}

.interactive-console.is-engaged .console-ring::after,
.interactive-console:focus-within .console-ring::after {
  animation: loaderSpin 70s linear infinite;
}

.interactive-console.is-engaged .console-ring-track,
.interactive-console:focus-within .console-ring-track {
  animation: consoleBreath 10s ease-in-out infinite;
}

.interactive-console.is-engaged .console-ring-wave,
.interactive-console:focus-within .console-ring-wave {
  animation: consoleWave 10.5s ease-out infinite;
}

.console-ring strong {
  position: relative;
  z-index: 1;
  color: rgb(var(--console-primary));
  font-size: 20px;
  line-height: 1.2;
  text-align: center;
  transition: color 0.2s ease;
}

.console-node {
  position: absolute;
  width: 13px;
  height: 13px;
  border: 3px solid #fff;
  border-radius: 50%;
  background: rgb(var(--console-primary));
  box-shadow: 0 10px 20px rgba(16, 33, 26, 0.16);
  transform: translate(var(--console-dx), var(--console-dy));
  transition: transform 0.55s ease, background 0.55s ease;
}

.console-node.care {
  top: 18%;
  left: 25%;
}

.console-node.uncertainty {
  top: 30%;
  right: 16%;
  background: rgb(var(--console-secondary));
}

.console-node.report {
  right: 29%;
  bottom: 16%;
  background: rgb(var(--console-accent));
}

.research-strip {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1px;
  margin: -18px 0 18px;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--line);
  box-shadow: 0 18px 46px rgba(31, 58, 42, 0.08);
}

.research-strip article {
  padding: 24px;
  background: rgba(255, 255, 255, 0.86);
}

.research-strip span {
  display: block;
  color: var(--gold);
  font-size: 12px;
  font-weight: 900;
}

.research-strip h2 {
  margin-top: 8px;
}

.research-strip p {
  margin: 0;
  color: var(--muted);
}

.flow-step {
  display: grid;
  grid-template-columns: 38px 1fr;
  column-gap: 14px;
  align-items: start;
}

.flow-step span {
  display: grid;
  place-items: center;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: var(--accent-soft);
  color: var(--accent-dark);
  font-weight: 800;
}

.flow-step strong {
  display: block;
  font-size: 18px;
}

.flow-step p {
  grid-column: 2;
  margin: 4px 0 0;
  color: var(--muted);
}

.flow-line {
  width: 1px;
  height: 24px;
  margin: 8px 0 8px 18px;
  background: var(--line);
}

.trust-band,
.metric-row,
.report-grid,
.stats-grid,
.distribution-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
}

.trust-band article,
.metric,
.report-section,
.next-step,
.open-scene,
.question-card,
.consent-box,
.admin-tools,
.admin-table-wrap,
.login-card,
.stat-card,
.distribution-grid article {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  box-shadow: 0 10px 28px rgba(31, 58, 42, 0.06);
}

.trust-band article {
  padding: 22px;
}

.trust-band.elevated {
  margin-top: 16px;
}

h2 {
  margin: 0 0 10px;
  font-size: 20px;
  line-height: 1.3;
}

.trust-band p,
.report-section p,
.open-scene p,
.next-step p {
  margin: 0;
  color: var(--muted);
}

.section-label {
  margin: 0 0 10px;
  color: var(--accent-dark);
  font-size: 13px;
  font-weight: 800;
}

.page-heading {
  padding: 34px 0 28px;
}

.page-heading.compact {
  max-width: 760px;
  margin: 0 auto;
}

.assessment-shell {
  max-width: 760px;
  margin: 0 auto;
}

.progress-wrap {
  position: sticky;
  top: 0;
  z-index: 10;
  display: grid;
  grid-template-columns: 1fr auto auto;
  gap: 12px;
  align-items: center;
  padding: 12px 0;
  background: linear-gradient(180deg, var(--bg), rgba(247, 248, 244, 0.88));
  backdrop-filter: blur(8px);
}

.view-toggle {
  display: inline-flex;
  gap: 4px;
  margin: 0 0 16px;
  padding: 4px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.72);
}

.view-toggle-button {
  min-height: 38px;
  padding: 8px 12px;
  border: 0;
  border-radius: 6px;
  background: transparent;
  color: var(--muted);
  cursor: pointer;
  font-size: 14px;
  font-weight: 900;
}

.view-toggle-button.active {
  background: var(--accent-dark);
  color: #fff;
}

.scale-flow.single-question-mode .scale-item {
  display: none;
}

.scale-flow.single-question-mode .scale-item.single-question-active {
  display: block;
}

.scale-flow.single-question-mode .question-card.single-question-active {
  min-height: min(52vh, 520px);
}

.progress-bar {
  height: 10px;
  overflow: hidden;
  border-radius: 999px;
  background: #dfe6dd;
}

.progress-bar span {
  display: block;
  width: 0;
  height: 100%;
  border-radius: inherit;
  background: var(--accent);
  transition: width 0.2s ease;
}

#progressText {
  color: var(--muted);
  font-size: 13px;
  font-weight: 700;
}

.answer-progress {
  padding: 5px 8px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.72);
  color: var(--accent-dark);
  font-size: 12px;
  font-weight: 800;
}

.question-card {
  position: relative;
  margin: 18px 0;
  padding: 22px;
  transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
}

.question-card.is-answered {
  border-color: rgba(47, 125, 78, 0.34);
}

.question-card.is-answered::after {
  content: "已记录";
  position: absolute;
  top: 14px;
  right: 16px;
  padding: 4px 8px;
  border-radius: 8px;
  background: var(--accent-soft);
  color: var(--accent-dark);
  font-size: 12px;
  font-weight: 900;
}

.question-card.just-answered {
  box-shadow: 0 16px 34px rgba(47, 125, 78, 0.12);
  transform: translateY(-1px);
}

.consent-panel {
  margin: 0 0 18px;
  padding: 22px;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--surface-soft);
}

.consent-panel h2 {
  margin-bottom: 8px;
}

.consent-panel ul {
  margin: 0;
  padding-left: 20px;
  color: var(--muted);
}

.flow-step-panel {
  display: none;
}

.flow-step-panel.active {
  display: block;
}

.metadata-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
  margin: 18px 0;
}

.metadata-grid label,
.filter-form label {
  display: grid;
  gap: 6px;
  color: var(--muted);
  font-size: 13px;
  font-weight: 700;
}

.metadata-grid input,
.filter-form input {
  min-height: 42px;
  padding: 8px 10px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #fff;
}

.scale-heading {
  position: relative;
  margin: 0 0 18px;
  padding: 22px;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--surface);
}

.scale-heading p {
  margin: 8px 0 0;
  color: var(--muted);
}

.scale-progress-chip {
  display: inline-flex;
  width: fit-content;
  margin-top: 14px;
  padding: 6px 10px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.72);
  color: var(--accent-dark);
  font-size: 13px;
  font-weight: 900;
}

.scale-progress-chip.is-complete {
  border-color: rgba(47, 125, 78, 0.34);
  background: var(--accent-soft);
}

.likert-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 8px;
}

.likert-option {
  display: grid;
  gap: 8px;
  justify-items: center;
  align-content: start;
  min-height: 86px;
  padding: 12px 8px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #fbfcfa;
  color: var(--muted);
  cursor: pointer;
  text-align: center;
  font-size: 13px;
  line-height: 1.35;
}

.likert-option:has(input:checked) {
  border-color: var(--accent);
  background: var(--accent-soft);
  color: var(--accent-dark);
  font-weight: 800;
}

.likert-option input {
  width: 18px;
  height: 18px;
  accent-color: var(--accent);
}

.submit-review,
.export-panel,
.scale-result-card {
  padding: 24px;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--surface);
  box-shadow: 0 10px 28px rgba(31, 58, 42, 0.06);
}

.review-counts,
.export-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 16px;
}

.review-counts span {
  padding: 8px 12px;
  border-radius: 999px;
  background: var(--accent-soft);
  color: var(--accent-dark);
  font-size: 13px;
  font-weight: 800;
}

.question-card legend {
  display: flex;
  gap: 10px;
  margin: 0 0 16px;
  padding: 0;
  font-size: 19px;
  font-weight: 800;
  line-height: 1.45;
}

.question-card legend span {
  color: var(--accent-dark);
}

.option-grid {
  display: grid;
  gap: 10px;
}

.option {
  display: grid;
  grid-template-columns: 20px 1fr;
  gap: 10px;
  align-items: start;
  padding: 14px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #fbfcfa;
  cursor: pointer;
}

.option:has(input:checked) {
  border-color: var(--accent);
  background: var(--accent-soft);
}

.option input {
  width: 18px;
  height: 18px;
  margin-top: 4px;
  accent-color: var(--accent);
}

textarea {
  width: 100%;
  resize: vertical;
  min-height: 130px;
  padding: 14px;
  border: 1px solid var(--line);
  border-radius: 8px;
  color: var(--ink);
  background: #fbfcfa;
}

textarea:focus,
select:focus,
button:focus-visible,
a:focus-visible,
input:focus-visible {
  outline: 3px solid rgba(47, 125, 78, 0.22);
  outline-offset: 2px;
}

.field-note {
  margin: 8px 0 0;
  color: var(--muted);
  font-size: 13px;
}

.consent-box {
  padding: 18px;
}

.consent-box label {
  display: grid;
  grid-template-columns: 20px 1fr;
  gap: 10px;
  align-items: start;
  color: var(--muted);
}

.consent-box input {
  width: 18px;
  height: 18px;
  margin-top: 4px;
  accent-color: var(--accent);
}

.form-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-top: 22px;
}

.form-error {
  margin: 0;
  color: var(--warning);
  font-weight: 700;
}

.report-hero {
  display: flex;
  justify-content: space-between;
  gap: 24px;
  align-items: flex-end;
  padding: 34px 0;
}

.report-hero h1 {
  font-size: clamp(34px, 6vw, 56px);
}

.report-meta {
  display: grid;
  gap: 4px;
  min-width: 170px;
  color: var(--muted);
  font-size: 13px;
  text-align: right;
}

.metric {
  padding: 20px;
}

.metric span {
  display: block;
  color: var(--muted);
  font-size: 13px;
  font-weight: 700;
}

.metric strong {
  display: block;
  margin-top: 8px;
  font-size: 28px;
  line-height: 1.2;
}

.report-summary-panel {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 16px;
}

.report-summary-panel div {
  padding: 22px;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.96), rgba(238, 244, 236, 0.76));
  box-shadow: 0 10px 28px rgba(31, 58, 42, 0.06);
}

.report-summary-panel span,
.action-card span {
  display: block;
  color: var(--accent-dark);
  font-size: 13px;
  font-weight: 900;
}

.report-summary-panel strong {
  display: block;
  margin-top: 6px;
  font-size: 20px;
  line-height: 1.25;
}

.report-summary-panel p {
  margin: 10px 0 0;
  color: var(--muted);
}

.report-interpretation {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
  margin: 16px 0;
}

.report-interpretation article {
  padding: 22px;
}

.report-interpretation p {
  margin: 0;
  color: var(--muted);
}

.report-grid {
  grid-template-columns: 1.2fr 0.8fr;
  margin-top: 16px;
}

.report-section {
  padding: 24px;
}

.report-section.wide {
  grid-column: 1 / -1;
}

.action-card {
  background: var(--accent-dark);
  color: #fff;
}

.action-card p {
  color: rgba(255, 255, 255, 0.86);
}

.action-card .button {
  margin-top: 18px;
  background: #fff;
  color: var(--accent-dark);
  box-shadow: none;
}

.open-scene,
.next-step {
  margin-top: 16px;
  padding: 24px;
}

.next-step {
  display: grid;
  gap: 8px;
  background: var(--surface-soft);
}

.next-step span {
  color: var(--accent-dark);
  font-size: 13px;
  font-weight: 800;
}

.next-step strong {
  font-size: 22px;
}

.report-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 16px;
}

.scale-results {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 16px;
}

.scale-result-card {
  display: grid;
  gap: 18px;
}

.score-dashboard {
  display: grid;
  gap: 12px;
  padding: 16px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #fbfcfa;
}

.score-main {
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 10px;
  align-items: baseline;
}

.score-main span,
.score-main small {
  color: var(--muted);
  font-size: 13px;
  font-weight: 800;
}

.score-main strong {
  color: var(--accent-dark);
  font-size: 32px;
  line-height: 1;
}

.score-bar,
.dimension-bar,
.chart-bar {
  height: 10px;
  overflow: hidden;
  border-radius: 999px;
  background: #e3e9df;
}

.score-bar span,
.dimension-bar span,
.chart-bar span {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--accent-dark), var(--accent));
}

.score-pair {
  display: grid;
  grid-template-columns: repeat(4, auto);
  gap: 8px 14px;
  align-items: baseline;
}

.score-pair span {
  color: var(--muted);
  font-size: 13px;
  font-weight: 800;
}

.score-pair strong {
  font-size: 28px;
}

.dimension-list {
  display: grid;
  gap: 10px;
}

.dimension-title {
  margin: 0;
  font-size: 16px;
}

.dimension-score-row {
  display: grid;
  gap: 6px;
}

.dimension-score-row div:first-child {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  color: var(--muted);
}

.dimension-score-row strong {
  color: var(--ink);
}

.action-status {
  min-height: 24px;
  color: var(--accent-dark);
  font-size: 14px;
  font-weight: 700;
}

.login-shell {
  display: grid;
  place-items: center;
  min-height: calc(100vh - 160px);
}

.login-card {
  width: min(100%, 460px);
  padding: 28px;
}

.login-card h1 {
  margin: 0;
  font-size: 32px;
  line-height: 1.2;
}

.login-card p {
  color: var(--muted);
}

.login-form {
  display: grid;
  gap: 12px;
  margin-top: 22px;
}

.login-form label {
  color: var(--muted);
  font-size: 13px;
  font-weight: 700;
}

.login-form input {
  min-height: 46px;
  padding: 10px 12px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #fff;
}

.stats-grid {
  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin-bottom: 16px;
}

.stat-card,
.distribution-grid article {
  padding: 20px;
}

.stat-card span {
  display: block;
  color: var(--muted);
  font-size: 13px;
  font-weight: 800;
}

.stat-card strong {
  display: block;
  margin-top: 8px;
  font-size: 30px;
  line-height: 1.2;
}

.stat-card .stat-time {
  font-size: 18px;
}

.distribution-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin-bottom: 16px;
}

.admin-chart-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 16px;
}

.admin-chart-card {
  padding: 20px;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--surface);
  box-shadow: 0 10px 28px rgba(31, 58, 42, 0.06);
}

.admin-chart-card.wide {
  grid-column: 1 / -1;
}

.chart-row {
  display: grid;
  gap: 8px;
  padding: 10px 0;
  border-top: 1px solid var(--line);
}

.chart-row div:first-child,
.quality-split div > span,
.quality-split div > strong {
  display: flex;
  justify-content: space-between;
  gap: 12px;
}

.chart-row span,
.quality-split span {
  color: var(--muted);
  font-size: 13px;
  font-weight: 800;
}

.chart-row strong,
.quality-split strong {
  color: var(--ink);
}

.chart-bar.blue span {
  background: linear-gradient(90deg, var(--accent-blue), #7ba1b7);
}

.chart-bar.warning span {
  background: linear-gradient(90deg, #b34e24, #d89a63);
}

.chart-bar.success span {
  background: linear-gradient(90deg, var(--accent-dark), var(--accent));
}

.quality-split {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
}

.quality-split > div {
  display: grid;
  gap: 8px;
  padding: 14px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #fbfcfa;
}

.mini-distribution {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0 18px;
}

.distribution-row {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  padding: 10px 0;
  border-top: 1px solid var(--line);
}

.distribution-row span {
  color: var(--muted);
}

.admin-tools {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 16px;
  padding: 18px;
}

.filter-form {
  display: grid;
  grid-template-columns: repeat(4, minmax(130px, 1fr)) auto;
  gap: 10px;
  align-items: end;
  width: 100%;
}

.pilot-summary {
  display: grid;
  grid-template-columns: minmax(220px, 0.35fr) 1fr;
  gap: 16px;
  margin-bottom: 16px;
}

.pilot-summary h2 {
  margin-bottom: 0;
}

.pilot-summary-list {
  display: grid;
  gap: 8px;
}

.pilot-summary-list p {
  margin: 0;
  padding: 10px 12px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #fbfcfa;
  color: var(--muted);
}

.filter-form label {
  display: grid;
  gap: 6px;
  color: var(--muted);
  font-size: 13px;
  font-weight: 700;
}

select {
  min-width: 230px;
  min-height: 42px;
  padding: 8px 10px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #fff;
}

.filter-form input {
  min-height: 42px;
  padding: 8px 10px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #fff;
}

.admin-table-wrap {
  margin-top: 16px;
  overflow-x: auto;
}

.export-panel {
  margin-top: 16px;
}

.export-panel p {
  margin: 12px 0 0;
  color: var(--muted);
}

.admin-table {
  width: 100%;
  border-collapse: collapse;
  min-width: 860px;
}

.admin-table th,
.admin-table td {
  padding: 14px;
  border-bottom: 1px solid var(--line);
  text-align: left;
  vertical-align: top;
}

.admin-table th {
  color: var(--muted);
  font-size: 13px;
}

.open-answer {
  max-width: 260px;
  color: var(--muted);
}

.empty-state {
  color: var(--muted);
  text-align: center;
}

.error-shell {
  display: grid;
  place-items: center;
  min-height: calc(100vh - 220px);
  text-align: center;
}

.error-shell h1 {
  margin: 0;
  font-size: clamp(36px, 8vw, 64px);
  line-height: 1.1;
}

.error-shell p {
  color: var(--muted);
}

@keyframes loaderFadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes loaderFadeOut {
  from {
    opacity: 1;
  }
  to {
    opacity: 0;
    visibility: hidden;
  }
}

@keyframes loaderShellIn {
  from {
    transform: translateY(10px) scale(0.985);
  }
  to {
    transform: translateY(0) scale(1);
  }
}

@keyframes loaderSpin {
  to {
    transform: rotate(360deg);
  }
}

@keyframes loaderPulse {
  0%,
  100% {
    opacity: 0.62;
    transform: rotate(0deg) scale(1);
  }
  50% {
    opacity: 1;
    transform: rotate(8deg) scale(1.025);
  }
}

@keyframes loaderWave {
  0% {
    opacity: 0.64;
    transform: scale(0.74);
  }
  100% {
    opacity: 0;
    transform: scale(1.75);
  }
}

@keyframes consoleBreath {
  0%,
  100% {
    opacity: 0.64;
    transform: rotate(0deg) scale(1);
  }
  50% {
    opacity: 1;
    transform: rotate(8deg) scale(1.03);
  }
}

@keyframes consoleWave {
  0% {
    opacity: 0.58;
    transform: scale(0.76);
  }
  100% {
    opacity: 0;
    transform: scale(1.62);
  }
}

@media print {
  body {
    background: #fff;
  }

  .site-header,
  .site-footer,
  .next-step,
  .report-actions,
  .print-button {
    display: none !important;
  }

  main {
    max-width: none;
    padding: 0;
  }

  .report-section,
  .metric,
  .report-summary-panel div,
  .scale-result-card,
  .open-scene {
    box-shadow: none;
    break-inside: avoid;
  }

  .report-hero,
  .report-summary-panel,
  .report-interpretation,
  .metric-row,
  .scale-results,
  .report-grid {
    display: block;
  }

  .report-summary-panel div,
  .report-interpretation article,
  .metric,
  .scale-result-card,
  .report-section {
    margin-bottom: 12px;
  }
}

@media (max-width: 820px) {
  .site-header {
    align-items: flex-start;
    padding: 18px;
  }

  .site-footer {
    flex-direction: column;
    padding: 12px 18px 28px;
  }

  .nav {
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
  }

  main {
    padding: 0 18px 40px;
  }

  .hero,
  .research-entry,
  .research-strip,
  .trust-band,
  .study-brief,
  .study-info-grid,
  .metric-row,
  .report-grid,
  .report-summary-panel,
  .report-interpretation,
  .admin-chart-grid,
  .mini-distribution,
  .pilot-summary,
  .stats-grid,
  .distribution-grid,
  .metadata-grid,
  .scale-results {
    grid-template-columns: 1fr;
  }

  .entry-loader {
    padding: 16px;
  }

  .entry-loader-shell {
    grid-template-columns: 1fr;
    gap: 22px;
    align-content: center;
    min-height: calc(100vh - 32px);
    padding: 22px;
  }

  .entry-loader-copy h1 {
    font-size: 38px;
  }

  .entry-loader-copy p {
    min-height: 0;
    font-size: 16px;
  }

  .emotion-ring {
    width: min(72vw, 300px);
  }

  .entry-zones {
    grid-template-columns: 1fr;
  }

  .entry-zone {
    min-height: 46px;
  }

  .likert-grid {
    grid-template-columns: 1fr;
  }

  .progress-wrap {
    grid-template-columns: 1fr;
  }

  .likert-option {
    grid-template-columns: 24px 1fr;
    justify-items: start;
    min-height: 0;
    text-align: left;
  }

  .hero {
    min-height: auto;
    padding: 28px 0;
  }

  .research-entry {
    gap: 24px;
    padding: 20px 0 34px;
  }

  .research-entry::before {
    display: none;
  }

  .hero-copy h1,
  .page-heading h1,
  .report-hero h1 {
    font-size: 40px;
  }

  .hero-copy p,
  .page-heading p,
  .report-hero p {
    font-size: 16px;
  }

  .research-entry .hero-copy p {
    font-size: 16px;
  }

  .research-console {
    padding: 16px;
  }

  .console-emotion-map {
    min-height: 180px;
  }

  .console-ring {
    width: min(70vw, 210px);
  }

  .console-top,
  .scale-preview-head,
  .console-insights {
    align-items: flex-start;
    flex-direction: column;
  }

  .console-insights button {
    width: 100%;
  }

  .quality-split {
    grid-template-columns: 1fr;
  }

  .research-strip {
    margin-top: 0;
  }

  .hero-actions,
  .form-footer,
  .admin-tools,
  .filter-form,
  .report-hero {
    align-items: stretch;
    flex-direction: column;
  }

  .filter-form {
    display: grid;
    grid-template-columns: 1fr;
  }

  .filter-form select,
  .filter-form input {
    min-width: 0;
    width: 100%;
  }

  .button {
    width: 100%;
  }

  .report-meta {
    text-align: left;
  }
}

@media (prefers-reduced-motion: reduce) {
  .entry-loader.is-visible,
  .entry-loader.is-leaving,
  .entry-loader-shell,
  .emotion-ring::after,
  .temperature-ring,
  .temperature-wave,
  .console-ring::after,
  .console-ring-track,
  .console-ring-wave {
    animation: none !important;
  }

  .button,
  .entry-zone {
    transition: none;
  }
}
