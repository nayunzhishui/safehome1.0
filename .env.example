APP_ENV=development
DB_PROVIDER=sqlite
DATABASE_PATH=backend/safehome.sqlite3
CONTENT_DIR=content

# Set DB_PROVIDER=mysql in CloudBase/production when using Tencent Cloud MySQL.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Development only. Production must set a strong random token and must not use this default.
ADMIN_EXPORT_TOKEN=safehome-local-admin-token

# Development only. Production must set a strong random secret with at least 32 characters.
SECRET_KEY=safehome-local-dev-secret

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Trust X-WX identity headers only behind a verified CloudBase callContainer gateway.
TRUST_CLOUDBASE_IDENTITY_HEADERS=0

# Optional logging controls. Leave LOG_FILE empty in containers to write to platform stdout.
LOG_LEVEL=INFO
LOG_FILE=

# WeChat login fallback for non-CloudBase deployments. Keep real values only in
# deployment secrets, never in frontend code. CloudBase callContainer login uses
# trusted X-WX identity headers and does not require these two values.
WECHAT_APPID=
WECHAT_SECRET=

# WeChat subscription reminder. Keep real send disabled until the template has
# passed platform review and a real-device dry run has been accepted.
WECHAT_TRAINING_DUE_TEMPLATE_ID=
# Example only; replace the keyword names with fields from the approved template.
WECHAT_TRAINING_DUE_TEMPLATE_FIELDS={"thing1":"title","date2":"time","thing3":"note"}
WECHAT_TRAINING_DUE_PAGE=pages/personalized-plan/index
WECHAT_SUBSCRIBE_MODE=once
WECHAT_SUBSCRIBE_SEND_ENABLED=0
NOTIFICATION_SCHEDULER_TOKEN=

# Privacy lifecycle executor. Keep all three switches off until the retention
# matrix has owner/ethics/legal approval and test-cloud evidence is accepted.
PRIVACY_EXECUTION_ENABLED=0
PRIVACY_RETENTION_POLICY_APPROVED=0
PRIVACY_PRODUCTION_EXECUTION_ENABLED=0
# Use a dedicated random value with at least 32 characters in production.
PRIVACY_TOMBSTONE_SECRET=

# Optional override. WeChat Cloud Hosting injects this token file by default.
CLOUDBASE_ACCESS_TOKEN_PATH=/.tencentcloudbase/wx/cloudbase_access_token
