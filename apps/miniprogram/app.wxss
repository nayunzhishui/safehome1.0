page {
  --safe-primary: #578b5f;
  --safe-primary-soft: #e9f2df;
  --safe-primary-pale: #f3f8ee;
  --safe-primary-deep: #2f5f48;
  --safe-orange: #f47f45;
  --safe-orange-soft: #fff1e4;
  --safe-yellow: #f1c86d;
  --safe-peach: #ffe3d2;
  --safe-blue: #6f9cc5;
  --safe-blue-soft: #eef6fb;
  --safe-purple: #8767b7;
  --safe-purple-soft: #f3effb;
  --safe-cyan: #b7d7d6;
  --safe-bg: #fff8ee;
  --safe-bg-soft: #f7efe6;
  --safe-bg-leaf: #f6faf2;
  --safe-card: #fffdf8;
  --safe-card-strong: #ffffff;
  --safe-title: #202622;
  --safe-text: #555f59;
  --safe-muted: #7d8580;
  --safe-border: #e4dccf;
  --safe-border-strong: #d4cbbd;
  --safe-success: #578b5f;
  --safe-warning: #e79a42;
  --safe-danger: #d76f67;
  --safe-info: #6f8fb8;
  --safe-shadow-card: 0 16rpx 38rpx rgba(52, 66, 58, 0.08);
  --safe-shadow-float: 0 22rpx 54rpx rgba(52, 66, 58, 0.12);
  --safe-radius-xs: 12rpx;
  --safe-radius-sm: 16rpx;
  --safe-radius-md: 24rpx;
  --safe-radius-lg: 32rpx;
  --safe-radius-pill: 999rpx;
  --safe-page-x: 40rpx;
  --safe-section-gap: 40rpx;
  --safe-card-pad: 28rpx;
  --safe-touch: 88rpx;
  min-height: 100vh;
  background:
    radial-gradient(circle at 8% 0%, rgba(220, 233, 214, 0.72), transparent 360rpx),
    linear-gradient(180deg, #fffdf8 0%, var(--safe-bg) 46%, var(--safe-bg-leaf) 100%);
  color: var(--safe-title);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

button {
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  line-height: normal;
}

button::after {
  border: 0;
}

input,
textarea {
  color: var(--safe-title);
  font: inherit;
}

.safe-page {
  min-height: 100vh;
  padding: var(--safe-page-x);
  padding-bottom: calc(44rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 10% 0%, rgba(220, 233, 214, 0.68), transparent 360rpx),
    radial-gradient(circle at 92% 12%, rgba(241, 200, 109, 0.16), transparent 280rpx),
    linear-gradient(180deg, #fffdf8 0%, var(--safe-bg) 52%, var(--safe-bg-leaf) 100%);
}

.safe-page--with-tabbar {
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.safe-section {
  margin-top: var(--safe-section-gap);
}

.safe-card,
.safe-surface,
.page-head,
.overview-card,
.pattern-card,
.feedback-card,
.starter-card,
.reminder-card,
.legacy-panel,
.growth-card,
.training-card,
.record-card,
.profile-card,
.supervision-card {
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: rgba(255, 253, 248, 0.94);
  box-shadow: var(--safe-shadow-card);
}

.safe-card {
  padding: var(--safe-card-pad);
}

.safe-card--hero {
  border-radius: var(--safe-radius-lg);
  background:
    linear-gradient(108deg, rgba(255, 253, 248, 0.98) 0%, rgba(255, 248, 238, 0.9) 52%, rgba(233, 242, 223, 0.72) 100%);
  box-shadow: var(--safe-shadow-float);
}

.safe-card--green {
  background: linear-gradient(135deg, var(--safe-primary-pale), #fffdf8);
}

.safe-card--orange {
  background: linear-gradient(135deg, var(--safe-orange-soft), #fffdf8);
}

.safe-card--blue {
  background: linear-gradient(135deg, var(--safe-blue-soft), #fffdf8);
}

.safe-title,
.page-title {
  color: var(--safe-title);
  font-size: 40rpx;
  font-weight: 850;
  line-height: 1.24;
  letter-spacing: 0;
}

.safe-subtitle,
.page-subtitle {
  color: var(--safe-muted);
  font-size: 26rpx;
  line-height: 1.65;
}

.safe-muted,
.body-text {
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.58;
}

.safe-h1 {
  display: block;
  color: var(--safe-title);
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.18;
  letter-spacing: 0;
}

.safe-h2 {
  display: block;
  color: var(--safe-title);
  font-size: 36rpx;
  font-weight: 850;
  line-height: 1.28;
  letter-spacing: 0;
}

.safe-h3 {
  display: block;
  color: var(--safe-title);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.36;
  letter-spacing: 0;
}

.safe-body {
  display: block;
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.62;
}

.safe-caption {
  display: block;
  color: var(--safe-muted);
  font-size: 22rpx;
  line-height: 1.5;
}

.safe-primary-button,
.safe-secondary-button,
.safe-outline-button,
.safe-ghost-button,
.safe-orange-button {
  min-height: var(--safe-touch);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
  border-radius: var(--safe-radius-pill);
  font-size: 28rpx;
  font-weight: 800;
}

.safe-primary-button {
  background: linear-gradient(135deg, var(--safe-primary), var(--safe-primary-deep));
  color: #ffffff;
  box-shadow: 0 14rpx 28rpx rgba(78, 124, 107, 0.22);
}

.safe-secondary-button {
  border: 1rpx solid #d8e2ef;
  background: var(--safe-blue-soft);
  color: #58749a;
}

.safe-outline-button {
  border: 1rpx solid var(--safe-primary);
  background: rgba(255, 253, 248, 0.92);
  color: var(--safe-primary-deep);
}

.safe-ghost-button {
  min-height: 72rpx;
  border: 1rpx solid var(--safe-border);
  background: rgba(255, 253, 248, 0.72);
  color: var(--safe-muted);
  font-size: 24rpx;
}

.safe-orange-button {
  background: linear-gradient(135deg, #ff965d, var(--safe-orange));
  color: #ffffff;
  box-shadow: 0 14rpx 28rpx rgba(244, 127, 69, 0.22);
}

.safe-button-sm {
  min-height: 68rpx;
  padding: 0 26rpx;
  font-size: 24rpx;
}

.safe-active {
  transform: scale(0.99);
}

.safe-icon,
.safe-icon-round,
.safe-icon-soft {
  width: 82rpx;
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  border-radius: var(--safe-radius-sm);
  background: var(--safe-primary-soft);
  color: var(--safe-primary);
  font-size: 34rpx;
  font-weight: 900;
}

.safe-icon-round {
  border-radius: 50%;
}

.safe-icon-soft {
  border: 1rpx solid rgba(87, 139, 95, 0.18);
  background: rgba(233, 242, 223, 0.72);
}

.safe-icon--orange {
  background: var(--safe-orange-soft);
  color: var(--safe-orange);
}

.safe-icon--blue {
  background: var(--safe-blue-soft);
  color: var(--safe-blue);
}

.safe-icon--purple {
  background: var(--safe-purple-soft);
  color: var(--safe-purple);
}

.safe-tag {
  min-height: 44rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 18rpx;
  border-radius: var(--safe-radius-pill);
  background: var(--safe-primary-soft);
  color: var(--safe-primary-deep);
  font-size: 22rpx;
  font-weight: 700;
}

.safe-tag-orange {
  background: var(--safe-orange-soft);
  color: #b36b1d;
}

.safe-tag-blue {
  background: var(--safe-blue-soft);
  color: #5d79a0;
}

.safe-list {
  display: grid;
  gap: 18rpx;
}

.safe-list-item {
  min-height: 104rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: rgba(255, 253, 248, 0.96);
  box-shadow: var(--safe-shadow-card);
  text-align: left;
}

.safe-list-copy {
  min-width: 0;
  flex: 1;
}

.safe-list-title {
  display: block;
  color: var(--safe-title);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.42;
}

.safe-list-subtitle {
  display: block;
  margin-top: 6rpx;
  color: var(--safe-muted);
  font-size: 23rpx;
  line-height: 1.45;
}

.safe-list-arrow {
  color: var(--safe-primary-deep);
  font-size: 34rpx;
  font-weight: 800;
}

.safe-section-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.page-head {
  position: relative;
  min-height: 190rpx;
  display: grid;
  gap: 10rpx;
  overflow: hidden;
  padding: 32rpx;
  background:
    linear-gradient(110deg, rgba(255, 253, 248, 0.96) 0%, rgba(255, 247, 240, 0.88) 54%, rgba(220, 233, 214, 0.62) 100%);
}

.page-head::before {
  content: "";
  position: absolute;
  right: 42rpx;
  top: 34rpx;
  width: 88rpx;
  height: 88rpx;
  border: 2rpx solid rgba(78, 124, 107, 0.28);
  border-radius: 50%;
}

.head-image {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 260rpx;
  height: 190rpx;
  opacity: 0.88;
}

.action-grid {
  position: sticky;
  bottom: 0;
  z-index: 3;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin: 34rpx calc(var(--safe-page-x) * -1) calc(var(--safe-page-x) * -1);
  padding: 18rpx var(--safe-page-x) calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 247, 240, 0.92);
  border-top: 1rpx solid rgba(225, 216, 204, 0.86);
  backdrop-filter: blur(16rpx);
}

.action-grid .safe-primary-button:first-child,
.action-grid .action-button:first-child {
  grid-column: 1 / -1;
}
