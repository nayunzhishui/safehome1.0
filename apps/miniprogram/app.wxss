page {
  --safe-primary: #4e7c6b;
  --safe-primary-deep: #2f5f48;
  --safe-orange: #f0b767;
  --safe-peach: #ffe3d2;
  --safe-blue: #a8c1e0;
  --safe-cyan: #b7d7d6;
  --safe-bg: #fff7f0;
  --safe-bg-soft: #f7efe6;
  --safe-card: #fffdf8;
  --safe-title: #242b27;
  --safe-text: #555f59;
  --safe-muted: #7d8580;
  --safe-border: #e1d8cc;
  --safe-success: #4e7c6b;
  --safe-warning: #e79a42;
  --safe-danger: #d76f67;
  --safe-info: #6f8fb8;
  min-height: 100vh;
  background:
    radial-gradient(circle at 8% 0%, rgba(220, 233, 214, 0.72), transparent 360rpx),
    linear-gradient(180deg, #fffdf8 0%, #fff7f0 46%, #f7fbf3 100%);
  color: var(--safe-title);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

button {
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  line-height: normal;
}

button::after {
  border: 0;
}

input,
textarea {
  color: var(--safe-title);
  font: inherit;
}

.safe-page {
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: calc(44rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 10% 0%, rgba(220, 233, 214, 0.68), transparent 360rpx),
    linear-gradient(180deg, #fffdf8 0%, #fff7f0 52%, #f6faf2 100%);
}

.safe-section {
  margin-top: 34rpx;
}

.safe-card,
.page-head,
.overview-card,
.pattern-card,
.feedback-card,
.starter-card,
.reminder-card,
.legacy-panel,
.growth-card,
.training-card,
.record-card,
.profile-card,
.supervision-card {
  border: 1rpx solid var(--safe-border);
  border-radius: 16rpx;
  background: rgba(255, 253, 248, 0.94);
  box-shadow: 0 16rpx 38rpx rgba(52, 66, 58, 0.08);
}

.safe-title,
.page-title {
  color: var(--safe-title);
  font-size: 40rpx;
  font-weight: 850;
  line-height: 1.24;
  letter-spacing: 0;
}

.safe-subtitle,
.page-subtitle {
  color: var(--safe-muted);
  font-size: 26rpx;
  line-height: 1.65;
}

.safe-muted,
.body-text {
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.58;
}

.safe-primary-button,
.safe-secondary-button,
.safe-outline-button {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.safe-primary-button {
  background: linear-gradient(135deg, var(--safe-primary), var(--safe-primary-deep));
  color: #ffffff;
  box-shadow: 0 14rpx 28rpx rgba(78, 124, 107, 0.22);
}

.safe-secondary-button {
  border: 1rpx solid #d8e2ef;
  background: #eef4fb;
  color: #58749a;
}

.safe-outline-button {
  border: 1rpx solid var(--safe-primary);
  background: rgba(255, 253, 248, 0.92);
  color: var(--safe-primary-deep);
}

.safe-tag {
  min-height: 44rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 18rpx;
  border-radius: 22rpx;
  background: #dce9d6;
  color: var(--safe-primary-deep);
  font-size: 22rpx;
  font-weight: 700;
}

.safe-tag-orange {
  background: #ffe8ca;
  color: #b36b1d;
}

.safe-tag-blue {
  background: #e7eef8;
  color: #5d79a0;
}

.page-head {
  position: relative;
  min-height: 190rpx;
  display: grid;
  gap: 10rpx;
  overflow: hidden;
  padding: 32rpx;
  background:
    linear-gradient(110deg, rgba(255, 253, 248, 0.96) 0%, rgba(255, 247, 240, 0.88) 54%, rgba(220, 233, 214, 0.62) 100%);
}

.page-head::before {
  content: "";
  position: absolute;
  right: 42rpx;
  top: 34rpx;
  width: 88rpx;
  height: 88rpx;
  border: 2rpx solid rgba(78, 124, 107, 0.28);
  border-radius: 50%;
}

.head-image {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 260rpx;
  height: 190rpx;
  opacity: 0.88;
}

.action-grid {
  position: sticky;
  bottom: 0;
  z-index: 3;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin: 34rpx -32rpx -32rpx;
  padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 247, 240, 0.92);
  border-top: 1rpx solid rgba(225, 216, 204, 0.86);
  backdrop-filter: blur(16rpx);
}

.action-grid .safe-primary-button:first-child,
.action-grid .action-button:first-child {
  grid-column: 1 / -1;
}
