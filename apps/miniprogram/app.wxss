page {
  --safe-primary: #4f7c6b;
  --safe-primary-soft: #e8f0ea;
  --safe-primary-pale: #f4f8f5;
  --safe-primary-deep: #2f5b4d;
  --safe-orange: #d98243;
  --safe-orange-soft: #fbf0e6;
  --safe-yellow: #d9b85d;
  --safe-peach: #f7e5d8;
  --safe-blue: #627f9f;
  --safe-blue-soft: #eef3f7;
  --safe-purple: #746390;
  --safe-purple-soft: #f1eef6;
  --safe-cyan: #a8c8c4;
  --safe-bg: #f7f8f5;
  --safe-bg-soft: #f2f4f0;
  --safe-bg-leaf: #f7faf5;
  --safe-card: #ffffff;
  --safe-card-strong: #ffffff;
  --safe-title: #202622;
  --safe-text: #535f58;
  --safe-muted: #78817b;
  --safe-border: #dfe5dc;
  --safe-border-strong: #cbd5ca;
  --safe-success: #578b5f;
  --safe-warning: #e79a42;
  --safe-danger: #d76f67;
  --safe-info: #6f8fb8;
  --safe-shadow-card: 0 8rpx 20rpx rgba(37, 55, 44, 0.05);
  --safe-shadow-float: 0 14rpx 34rpx rgba(37, 55, 44, 0.08);
  --safe-radius-xs: 8rpx;
  --safe-radius-sm: 16rpx;
  --safe-radius-md: 16rpx;
  --safe-radius-lg: 20rpx;
  --safe-radius-pill: 999rpx;
  --safe-page-x: 40rpx;
  --safe-section-gap: 40rpx;
  --safe-card-pad: 28rpx;
  --safe-touch: 88rpx;
  min-height: 100vh;
  background: var(--safe-bg);
  color: var(--safe-title);
  font-family: "Heiti SC", "STHeiti", "SimHei", "Microsoft YaHei", "PingFang SC", sans-serif;
  line-height: 1.7;
  font-size: 28rpx;
}

button {
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  line-height: normal;
}

button::after {
  border: 0;
}

input,
textarea {
  color: var(--safe-title);
  font: inherit;
}

.safe-page {
  min-height: 100vh;
  padding: var(--safe-page-x);
  padding-bottom: calc(44rpx + env(safe-area-inset-bottom));
  background: var(--safe-bg);
}

.safe-page--with-tabbar {
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.safe-section {
  margin-top: var(--safe-section-gap);
}

.safe-card,
.safe-surface,
.page-head,
.overview-card,
.pattern-card,
.feedback-card,
.starter-card,
.reminder-card,
.legacy-panel,
.growth-card,
.training-card,
.record-card,
.profile-card,
.supervision-card {
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: var(--safe-card);
  box-shadow: var(--safe-shadow-card);
}

.safe-card {
  padding: var(--safe-card-pad);
}

.safe-card--hero {
  border-radius: var(--safe-radius-lg);
  background: var(--safe-card);
  box-shadow: var(--safe-shadow-float);
}

.safe-card--green {
  background: var(--safe-primary-pale);
}

.safe-card--orange {
  background: var(--safe-orange-soft);
}

.safe-card--blue {
  background: var(--safe-blue-soft);
}

.safe-title,
.page-title {
  color: var(--safe-title);
  font-size: 40rpx;
  font-weight: 850;
  line-height: 1.24;
  letter-spacing: 0;
}

.safe-subtitle,
.page-subtitle {
  color: var(--safe-muted);
  font-size: 26rpx;
  line-height: 1.65;
}

.safe-muted,
.body-text {
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.58;
}

.safe-h1 {
  display: block;
  color: var(--safe-title);
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.18;
  letter-spacing: 0;
}

.safe-h2 {
  display: block;
  color: var(--safe-title);
  font-size: 36rpx;
  font-weight: 850;
  line-height: 1.28;
  letter-spacing: 0;
}

.safe-h3 {
  display: block;
  color: var(--safe-title);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.36;
  letter-spacing: 0;
}

.safe-body {
  display: block;
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.62;
}

.safe-caption {
  display: block;
  color: var(--safe-muted);
  font-size: 22rpx;
  line-height: 1.5;
}

.safe-primary-button,
.safe-secondary-button,
.safe-outline-button,
.safe-ghost-button,
.safe-orange-button {
  min-height: var(--safe-touch);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
  border-radius: var(--safe-radius-pill);
  font-size: 28rpx;
  font-weight: 800;
}

.safe-primary-button {
  background: var(--safe-primary);
  color: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(78, 124, 107, 0.18);
}

.safe-secondary-button {
  border: 1rpx solid #d8e2ef;
  background: var(--safe-blue-soft);
  color: #58749a;
}

.safe-outline-button {
  border: 1rpx solid var(--safe-primary);
  background: #ffffff;
  color: var(--safe-primary-deep);
}

.safe-ghost-button {
  min-height: 72rpx;
  border: 1rpx solid var(--safe-border);
  background: #ffffff;
  color: var(--safe-muted);
  font-size: 24rpx;
}

.safe-orange-button {
  background: var(--safe-orange);
  color: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(217, 130, 67, 0.18);
}

.safe-button-sm {
  min-height: 68rpx;
  padding: 0 26rpx;
  font-size: 24rpx;
}

.safe-active {
  transform: scale(0.99);
}

.safe-icon,
.safe-icon-round,
.safe-icon-soft {
  width: 82rpx;
  height: 82rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  border-radius: var(--safe-radius-sm);
  background: var(--safe-primary-soft);
  color: var(--safe-primary);
  font-size: 34rpx;
  font-weight: 900;
}

.safe-icon-round {
  border-radius: 50%;
}

.safe-icon-soft {
  border: 1rpx solid rgba(87, 139, 95, 0.18);
  background: rgba(233, 242, 223, 0.72);
}

.safe-icon--orange {
  background: var(--safe-orange-soft);
  color: var(--safe-orange);
}

.safe-icon--blue {
  background: var(--safe-blue-soft);
  color: var(--safe-blue);
}

.safe-icon--purple {
  background: var(--safe-purple-soft);
  color: var(--safe-purple);
}

.safe-tag {
  min-height: 44rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 18rpx;
  border-radius: var(--safe-radius-pill);
  background: var(--safe-primary-soft);
  color: var(--safe-primary-deep);
  font-size: 22rpx;
  font-weight: 700;
}

.safe-tag-orange {
  background: var(--safe-orange-soft);
  color: #b36b1d;
}

.safe-tag-blue {
  background: var(--safe-blue-soft);
  color: #5d79a0;
}

.safe-list {
  display: grid;
  gap: 18rpx;
}

.safe-list-item {
  min-height: 104rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: var(--safe-card);
  box-shadow: var(--safe-shadow-card);
  text-align: left;
}

.safe-list-copy {
  min-width: 0;
  flex: 1;
}

.safe-list-title {
  display: block;
  color: var(--safe-title);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.42;
}

.safe-list-subtitle {
  display: block;
  margin-top: 6rpx;
  color: var(--safe-muted);
  font-size: 23rpx;
  line-height: 1.45;
}

.safe-list-arrow {
  color: var(--safe-primary-deep);
  font-size: 34rpx;
  font-weight: 800;
}

.safe-section-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.page-head {
  position: relative;
  min-height: 190rpx;
  display: grid;
  gap: 10rpx;
  overflow: hidden;
  padding: 32rpx;
  background: var(--safe-card);
}

.page-head::before {
  display: none;
}

.head-image {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 260rpx;
  height: 190rpx;
  opacity: 0.88;
}

.action-grid {
  position: sticky;
  bottom: 0;
  z-index: 3;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin: 34rpx calc(var(--safe-page-x) * -1) calc(var(--safe-page-x) * -1);
  padding: 18rpx var(--safe-page-x) calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(247, 248, 245, 0.94);
  border-top: 1rpx solid var(--safe-border);
  backdrop-filter: blur(16rpx);
}

.action-grid .safe-primary-button:first-child,
.action-grid .action-button:first-child {
  grid-column: 1 / -1;
}
