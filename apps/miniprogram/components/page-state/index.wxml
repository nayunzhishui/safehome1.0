<view class="page-state page-state--{{kind}}" role="status" aria-live="polite">
  <view wx:if="{{kind === 'loading'}}" class="page-state__loader" aria-hidden="true">
    <text></text><text></text><text></text>
  </view>
  <view wx:else class="page-state__mark" aria-hidden="true">{{kind === 'error' ? '!' : '·'}}</view>
  <view class="page-state__copy">
    <text class="page-state__title">{{title}}</text>
    <text wx:if="{{description}}" class="page-state__description">{{description}}</text>
  </view>
  <button
    wx:if="{{actionLabel}}"
    class="page-state__action"
    aria-label="{{actionAriaLabel || actionLabel}}"
    bindtap="handleAction"
  >{{actionLabel}}</button>
</view>
