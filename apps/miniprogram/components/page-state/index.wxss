/* PageState（Figma 658:2096）：Empty 新竹插画、Error 风险色徽章、Loading 三点；动作为 Secondary 按钮。 */
.page-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  box-sizing: border-box;
  width: 100%;
  padding: 64rpx 40rpx;
  text-align: center;
}

.page-state__sprout {
  display: block;
  width: 128rpx;
  height: 128rpx;
}

.page-state__dots {
  display: block;
  width: 80rpx;
  height: 48rpx;
}

.page-state__badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  overflow: hidden;
  border-radius: 52rpx;
  background: var(--p3-risk-soft);
}

.page-state__title {
  display: block;
  width: 100%;
  color: var(--p3-ink);
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: 500;
  overflow-wrap: anywhere;
}

.page-state__description {
  display: block;
  width: 100%;
  color: var(--p3-muted);
  font-size: 30rpx;
  line-height: 52rpx;
  overflow-wrap: anywhere;
}

.page-state__action {
  min-height: var(--safe-touch, 88rpx);
}
