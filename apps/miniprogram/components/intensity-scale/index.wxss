.intensity-scale {
  display: flex;
  align-items: stretch;
  justify-content: center;
  gap: 18rpx;
  min-width: 0;
}

.intensity-labels {
  height: 396rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-end;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1;
}

.intensity-touch-target {
  width: 108rpx;
  min-height: 396rpx;
  display: flex;
  justify-content: center;
  touch-action: none;
}

.intensity-track {
  position: relative;
  width: 58rpx;
  height: 396rpx;
  overflow: visible;
  border: 1rpx solid var(--safe-border);
  border-radius: 30rpx;
  background: var(--safe-bg-leaf);
}

.intensity-fill {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  min-height: 10%;
  border-radius: 30rpx;
  background: var(--safe-primary);
}

.intensity-marker {
  position: absolute;
  left: 50%;
  width: 70rpx;
  height: 70rpx;
  margin-bottom: -35rpx;
  margin-left: -35rpx;
  border: 6rpx solid #ffffff;
  border-radius: 50%;
  background: var(--safe-primary);
  box-shadow: 0 4rpx 12rpx rgba(52, 66, 58, 0.12);
}
