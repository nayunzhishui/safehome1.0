/* 数据导出（研究者工作台“管理”页）：类型与行数选择、生成和转发按钮。 */
.research-export,
.research-export__head {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
}

.research-export__chips {
  display: flex;
  flex-wrap: wrap;
  gap: var(--p3-tight);
}

.research-export__picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--p3-tight);
  min-height: 88rpx;
  padding: 0 32rpx;
  border-radius: var(--p3-radius-pill);
  background: var(--p3-surface);
  box-shadow: inset 0 0 0 2rpx var(--p3-hairline);
  color: var(--p3-ink);
  font-size: 28rpx;
}
