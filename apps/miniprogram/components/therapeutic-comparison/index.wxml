<view class="therapeutic-comparison" aria-label="原话与系统整理对照">
  <view class="spine-note">
    <view class="spine-note__spine" aria-hidden="true"><view class="spine-note__joint"></view><view class="spine-note__line"></view></view>
    <view class="spine-note__copy"><text class="spine-note__label">你的原话</text><text class="spine-note__body">{{originalText || '尚未填写'}}</text></view>
  </view>
  <view class="spine-note spine-note--muted">
    <view class="spine-note__spine" aria-hidden="true"><view class="spine-note__joint"></view><view class="spine-note__line"></view></view>
    <view class="spine-note__copy"><text class="spine-note__label">系统整理</text><text class="spine-note__body">{{systemText || '尚未形成整理版本'}}</text></view>
  </view>
</view>
