/* 竹节脊线对照（Figma 658:2059 SpineNote）：原话青瓷脊线，系统整理细线脊线。 */
:host {
  display: block;
  width: 100%;
}

.therapeutic-comparison {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
}

.spine-note {
  display: flex;
  align-items: stretch;
  gap: var(--p3-tight);
}

.spine-note__spine {
  display: flex;
  flex: 0 0 auto;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding-top: 14rpx;
}

.spine-note__joint {
  width: 20rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--p3-primary);
}

.spine-note__line {
  flex: 1 0 0;
  width: 4rpx;
  background: var(--p3-primary);
  opacity: 0.35;
}

.spine-note--muted .spine-note__joint,
.spine-note--muted .spine-note__line {
  background: var(--p3-hairline);
  opacity: 1;
}

.spine-note__copy {
  display: flex;
  flex: 1 0 0;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.spine-note__label {
  color: var(--p3-primary);
  font-size: 26rpx;
  line-height: 40rpx;
}

.spine-note--muted .spine-note__label {
  color: var(--p3-muted);
}

.spine-note__body {
  color: var(--p3-ink);
  font-size: 30rpx;
  line-height: 52rpx;
  overflow-wrap: anywhere;
}
