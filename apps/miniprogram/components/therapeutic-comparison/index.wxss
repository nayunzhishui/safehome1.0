.therapeutic-comparison { display: grid; gap: 32rpx; }
.comparison-panel { min-width: 0; display: grid; grid-template-columns: 24rpx minmax(0, 1fr); gap: 24rpx; align-items: stretch; }
.comparison-spine { position: relative; min-height: 160rpx; }
.comparison-spine__line { position: absolute; top: 16rpx; bottom: 12rpx; left: 11rpx; width: 2rpx; background: var(--safe-primary); }
.comparison-spine__joint { position: absolute; top: 0; left: 6rpx; width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--safe-primary); }
.comparison-spine__tick { position: absolute; top: 40rpx; left: 4rpx; width: 16rpx; height: 4rpx; border-radius: 2rpx; background: var(--safe-primary); }
.comparison-copy { min-width: 0; display: grid; align-content: start; gap: 24rpx; }
.comparison-label { color: var(--safe-primary-deep); font-size: 28rpx; font-weight: 500; line-height: 40rpx; }
.comparison-body { color: var(--safe-text); font-size: 28rpx; line-height: 48rpx; }
