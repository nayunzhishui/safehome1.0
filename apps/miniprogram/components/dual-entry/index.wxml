<view class="dual-entries" role="group" aria-label="主要记录入口">
  <function-entry-card class="dual-entry" title="{{leftTitle}}" subtitle="{{leftSubtitle}}" icon-type="{{leftIcon}}" action-key="{{leftKey}}" bind:tapcard="forwardAction" />
  <function-entry-card class="dual-entry" title="{{rightTitle}}" subtitle="{{rightSubtitle}}" icon-type="{{rightIcon}}" action-key="{{rightKey}}" accent-color="#C96F2D" accent-bg="#FFF1E5" bind:tapcard="forwardAction" />
</view>
