<view class="p3-page taf-page" role="main" aria-label="{{title}}">
  <view class="taf-progress" aria-label="第 {{stepNumber}} 步，共 {{stepTotal}} 步">
    <text class="taf-progress__text">第 {{stepNumber}} 步 / 共 {{stepTotal}} 步</text>
    <view class="taf-progress__joints" aria-hidden="true">
      <view wx:for="{{joints}}" wx:key="index" class="taf-progress__joint taf-progress__joint--{{item}}"></view>
    </view>
  </view>

  <text class="p3-serif-title taf-title" role="heading" aria-level="1">{{title}}</text>

  <page-state
    wx:if="{{loading}}"
    kind="loading"
    title="正在读取"
  />
  <page-state
    wx:elif="{{stateKind}}"
    kind="{{stateKind === 'withdrawn' || stateKind === 'expired' ? 'error' : stateKind}}"
    title="{{stateTitle}}"
    description="{{stateDescription}}"
    action-label="{{stateKind === 'error' || stateKind === 'offline' ? '重新读取' : ''}}"
    action-aria-label="重新读取本步骤"
    bindaction="handleRetry"
  />

  <view wx:if="{{offline}}" class="p3-notice p3-notice--warm" role="status" aria-live="polite">
    <text class="p3-notice__body">当前离线。内容会先保存在本机，联网后可再次同步。</text>
  </view>

  <view wx:if="{{!loading && stateKind !== 'withdrawn' && stateKind !== 'expired'}}" class="taf-card">
    <text wx:if="{{description}}" class="taf-description">{{description}}</text>

    <view wx:if="{{mode === 'text'}}" class="p3-field">
      <text wx:if="{{prompt}}" class="p3-field__label">{{prompt}}</text>
      <therapeutic-textarea maxlength="4000" value="{{value}}" aria-label="{{prompt || title}}" placeholder="{{placeholder}}" bind:input="handleInput" />
    </view>
    <text wx:elif="{{prompt}}" class="p3-item-title">{{prompt}}</text>

    <view wx:if="{{notice}}" class="p3-notice">
      <text class="p3-notice__body">{{notice}}</text>
    </view>

    <therapeutic-feedback-letter
      wx:if="{{mode === 'feedback' && feedbackContent}}"
      layer-label="{{feedbackLayerLabel}}"
      title="{{feedbackTitle}}"
      content="{{feedbackContent}}"
    />

    <view wx:if="{{mode === 'choice' || mode === 'feedback'}}" class="taf-options" role="radiogroup" aria-label="{{prompt || title}}">
      <therapeutic-choice-option
        wx:for="{{options}}"
        wx:key="value"
        value="{{item.value}}"
        label="{{item.label}}"
        description="{{item.description}}"
        selected="{{selected === item.value}}"
        bind:change="handleOption"
      />
    </view>

    <therapeutic-textarea
      wx:if="{{mode === 'feedback' && selected === 'not_like'}}"
      maxlength="4000"
      value="{{value}}"
      aria-label="{{prompt || title}}"
      placeholder="{{placeholder}}"
      bind:input="handleInput"
    />

    <view wx:if="{{mode === 'action'}}" class="taf-action-form">
      <view class="taf-action-section">
        <p3-section-header title="想做什么" />
        <view class="p3-field">
          <text class="p3-field__label">我愿意尝试的一小步</text>
          <therapeutic-textarea maxlength="500" value="{{value}}" aria-label="我愿意尝试的一小步" placeholder="写下低压力、可停止的一小步。" bind:input="handleInput" />
        </view>
        <view class="p3-field">
          <text class="p3-field__label">我为什么想试试</text>
          <therapeutic-compact-textarea maxlength="500" value="{{actionPlan.purposeText}}" field="purposeText" aria-label="行动目的" placeholder="记录你的目的，不要求证明效果。" bind:input="handleActionInput" />
        </view>
      </view>
      <view class="taf-action-section taf-action-section--divided">
        <p3-section-header title="怎样安排" />
        <view class="taf-action-grid">
          <view class="p3-field taf-action-grid__item">
            <text class="p3-field__label">计划日期（可不填）</text>
            <picker mode="date" value="{{actionPlan.plannedDate}}" data-field="plannedDate" aria-label="选择计划日期" bindchange="handleActionInput">
              <view class="taf-select">
                <text class="taf-select__value {{plannedDateText ? '' : 'taf-select__value--empty'}}">{{plannedDateText || '选择日期'}}</text>
                <p3-icon class="taf-select__icon" name="calendar" size="24" tone="field" />
              </view>
            </picker>
          </view>
          <view class="p3-field taf-action-grid__item">
            <text class="p3-field__label">提醒方式</text>
            <picker mode="selector" range="{{reminderOptions}}" value="{{actionPlan.reminderMode === 'in_app' ? 1 : actionPlan.reminderMode === 'wechat_subscription' ? 2 : 0}}" bindchange="handleReminderMode">
              <view class="taf-select" role="button" aria-label="选择提醒方式">
                <text class="taf-select__value">{{actionPlan.reminderMode === 'in_app' ? '仅站内提醒' : actionPlan.reminderMode === 'wechat_subscription' ? '微信订阅提醒' : '不提醒'}}</text>
                <p3-icon class="taf-select__icon" name="chevron-down" size="24" tone="muted" />
              </view>
            </picker>
          </view>
        </view>
      </view>
      <view class="taf-action-section taf-action-section--divided">
        <p3-section-header title="何时停下" />
        <view class="p3-field">
          <text class="p3-field__label">什么情况下先停下来</text>
          <therapeutic-compact-textarea maxlength="300" value="{{actionPlan.stopCondition}}" field="stopCondition" aria-label="停止条件" placeholder="例如：感到明显不适、冲突升级或不再愿意时。" bind:input="handleActionInput" />
        </view>
        <view class="p3-field">
          <text class="p3-field__label">如果没做到，我会怎么记录</text>
          <therapeutic-compact-textarea maxlength="800" value="{{actionPlan.setbackPlan}}" field="setbackPlan" aria-label="未完成时的记录方式" placeholder="只记录发生了什么，不责备自己。" bind:input="handleActionInput" />
        </view>
      </view>
      <button class="taf-confirmation" role="checkbox" aria-checked="{{actionPlan.confirmed}}" bindtap="handleActionConfirmation">
        <view class="taf-confirmation__box {{actionPlan.confirmed ? 'taf-confirmation__box--checked' : ''}}" aria-hidden="true">
          <image wx:if="{{actionPlan.confirmed}}" class="taf-confirmation__tick" src="/assets/icons/p3/tick-14-white.svg" />
        </view>
        <text class="taf-confirmation__text">这是我自愿选择的行动，我知道可以修改、停止或不做。</text>
      </button>
    </view>

    <therapeutic-comparison wx:if="{{mode === 'summary'}}" original-text="{{originalText}}" system-text="{{systemText}}" />

    <text wx:if="{{saveStatus}}" class="taf-status" aria-live="polite">{{saveStatus}}</text>
  </view>

  <view wx:if="{{!loading && stateKind !== 'withdrawn' && stateKind !== 'expired'}}" class="taf-actions">
    <button class="p3-btn p3-btn--secondary taf-actions__back" aria-label="返回上一步" bindtap="handleBack">上一步</button>
    <button
      class="p3-btn p3-btn--primary taf-actions__next"
      loading="{{saving}}"
      disabled="{{saving || !canContinue}}"
      aria-label="{{nextLabel}}"
      bindtap="handleContinue"
    >{{nextLabel}}</button>
  </view>

  <text wx:if="{{stepNumber === 1}}" class="p3-footnote">你可以暂停、修改或撤回。这里提供自我了解线索，不替代诊断、治疗或紧急帮助。</text>
</view>
