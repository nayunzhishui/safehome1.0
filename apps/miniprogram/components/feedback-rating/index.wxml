<view class="feedback-rating {{compact ? 'feedback-rating--compact' : ''}} {{editorial ? 'feedback-rating--editorial' : ''}}">
  <text class="feedback-rating-prompt">{{prompt}}</text>
  <view class="feedback-rating-options">
    <button
      wx:for="{{options}}"
      wx:key="value"
      class="feedback-rating-option {{value === item.value ? 'feedback-rating-option--active' : ''}} {{item.value === 'uncomfortable' ? 'feedback-rating-option--care' : ''}}"
      data-value="{{item.value}}"
      disabled="{{disabled}}"
      aria-label="评价为{{item.label}}"
      aria-pressed="{{value === item.value}}"
      bindtap="select"
    >{{item.label}}</button>
  </view>
  <text wx:if="{{value === 'uncomfortable'}}" class="feedback-rating-note feedback-rating-note--care" role="status" aria-live="polite">已记录为需要人工复核的体验信号，不会据此推断风险或诊断。</text>
  <text wx:elif="{{value}}" class="feedback-rating-note" role="status" aria-live="polite">已记录你的核对，可以随时调整。</text>
</view>
