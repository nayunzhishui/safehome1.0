.feedback-rating {
  padding: 20rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: var(--ui2-feedback-bg,var(--safe-card));
}

.feedback-rating--compact { padding: 16rpx; }

.feedback-rating--editorial {
  padding: var(--ui2-feedback-padding,40rpx);
  border-radius: var(--ui2-button-radius,32rpx);
}

.feedback-rating--editorial .feedback-rating-prompt {
  font-size: var(--ui2-body,28rpx);
  line-height: 1.43;
}

.feedback-rating--editorial .feedback-rating-options {
  gap: 16rpx;
  margin-top: 28rpx;
}

.feedback-rating--editorial .feedback-rating-option {
  box-sizing: border-box;
  flex: var(--ui2-feedback-option-flex, 0 1 auto);
  min-height: var(--safe-touch,88rpx);
  padding: 10rpx 20rpx;
  font-size: var(--ui2-body,24rpx);
}

.feedback-rating--editorial .feedback-rating-note {
  margin-top: 20rpx;
  font-size: var(--ui2-body,24rpx);
  line-height: 1.5;
}

.feedback-rating-prompt {
  display: block;
  color: var(--safe-title);
  font-size: var(--ui2-body,24rpx);
  font-weight: 800;
  line-height: 1.45;
}

.feedback-rating-options {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.feedback-rating-option {
  min-height: var(--safe-touch,88rpx);
  margin: 0;
  padding: 10rpx 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--ui2-button-radius,999rpx);
  background: var(--safe-bg-soft);
  color: var(--safe-text);
  font-size: var(--ui2-body,22rpx);
  font-weight: 700;
  line-height: 1.3;
}

.feedback-rating-option::after { border: 0; }
.feedback-rating-option:focus-visible { outline: 4rpx solid var(--safe-blue); outline-offset: 3rpx; }
.feedback-rating-option--active {
  border-color: var(--safe-primary);
  background: var(--safe-primary-soft);
  color: var(--safe-primary-deep);
}

.feedback-rating-option--care.feedback-rating-option--active {
  border-color: #c77954;
  background: #fff4ed;
  color: #7b452e;
}

.feedback-rating-note {
  display: block;
  margin-top: 12rpx;
  color: var(--safe-muted);
  font-size: var(--ui2-caption,20rpx);
  line-height: 1.5;
}

.feedback-rating-note--care { color: #7b452e; }
