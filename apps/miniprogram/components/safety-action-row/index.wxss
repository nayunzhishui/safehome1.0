:host{display:block}.action-row{min-height:140rpx;display:flex;gap:28rpx;align-items:flex-start;padding:28rpx 8rpx;border-bottom:1rpx solid var(--experience-line)}.action-number,.step-text{display:block}.action-number{width:88rpx;flex:0 0 88rpx;color:var(--experience-primary-deep);font-size:40rpx;font-weight:700;line-height:56rpx}.step-text{min-width:0;flex:1;color:var(--experience-ink);font-size:var(--experience-font-body);line-height:44rpx;overflow-wrap:anywhere}
