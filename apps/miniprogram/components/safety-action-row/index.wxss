/* 编号步骤行（Figma StepRow·Number 670:3087）：衬线青瓷数字 + 正文，底部细线可关。 */
:host {
  display: block;
}

.step-row {
  display: flex;
  align-items: flex-start;
  gap: 28rpx;
  padding: 28rpx 0;
}

.step-row--divided {
  border-bottom: 2rpx solid var(--p3-hairline);
}

.step-row__number {
  flex: 0 0 auto;
  width: 56rpx;
  color: var(--p3-primary);
  font-family: var(--p3-font-serif-text);
  font-size: 34rpx;
  line-height: 56rpx;
  letter-spacing: 0.6rpx;
}

.step-row__text {
  flex: 1 0 0;
  min-width: 0;
  padding-top: 2rpx;
  color: var(--p3-ink);
  font-size: 30rpx;
  line-height: 52rpx;
}
