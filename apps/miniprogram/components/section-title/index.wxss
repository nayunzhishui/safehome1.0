.section-title-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.section-title-main {
  min-width: 0;
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.section-accent {
  width: 10rpx;
  height: 38rpx;
  flex: 0 0 auto;
  margin-top: 1rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.section-accent__segment {
  width: 6rpx;
  border-radius: var(--safe-radius-pill);
  background: var(--safe-primary);
}

.section-accent__segment--top {
  height: 13rpx;
}

.section-accent__joint {
  width: 10rpx;
  height: 4rpx;
  margin: 2rpx 0;
  border-radius: var(--safe-radius-pill);
  background: var(--safe-primary-deep);
}

.section-accent__segment--bottom {
  height: 17rpx;
}

.section-title-text,
.section-subtitle-text {
  display: block;
  text-align: left;
}

.section-title-text {
  color: var(--safe-title);
  font-size: 30rpx;
  font-weight: 850;
  line-height: 1.35;
}

.section-subtitle-text {
  margin-top: 8rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.45;
}

.section-more {
  min-height: 54rpx;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  padding: 0 4rpx 0 18rpx;
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 750;
}
