.section-title-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.section-title-main {
  min-width: 0;
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.section-accent {
  width: 8rpx;
  height: 34rpx;
  flex: 0 0 auto;
  margin-top: 4rpx;
  border-radius: 999rpx;
  background: var(--safe-primary);
}

.section-title-text,
.section-subtitle-text {
  display: block;
  text-align: left;
}

.section-title-text {
  color: var(--safe-title);
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.35;
}

.section-subtitle-text {
  margin-top: 8rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.45;
}

.section-more {
  min-height: 54rpx;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  padding: 0 4rpx 0 18rpx;
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 600;
}
