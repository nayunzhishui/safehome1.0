/* 功能知情说明（P3 弹层）：深青半透明遮罩；纸白卡片圆角 24；说明可滚动；勾选后主按钮可用。 */
.consent-shade {
  position: fixed;
  inset: 0;
  z-index: 1200;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 40rpx;
  background: rgba(23, 60, 67, 0.62);
}

.consent-dialog {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
  box-sizing: border-box;
  width: 100%;
  max-width: 670rpx;
  max-height: 90vh;
  padding: 48rpx 40rpx 32rpx;
  border-radius: var(--p3-radius-card);
  background: var(--p3-surface);
  box-shadow: var(--p3-shadow-float);
  color: var(--p3-ink);
}

.consent-title {
  display: block;
  font-size: 40rpx;
  line-height: 56rpx;
  font-weight: 500;
  text-align: center;
}

.consent-content {
  min-height: 0;
  max-height: 42vh;
  font-size: 28rpx;
  line-height: 44rpx;
}

.consent-content text {
  display: block;
}

.consent-boundary {
  margin-top: 24rpx;
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

.consent-link {
  margin-top: 8rpx;
}

.consent-actions {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
}
