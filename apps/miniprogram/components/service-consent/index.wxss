.consent-shade{position:fixed;inset:0;z-index:1200;background:rgba(20,39,35,.55);display:flex;align-items:center;justify-content:center;padding:32rpx;box-sizing:border-box}.consent-dialog{width:100%;max-width:650rpx;background:#fffdf9;border-radius:28rpx;padding:36rpx;box-sizing:border-box;max-height:90vh;display:flex;flex-direction:column;gap:24rpx;color:#20332e}.consent-title{font-size:36rpx;font-weight:600;text-align:center}.consent-content{min-height:0;max-height:42vh;font-size:28rpx;line-height:1.7}.consent-content text{display:block}.consent-boundary{margin-top:24rpx}.consent-check{display:flex;align-items:flex-start;gap:12rpx;font-size:28rpx;line-height:1.6;padding:8rpx 0}.consent-dialog button{width:100%;min-height:88rpx;font-size:28rpx;line-height:1.5;padding:22rpx 20rpx;border-radius:16rpx}.consent-primary{background:#2f6a60;color:white}.consent-primary[disabled]{background:#e0e6e2;color:#66736c}.consent-secondary,.consent-link{background:transparent;color:#2f6a60}.consent-link{margin-top:16rpx;text-decoration:underline}
