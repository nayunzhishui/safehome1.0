<view class="spine-note" role="article" aria-label="{{title}}">
  <view class="spine-note__spine" aria-hidden="true"><view class="spine-note__joint"></view><view class="spine-note__line"></view></view>
  <view class="spine-note__copy">
    <text wx:if="{{layerLabel}}" class="spine-note__label">{{layerLabel}}</text>
    <text wx:if="{{title}}" class="spine-note__title">{{title}}</text>
    <text class="spine-note__body">{{content}}</text>
  </view>
</view>
