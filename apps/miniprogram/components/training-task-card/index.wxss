.training-card {
  width: 100%;
  display: block;
  padding: 28rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(255, 253, 248, 0.98) 0%, rgba(255, 242, 226, 0.88) 100%);
  box-shadow: 0 14rpx 34rpx rgba(52, 66, 58, 0.09);
}

.training-card:active {
  transform: scale(0.99);
}

.training-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.training-mark {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--safe-primary);
}

.mark-face {
  width: 34rpx;
  height: 34rpx;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
}

.training-title-wrap {
  min-width: 0;
  flex: 1;
  text-align: left;
}

.title-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.training-title {
  color: var(--safe-title);
  font-size: 32rpx;
  font-weight: 800;
}

.training-tag {
  min-height: 38rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 14rpx;
  border-radius: 19rpx;
  background: #ffe8ca;
  color: #b36b1d;
  font-size: 20rpx;
  font-weight: 700;
}

.training-subtitle {
  display: block;
  margin-top: 8rpx;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.5;
}

.training-arrow {
  color: var(--safe-primary);
  font-size: 42rpx;
  line-height: 1;
}

.training-meta {
  display: grid;
  gap: 14rpx;
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(225, 216, 204, 0.86);
}

.meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.45;
  text-align: left;
}

.meta-dot {
  width: 20rpx;
  height: 20rpx;
  flex: 0 0 auto;
  border: 4rpx solid var(--safe-primary);
  border-radius: 50%;
}

.clock-dot {
  border-color: var(--safe-orange);
}
