.training-card {
  width: 100%;
  display: block;
  padding: 26rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: var(--safe-card);
  box-shadow: var(--safe-shadow-card);
}

.training-card:active {
  transform: scale(0.99);
}

.training-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.training-mark {
  width: 66rpx;
  height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  border-radius: var(--safe-radius-sm);
  background: var(--safe-primary-pale);
}

.mark-face {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid var(--safe-primary);
  border-radius: 50%;
}

.training-title-wrap {
  min-width: 0;
  flex: 1;
  text-align: left;
}

.title-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.training-title {
  color: var(--safe-title);
  font-size: 30rpx;
  font-weight: 800;
}

.training-tag {
  min-height: 38rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 14rpx;
  border-radius: var(--safe-radius-pill);
  background: var(--safe-orange-soft);
  color: #b36b1d;
  font-size: 20rpx;
  font-weight: 700;
}

.training-subtitle {
  display: block;
  margin-top: 8rpx;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.5;
}

.training-arrow {
  color: var(--safe-primary);
  font-size: 36rpx;
  line-height: 1;
}

.training-meta {
  display: grid;
  gap: 14rpx;
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(225, 216, 204, 0.86);
}

.meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.45;
  text-align: left;
}

.meta-dot {
  width: 20rpx;
  height: 20rpx;
  flex: 0 0 auto;
  border: 4rpx solid var(--safe-primary);
  border-radius: 50%;
}

.clock-dot {
  border-color: var(--safe-orange);
}
