/* 单行起步、随内容增高的输入（Figma P3/Field Single，最小 48）。 */
:host {
  display: block;
  width: 100%;
}

.compact-textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 96rpx;
  padding: 22rpx 28rpx;
  border-radius: 28rpx;
  background: var(--p3-surface);
  box-shadow: inset 0 0 0 2rpx var(--p3-control);
  color: var(--p3-ink);
  font-size: 30rpx;
  line-height: 52rpx;
}

.compact-placeholder {
  color: var(--p3-muted);
  opacity: 1;
}
