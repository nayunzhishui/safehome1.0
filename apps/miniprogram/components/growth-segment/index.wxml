<button class="growth-segment {{active ? 'growth-segment--active' : ''}}" aria-label="查看{{label}}，当前{{count}}{{segmentKey === 'assessments' ? '组量表' : '条线索'}}" aria-pressed="{{active}}" bindtap="handleTap">
  <text class="growth-segment__label">{{label}}</text>
  <text class="growth-segment__count">{{count}}</text>
</button>
