<view class="welcome-card">
  <view class="welcome-copy">
    <text class="welcome-title">{{title}}</text>
    <text class="welcome-subtitle">{{subtitle}}</text>
    <text class="welcome-detail">{{detail}}</text>
    <view wx:if="{{streakText}}" class="welcome-streak">
      <view class="streak-icon"></view>
      <text>{{streakText}}</text>
    </view>
  </view>
</view>
