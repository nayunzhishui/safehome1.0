.welcome-card {
  position: relative;
  min-height: 260rpx;
  display: flex;
  overflow: hidden;
  padding: 34rpx 32rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-lg);
  background: var(--safe-card);
  box-shadow: var(--safe-shadow-float);
}

.welcome-copy {
  position: relative;
  z-index: 2;
  width: 100%;
}

.welcome-title,
.welcome-subtitle,
.welcome-detail {
  display: block;
}

.welcome-title {
  color: var(--safe-title);
  font-size: 40rpx;
  font-weight: 850;
  line-height: 1.25;
}

.welcome-subtitle {
  margin-top: 14rpx;
  color: var(--safe-title);
  font-size: 28rpx;
  font-weight: 700;
}

.welcome-detail {
  margin-top: 8rpx;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.5;
}

.welcome-streak {
  min-height: 56rpx;
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 22rpx;
  padding: 0 20rpx;
  border-radius: var(--safe-radius-pill);
  border: 1rpx solid var(--safe-border);
  background: var(--safe-primary-pale);
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 700;
}

.streak-icon {
  width: 24rpx;
  height: 24rpx;
  border: 4rpx solid var(--safe-primary);
  border-radius: 8rpx;
}
