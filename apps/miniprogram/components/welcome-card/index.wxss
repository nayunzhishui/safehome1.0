.welcome-card {
  position: relative;
  min-height: 300rpx;
  display: flex;
  overflow: hidden;
  padding: 36rpx 32rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: 16rpx;
  background: linear-gradient(135deg, #edf5e8 0%, #fff4e8 100%);
  box-shadow: 0 18rpx 42rpx rgba(52, 66, 58, 0.11);
}

.welcome-card::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(255, 253, 248, 0.96) 0%, rgba(255, 253, 248, 0.78) 48%, rgba(255, 253, 248, 0.08) 100%);
  pointer-events: none;
}

.welcome-copy {
  position: relative;
  z-index: 2;
  width: 56%;
}

.welcome-image {
  position: absolute;
  right: 0;
  top: 0;
  width: 58%;
  height: 100%;
}

.welcome-title,
.welcome-subtitle,
.welcome-detail {
  display: block;
}

.welcome-title {
  color: var(--safe-title);
  font-size: 42rpx;
  font-weight: 850;
  line-height: 1.25;
}

.welcome-subtitle {
  margin-top: 14rpx;
  color: var(--safe-title);
  font-size: 28rpx;
  font-weight: 700;
}

.welcome-detail {
  margin-top: 8rpx;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.5;
}

.welcome-streak {
  min-height: 56rpx;
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 22rpx;
  padding: 0 20rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.88);
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 700;
}

.streak-icon {
  width: 24rpx;
  height: 24rpx;
  border: 4rpx solid var(--safe-primary);
  border-radius: 8rpx;
}

.welcome-art {
  position: absolute;
  z-index: 1;
  right: 0;
  bottom: 0;
  width: 48%;
  height: 100%;
}

.sun {
  position: absolute;
  top: 24rpx;
  right: 34rpx;
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  background: var(--safe-orange);
}

.cloud {
  position: absolute;
  height: 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
}

.cloud-left {
  top: 62rpx;
  left: 22rpx;
  width: 76rpx;
}

.cloud-right {
  top: 92rpx;
  right: 92rpx;
  width: 52rpx;
}

.family {
  position: absolute;
  right: 44rpx;
  bottom: 44rpx;
  width: 178rpx;
  height: 142rpx;
}

.adult,
.child {
  position: absolute;
  bottom: 0;
  border-radius: 999rpx 999rpx 30rpx 30rpx;
}

.adult::before,
.child::before {
  content: "";
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  border-radius: 50%;
  background: #f4bf87;
}

.adult-left {
  left: 8rpx;
  width: 64rpx;
  height: 92rpx;
  background: #f0b767;
}

.adult-right {
  right: 8rpx;
  width: 70rpx;
  height: 112rpx;
  background: var(--safe-primary);
}

.child {
  left: 74rpx;
  width: 52rpx;
  height: 72rpx;
  background: #f0d28a;
}

.adult::before {
  top: -34rpx;
  width: 50rpx;
  height: 50rpx;
}

.child::before {
  top: -28rpx;
  width: 40rpx;
  height: 40rpx;
}

.plant {
  position: absolute;
  bottom: 0;
  width: 40rpx;
  height: 90rpx;
  border-radius: 40rpx 40rpx 0 0;
  background: #9fbc94;
}

.plant-left {
  left: 10rpx;
}

.plant-right {
  right: 8rpx;
  height: 116rpx;
  background: #86aa80;
}
