/* 首页使用教程浮层：UIproduct3 色板（行动卡 + 一个实心按钮 + 描边按钮 + 文字链接）。 */
.tour-layer {
  position: fixed;
  inset: 0;
  z-index: 1300;
}

.tour-highlight {
  position: fixed;
  box-sizing: border-box;
  border: 3px solid var(--p3-soft, #e2f0ed);
  border-radius: 40rpx;
  box-shadow: 0 0 0 3000px rgba(23, 60, 67, 0.62);
  pointer-events: none;
}

.tour-fallback {
  position: absolute;
  inset: 0;
  background: rgba(23, 60, 67, 0.62);
}

.tour-dialog {
  position: fixed;
  left: 16px;
  right: 16px;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  box-sizing: border-box;
  max-height: calc(100vh - 32px);
  padding: 40rpx;
  border-radius: 48rpx;
  background: var(--p3-surface, #fffdf9);
  color: var(--p3-ink, #173c43);
  box-shadow: 0 20rpx 56rpx rgba(23, 61, 66, 0.07);
}

.guide-kicker {
  color: var(--p3-muted, #536e73);
  font-size: 26rpx;
  line-height: 40rpx;
}

.guide-title {
  display: block;
  color: var(--p3-ink, #173c43);
  font-size: 40rpx;
  line-height: 56rpx;
  font-weight: 600;
}

.tour-copy {
  max-height: 100px;
  color: var(--p3-ink, #173c43);
  font-size: 28rpx;
  line-height: 44rpx;
}

.tour-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 8rpx;
}

button {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 52rpx;
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: 500;
}

button::after {
  border: 0;
}

.guide-primary {
  height: 104rpx;
  background: var(--p3-primary, #23666e);
  color: #ffffff;
}

.guide-secondary {
  height: 104rpx;
  background: transparent;
  box-shadow: inset 0 0 0 2rpx var(--p3-control, #6d9294);
  color: var(--p3-primary, #23666e);
}

.guide-primary[disabled],
.guide-secondary[disabled] {
  opacity: 0.45;
}

.guide-link {
  flex: none;
  background: transparent;
  color: var(--p3-primary, #23666e);
  font-size: 26rpx;
  line-height: 40rpx;
  font-weight: 400;
}

.tour-arrow {
  position: absolute;
  width: 16px;
  height: 16px;
  background: var(--p3-surface, #fffdf9);
  transform: rotate(45deg);
}

.tour-arrow.up {
  top: -8px;
}

.tour-arrow.down {
  bottom: -8px;
}
