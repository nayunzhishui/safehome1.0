<view class="message message--{{message.role}}"><text class="message-label">{{message.role === 'user' ? '你' : '支持性整理'}}</text><text class="message-content">{{message.content}}</text><view wx:if="{{message.citations && message.citations.length}}" class="citations"><text class="citation-title">参考来源</text><text wx:for="{{message.citations}}" wx:key="version_id" class="citation-item">{{index + 1}}. {{item.title}}</text></view></view>
