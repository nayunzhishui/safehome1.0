:host{display:block}.message{padding:28rpx 0;border-bottom:1rpx solid var(--safe-border)}.message-label,.message-content,.citation-title,.citation-item{display:block}.message-label{color:var(--safe-primary-deep);font-size:24rpx;font-weight:700;line-height:36rpx}.message-content{margin-top:10rpx;color:var(--safe-title);font-size:28rpx;line-height:44rpx;white-space:pre-wrap}.citations{margin-top:20rpx;padding:20rpx 24rpx;border-radius:16rpx;background:var(--safe-bg-soft)}.citation-title{color:var(--safe-text);font-size:24rpx;font-weight:700;line-height:36rpx}.citation-item{margin-top:6rpx;color:var(--safe-muted);font-size:24rpx;line-height:36rpx}.message--user{padding-left:24rpx;border-left:4rpx solid var(--safe-primary)}
