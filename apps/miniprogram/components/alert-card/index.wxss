.alert-card {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #d8e2ef;
  border-radius: var(--safe-radius-md);
  background: #ffffff;
}

.alert-icon {
  width: 34rpx;
  height: 34rpx;
  flex: 0 0 auto;
  border: 4rpx solid var(--safe-info);
  border-radius: 50%;
}

.alert-copy {
  min-width: 0;
  flex: 1;
}

.alert-title,
.alert-content {
  display: block;
}

.alert-title {
  color: #58749a;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.4;
}

.alert-content {
  margin-top: 6rpx;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.5;
}

.alert-success {
  border-color: #cddfc5;
  background: #ffffff;
}

.alert-success .alert-icon {
  border-color: var(--safe-success);
}

.alert-success .alert-title {
  color: var(--safe-primary-deep);
}

.alert-warning {
  border-color: #f5d8aa;
  background: #ffffff;
}

.alert-warning .alert-icon {
  border-color: var(--safe-warning);
}

.alert-warning .alert-title {
  color: #a76418;
}

.alert-danger {
  border-color: #efd0cc;
  background: #ffffff;
}

.alert-danger .alert-icon {
  border-color: var(--safe-danger);
}

.alert-danger .alert-title {
  color: #cf4a3c;
}
