<view class="journey-action journey-action--{{variant}} journey-action--{{loading ? 'loading' : (errorMessage ? 'error' : state)}}" role="region" aria-label="{{regionAriaLabel}}">
  <view class="journey-action__head">
    <text wx:if="{{showMarker}}" class="journey-action__marker" aria-hidden="true">{{marker}}</text>
    <text class="journey-action__kicker">{{eyebrow}}{{!loading && !errorMessage && metaText ? ' · ' + metaText : ''}}</text>
    <status-pill wx:if="{{!loading && !errorMessage}}" label="{{stateLabel}}" tone="{{statusTone}}" />
  </view>

  <view wx:if="{{loading}}" class="journey-action__loading" role="status" aria-live="polite">
    <view class="journey-action__skeleton journey-action__skeleton--title"></view>
    <view class="journey-action__skeleton journey-action__skeleton--copy"></view>
    <text class="journey-action__description">正在整理可继续的操作</text>
  </view>

  <block wx:elif="{{errorMessage}}">
    <text class="journey-action__title" role="status" aria-live="polite">暂时没有读取到下一步</text>
    <text class="journey-action__description">{{errorMessage}}</text>
    <button class="p3-btn p3-btn--secondary journey-action__button" aria-label="重新读取今天的一小步" bindtap="handleRetry">重新读取</button>
  </block>

  <block wx:else>
    <text class="journey-action__title">{{title}}</text>
    <text wx:if="{{description}}" class="journey-action__description">{{description}}</text>
    <button class="p3-btn p3-btn--primary journey-action__button" aria-label="{{actionAriaLabel}}" bindtap="handleAction">{{buttonLabel}}</button>
    <text wx:if="{{boundaryNotice}}" class="journey-action__boundary">{{boundaryNotice}}</text>
  </block>
</view>
