/* 今天的一小步（Figma 643:543）：行动卡，全页唯一实心按钮。 */
.journey-action {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
  box-sizing: border-box;
  width: 100%;
  padding: var(--p3-card);
  border-radius: var(--p3-radius-card);
  background: var(--p3-surface);
  box-shadow: var(--p3-shadow-float);
}

.journey-action__head {
  display: flex;
  align-items: center;
  gap: var(--p3-tight);
}

.journey-action__marker {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--p3-soft);
  color: var(--p3-primary);
  font-size: 26rpx;
  line-height: 40rpx;
}

.journey-action__kicker {
  flex: 1 0 0;
  min-width: 0;
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

.journey-action__title {
  display: block;
  color: var(--p3-ink);
  font-size: 40rpx;
  line-height: 56rpx;
  font-weight: 600;
  overflow-wrap: anywhere;
}

.journey-action__description {
  display: block;
  color: var(--p3-muted);
  font-size: 28rpx;
  line-height: 44rpx;
  overflow-wrap: anywhere;
}

.journey-action__button {
  min-height: var(--safe-touch, 88rpx);
}

.journey-action__boundary {
  display: block;
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

.journey-action__loading {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
}

.journey-action__skeleton {
  height: 28rpx;
  border-radius: 14rpx;
  background: var(--p3-mist);
}

.journey-action__skeleton--title {
  width: 60%;
  height: 40rpx;
}

.journey-action__skeleton--copy {
  width: 86%;
}

/* 关系探索“当前步骤”（Figma 665:2704）：间距 12、52 序号圆、24/32 宋体标题、15/26 说明 */
.journey-action--stage {
  gap: var(--p3-stack);
}

.journey-action--stage .journey-action__marker {
  width: 104rpx;
  height: 104rpx;
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: 500;
}

.journey-action--stage .journey-action__title {
  font-family: var(--p3-font-serif);
  font-size: 48rpx;
  line-height: 64rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.journey-action--stage .journey-action__description {
  font-size: 30rpx;
  line-height: 52rpx;
}
