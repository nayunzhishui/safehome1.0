<button
  class="choice-option {{selected ? 'choice-option--selected' : ''}}"
  role="radio"
  aria-checked="{{selected}}"
  aria-label="{{description ? label + '：' + description : label}}"
  bindtap="handleTap"
>
  <image class="choice-option__radio" src="{{selected ? '/assets/icons/p3/radio-20-selected.svg' : '/assets/icons/p3/radio-20-default.svg'}}" aria-hidden="true" />
  <view class="choice-option__copy">
    <text class="choice-option__title">{{label}}</text>
    <text wx:if="{{description}}" class="choice-option__description">{{description}}</text>
  </view>
</button>
