/* 带说明的单选项（Figma 656:2021 P3/ChoiceOption）：整块可点；描边计入布局，选中为浅青瓷底 + 1.5 青瓷描边 + 粗边圆点。 */
:host {
  display: block;
  width: 100%;
}

.choice-option {
  display: flex;
  align-items: flex-start;
  gap: var(--p3-stack);
  box-sizing: border-box;
  width: 100%;
  min-height: 0;
  padding: 30rpx 34rpx;
  border-radius: var(--p3-radius-group);
  background: var(--p3-surface);
  box-shadow: inset 0 0 0 2rpx var(--p3-hairline);
  text-align: left;
}

.choice-option--selected {
  padding: 31rpx 35rpx;
  background: var(--p3-soft);
  box-shadow: inset 0 0 0 3rpx var(--p3-primary);
}

.choice-option__radio {
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
}

.choice-option__copy {
  display: flex;
  flex: 1 0 0;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.choice-option__title {
  color: var(--p3-ink);
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: 500;
}

.choice-option__description {
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}
