.choice-option {
  box-sizing: border-box;
  width: 100%;
  min-height: var(--ui2-choice-height,180rpx);
  display: flex;
  align-items: center;
  gap: var(--ui2-choice-gap,28rpx);
  padding: var(--ui2-choice-padding,30rpx 32rpx);
  border: 2rpx solid var(--ui2-control-border,var(--safe-border));
  border-radius: var(--ui2-button-radius,32rpx);
  background: var(--safe-card);
  text-align: left;
}

.choice-option--selected {
  border-color: var(--safe-primary);
  background: var(--safe-bg-soft);
}

.choice-option__mark {
  width: var(--ui2-choice-mark,68rpx);
  height: var(--ui2-choice-mark,68rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  border: var(--ui2-control-border-weight,4rpx) solid var(--safe-primary);
  border-radius: 50%;
  color: var(--safe-card);
  font-size: 32rpx;
  font-weight: 700;
}

.choice-option--selected .choice-option__mark { background: var(--safe-primary); }
.choice-option__copy { min-width: 0; display: grid; gap: 8rpx; }
.choice-option__title { color: var(--safe-title); font-size: 30rpx; font-weight: 500; line-height: 44rpx; }
.choice-option__description { color: var(--safe-muted); font-size: var(--ui2-body,26rpx); line-height: var(--ui2-choice-line-height,38rpx); }
