<view class="boundary-note"><text class="boundary-title">使用边界</text><text class="boundary-copy">{{text}}</text><button wx:if="{{!consented}}" class="consent-button" hover-class="button-pressed" aria-label="确认已阅读使用边界并同意AI辅助处理" disabled="{{sending}}" bindtap="confirm">{{sending ? '正在记录' : '阅读并同意 AI 辅助处理'}}</button><view wx:else class="consent-status" role="status"><view class="consent-check" aria-hidden="true">✓</view><text>已记录本次选择</text></view><text wx:if="{{error && !consented}}" class="inline-error">{{error}}</text></view>
