:host{display:block}.boundary-note{padding:32rpx;border:1rpx solid var(--safe-border);border-radius:24rpx;background:var(--safe-card)}.boundary-title,.boundary-copy,.inline-error{display:block}.boundary-title{color:var(--safe-title);font-size:32rpx;font-weight:700;line-height:46rpx}.boundary-copy{margin-top:16rpx;color:var(--safe-text);font-size:28rpx;line-height:44rpx}.consent-button{width:100%;min-height:88rpx;margin-top:28rpx;border:1rpx solid var(--safe-primary);border-radius:20rpx;background:transparent;color:var(--safe-primary-deep);font-size:28rpx;font-weight:700;line-height:88rpx}.consent-button::after{border:0}.consent-status{min-height:72rpx;display:flex;align-items:center;gap:16rpx;margin-top:24rpx;color:var(--safe-primary-deep);font-size:26rpx}.consent-check{width:44rpx;height:44rpx;border:2rpx solid var(--safe-primary);border-radius:50%;font-size:28rpx;line-height:40rpx;text-align:center}.inline-error{margin-top:16rpx;color:var(--experience-danger);font-size:24rpx;line-height:36rpx}.button-pressed{transform:scale(.985);opacity:.92}
