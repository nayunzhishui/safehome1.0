:host{display:block}.boundary-note{padding:32rpx;border:1rpx solid var(--safe-border);border-radius:24rpx;background:var(--ui2-boundary-bg,var(--safe-card))}.boundary-title,.boundary-copy,.inline-error{display:block}.boundary-title{color:var(--safe-title);font-size:32rpx;font-weight:700;line-height:46rpx}.boundary-copy{margin-top:16rpx;color:var(--safe-text);font-size:var(--ui2-body,28rpx);line-height:44rpx}.consent-button{width:100%;min-height:var(--safe-touch,88rpx);margin-top:28rpx;border:1rpx solid var(--safe-primary);border-radius:20rpx;background:var(--ui2-consent-bg,transparent);color:var(--ui2-consent-text,var(--safe-primary-deep));font-size:var(--ui2-body,28rpx);font-weight:700;box-sizing:border-box;padding:var(--ui2-button-padding,0);line-height:var(--ui2-button-line-height,88rpx)}.consent-button::after{border:0}.consent-status{min-height:72rpx;display:flex;align-items:center;gap:16rpx;margin-top:24rpx;color:var(--safe-primary-deep);font-size:26rpx}.consent-check{width:44rpx;height:44rpx;border:2rpx solid var(--safe-primary);border-radius:50%;font-size:var(--ui2-body,28rpx);line-height:40rpx;text-align:center}.inline-error{margin-top:16rpx;color:var(--experience-danger);font-size:var(--ui2-caption,24rpx);line-height:36rpx}.button-pressed{transform:scale(.985);opacity:.92}

@media(prefers-reduced-motion:reduce){.button-pressed{transform:none}}

.consent-defer{box-sizing:border-box;display:flex;align-items:center;justify-content:center;min-height:96rpx;margin-top:16rpx;padding:20rpx 24rpx;border:2rpx solid var(--safe-border-strong);border-radius:24rpx;color:var(--safe-primary-deep);font-size:30rpx;line-height:1.6;text-align:center}
