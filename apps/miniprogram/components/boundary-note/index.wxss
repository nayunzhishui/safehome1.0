/* 使用边界（Figma 671:3137）：页尾边界脚注 + 同意按钮；同意后只留一行“已记录本次选择”。 */
:host {
  display: block;
}

.boundary {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
}

.consent-defer {
  height: auto;
  min-height: var(--safe-touch, 88rpx);
}

.consent-status {
  display: flex;
  align-items: center;
  gap: var(--p3-tight);
  color: var(--p3-primary);
  font-size: 26rpx;
  line-height: 40rpx;
}

.button-pressed {
  opacity: 0.92;
}
