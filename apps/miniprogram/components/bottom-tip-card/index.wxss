.bottom-tip-card {
  position: relative;
  overflow: hidden;
  padding: 30rpx 34rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: linear-gradient(135deg, var(--safe-primary-pale), var(--safe-orange-soft));
}

.tip-copy {
  position: relative;
  z-index: 1;
  padding-right: 130rpx;
}

.tip-text,
.tip-subtext {
  display: block;
}

.tip-text {
  color: var(--safe-title);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.55;
}

.tip-subtext {
  margin-top: 8rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.55;
}

.tip-plant {
  position: absolute;
  right: 24rpx;
  bottom: 0;
  width: 106rpx;
  height: 104rpx;
}

.tip-plant view {
  position: absolute;
  bottom: 0;
  width: 30rpx;
  border-radius: 30rpx 30rpx 0 0;
  background: #9fbc94;
}

.tip-plant view:nth-child(1) {
  left: 4rpx;
  height: 68rpx;
}

.tip-plant view:nth-child(2) {
  left: 38rpx;
  height: 100rpx;
  background: var(--safe-primary);
}

.tip-plant view:nth-child(3) {
  right: 4rpx;
  height: 82rpx;
}
