.bottom-tip-card {
  position: relative;
  overflow: hidden;
  padding: 26rpx 30rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: var(--safe-card);
}

.bottom-tip-card::before,
.bottom-tip-card::after {
  position: absolute;
  left: 0;
  width: 7rpx;
  border-radius: 0 var(--safe-radius-pill) var(--safe-radius-pill) 0;
  background: var(--safe-primary);
  content: "";
}

.bottom-tip-card::before {
  top: 22rpx;
  height: 24rpx;
}

.bottom-tip-card::after {
  top: 52rpx;
  height: 38rpx;
}

.tip-copy {
  position: relative;
  z-index: 1;
  padding-right: 0;
}

.tip-text,
.tip-subtext {
  display: block;
}

.tip-text {
  color: var(--safe-title);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.55;
}

.tip-subtext {
  margin-top: 8rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.55;
}
