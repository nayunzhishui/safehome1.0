.bottom-tip-card {
  position: relative;
  overflow: hidden;
  padding: var(--ui2-tip-padding, 26rpx 30rpx);
  border: var(--ui2-tip-border, 1rpx) solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: var(--ui2-tip-background, var(--safe-card));
}

.bottom-tip-card::before,
.bottom-tip-card::after {
  display: var(--ui2-marker-display, block);
  position: absolute;
  left: 0;
  width: 7rpx;
  border-radius: 0 var(--safe-radius-pill) var(--safe-radius-pill) 0;
  background: var(--safe-primary);
  content: "";
}

.bottom-tip-card::before {
  top: 22rpx;
  height: 24rpx;
}

.bottom-tip-card::after {
  top: 52rpx;
  height: 38rpx;
}

.tip-copy {
  position: relative;
  z-index: 1;
  padding-right: 0;
}

.tip-text,
.tip-subtext {
  display: block;
}

.tip-text {
  color: var(--safe-title);
  font-size: var(--ui2-body, 28rpx);
  font-weight: 700;
  line-height: 1.55;
}

.tip-subtext {
  margin-top: 8rpx;
  color: var(--safe-muted);
  font-size: var(--ui2-caption, 24rpx);
  line-height: 1.55;
}
