.bottom-tip-card {
  position: relative;
  overflow: hidden;
  padding: 26rpx 30rpx;
  border: 1rpx solid var(--safe-border);
  border-left: 8rpx solid var(--safe-primary);
  border-radius: var(--safe-radius-md);
  background: var(--safe-card);
}

.tip-copy {
  position: relative;
  z-index: 1;
  padding-right: 0;
}

.tip-text,
.tip-subtext {
  display: block;
}

.tip-text {
  color: var(--safe-title);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.55;
}

.tip-subtext {
  margin-top: 8rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.55;
}
