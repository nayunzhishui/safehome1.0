.entry-card {
  min-height: 198rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 16rpx;
  border: 1rpx solid #efe7dc;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(80, 64, 45, 0.08);
}

.entry-card:active {
  transform: scale(0.98);
}

.entry-icon {
  width: 78rpx;
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
  border-radius: 22rpx;
  font-size: 34rpx;
  font-weight: 800;
}

.entry-title,
.entry-subtitle {
  display: block;
  text-align: center;
}

.entry-title {
  color: #333333;
  font-size: 28rpx;
  font-weight: 700;
}

.entry-subtitle {
  margin-top: 8rpx;
  color: #777777;
  font-size: 22rpx;
}
