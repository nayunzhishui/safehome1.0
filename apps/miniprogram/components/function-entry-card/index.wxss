.entry-card {
  min-height: 198rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 16rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: rgba(255, 253, 248, 0.96);
  box-shadow: var(--safe-shadow-card);
}

.entry-card:active {
  transform: scale(0.98);
}

.entry-icon {
  width: 78rpx;
  height: 78rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
  border-radius: var(--safe-radius-sm);
  font-size: 34rpx;
  font-weight: 800;
}

.entry-title,
.entry-subtitle {
  display: block;
  text-align: center;
}

.entry-title {
  color: var(--safe-title);
  font-size: 28rpx;
  font-weight: 800;
}

.entry-subtitle {
  margin-top: 8rpx;
  color: var(--safe-muted);
  font-size: 22rpx;
}
