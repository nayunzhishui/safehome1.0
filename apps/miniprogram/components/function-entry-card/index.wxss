.entry-card {
  min-height: 184rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 18rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: var(--safe-card);
  box-shadow: var(--safe-shadow-card);
}

.entry-card:active {
  transform: scale(0.98);
}

.entry-icon {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
  border-radius: var(--safe-radius-sm);
  font-size: 30rpx;
  font-weight: 800;
}

.entry-glyph {
  position: relative;
  box-sizing: border-box;
  width: 30rpx;
  height: 30rpx;
  border: 3rpx solid currentColor;
}

.entry-glyph--assessment {
  border-radius: 50%;
}

.entry-glyph--assessment .entry-glyph__inner {
  position: absolute;
  left: 7rpx;
  top: 5rpx;
  width: 8rpx;
  height: 13rpx;
  border-right: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: rotate(42deg);
}

.entry-glyph--diary {
  border-radius: 3rpx;
}

.entry-glyph--diary::before,
.entry-glyph--diary::after,
.entry-glyph--diary .entry-glyph__inner {
  position: absolute;
  left: 6rpx;
  width: 14rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: currentColor;
  content: "";
}

.entry-glyph--diary::before { top: 7rpx; }
.entry-glyph--diary .entry-glyph__inner { top: 13rpx; }
.entry-glyph--diary::after { top: 19rpx; }

.entry-title,
.entry-subtitle {
  display: block;
  text-align: center;
}

.entry-title {
  color: var(--safe-title);
  font-size: 27rpx;
  font-weight: 800;
}

.entry-subtitle {
  margin-top: 8rpx;
  color: var(--safe-muted);
  font-size: 22rpx;
}
