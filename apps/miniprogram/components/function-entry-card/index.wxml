<button class="entry-card" bindtap="handleTap">
  <view class="entry-icon" style="background: {{accentBg}}; color: {{accentColor}};">
    <view wx:if="{{iconType}}" class="entry-glyph entry-glyph--{{iconType}}" aria-hidden="true">
      <view class="entry-glyph__inner"></view>
    </view>
    <text wx:else>{{iconText}}</text>
  </view>
  <text class="entry-title">{{title}}</text>
  <text class="entry-subtitle">{{subtitle}}</text>
</button>
