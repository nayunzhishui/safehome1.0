.course-card {
  width: 100%;
  display: flex;
  gap: 22rpx;
  padding: 22rpx;
  border: 1rpx solid #efe7dc;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(80, 64, 45, 0.08);
  text-align: left;
}

.course-card:active {
  transform: scale(0.99);
}

.course-cover {
  position: relative;
  width: 162rpx;
  height: 142rpx;
  flex: 0 0 auto;
  overflow: hidden;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #f5fbe9, #fff0d5);
}

.cover-sun {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: #ffd36f;
}

.cover-tree {
  position: absolute;
  left: 20rpx;
  bottom: 0;
  width: 42rpx;
  height: 88rpx;
  border-radius: 42rpx 42rpx 0 0;
  background: #8bcf86;
}

.cover-family {
  position: absolute;
  right: 24rpx;
  bottom: 18rpx;
  width: 70rpx;
  height: 74rpx;
  border-radius: 44rpx 44rpx 18rpx 18rpx;
  background: #ffb26b;
  box-shadow: -34rpx 18rpx 0 -8rpx #62b77a;
}

.course-content {
  min-width: 0;
  flex: 1;
}

.course-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.course-title {
  color: #333333;
  font-size: 30rpx;
  font-weight: 800;
}

.course-category {
  min-height: 38rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 12rpx;
  border-radius: 19rpx;
  background: #eef8e9;
  color: #4caf7d;
  font-size: 20rpx;
}

.course-description {
  display: block;
  margin-top: 10rpx;
  color: #555555;
  font-size: 24rpx;
  line-height: 1.45;
}

.course-meta {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 16rpx;
  color: #777777;
  font-size: 22rpx;
}

.progress-track {
  height: 12rpx;
  margin-top: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #edf3e8;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #6fbc6b;
}

.course-action {
  display: inline-flex;
  margin-top: 14rpx;
  color: #4caf7d;
  font-size: 24rpx;
  font-weight: 700;
}
