.course-card {
  width: 100%;
  display: flex;
  gap: 22rpx;
  padding: 22rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: rgba(255, 253, 248, 0.96);
  box-shadow: var(--safe-shadow-card);
  text-align: left;
}

.course-card:active {
  transform: scale(0.99);
}

.course-cover {
  position: relative;
  width: 162rpx;
  height: 142rpx;
  flex: 0 0 auto;
  overflow: hidden;
  border-radius: var(--safe-radius-sm);
  background: linear-gradient(135deg, var(--safe-primary-pale), var(--safe-orange-soft));
}

.cover-sun {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: var(--safe-orange);
}

.cover-tree {
  position: absolute;
  left: 20rpx;
  bottom: 0;
  width: 42rpx;
  height: 88rpx;
  border-radius: 42rpx 42rpx 0 0;
  background: #9fbc94;
}

.cover-family {
  position: absolute;
  right: 24rpx;
  bottom: 18rpx;
  width: 70rpx;
  height: 74rpx;
  border-radius: 44rpx 44rpx 18rpx 18rpx;
  background: var(--safe-orange);
  box-shadow: -34rpx 18rpx 0 -8rpx var(--safe-primary);
}

.course-content {
  min-width: 0;
  flex: 1;
}

.course-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.course-title {
  color: var(--safe-title);
  font-size: 30rpx;
  font-weight: 800;
}

.course-category {
  min-height: 38rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 12rpx;
  border-radius: var(--safe-radius-pill);
  background: var(--safe-primary-soft);
  color: var(--safe-primary-deep);
  font-size: 20rpx;
}

.course-description {
  display: block;
  margin-top: 10rpx;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.45;
}

.course-meta {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 16rpx;
  color: var(--safe-muted);
  font-size: 22rpx;
}

.progress-track {
  height: 12rpx;
  margin-top: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e8e3db;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--safe-primary);
}

.course-action {
  display: inline-flex;
  margin-top: 14rpx;
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 700;
}
