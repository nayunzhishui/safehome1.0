.course-card {
  width: 100%;
  display: flex;
  gap: 18rpx;
  padding: 24rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: var(--safe-card);
  box-shadow: var(--safe-shadow-card);
  text-align: left;
}

.course-card:active {
  transform: scale(0.99);
}

.course-cover {
  position: relative;
  width: 10rpx;
  min-height: 142rpx;
  flex: 0 0 auto;
  overflow: hidden;
  border-radius: 999rpx;
  background: var(--safe-primary);
}

.course-content {
  min-width: 0;
  flex: 1;
}

.course-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.course-title {
  color: var(--safe-title);
  font-size: 29rpx;
  font-weight: 800;
}

.course-category {
  min-height: 38rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 12rpx;
  border-radius: var(--safe-radius-pill);
  background: var(--safe-primary-soft);
  color: var(--safe-primary-deep);
  font-size: 20rpx;
}

.course-description {
  display: block;
  margin-top: 10rpx;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.45;
}

.course-meta {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 16rpx;
  color: var(--safe-muted);
  font-size: 22rpx;
}

.progress-track {
  height: 12rpx;
  margin-top: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e8e3db;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--safe-primary);
}

.course-action {
  display: inline-flex;
  margin-top: 14rpx;
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 700;
}
