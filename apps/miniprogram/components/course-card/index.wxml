<button class="course-card" bindtap="handleTap">
  <view class="course-content">
    <view class="course-bookmark" aria-hidden="true"></view>
    <view class="course-title-row">
      <text class="course-title">{{title}}</text>
      <text wx:if="{{category}}" class="course-category">{{category}}</text>
    </view>
    <text class="course-description">{{description}}</text>
    <view class="course-meta">
      <text>{{lessonCount}} 小节 · 已查看 {{progress}}%</text>
      <text class="course-action">{{buttonText}} ›</text>
    </view>
    <view class="progress-track">
      <view class="progress-fill" style="width: {{progress}}%;"></view>
    </view>
  </view>
</button>
