<button
  class="message-row {{message.is_unread ? 'message-row--unread' : ''}} {{message.is_withdrawn ? 'message-row--withdrawn' : ''}} {{showDivider ? 'message-row--divided' : ''}}"
  aria-label="{{message.is_withdrawn ? '已撤回消息：' : (message.is_unread ? '未读消息：' : '已读消息：')}}{{message.title}}"
  bindtap="handleTap"
>
  <view class="message-row__title-row">
    <view wx:if="{{message.is_unread && !message.is_withdrawn}}" class="message-row__dot" aria-hidden="true"></view>
    <text class="message-row__title">{{message.title}}</text>
  </view>
  <text class="message-row__body">{{message.is_withdrawn ? '研究者已撤回这条内容，请忽略此前版本。' : (message.body || '打开查看详情。')}}</text>
  <view class="message-row__meta">
    <text class="message-row__time">{{message.sender_role ? '研究者补充 · ' : ''}}{{displayTime}}{{message.delivery_version ? ' · 第 ' + message.delivery_version + ' 版' : ''}}</text>
    <text class="message-row__status">{{message.is_withdrawn ? '已撤回' : (message.is_unread ? '未读' : '已读')}}</text>
  </view>
</button>
