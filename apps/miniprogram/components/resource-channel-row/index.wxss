/* 竹节步骤行（Figma StepRow·Joint 670:3094）：一小段青瓷竹节 + 标题与说明，底部细线可关。 */
:host {
  display: block;
}

.channel-row {
  display: flex;
  align-items: flex-start;
  gap: 28rpx;
  padding: 28rpx 0;
}

.channel-row--divided {
  border-bottom: 2rpx solid var(--p3-hairline);
}

.channel-row__joint {
  flex: 0 0 auto;
  width: 56rpx;
  padding-top: 22rpx;
}

.channel-row__bar {
  width: 24rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--p3-primary);
}

.channel-row__copy {
  display: flex;
  flex: 1 0 0;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.channel-row__title {
  color: var(--p3-ink);
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: 500;
}

.channel-row__text {
  color: var(--p3-ink);
  font-size: 30rpx;
  line-height: 52rpx;
}
