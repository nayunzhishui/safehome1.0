:host{display:block}.resource-row{display:flex;align-items:flex-start;gap:28rpx;padding:30rpx 0;border-bottom:1rpx solid var(--experience-line)}.bamboo-corner{position:relative;width:8rpx;height:68rpx;flex:0 0 8rpx;border-radius:6rpx;background:linear-gradient(to bottom,var(--experience-primary) 0 42%,transparent 42% 50%,var(--experience-primary) 50% 100%)}.bamboo-joint{position:absolute;top:42%;left:-3rpx;width:14rpx;height:8rpx;border-radius:6rpx;background:var(--experience-primary)}.resource-copy{min-width:0;flex:1}.resource-title,.resource-text{display:block}.resource-title{color:var(--experience-ink);font-size:32rpx;font-weight:700;line-height:44rpx}.resource-text{margin-top:12rpx;color:var(--experience-muted);font-size:var(--experience-font-body);line-height:44rpx;overflow-wrap:anywhere}
