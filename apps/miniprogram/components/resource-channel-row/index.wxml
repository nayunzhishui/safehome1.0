<view class="channel-row {{showDivider ? 'channel-row--divided' : ''}}">
  <view class="channel-row__joint" aria-hidden="true"><view class="channel-row__bar"></view></view>
  <view class="channel-row__copy">
    <text class="channel-row__title">{{title}}</text>
    <text class="channel-row__text">{{text}}</text>
  </view>
</view>
