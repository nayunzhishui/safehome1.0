.status-pill {
  min-height: 44rpx;
  display: inline-flex;
  align-items: center;
  padding: 2rpx 15rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-pill);
  background: var(--safe-bg-soft);
  color: var(--safe-muted);
  font-size: 20rpx;
  font-weight: 750;
  line-height: 1.3;
}
.status-pill--success { border-color: rgba(79, 124, 107, 0.28); background: var(--safe-primary-soft); color: var(--safe-primary-deep); }
.status-pill--warning { border-color: rgba(184, 121, 45, 0.28); background: var(--safe-orange-soft); color: #72552f; }
.status-pill--info { border-color: rgba(98, 127, 159, 0.26); background: var(--safe-blue-soft); color: #506d91; }
.status-pill--danger { border-color: rgba(215, 111, 103, 0.28); background: #fff1ee; color: #9f3e38; }
