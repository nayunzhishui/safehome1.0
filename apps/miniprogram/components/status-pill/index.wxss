/* StatusPill（Figma 620:41）：浅底 + 6px 圆点 + 13/20 文字；色调随状态。 */
.status-pill {
  display: inline-flex;
  align-items: center;
  flex: 0 0 auto;
  gap: 12rpx;
  padding: 6rpx 24rpx 6rpx 20rpx;
  border-radius: 999rpx;
  background: var(--p3-soft);
  color: var(--p3-primary);
  font-size: 26rpx;
  line-height: 40rpx;
  font-weight: 400;
  white-space: nowrap;
}

.status-pill::before {
  content: "";
  width: 12rpx;
  height: 12rpx;
  flex: 0 0 auto;
  border-radius: 50%;
  background: currentColor;
}

.status-pill--neutral { background: var(--p3-paper); color: var(--p3-muted); }
.status-pill--warning { background: var(--p3-warm-soft); color: var(--p3-warm-ink); }
.status-pill--danger { background: var(--p3-risk-soft); color: var(--p3-risk-ink); }
