:host {
  display: block;
}

.section-heading {
  min-height: var(--ui2-section-height, 104rpx);
  display: flex;
  align-items: center;
  border-bottom: var(--ui2-section-border, 1rpx) solid var(--safe-border);
  color: var(--safe-title);
  font-size: var(--ui2-section, 40rpx);
  font-weight: 700;
  line-height: 1.4;
}
