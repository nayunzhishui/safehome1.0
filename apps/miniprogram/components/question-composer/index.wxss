:host{display:block}.composer{margin-top:32rpx;padding:32rpx;border:1rpx solid var(--safe-border);border-radius:24rpx;background:var(--safe-card)}.composer-head{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.composer-label,.composer-counter,.inline-error{display:block}.composer-label{color:var(--safe-title);font-size:30rpx;font-weight:700;line-height:44rpx}.composer-counter{color:var(--safe-muted);font-size:24rpx;line-height:36rpx}.question-input{box-sizing:border-box;width:100%;min-height:260rpx;margin-top:24rpx;padding:24rpx;border:1rpx solid var(--safe-border);border-radius:20rpx;background:var(--safe-card);color:var(--safe-title);font-size:28rpx;line-height:44rpx}.send-button{min-height:88rpx;margin-top:24rpx;border:0;border-radius:20rpx;background:var(--safe-primary);color:#fff;font-size:28rpx;font-weight:700;line-height:88rpx}.send-button[disabled]{background:var(--safe-bg-soft);color:var(--safe-muted)}.send-button::after{border:0}.inline-error{margin-top:16rpx;color:var(--experience-danger);font-size:24rpx;line-height:36rpx}
