/* 多行输入（Figma P3/Field Multi）：高 128、1px 控件描边、圆角 14、15/26。 */
:host {
  display: block;
  width: 100%;
}

.therapeutic-textarea {
  box-sizing: border-box;
  width: 100%;
  height: 256rpx;
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  background: var(--p3-surface);
  box-shadow: inset 0 0 0 2rpx var(--p3-control);
  color: var(--p3-ink);
  font-size: 30rpx;
  line-height: 52rpx;
}

.therapeutic-textarea--error {
  box-shadow: inset 0 0 0 3rpx var(--p3-risk-ink);
}

.therapeutic-placeholder {
  color: var(--p3-muted);
  opacity: 1;
}
