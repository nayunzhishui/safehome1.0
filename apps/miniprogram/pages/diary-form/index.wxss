/* 记录情绪事件（Figma 647:1105）：暖色隐私提示；场景与情绪选择块；0–10 强度滑条；可选内容默认收起；草稿状态与保存。 */
page {
  background: var(--p3-paper);
}

.diary-page {
  display: flex;
  flex-direction: column;
  gap: var(--p3-section);
  box-sizing: border-box;
  min-height: 100vh;
  padding: 16rpx var(--p3-page-x) calc(72rpx + env(safe-area-inset-bottom));
  background: var(--p3-paper);
  overflow-x: hidden;
}

.diary-goal {
  align-self: flex-start;
  margin-bottom: -24rpx;
}

.diary-section {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
  min-width: 0;
}

.diary-chips {
  display: flex;
  flex-wrap: wrap;
  gap: var(--p3-tight);
}

.diary-label {
  display: block;
  color: var(--p3-ink);
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: 500;
}

/* 情绪与身体感觉分组：类名小字在上、词在下；选中的情绪词带顺序号，1 为主要情绪。 */
.diary-emotion-group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.diary-emotion-group__label {
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

.diary-chip-order {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  margin-left: 12rpx;
  border-radius: 999rpx;
  background: var(--p3-primary);
  color: var(--p3-on-primary);
  font-size: 22rpx;
  line-height: 36rpx;
}

/* 自己写一个词：输入框占一行，下一行选最接近的类再加入。 */
.diary-custom {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--p3-tight);
}

.diary-custom__input {
  flex: 1 1 100%;
  min-width: 0;
}

.diary-custom__picker {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 88rpx;
  padding: 0 28rpx;
  border: 2rpx solid var(--p3-control);
  border-radius: 28rpx;
  background: var(--p3-surface);
  color: var(--p3-ink);
  font-size: 28rpx;
  white-space: nowrap;
}

.diary-custom__add {
  flex: 0 0 auto;
}

.diary-slider {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
}

.diary-slider__label {
  color: var(--p3-ink);
  font-size: 28rpx;
  line-height: 44rpx;
}

.diary-more {
  display: flex;
  flex-direction: column;
  border-radius: var(--p3-radius-group);
  background: var(--p3-surface);
}

.diary-more__toggle {
  display: flex;
  align-items: center;
  gap: var(--p3-tight);
  width: 100%;
  padding: 28rpx 32rpx;
  text-align: left;
}

.diary-more__text {
  flex: 1 0 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.diary-more__title {
  color: var(--p3-ink);
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: 500;
}

.diary-more__subtitle {
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

.diary-more__chevron {
  display: flex;
  flex: 0 0 auto;
}

.diary-more__chevron--open {
  transform: rotate(180deg);
}

.diary-more__body {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
  padding: 8rpx 32rpx 36rpx;
}

.diary-save {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
}

.diary-save__note {
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}
