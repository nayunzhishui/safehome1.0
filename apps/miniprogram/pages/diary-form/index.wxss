.diary-page {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.diary-hero {
  position: relative;
  min-height: 230rpx;
  overflow: hidden;
  border-radius: 28rpx;
  border-left: 8rpx solid var(--safe-primary);
  background: linear-gradient(135deg, rgba(244, 249, 240, 0.98), rgba(255, 253, 248, 0.98));
}

.hero-copy {
  position: relative;
  z-index: 1;
  max-width: 100%;
}

.hero-title {
  display: block;
  color: var(--safe-title);
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.28;
  letter-spacing: 0;
}

.hero-summary {
  display: block;
  margin-top: 14rpx;
  color: var(--safe-text);
  font-size: 27rpx;
  line-height: 1.62;
}

.goal-hint {
  display: inline-flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(95, 143, 91, 0.18);
  border-radius: var(--safe-radius-pill);
  background: var(--safe-primary-soft);
  color: var(--safe-primary);
  font-size: 24rpx;
  font-weight: 700;
}

.hero-steps {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-top: 24rpx;
}

.hero-steps text {
  display: inline-flex;
  align-items: center;
  min-height: 46rpx;
  padding: 0 16rpx;
  border: 1rpx solid rgba(87, 139, 95, 0.16);
  border-radius: var(--safe-radius-pill);
  background: rgba(255, 253, 248, 0.76);
  color: var(--safe-primary-deep);
  font-size: 22rpx;
  font-weight: 750;
}

.privacy-note {
  display: block;
  margin-top: 18rpx;
  color: var(--safe-muted);
  font-size: 22rpx;
  line-height: 1.55;
}

.diary-form {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.diary-section {
  padding: 30rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: 24rpx;
  background: rgba(255, 253, 248, 0.96);
  box-shadow: 0 10rpx 24rpx rgba(52, 66, 58, 0.06);
}

.more-section {
  border-style: dashed;
}

.more-toggle {
  min-height: 78rpx;
  margin: 0;
  border: 1rpx solid rgba(95, 143, 91, 0.28);
  border-radius: var(--safe-radius-pill);
  background: rgba(237, 246, 232, 0.84);
  color: var(--safe-primary-deep);
  font-size: 26rpx;
  font-weight: 850;
  line-height: 78rpx;
}

.more-toggle::after {
  border: 0;
}

.section-head {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
  margin-bottom: 28rpx;
}

.section-index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 48rpx;
  flex: 0 0 72rpx;
  border-radius: var(--safe-radius-pill);
  background: var(--safe-primary-soft);
  color: var(--safe-primary-deep);
  font-size: 22rpx;
  font-weight: 850;
  line-height: 48rpx;
}

.section-copy {
  flex: 1;
}

.section-title {
  display: block;
  color: var(--safe-title);
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.35;
}

.section-hint {
  display: block;
  margin-top: 6rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.65;
}

.field-group {
  margin-top: 30rpx;
}

.field-group:first-of-type {
  margin-top: 0;
}

.field-label {
  display: block;
  margin-bottom: 14rpx;
  color: var(--safe-title);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.5;
}

.tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  min-height: 62rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-pill);
  background: rgba(255, 248, 238, 0.72);
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 62rpx;
}

.tag::after {
  border: 0;
}

.tag.active {
  border-color: rgba(95, 143, 91, 0.42);
  background: var(--safe-primary-soft);
  color: var(--safe-primary);
  font-weight: 800;
}

.tag--child.active {
  border-color: rgba(215, 120, 74, 0.36);
  background: var(--safe-orange-soft);
  color: #a65d25;
}

.input,
.textarea {
  box-sizing: border-box;
  width: 100%;
  border: 1rpx solid var(--safe-border);
  border-radius: 22rpx;
  background: rgba(255, 248, 238, 0.76);
  color: var(--safe-title);
  font-size: 28rpx;
  line-height: 1.65;
}

.input {
  min-height: 84rpx;
  padding: 0 32rpx;
}

.textarea {
  min-height: 176rpx;
  padding: 24rpx 32rpx;
}

.textarea--large {
  min-height: 214rpx;
}

.slider-row {
  margin-top: 24rpx;
  padding: 22rpx 28rpx;
  border-radius: var(--safe-radius-md);
  background: rgba(244, 241, 232, 0.48);
}

.slider-row--child {
  background: rgba(255, 241, 228, 0.58);
}

.slider-label {
  display: block;
  margin-bottom: 4rpx;
  color: var(--safe-text);
  font-size: 24rpx;
  font-weight: 700;
}

.error-box {
  padding: 24rpx 32rpx;
  border: 1rpx solid rgba(216, 104, 96, 0.28);
  border-radius: var(--safe-radius-md);
  background: rgba(255, 241, 239, 0.92);
  color: #9F3E38;
  font-size: 24rpx;
  line-height: 1.7;
}

.submit-area {
  padding-bottom: 16rpx;
}

.draft-status {
  display: block;
  margin-bottom: 14rpx;
  color: var(--safe-muted);
  font-size: 23rpx;
  line-height: 1.55;
}

.draft-status--slow {
  color: #8a5a2f;
}

.submit-note {
  margin-bottom: 24rpx;
  padding: 22rpx 26rpx;
  border: 1rpx solid rgba(87, 139, 95, 0.18);
  border-radius: 22rpx;
  background: rgba(233, 242, 223, 0.58);
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  line-height: 1.6;
}

.primary-button {
  min-height: 88rpx;
  margin: 0;
  border-radius: var(--safe-radius-pill);
  background: var(--safe-primary);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 88rpx;
  box-shadow: 0 8rpx 18rpx rgba(87, 139, 95, 0.18);
}

.primary-button::after {
  border: 0;
}

.primary-button[disabled] {
  opacity: 0.62;
}
