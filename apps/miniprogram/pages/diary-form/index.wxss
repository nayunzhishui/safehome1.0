.diary-page {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.diary-hero {
  position: relative;
  min-height: 300rpx;
  overflow: hidden;
}

.hero-copy {
  position: relative;
  z-index: 1;
  max-width: 470rpx;
}

.hero-kicker {
  display: block;
  margin-bottom: 10rpx;
  color: var(--safe-primary);
  font-size: 24rpx;
  font-weight: 700;
}

.hero-title {
  display: block;
  color: var(--safe-title);
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.28;
  letter-spacing: 0;
}

.hero-summary {
  display: block;
  margin-top: 16rpx;
  color: var(--safe-text);
  font-size: 28rpx;
  line-height: 1.7;
}

.goal-hint {
  display: inline-flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 8rpx 18rpx;
  border: 1rpx solid rgba(95, 143, 91, 0.18);
  border-radius: var(--safe-radius-pill);
  background: var(--safe-primary-soft);
  color: var(--safe-primary);
  font-size: 24rpx;
  font-weight: 700;
}

.hero-note {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 32rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.6;
}

.privacy-note {
  margin-top: 14rpx;
}

.note-dot {
  width: 12rpx;
  height: 12rpx;
  flex: 0 0 12rpx;
  border-radius: 50%;
  background: var(--safe-yellow);
}

.hero-image {
  position: absolute;
  right: -24rpx;
  bottom: -16rpx;
  width: 260rpx;
  height: 220rpx;
  border-radius: var(--safe-radius-lg);
  opacity: 0.92;
}

.diary-form {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.diary-section {
  padding: 32rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-lg);
  background: var(--safe-card);
  box-shadow: var(--safe-shadow-card);
}

.more-section {
  border-style: dashed;
}

.more-toggle {
  min-height: 78rpx;
  margin: 0;
  border: 1rpx solid rgba(95, 143, 91, 0.28);
  border-radius: var(--safe-radius-pill);
  background: rgba(237, 246, 232, 0.84);
  color: var(--safe-primary-deep);
  font-size: 26rpx;
  font-weight: 850;
  line-height: 78rpx;
}

.more-toggle::after {
  border: 0;
}

.section-head {
  display: flex;
  gap: 24rpx;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.section-index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  flex: 0 0 52rpx;
  border-radius: 18rpx;
  background: var(--safe-primary-soft);
  color: var(--safe-primary);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 52rpx;
}

.section-copy {
  flex: 1;
}

.section-title {
  display: block;
  color: var(--safe-title);
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.35;
}

.section-hint {
  display: block;
  margin-top: 6rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.65;
}

.field-group {
  margin-top: 32rpx;
}

.field-group:first-of-type {
  margin-top: 0;
}

.field-label {
  display: block;
  margin-bottom: 16rpx;
  color: var(--safe-title);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.5;
}

.tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag {
  min-height: 64rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-pill);
  background: var(--safe-bg);
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 64rpx;
}

.tag::after {
  border: 0;
}

.tag.active {
  border-color: rgba(95, 143, 91, 0.42);
  background: var(--safe-primary-soft);
  color: var(--safe-primary);
  font-weight: 800;
}

.input,
.textarea {
  box-sizing: border-box;
  width: 100%;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: var(--safe-bg);
  color: var(--safe-title);
  font-size: 28rpx;
  line-height: 1.65;
}

.input {
  min-height: 84rpx;
  padding: 0 32rpx;
}

.textarea {
  min-height: 168rpx;
  padding: 24rpx 32rpx;
}

.textarea--large {
  min-height: 192rpx;
}

.slider-row {
  margin-top: 24rpx;
  padding: 24rpx 32rpx;
  border-radius: var(--safe-radius-md);
  background: rgba(244, 241, 232, 0.48);
}

.slider-label {
  display: block;
  margin-bottom: 4rpx;
  color: var(--safe-text);
  font-size: 24rpx;
  font-weight: 700;
}

.error-box {
  padding: 24rpx 32rpx;
  border: 1rpx solid rgba(216, 104, 96, 0.28);
  border-radius: var(--safe-radius-md);
  background: rgba(255, 241, 239, 0.92);
  color: #9F3E38;
  font-size: 24rpx;
  line-height: 1.7;
}

.submit-area {
  padding-bottom: 16rpx;
}

.submit-tip {
  display: block;
  margin-bottom: 24rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.6;
  text-align: center;
}

.primary-button {
  min-height: 88rpx;
  margin: 0;
  border-radius: var(--safe-radius-pill);
  background: linear-gradient(135deg, var(--safe-primary), var(--safe-primary-deep));
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 88rpx;
  box-shadow: 0 14rpx 28rpx rgba(87, 139, 95, 0.24);
}

.primary-button::after {
  border: 0;
}

.primary-button[disabled] {
  opacity: 0.62;
}
