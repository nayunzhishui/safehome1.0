.page {
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: #fff7ec;
}

.hero {
  margin-bottom: 28rpx;
  padding: 32rpx;
  border: 1rpx solid #efe7dc;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f7faf4 100%);
  box-shadow: 0 12rpx 32rpx rgba(80, 64, 45, 0.08);
}

.eyebrow {
  display: block;
  margin-bottom: 10rpx;
  color: #4caf7d;
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  display: block;
  margin-bottom: 14rpx;
  color: #333333;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.32;
}

.summary,
.hint {
  display: block;
  color: #555555;
  font-size: 28rpx;
  line-height: 1.7;
}

.goal-hint {
  display: inline-block;
  margin-top: 18rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #eef8e9;
  color: #4caf7d;
  font-size: 24rpx;
  font-weight: 700;
}

.hero-image {
  width: 100%;
  height: 300rpx;
  display: block;
  margin-top: 24rpx;
  overflow: hidden;
  border-radius: 22rpx;
  background: #fffaf3;
}

.panel {
  padding: 28rpx;
  border: 1rpx solid #efe7dc;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(80, 64, 45, 0.08);
}

.step-card {
  margin-bottom: 28rpx;
  padding: 28rpx;
  border: 1rpx solid #efe7dc;
  border-radius: 20rpx;
  background: #fffdf9;
}

.step-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 12rpx;
}

.step-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 16rpx;
  background: #eef8e9;
  color: #4caf7d;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 48rpx;
  text-align: center;
}

.step-title {
  color: #333333;
  font-size: 30rpx;
  font-weight: 700;
}

.label {
  display: block;
  margin-top: 22rpx;
  margin-bottom: 12rpx;
  color: #333333;
  font-size: 28rpx;
  font-weight: 700;
}

.spaced-label {
  margin-top: 30rpx;
}

.slider-row {
  margin-top: 18rpx;
}

.tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 18rpx;
}

.tag {
  min-height: 64rpx;
  margin: 0;
  padding: 0 22rpx;
  border: 1rpx solid #e9e3d8;
  border-radius: 999rpx;
  background: #ffffff;
  color: #555555;
  font-size: 26rpx;
  line-height: 64rpx;
}

.tag.active {
  border-color: #7ccb8a;
  background: #eef8e9;
  color: #4caf7d;
  font-weight: 700;
}

.input,
.textarea {
  box-sizing: border-box;
  width: 100%;
  margin-top: 18rpx;
  padding: 20rpx;
  border: 1rpx solid #e9e3d8;
  border-radius: 18rpx;
  background: #fffdf9;
  color: #333333;
  font-size: 28rpx;
  line-height: 1.6;
}

.input {
  min-height: 80rpx;
}

.textarea {
  min-height: 150rpx;
}

.error-box {
  margin-bottom: 24rpx;
  padding: 20rpx;
  border: 1rpx solid #efb4b4;
  border-radius: 18rpx;
  background: #fff1f1;
  color: #8a2f2f;
  font-size: 26rpx;
  line-height: 1.6;
}

.primary-button {
  min-height: 88rpx;
  margin-top: 8rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #7ccb8a, #4caf7d);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 26rpx rgba(76, 175, 125, 0.22);
}
