<view class="safe-page safe-page--with-tabbar diary-page">
  <view class="diary-hero safe-card safe-card--hero">
    <view class="hero-copy">
      <text class="hero-kicker">情绪事件记录</text>
      <text class="hero-title">记录刚才发生的一小段</text>
      <text class="hero-summary">不需要写得完整，先把此刻能想到的写下来。</text>
      <text wx:if="{{goalId}}" class="goal-hint">已关联本周小目标</text>
      <view class="hero-note">
        <view class="note-dot" aria-hidden="true"></view>
        <text>用于生成支持性反馈，不评价谁对谁错。</text>
      </view>
      <view class="hero-note privacy-note">
        <view class="note-dot" aria-hidden="true"></view>
        <text>请不要填写姓名、学校、电话等强身份信息。</text>
      </view>
    </view>
    <image
      class="hero-image"
      src="/assets/illustrations/diary-reflection.png"
      mode="aspectFill"
      aria-hidden="true"
    />
  </view>

  <view class="diary-form">
    <view class="diary-section">
      <view class="section-head">
        <text class="section-index">01</text>
        <view class="section-copy">
          <text class="section-title">发生了什么</text>
          <text class="section-hint">选择一个常见场景，再写下刚才的具体片段。</text>
        </view>
      </view>
      <view class="tag-grid">
        <button
          wx:for="{{sceneOptions}}"
          wx:key="*this"
          class="tag {{selectedScene === item ? 'active' : ''}}"
          data-value="{{item}}"
          bindtap="selectScene"
        >
          {{item}}
        </button>
      </view>
      <view class="field-group">
        <text class="field-label">其他场景</text>
        <input class="input" value="{{customScene}}" placeholder="如果上面没有合适场景，可以写在这里" bindinput="onTextInput" data-key="customScene" />
      </view>
      <view class="field-group">
        <text class="field-label">具体经过</text>
        <textarea
          class="textarea textarea--large"
          value="{{eventDescription}}"
          placeholder="例如：孩子一直没有开始写作业，我提醒了几次，声音慢慢变大。"
          bindinput="onTextInput"
          data-key="eventDescription"
        />
      </view>
    </view>

    <view class="diary-section">
      <view class="section-head">
        <text class="section-index">02</text>
        <view class="section-copy">
          <text class="section-title">我的情绪</text>
          <text class="section-hint">先记录自己的感受和强度，后面可以展开补充更多信息。</text>
        </view>
      </view>
      <view class="field-group">
        <text class="field-label">家长当时的主要情绪</text>
        <view class="tag-grid">
          <button
            wx:for="{{parentEmotionOptions}}"
            wx:key="*this"
            class="tag {{parentEmotion === item ? 'active' : ''}}"
            data-value="{{item}}"
            bindtap="selectParentEmotion"
          >
            {{item}}
          </button>
        </view>
        <view class="slider-row">
          <text class="slider-label">强度 {{parentEmotionIntensity}} / 10</text>
          <slider min="0" max="10" step="1" value="{{parentEmotionIntensity}}" activeColor="#5F8F5B" block-color="#5F8F5B" bindchange="onParentIntensityChange" />
        </view>
      </view>

    </view>

    <view class="diary-section">
      <view class="section-head">
        <text class="section-index">03</text>
        <view class="section-copy">
          <text class="section-title">我当时怎么回应</text>
          <text class="section-hint">只记录能看到的动作和话语，不需要评判对错。</text>
        </view>
      </view>
      <view class="field-group">
        <text class="field-label">我当时的做法</text>
        <textarea
          class="textarea"
          value="{{behavior}}"
          placeholder="例如：我连续提醒了几次，后来声音提高了一些。"
          bindinput="onTextInput"
          data-key="behavior"
        />
      </view>
    </view>

    <button class="more-toggle" bindtap="toggleMoreFields">
      {{showMoreFields ? '收起更多记录项' : '展开更多记录项'}}
    </button>

    <view wx:if="{{showMoreFields}}" class="diary-section more-section">
      <view class="section-head">
        <text class="section-index">04</text>
        <view class="section-copy">
          <text class="section-title">更多线索（可选）</text>
          <text class="section-hint">这些内容可以帮助复盘，但不填也能提交。</text>
        </view>
      </view>
      <view class="field-group">
        <text class="field-label">孩子当时看起来的情绪</text>
        <view class="tag-grid">
          <button
            wx:for="{{childEmotionOptions}}"
            wx:key="*this"
            class="tag {{childEmotion === item ? 'active' : ''}}"
            data-value="{{item}}"
            bindtap="selectChildEmotion"
          >
            {{item}}
          </button>
        </view>
        <view class="slider-row">
          <text class="slider-label">强度 {{childEmotionIntensity}} / 10</text>
          <slider min="0" max="10" step="1" value="{{childEmotionIntensity}}" activeColor="#F47B48" block-color="#F47B48" bindchange="onChildIntensityChange" />
        </view>
      </view>
      <view class="field-group">
        <text class="field-label">脑子里闪过的想法</text>
        <textarea
          class="textarea"
          value="{{automaticThought}}"
          placeholder="例如：我当时脑中冒出一个念头：再这样下去会不会更难收拾。"
          bindinput="onTextInput"
          data-key="automaticThought"
        />
      </view>
      <view class="field-group">
        <text class="field-label">身体感觉</text>
        <view class="tag-grid">
          <button
            wx:for="{{bodySensationOptions}}"
            wx:key="*this"
            class="tag {{bodySensation === item ? 'active' : ''}}"
            data-value="{{item}}"
            bindtap="selectBodySensation"
          >
            {{item}}
          </button>
        </view>
        <input class="input" value="{{bodySensationNote}}" placeholder="也可以补充一句身体感觉，可不填" bindinput="onTextInput" data-key="bodySensationNote" />
      </view>
      <view class="field-group">
        <text class="field-label">孩子后来的反应</text>
        <textarea
          class="textarea"
          value="{{childReaction}}"
          placeholder="孩子后来有什么反应？例如：沉默、争辩、哭了，或暂时离开。"
          bindinput="onTextInput"
          data-key="childReaction"
        />
      </view>
      <view class="field-group">
        <text class="field-label">当下结果</text>
        <textarea
          class="textarea"
          value="{{shortTermResult}}"
          placeholder="短期结果：当下有没有暂时停下来，或情绪有没有更强？"
          bindinput="onTextInput"
          data-key="shortTermResult"
        />
      </view>
      <view class="field-group">
        <text class="field-label">我担心的长期影响</text>
        <textarea
          class="textarea"
          value="{{longTermImpact}}"
          placeholder="如果类似方式经常出现，你担心它可能带来什么影响？"
          bindinput="onTextInput"
          data-key="longTermImpact"
        />
      </view>
    </view>

    <view wx:if="{{errorMessage}}" class="error-box">
      <text>{{errorMessage}}</text>
    </view>

    <view class="submit-area">
      <text class="submit-tip">记录保存后，会进入即时反馈和训练卡推荐。</text>
      <button class="primary-button" bindtap="submitDiary" disabled="{{submitting}}">
        {{submitting ? '提交中...' : '保存并查看反馈'}}
      </button>
    </view>
  </view>
</view>
