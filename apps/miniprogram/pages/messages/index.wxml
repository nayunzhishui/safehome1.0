<view class="safe-page messages-page" role="main" aria-label="消息">
  <view class="messages-header">
    <text class="page-kicker">消息提醒</text>
    <text class="page-title">需要你看看</text>
    <text class="page-summary">人工补充和必要提醒会按时间排列。</text>
  </view>

  <view class="messages-content">
    <page-state wx:if="{{loading}}" kind="loading" title="正在加载消息" description="人工反馈和必要提醒会按时间排列。" />

    <block wx:elif="{{errorMessage}}">
      <page-state kind="error" title="消息暂时没有读取成功" description="{{errorMessage}}" action-label="{{needsLogin ? '去登录' : '重新加载'}}" action-aria-label="{{needsLogin ? '登录后查看消息' : '重新加载消息'}}" bind:action="handleStateAction" />
      <view wx:if="{{errorDiagnostic}}" class="diagnostic-card">
        <text class="diagnostic-copy">请求编号：{{errorDiagnostic.requestId || '未返回'}} · 服务版本：{{errorDiagnostic.serviceVersion || '未知'}}</text>
        <button class="diagnostic-action" aria-label="复制本次错误的诊断信息" bindtap="copyDiagnostic">复制诊断信息</button>
      </view>
    </block>

    <view wx:elif="{{messages.length}}" class="message-list">
      <button
        wx:for="{{messages}}"
        wx:key="id"
        class="message-row {{item.is_unread ? 'message-row--unread' : ''}} {{item.is_withdrawn ? 'message-row--withdrawn' : ''}}"
        aria-label="{{item.is_withdrawn ? '已撤回消息：' : (item.is_unread ? '未读消息：' : '已读消息：')}}{{item.title}}"
        data-id="{{item.id}}"
        bindtap="openMessage"
      >
        <view wx:if="{{item.is_unread}}" class="unread-marker" aria-hidden="true"></view>
        <view class="message-copy">
          <text class="message-title">{{item.title}}</text>
          <text class="message-body">{{item.is_withdrawn ? '研究者已撤回这条内容，请忽略此前版本。' : (item.body || '打开查看详情。')}}</text>
          <view class="message-meta">
            <text class="message-time">{{item.sender_role ? '研究者补充 · ' : ''}}{{item.created_at}}{{item.delivery_version ? ' · 第 ' + item.delivery_version + ' 版' : ''}}</text>
            <text class="message-status {{item.is_unread ? 'message-status--unread' : ''}}">{{item.is_withdrawn ? '已撤回' : (item.is_unread ? '未读' : '已读')}}</text>
          </view>
        </view>
      </button>
    </view>

    <page-state wx:else kind="empty" title="暂时没有新消息" description="如果研究者后续补充反馈，会出现在这里。" />
  </view>

  <view class="message-boundary">
    <view class="message-boundary__rule" aria-hidden="true"></view>
    <text class="message-boundary__text">消息只用于补充说明和支持提醒，不替代紧急帮助。</text>
  </view>
</view>
