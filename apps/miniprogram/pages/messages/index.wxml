<view class="safe-page messages-page">
  <view class="safe-card safe-card--hero">
    <text class="page-kicker">消息提醒</text>
    <text class="page-title">需要你看看</text>
    <text class="page-summary">这里主要放人工督导补充反馈和必要提醒，不做营销推送。</text>
  </view>

  <page-state wx:if="{{loading}}" kind="loading" title="正在加载消息" description="人工反馈和必要提醒会按时间排列。" />
  <page-state wx:elif="{{errorMessage}}" kind="error" title="消息暂时没有读取成功" description="{{errorMessage}}" action-label="{{needsLogin ? '去登录' : '重新加载'}}" action-aria-label="{{needsLogin ? '登录后查看消息' : '重新加载消息'}}" bind:action="handleStateAction" />
  <view wx:if="{{errorMessage && errorDiagnostic}}" class="diagnostic-card">
    <text class="diagnostic-copy">请求编号：{{errorDiagnostic.requestId || '未返回'}} · 服务版本：{{errorDiagnostic.serviceVersion || '未知'}}</text>
    <button class="diagnostic-action" bindtap="copyDiagnostic">复制诊断信息</button>
  </view>

  <view wx:elif="{{messages.length}}" class="message-list">
    <button wx:for="{{messages}}" wx:key="id" class="message-row {{item.is_unread ? 'message-row--unread' : ''}}" data-id="{{item.id}}" bindtap="openMessage">
      <view class="message-copy">
        <text class="message-title">{{item.title}}</text>
        <text class="message-body">{{item.body || '打开查看详情。'}}</text>
        <text class="message-time">{{item.created_at}}</text>
      </view>
      <status-pill label="{{item.is_unread ? '未读' : '已读'}}" tone="{{item.is_unread ? 'success' : 'neutral'}}" aria-label="消息状态：{{item.is_unread ? '未读' : '已读'}}" />
    </button>
  </view>

  <page-state wx:else kind="empty" title="暂时没有新消息" description="如果研究者后续补充反馈，会出现在这里。" />

  <view class="safe-section">
    <bottom-tip-card text="消息只用于补充说明和支持提醒，不替代紧急帮助。" />
  </view>
</view>
