.messages-page {
  box-sizing: border-box;
  padding: 40rpx 48rpx calc(64rpx + env(safe-area-inset-bottom));
}

.messages-header { display: flex; flex-direction: column; align-items: stretch; text-align: center; }
.page-title, .diagnostic-copy { display: block; }

.page-title {
  color: var(--safe-title);
  font-size: 44rpx;
  font-weight: 700;
  line-height: 60rpx;
  letter-spacing: 0;
  text-align: center;
}

.messages-content {
  margin-top: 48rpx;
}

.message-list {
  --ui2-message-padding: 40rpx 0;
  --ui2-message-bg: transparent;
  --ui2-unread-marker: none;
  border-top: 1rpx solid var(--safe-border);
}

.diagnostic-card {
  margin-top: 32rpx;
  padding: 32rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: 24rpx;
  background: var(--safe-bg-soft);
}

.diagnostic-copy {
  color: var(--safe-muted);
  font-size: 26rpx;
  line-height: 36rpx;
  overflow-wrap: anywhere;
}

.diagnostic-action {
  min-height: 96rpx;
  margin: 16rpx 0 0;
  border: 0;
  background: transparent;
  color: var(--safe-primary-deep);
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.5;
  padding: 24rpx 0;
  text-align: left;
}

.diagnostic-action::after {
  border: 0;
}

bottom-tip-card {
  display: block;
  margin-top: 64rpx;
}

@media (max-width: 340px) {
  .messages-page {
    padding-right: 40rpx;
    padding-left: 40rpx;
  }

}

bottom-tip-card { --ui2-tip-border: 0; --ui2-tip-padding: 0; --ui2-tip-background: transparent; }
