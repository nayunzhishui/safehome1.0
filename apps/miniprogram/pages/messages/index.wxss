/* 消息（Figma 670:3108）：一张纸白分组列表，行间细线；页尾一行居中说明。 */
.messages-page {
  display: flex;
  flex-direction: column;
  gap: var(--p3-section);
  padding-top: 16rpx;
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
}

.messages-list {
  display: flex;
  flex-direction: column;
  padding: 0 32rpx;
  border-radius: var(--p3-radius-group);
  background: var(--p3-surface);
}

.messages-diagnostic {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.messages-foot {
  text-align: center;
}
