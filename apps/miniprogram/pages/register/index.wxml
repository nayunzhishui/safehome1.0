<view class="safe-page ui2-page auth-page" role="main" aria-label="注册">
  <view class="auth-shell">
    <view class="auth-header">
      <text class="auth-title">创建账号</text>
    </view>

    <view class="auth-form">
      <view class="auth-section-title">账号信息</view>

      <view class="field field-first">
        <text class="field-label">用户名</text>
        <input value="{{username}}" aria-label="用户名" placeholder-class="field-placeholder" placeholder="请输入用户名" bindinput="onUsernameInput" />
        <text class="field-helper">至少 3 个字符</text>
      </view>

      <view class="field">
        <text class="field-label">密码</text>
        <input value="{{password}}" aria-label="密码" placeholder-class="field-placeholder" password placeholder="请输入密码" bindinput="onPasswordInput" />
        <text class="field-helper">至少 8 个字符</text>
      </view>

      <view class="auth-section-title identity-heading">使用身份</view>
      <view class="field">
        <text class="field-label">角色</text>
        <picker
          range="{{roleOptions}}"
          range-key="label"
          value="{{roleIndex}}"
          bindchange="onRoleChange"
          aria-label="选择角色，当前为{{roleOptions[roleIndex].label}}"
        >
          <view class="picker-value">
            <text>{{roleOptions[roleIndex].label}}</text>
            <image class="picker-chevron" src="/assets/icons/chevron-down.svg" mode="aspectFit" aria-hidden="true" />
          </view>
        </picker>
      </view>

      <view class="field">
        <text class="field-label">昵称（可选）</text>
        <input value="{{nickname}}" aria-label="昵称，可选" placeholder-class="field-placeholder" placeholder="选填" bindinput="onNicknameInput" />
      </view>

      <view class="auth-agreement" aria-label="协议确认">
        <checkbox-group bindchange="onAgreementChange">
          <label class="auth-agreement-label">
            <checkbox value="agreed" checked="{{agreed}}" aria-label="我已阅读并同意用户服务协议和隐私政策" />
            <text class="auth-agreement-text">我已阅读并同意</text>
          </label>
        </checkbox-group>
        <text class="auth-agreement-link" bindtap="openAgreement">《用户服务协议》</text>
        <text class="auth-agreement-text">和</text>
        <text class="auth-agreement-link" bindtap="openPrivacy">《隐私政策》</text>
      </view>

      <view wx:if="{{message}}" class="message {{status}}" aria-live="polite">{{message}}</view>
      <button class="primary-action" loading="{{loading}}" disabled="{{loading}}" bindtap="submitRegister">注册</button>
      <button class="ghost-action" bindtap="goLogin">已有账号，去登录</button>
    </view>
  </view>
</view>
