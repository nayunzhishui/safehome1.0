.auth-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 40rpx 48rpx calc(56rpx + env(safe-area-inset-bottom));
  background: var(--safe-bg);
}

.auth-shell {
  width: 100%;
  max-width: 684rpx;
  margin: 0 auto;
}

.auth-header {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  text-align: center;
}

.auth-title {
  margin-top: 24rpx;
  color: var(--safe-title);
  font-size: 44rpx;
  font-weight: 700;
  line-height: 60rpx;
  letter-spacing: 0;
  text-align: center;
}

.auth-form {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 40rpx;
}

.auth-section-title {
  width: 100%;
  color: var(--safe-title);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 56rpx;
}

.field {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  flex-direction: column;
  margin-top: 32rpx;
  color: var(--safe-title);
}

.field-first {
  margin-top: 40rpx;
}

.field-label {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 40rpx;
}

.field input,
.picker-value {
  box-sizing: border-box;
  width: 100%;
  height: 104rpx;
  margin-top: 12rpx;
  padding: 0 28rpx;
  border: 2rpx solid var(--safe-border-strong);
  border-radius: 24rpx;
  color: var(--safe-title);
  background: var(--safe-card);
  font-size: 30rpx;
  font-weight: 400;
  line-height: 44rpx;
}

.field input:focus {
  border: 2rpx solid var(--safe-focus);
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-value:active {
  border-color: var(--safe-focus);
}

.picker-chevron {
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 auto;
}

.field-helper {
  margin-top: 8rpx;
  color: var(--safe-muted);
  font-size: 26rpx;
  font-weight: 400;
  line-height: 36rpx;
}

.message {
  box-sizing: border-box;
  width: 100%;
  margin-top: 32rpx;
  color: var(--safe-title);
  font-size: 26rpx;
  line-height: 36rpx;
  text-align: left;
}

.message.error {
  color: #9f3e38;
}

.primary-action,
.ghost-action {
  box-sizing: border-box;
  width: 100%;
  min-height: 96rpx;
  margin-right: 0;
  margin-left: 0;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.5;
  padding: 24rpx;
  white-space: normal;
}

.primary-action {
  margin-top: 40rpx;
  color: #fff;
  background: var(--safe-primary);
}

.ghost-action {
  margin-top: 16rpx;
  color: var(--safe-primary-deep);
  background: transparent;
}

.primary-action[disabled] {
  opacity: 0.54;
}

@media (max-width: 340px) {
  .auth-page {
    padding-right: 40rpx;
    padding-left: 40rpx;
  }

  .auth-title {
    font-size: 44rpx;
    line-height: 60rpx;
  }
}

.identity-heading {
  margin-top: 48rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid var(--safe-border);
}
.message { font-size: 30rpx; line-height: 48rpx; }

.field-placeholder { color: var(--safe-muted); opacity: 1; }
