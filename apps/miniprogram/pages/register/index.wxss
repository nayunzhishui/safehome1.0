.auth-page {
  min-height: 100vh;
}

.auth-card {
  margin: 48rpx 0;
  padding: 36rpx;
  border-color: var(--safe-border-strong);
}

.field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 28rpx;
  color: var(--safe-text);
  font-size: 28rpx;
}

.field input,
.picker-value {
  min-height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--safe-border-strong);
  border-radius: var(--safe-radius-sm);
  background: var(--safe-card);
  line-height: 88rpx;
}

.message {
  margin-top: 24rpx;
  color: var(--safe-text);
  font-size: 26rpx;
}

.message.error {
  color: var(--safe-danger);
}

.primary-action,
.ghost-action {
  margin-top: 28rpx;
  border-radius: var(--safe-radius-pill);
  font-weight: 800;
}

.primary-action {
  color: #fff;
  background: var(--safe-primary);
}

.ghost-action {
  color: var(--safe-primary-deep);
  background: transparent;
}
