/* 课程内容（Figma 655:1890）：衬线标题 + 竹简 → 要点 → 小节时间线 → 误区 → 示例/反例 → 理解检查 → 练一次 → 关联训练卡 → 记录学习。 */
.course-detail-page {
  display: flex;
  flex-direction: column;
  gap: var(--p3-section);
  padding-top: 16rpx;
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
}

.course-head {
  display: flex;
  align-items: center;
  gap: var(--p3-stack);
}

.course-head__text {
  display: flex;
  flex: 1 0 0;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.course-head__art {
  flex: 0 0 auto;
  width: 144rpx;
  height: 144rpx;
}

.course-section {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
}

/* 浅底说明块：要点、完整示例（青瓷浅底）；常见反例（暖底） */
.course-panel {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 32rpx 36rpx;
  border-radius: var(--p3-radius-group);
}

.course-panel--soft {
  background: var(--p3-soft);
}

.course-panel--warm {
  background: var(--p3-warm-soft);
}

.course-panel__label {
  color: var(--p3-primary);
  font-size: 26rpx;
  line-height: 40rpx;
}

.course-panel__label--warm {
  color: var(--p3-warm-ink);
}

.course-panel__line {
  color: var(--p3-ink);
  font-size: 28rpx;
  line-height: 44rpx;
}

.course-timeline {
  display: flex;
  flex-direction: column;
}

.course-myth {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 28rpx 0;
}

.course-myth--divided {
  border-bottom: 2rpx solid var(--p3-hairline);
}

.course-myth__label {
  color: var(--p3-primary);
  font-size: 26rpx;
  line-height: 40rpx;
}

.course-myth__label--warm {
  color: var(--p3-warm-ink);
}

.course-myth__text {
  color: var(--p3-ink);
  font-size: 30rpx;
  line-height: 52rpx;
}

/* 理解检查选项（Figma OptionRow 623:101）：描边计入布局，选中青瓷浅底 + 1.5 描边 */
.course-check {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
}

.course-check__options {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
}

.course-option {
  display: flex;
  align-items: center;
  gap: var(--p3-stack);
  box-sizing: border-box;
  min-height: 112rpx;
  padding: 30rpx 34rpx;
  border-radius: 28rpx;
  background: var(--p3-surface);
  box-shadow: inset 0 0 0 2rpx var(--p3-hairline);
}

.course-option--active {
  min-height: 114rpx;
  padding: 31rpx 35rpx;
  background: var(--p3-soft);
  box-shadow: inset 0 0 0 3rpx var(--p3-primary);
}

.course-option__radio {
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
}

.course-option__label {
  flex: 1 0 0;
  min-width: 0;
  color: var(--p3-ink);
  font-size: 30rpx;
  line-height: 52rpx;
}

.course-check__feedback {
  color: var(--p3-primary);
  font-size: 28rpx;
  line-height: 44rpx;
}

.course-reflect {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.course-row-button {
  display: block;
  width: 100%;
  min-height: 0;
  text-align: left;
}

.course-progress {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 32rpx 36rpx;
  border-radius: var(--p3-radius-group);
  background: var(--p3-surface);
}
