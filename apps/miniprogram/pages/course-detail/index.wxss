.course-detail-page {
  padding-bottom: 72rpx;
}

.detail-hero {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.hero-kicker,
.hero-title,
.hero-summary,
.hero-meta,
.section-title,
.section-body,
.relation-title,
.relation-text {
  display: block;
}

.hero-kicker {
  color: var(--safe-primary);
  font-size: 24rpx;
  font-weight: 800;
}

.hero-title {
  color: var(--safe-title);
  font-size: 40rpx;
  font-weight: 850;
  line-height: 1.28;
}

.hero-summary,
.hero-meta {
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.6;
}

.hero-meta {
  color: var(--safe-muted);
  font-weight: 800;
}

.section-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 20rpx;
}

.section-card {
  display: flex;
  gap: 18rpx;
  padding: 24rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: var(--safe-card);
  box-shadow: var(--safe-shadow-card);
}

.section-index {
  flex: 0 0 auto;
  width: 54rpx;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--safe-primary-soft);
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 900;
}

.section-copy {
  min-width: 0;
  flex: 1;
}

.section-title {
  color: var(--safe-title);
  font-size: 28rpx;
  font-weight: 850;
  line-height: 1.35;
}

.section-body {
  margin-top: 10rpx;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.65;
}

.relation-card,
.state-card,
.boundary-note {
  padding: 24rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: var(--safe-card);
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.6;
  box-shadow: var(--safe-shadow-card);
}

.relation-card {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.relation-title {
  color: var(--safe-title);
  font-size: 28rpx;
  font-weight: 850;
}

.relation-text {
  color: var(--safe-text);
}

.boundary-note {
  margin-top: 24rpx;
  background: var(--safe-primary-pale);
}

.state-card.error {
  border-color: #efb4b4;
  background: #fff1f1;
  color: #8a2f2f;
}

.outline-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 58rpx;
  margin-top: 16rpx;
  padding: 0 22rpx;
  border: 1rpx solid var(--safe-border-strong);
  border-radius: var(--safe-radius-pill);
  color: var(--safe-primary-deep);
  font-size: 23rpx;
  font-weight: 800;
}

.learning-panel,
.practice-band {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 18rpx;
  padding: 24rpx;
  border-left: 6rpx solid var(--safe-primary);
  background: var(--safe-card);
}

.core-concept,
.check-prompt {
  display: block;
  color: var(--safe-title);
  font-size: 28rpx;
  font-weight: 850;
  line-height: 1.55;
}

.learning-line,
.check-feedback,
.booster-line,
.example-label {
  display: block;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.65;
}

.example-label {
  color: var(--safe-primary-deep);
  font-weight: 850;
}

.correction-label {
  margin-top: 10rpx;
}

.counter-panel {
  border-left-color: #b66a4a;
}

.answer-button {
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  padding: 14rpx 20rpx;
  border: 1rpx solid var(--safe-border-strong);
  border-radius: var(--safe-radius-sm);
  background: var(--safe-card);
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.45;
  text-align: left;
}

.answer-button.selected {
  border-color: var(--safe-primary);
  background: var(--safe-primary-soft);
}

.check-feedback,
.booster-line {
  padding: 16rpx;
  background: var(--safe-primary-pale);
}

.progress-band {
  border-top: 1rpx solid var(--safe-border);
  padding-top: 24rpx;
}
