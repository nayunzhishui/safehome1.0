<view class="safe-page course-detail-page" role="main" aria-label="课程详情">
  <view wx:if="{{loading}}" class="state-card">
    <text>正在读取课程内容...</text>
  </view>

  <view wx:elif="{{errorMessage}}" class="state-card error">
    <text>{{errorMessage}}</text>
    <button class="outline-button" bindtap="retryLoadCourse">重新加载</button>
  </view>

  <view wx:elif="{{course}}">
    <view class="detail-hero">
      <text class="hero-title">{{course.title}}</text>
      <text class="hero-meta">{{course.theme}} · {{course.durationText}} · {{course.sections.length}} 小节</text>
    </view>

    <view class="safe-section">
      <section-title title="这节课会练什么" />
      <view class="learning-panel">
        <text class="core-concept">{{course.core_concept}}</text>
        <text wx:for="{{course.learning_objectives}}" wx:key="*this" class="learning-line">{{index + 1}}. {{item}}</text>
      </view>
    </view>

    <view class="safe-section">
      <section-title title="课程小节" />
      <view class="section-list">
        <view wx:for="{{course.sections}}" wx:key="title" class="section-card">
          <text class="section-index">{{index + 1}}</text>
          <view class="section-copy">
            <text class="section-title">{{item.title}}</text>
            <text class="section-body">{{item.body}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="safe-section">
      <section-title title="常见误区" />
      <view wx:for="{{course.common_misconceptions}}" wx:key="statement" class="learning-panel">
        <text class="example-label">容易误解</text>
        <text class="learning-line">{{item.statement}}</text>
        <text class="example-label correction-label">可以这样理解</text>
        <text class="learning-line">{{item.correction}}</text>
      </view>
    </view>

    <view class="safe-section example-grid">
      <view class="learning-panel">
        <text class="example-label">完整示例</text>
        <text class="learning-line">{{course.worked_example}}</text>
      </view>
      <view class="learning-panel counter-panel">
        <text class="example-label">常见反例</text>
        <text class="learning-line">{{course.counter_example}}</text>
      </view>
    </view>

    <view class="safe-section">
      <section-title title="理解检查" />
      <view wx:for="{{course.knowledgeChecks}}" wx:key="id" wx:for-item="check" class="learning-panel">
        <text class="check-prompt">{{check.prompt}}</text>
        <button wx:for="{{check.options}}" wx:key="value" wx:for-item="option" class="answer-button {{check.selectedValue === option.value ? 'selected' : ''}}" data-check-id="{{check.id}}" data-value="{{option.value}}" bindtap="chooseKnowledgeAnswer">{{option.label}}</button>
        <text wx:if="{{check.feedback}}" class="check-feedback">{{check.feedback}}</text>
      </view>
    </view>

    <view class="safe-section practice-band">
      <section-title title="现在练一次" />
      <text class="learning-line">{{course.guided_practice.instruction}}</text>
      <text class="example-label">真实场景迁移</text>
      <text class="learning-line">{{course.transfer_task}}</text>
      <text class="example-label">练习后想一想</text>
      <text wx:for="{{course.reflection_prompts}}" wx:key="*this" class="learning-line">{{index + 1}}. {{item}}</text>
      <text wx:if="{{course.boosterText}}" class="booster-line">{{course.boosterText}}</text>
    </view>

    <view wx:if="{{course.relationText}}" class="safe-section">
      <view class="relation-card">
        <text class="relation-title">关联训练卡</text>
        <text class="relation-text">{{course.relationText}}</text>
        <button class="safe-primary-button" bindtap="goTraining">去训练页</button>
      </view>
    </view>

    <view class="safe-section progress-band">
      <text class="core-concept">记录本次学习</text>
      <text class="learning-line">完成表示已经阅读并尝试理解检查，不代表掌握程度或心理状态改善。</text>
      <text wx:if="{{progressMessage}}" class="check-feedback">{{progressMessage}}</text>
      <button class="safe-primary-button" loading="{{savingProgress}}" disabled="{{savingProgress}}" bindtap="markCourseComplete">记录课程完成</button>
    </view>

    <view class="boundary-note">{{course.boundary_notice}}</view>
  </view>
</view>
