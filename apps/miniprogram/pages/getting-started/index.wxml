<view class="getting-page" role="main" aria-label="三步开始">
  <view class="getting-intro">
    <text class="p3-serif-title" role="heading" aria-level="1">从一件具体小事开始</text>
    <text class="intro-text">把一次亲子冲突写成一个小片段，看看反馈里的线索，再挑一个今天能做的小动作。</text>
    <text class="intro-text">也可以先“测一测”了解自己，大约 5 分钟；没时间写的话，在首页点一下“情绪温度计”记下此刻的感受。</text>
  </view>

  <view class="getting-section">
    <p3-section-header title="三步练习" />
    <view class="getting-timeline">
      <p3-timeline-item
        wx:for="{{exerciseSteps}}"
        wx:key="kicker"
        state="current"
        kicker="{{item.kicker}}"
        title="{{item.title}}"
        body="{{item.text}}"
        show-line="{{index < exerciseSteps.length - 1}}"
      />
    </view>
  </view>

  <view class="p3-notice" aria-label="为什么写具体的小事">
    <text class="p3-notice__title">为什么写具体的小事</text>
    <text wx:for="{{eventReasons}}" wx:key="*this" class="p3-notice__body">{{item}}</text>
  </view>

  <view class="getting-section">
    <p3-section-header title="情绪反射弧的七个位置" subtitle="第二步就在这里找一个位置" />
    <view class="getting-arc" role="list" aria-label="情绪反射弧七个位置">
      <view wx:for="{{arcNodes}}" wx:key="label" class="getting-arc__row" role="listitem">
        <view class="getting-arc__rail" aria-hidden="true">
          <view class="getting-arc__joint" style="opacity: {{item.opacity}};"></view>
        </view>
        <text class="getting-arc__index">{{index + 1}}</text>
        <text class="getting-arc__label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <view class="p3-notice" aria-label="使用边界">
    <text class="p3-notice__title">使用边界</text>
    <text wx:for="{{boundaries}}" wx:key="*this" class="p3-notice__body">{{item}}</text>
  </view>

  <view class="getting-section" aria-label="开始前的说明与保护入口">
    <view class="getting-section__head">
      <p3-section-header title="开始前，先了解" />
      <text class="getting-section__subtitle before-start-copy">查看说明不会自动记录同意；具体用途仍需单独选择</text>
    </view>
    <view class="p3-group">
      <navigator class="getting-row before-start-link" url="/pages/settings-detail/index?type=consent">
        <p3-group-row icon="info" title="知情与边界" />
      </navigator>
      <navigator class="getting-row before-start-link" url="/pages/settings-detail/index?type=privacy">
        <p3-group-row icon="lock" title="隐私说明" />
      </navigator>
      <navigator class="getting-row before-start-link" url="/pages/settings-detail/index?type=protection">
        <p3-group-row icon="shield" title="参与者保护" show-divider="{{false}}" />
      </navigator>
    </view>
  </view>

  <view class="getting-actions">
    <button class="p3-btn p3-btn--primary" bindtap="startDiary">记录一次</button>
    <button class="p3-btn p3-btn--secondary" bindtap="openAssessment">先测一测</button>
    <button class="p3-btn p3-btn--secondary" bindtap="openTraining">去训练中心</button>
  </view>

  <view class="getting-help" aria-label="需要帮助时">
    <text class="getting-help__title">需要帮助时</text>
    <view class="getting-help__links">
      <navigator class="p3-link" url="/pages/emergency-resources/index">查看求助资源 ›</navigator>
      <navigator class="p3-link" url="/pages/supervision/index">提交人工支持请求 ›</navigator>
    </view>
  </view>
</view>
