/* 三步开始（Figma 645:910）：衬线开场；三步竹节时间线；七个位置七节竹（越往后越深）；开始前先了解；行动区。 */
page {
  background: var(--p3-paper);
}

.getting-page {
  display: flex;
  flex-direction: column;
  gap: var(--p3-section);
  box-sizing: border-box;
  min-height: 100vh;
  padding: 16rpx var(--p3-page-x) calc(72rpx + env(safe-area-inset-bottom));
  background: var(--p3-paper);
  overflow-x: hidden;
}

.getting-intro {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
  min-width: 0;
}

.intro-text {
  display: block;
  color: var(--p3-muted);
  font-size: 30rpx;
  line-height: 52rpx;
}

.getting-section {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
  min-width: 0;
}

.getting-timeline {
  display: flex;
  flex-direction: column;
}

.getting-arc {
  display: flex;
  flex-direction: column;
  padding: 28rpx 36rpx;
  border-radius: var(--p3-radius-group);
  background: var(--p3-surface);
}

.getting-arc__row {
  display: flex;
  align-items: center;
  gap: var(--p3-stack);
  padding: 14rpx 0;
}

.getting-arc__rail {
  display: flex;
  justify-content: center;
  width: 28rpx;
  height: 60rpx;
  flex: 0 0 auto;
}

.getting-arc__joint {
  width: 16rpx;
  height: 36rpx;
  border-radius: 999rpx;
  background: var(--p3-primary);
}

.getting-arc__index {
  flex: 0 0 auto;
  color: var(--p3-primary);
  font-size: 26rpx;
  line-height: 40rpx;
}

.getting-arc__label {
  flex: 1 0 0;
  min-width: 0;
  color: var(--p3-ink);
  font-size: 28rpx;
  line-height: 44rpx;
}

/* 说明行放在页面层（与 SectionHeader 自带副标题同字号、同间距），便于开发者工具冒烟检查读取。 */
.getting-section__head {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.getting-section__subtitle {
  display: block;
  color: var(--p3-muted);
  font-size: 28rpx;
  line-height: 44rpx;
}

.getting-row {
  display: block;
}

.getting-actions {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
}

.getting-help {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.getting-help__title {
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

.getting-help__links {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0 40rpx;
}
