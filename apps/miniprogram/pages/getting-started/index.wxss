.getting-page {
  display: grid;
  gap: 24rpx;
  padding-bottom: 48rpx;
}

.intro-card,
.section-card,
.step-card,
.boundary-card {
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: var(--safe-card);
  box-shadow: var(--safe-shadow-card);
}

.intro-card {
  padding: 30rpx;
  border-left: 8rpx solid var(--safe-primary);
  background: var(--safe-card);
}

.intro-kicker,
.intro-title,
.intro-text,
.section-kicker,
.section-title,
.section-text,
.step-title,
.step-text,
.boundary-title,
.boundary-text {
  display: block;
}

.intro-kicker {
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 850;
}

.intro-title {
  margin-top: 10rpx;
  color: var(--safe-title);
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.25;
}

.intro-text {
  margin-top: 18rpx;
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.75;
}

.step-list {
  display: grid;
  gap: 18rpx;
}

.section-card {
  padding: 26rpx;
}

.section-kicker {
  color: var(--safe-primary-deep);
  font-size: 23rpx;
  font-weight: 850;
}

.section-title {
  margin-top: 10rpx;
  color: var(--safe-title);
  font-size: 30rpx;
  font-weight: 850;
  line-height: 1.48;
}

.section-text {
  margin-top: 12rpx;
  color: var(--safe-text);
  font-size: 25rpx;
  line-height: 1.68;
}

.reason-row {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.reason-index {
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--safe-primary-soft);
  color: var(--safe-primary-deep);
  font-size: 22rpx;
  font-weight: 900;
}

.reason-text {
  flex: 1;
  min-width: 0;
  color: var(--safe-text);
  font-size: 25rpx;
  line-height: 1.65;
}

.arc-scroll {
  margin-top: 20rpx;
  width: 100%;
  white-space: nowrap;
}

.arc-chain {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding-bottom: 4rpx;
}

.arc-node {
  max-width: 280rpx;
  min-height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-sm);
  background: var(--safe-bg-leaf);
  color: var(--safe-primary-deep);
  font-size: 23rpx;
  font-weight: 800;
  white-space: normal;
  text-align: center;
  line-height: 1.35;
}

.arc-arrow {
  color: var(--safe-muted);
  font-size: 28rpx;
  font-weight: 800;
}

.step-card {
  padding: 24rpx;
}

.step-title {
  color: var(--safe-title);
  font-size: 29rpx;
  font-weight: 850;
}

.step-text {
  margin-top: 12rpx;
  color: var(--safe-text);
  font-size: 25rpx;
  line-height: 1.65;
}

.boundary-card {
  padding: 24rpx;
  background: #fff7f0;
}

.boundary-title {
  color: var(--safe-title);
  font-size: 29rpx;
  font-weight: 850;
}

.boundary-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 16rpx;
}

.boundary-dot {
  width: 12rpx;
  height: 12rpx;
  flex: 0 0 auto;
  margin-top: 14rpx;
  border-radius: 50%;
  background: var(--safe-primary);
}

.boundary-text {
  color: var(--safe-text);
  font-size: 25rpx;
  line-height: 1.65;
}

.action-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.primary-action,
.secondary-action {
  min-height: 84rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 850;
}

.primary-action {
  background: var(--safe-primary);
  color: #ffffff;
}

.secondary-action {
  border: 1rpx solid var(--safe-border);
  background: rgba(255, 253, 248, 0.92);
  color: var(--safe-primary-deep);
}
