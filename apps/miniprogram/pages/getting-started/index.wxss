.getting-page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
  color: var(--safe-title);
}

.intro-block {
  padding: 18rpx 0 36rpx;
  text-align: center;
}

.intro-kicker,
.intro-title,
.intro-text,
.path-number,
.path-label,
.step-number,
.step-title,
.step-text,
.reason-text,
.arc-intro,
.arc-index,
.arc-node,
.step-route,
.boundary-title,
.boundary-text {
  display: block;
}

.intro-title {
  margin-top: 14rpx;
  color: var(--safe-title);
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.18;
  letter-spacing: 0;
  text-align: center;
}

.practice-list {
  border-top: 1rpx solid var(--safe-border);
}

.practice-step {
  display: grid;
  grid-template-columns: 64rpx minmax(0, 1fr);
  gap: 28rpx;
  padding: 48rpx 0;
  border-bottom: 1rpx solid var(--safe-border);
}

.practice-step-last {
  border-bottom: 0;
}

.step-number {
  color: var(--safe-primary);
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: -2rpx;
}

.step-content {
  min-width: 0;
  padding-left: 0;
  border-left: 0;
}

.step-title {
  color: var(--safe-title);
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.28;
}

.step-text,
.arc-intro {
  margin-top: 16rpx;
  color: var(--safe-muted);
  font-size: 30rpx;
  line-height: 1.7;
}

.reason-list {
  margin-top: 18rpx;
}

.reason-row,
.boundary-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 12rpx;
}

.reason-dot,
.boundary-dot {
  flex: 0 0 auto;
  color: var(--safe-primary);
  font-size: 32rpx;
  line-height: 1.45;
}

.reason-text,
.boundary-text {
  min-width: 0;
  flex: 1;
  color: var(--safe-text);
  font-size: 30rpx;
  line-height: 1.65;
}

.arc-chain {
  position: relative;
  display: grid;
  gap: 12rpx;
  margin-top: 20rpx;
}

.arc-chain::before {
  content: "";
  position: absolute;
  top: 24rpx;
  bottom: 24rpx;
  left: 23rpx;
  width: 2rpx;
  background: var(--safe-border);
}

.arc-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  min-width: 0;
}

.arc-index {
  width: 46rpx;
  height: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 46rpx;
  border-radius: 50%;
  background: var(--safe-primary);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 850;
  line-height: 1;
}

.arc-node {
  min-width: 0;
  padding-top: 4rpx;
  color: var(--safe-title);
  font-size: 30rpx;
  line-height: 1.5;
}

.step-route {
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  border-radius: var(--safe-radius-sm);
  background: var(--safe-primary-pale);
  color: var(--safe-primary-deep);
  font-size: 26rpx;
  font-weight: 750;
  line-height: 1.55;
}

.boundary-block {
  margin-top: 10rpx;
  padding: 28rpx;
  border-radius: var(--safe-radius-sm);
  background: var(--ui2-warm);
}

.boundary-title {
  color: var(--safe-danger);
  font-size: 30rpx;
  font-weight: 850;
  line-height: 1.4;
}

.action-row {
  display: grid;
  gap: 16rpx;
  margin-top: 28rpx;
}

.primary-action,
.secondary-action {
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  border-radius: var(--safe-radius-sm);
  font-size: 30rpx;
  font-weight: 850;
}

.primary-action:active,
.secondary-action:active {
  transform: scale(0.99);
  opacity: 0.9;
}

@media (max-width: 360px) {
  .intro-title {
    font-size: 44rpx;
  }

  .practice-step {
    grid-template-columns: 56rpx minmax(0, 1fr);
    gap: 20rpx;
  }

  .step-number {
    font-size: 40rpx;
  }

  .step-content {
    padding-left: 22rpx;
  }
}

.getting-page { box-sizing:border-box; padding-left:48rpx; padding-right:48rpx; }
@media(prefers-reduced-motion:reduce){.primary-action:active,.secondary-action:active{transform:none}}

.before-start { margin:0 0 40rpx; padding:28rpx; border-radius:24rpx; background:var(--ui2-soft); }
.before-start-title,.before-start-copy { display:block; color:var(--ui2-ink); font-size:30rpx; line-height:1.7; }
.before-start-title { font-size:32rpx; font-weight:700; }
.before-start-copy { margin:12rpx 0 20rpx; }
.before-start-link { display:flex; justify-content:space-between; align-items:center; gap:24rpx; min-height:96rpx; padding:20rpx 0; border-top:1rpx solid var(--ui2-control-border); color:var(--ui2-primary); font-size:30rpx; line-height:1.6; }

.ui2-page .boundary-title { color:#765323; }
.ui2-page .primary-action,.ui2-page .secondary-action { min-height:96rpx; padding:22rpx 24rpx; line-height:1.6; box-shadow:none; }
