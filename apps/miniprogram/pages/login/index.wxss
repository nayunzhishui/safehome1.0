.auth-page {
  min-height: 100vh;
}

.auth-card {
  margin: 48rpx 28rpx;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 28rpx;
  color: #5f4d3f;
  font-size: 28rpx;
}

.field input {
  min-height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid #e4d7c4;
  border-radius: 16rpx;
  background: #fffdf8;
}

.message {
  margin-top: 24rpx;
  color: #7a5d38;
  font-size: 26rpx;
}

.message.error {
  color: #a84232;
}

.wechat-action {
  margin-top: 32rpx;
  color: #fff;
  background: #4e7c6b;
}

.phone-action {
  margin-top: 18rpx;
  border: 1rpx solid rgba(78, 124, 107, 0.28);
  color: #4e7c6b;
  background: #fffdf8;
}

.auth-note {
  margin-top: 14rpx;
  color: #8a7b70;
  font-size: 24rpx;
  line-height: 1.55;
}

.divider {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 30rpx 0 8rpx;
  color: #8a7b70;
  font-size: 24rpx;
}

.divider::before,
.divider::after {
  content: "";
  flex: 1;
  height: 1rpx;
  background: #eadfce;
}

.primary-action,
.ghost-action {
  margin-top: 28rpx;
}

.primary-action {
  color: #fff;
  background: #4e7c6b;
}

.ghost-action {
  color: #4e7c6b;
  background: transparent;
}
