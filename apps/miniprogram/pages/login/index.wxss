.auth-page {
  min-height: 100vh;
}

.auth-card {
  margin: 48rpx 0;
  padding: 36rpx;
  border-color: var(--safe-border-strong);
}

.auth-methods {
  margin-top: 32rpx;
}

.field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 28rpx;
  color: var(--safe-text);
  font-size: 28rpx;
}

.field input {
  min-height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--safe-border-strong);
  border-radius: var(--safe-radius-sm);
  background: var(--safe-card);
}

.message {
  margin-top: 24rpx;
  color: var(--safe-text);
  font-size: 26rpx;
}

.message.error {
  color: var(--safe-danger);
}

.wechat-action {
  min-height: 88rpx;
  color: #fff;
  border-radius: var(--safe-radius-pill);
  background: var(--safe-primary);
  font-weight: 800;
}

.phone-action {
  margin-top: 18rpx;
  min-height: 88rpx;
  border: 1rpx solid rgba(78, 124, 107, 0.28);
  border-radius: var(--safe-radius-pill);
  color: var(--safe-primary-deep);
  background: var(--safe-card);
  font-weight: 800;
}

.auth-note {
  margin-top: 14rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.55;
}

.capability-note {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-left: 4rpx solid var(--safe-warning);
  border-radius: var(--safe-radius-xs);
  color: var(--safe-text);
  background: var(--safe-orange-soft);
  font-size: 24rpx;
  line-height: 1.55;
}

.divider {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 30rpx 0 8rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
}

.divider::before,
.divider::after {
  content: "";
  flex: 1;
  height: 1rpx;
  background: var(--safe-border);
}

.primary-action,
.ghost-action {
  margin-top: 28rpx;
  border-radius: var(--safe-radius-pill);
  font-weight: 800;
}

.primary-action {
  color: #fff;
  background: var(--safe-primary);
}

.ghost-action {
  color: var(--safe-primary-deep);
  background: transparent;
}
