/* 登录（Figma 645:753）与首次改密码（645:808）：品牌区、协议勾选、快捷登录、账号密码；不重复“登录”大标题。 */
page {
  background: var(--p3-paper);
}

.login-page {
  display: flex;
  flex-direction: column;
  gap: var(--p3-section);
  box-sizing: border-box;
  min-height: 100vh;
  padding: 16rpx var(--p3-page-x) calc(72rpx + env(safe-area-inset-bottom));
  background: var(--p3-paper);
  overflow-x: hidden;
}

.login-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--p3-tight);
}

.login-brand__art {
  width: 128rpx;
  height: 128rpx;
}

.login-brand__name {
  color: var(--p3-ink);
  font-family: var(--p3-font-serif);
  font-size: 60rpx;
  line-height: 80rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.login-brand__tagline {
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
  text-align: center;
}

.login-intro {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
}

.login-intro__body {
  display: block;
  color: var(--p3-muted);
  font-size: 28rpx;
  line-height: 44rpx;
}

.login-actions,
.login-form {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
}

.login-note {
  display: block;
  min-width: 0;
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

.login-divider {
  display: flex;
  align-items: center;
  gap: var(--p3-stack);
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
  white-space: nowrap;
}

.login-divider__line {
  flex: 1 0 0;
  height: 2rpx;
  background: var(--p3-hairline);
}
