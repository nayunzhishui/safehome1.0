.auth-page {
  min-height: 100vh;
  padding: 40rpx 48rpx calc(56rpx + env(safe-area-inset-bottom));
  background: var(--safe-bg);
}

.auth-shell {
  width: 100%;
  max-width: 684rpx;
  margin: 0 auto;
}

.auth-header {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.auth-brand {
  color: var(--safe-primary-deep);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 44rpx;
  letter-spacing: 1rpx;
}

.auth-title {
  margin-top: 16rpx;
  color: var(--safe-title);
  font-size: 56rpx;
  font-weight: 700;
  line-height: 72rpx;
  letter-spacing: -1rpx;
}

.auth-summary {
  margin-top: 16rpx;
  color: var(--safe-text);
  font-size: 28rpx;
  line-height: 44rpx;
}

.auth-methods,
.password-change-panel {
  margin-top: 44rpx;
}

.auth-section-title,
.password-change-title {
  color: var(--safe-title);
  font-size: 40rpx;
  font-weight: 700;
  line-height: 56rpx;
}

.wechat-action,
.phone-action,
.auth-unavailable,
.primary-action,
.ghost-action {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  margin-right: 0;
  margin-left: 0;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 88rpx;
}

.wechat-action {
  margin-top: 24rpx;
  color: #fff;
  background: var(--safe-primary);
}

.phone-action {
  margin-top: 20rpx;
  border: 1rpx solid var(--safe-border-strong);
  color: var(--safe-primary-deep);
  background: var(--safe-card);
}

.auth-unavailable {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--safe-border);
  color: var(--safe-muted);
  background: var(--safe-bg-soft);
}

.auth-unavailable-secondary {
  margin-top: 20rpx;
}

.auth-privacy-note {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 20rpx;
}

.auth-privacy-dot {
  flex: 0 0 auto;
  color: var(--safe-warning);
  font-size: 28rpx;
  line-height: 36rpx;
}

.auth-privacy-copy,
.auth-note,
.capability-note {
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}

.auth-note {
  margin-top: 12rpx;
}

.capability-note {
  margin-top: 12rpx;
}

.divider {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 40rpx 0 28rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}

.divider::before,
.divider::after {
  content: "";
  flex: 1;
  height: 1rpx;
  background: var(--safe-border);
}

.auth-form {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.field {
  display: flex;
  box-sizing: border-box;
  width: calc(100% - 32rpx);
  flex-direction: column;
  gap: 12rpx;
  color: var(--safe-text);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 40rpx;
}

.field + .field {
  margin-top: 28rpx;
}

.field input {
  box-sizing: border-box;
  width: 100%;
  height: 104rpx;
  padding: 0 32rpx;
  border: 1rpx solid var(--safe-border-strong);
  border-radius: 32rpx;
  color: var(--safe-text);
  background: var(--safe-card);
  font-size: 28rpx;
  font-weight: 400;
  line-height: 44rpx;
}

.field input:focus {
  border: 2rpx solid var(--safe-focus);
}

.password-change-panel .field {
  width: calc(100% - 32rpx);
  margin-right: auto;
  margin-left: auto;
}

.password-field-first {
  margin-top: 28rpx;
}

.message {
  width: 100%;
  margin-top: 24rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: center;
}

.message.error {
  color: #b4554f;
}

.primary-action,
.ghost-action {
  margin-top: 28rpx;
}

.primary-action {
  color: #fff;
  background: var(--safe-primary);
}

.ghost-action {
  margin-top: 16rpx;
  color: var(--safe-primary-deep);
  background: transparent;
}

.wechat-action[disabled],
.phone-action[disabled],
.primary-action[disabled] {
  opacity: 0.54;
}

@media (max-width: 340px) {
  .auth-page {
    padding-right: 40rpx;
    padding-left: 40rpx;
  }

  .auth-title {
    font-size: 52rpx;
    line-height: 68rpx;
  }
}
