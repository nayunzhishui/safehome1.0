/* 回看信（Figma 658:2097）：一张纸白信纸，按 L1/L2/L3 竹节分段；L3 折叠在米色小块里。 */
.sl-page {
  display: flex;
  flex-direction: column;
  gap: var(--p3-section);
  padding-top: 16rpx;
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
}

.sl-risk-action {
  margin-top: var(--p3-tight);
}

.sl-paper {
  display: flex;
  flex-direction: column;
  gap: var(--p3-section);
  padding: var(--p3-card);
  border-radius: var(--p3-radius-card);
  background: var(--p3-surface);
}

.sl-head {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
}

.sl-opening {
  color: var(--p3-muted);
  font-size: 30rpx;
  line-height: 52rpx;
}

.sl-section {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
}

.sl-section--safety {
  padding: 28rpx 32rpx;
  border-radius: var(--p3-radius-group);
  background: var(--p3-risk-soft);
}

/* L3“也许不太一样的角度”：米色折叠块 + 墨色箭头，展开后箭头转向下 */
.sl-disclosure {
  display: flex;
  align-items: center;
  gap: var(--p3-tight);
  width: 100%;
  min-height: 88rpx;
  padding: 24rpx 28rpx;
  border-radius: var(--p3-radius-group);
  background: var(--p3-paper);
  text-align: left;
}

.sl-disclosure__copy {
  flex: 1 0 0;
  min-width: 0;
}

.sl-disclosure__chevron {
  display: flex;
  flex: 0 0 auto;
  transition: transform 160ms ease;
}

.sl-disclosure__chevron--open {
  transform: rotate(90deg);
}

@media (prefers-reduced-motion: reduce) {
  .sl-disclosure__chevron {
    transition: none;
  }
}

.sl-intro {
  color: var(--p3-muted);
  font-size: 28rpx;
  line-height: 44rpx;
}

.sl-item {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
}

/* 原话引用（Figma 658:2060 LetterQuote）：青瓷大引号 + 衬线引文 */
.sl-quote {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.sl-quote__mark {
  flex: 0 0 auto;
  color: var(--p3-primary);
  font-family: var(--p3-font-serif);
  font-size: 48rpx;
  line-height: 64rpx;
  font-weight: 500;
}

.sl-quote__text {
  flex: 1 0 0;
  min-width: 0;
}

.sl-item__label {
  color: var(--p3-primary);
  font-size: 26rpx;
  line-height: 40rpx;
}

.sl-item__text {
  color: var(--p3-ink);
  font-size: 30rpx;
  line-height: 52rpx;
}

.sl-note-toggle {
  align-self: flex-start;
  width: auto;
  min-height: 0;
  margin: -12rpx 0;
  padding: 12rpx 0;
  color: var(--p3-primary);
  font-size: 26rpx;
  line-height: 40rpx;
  text-align: left;
}

.sl-closing {
  color: var(--p3-primary);
}

.sl-actions {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
}

.sl-save-status {
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
  text-align: center;
}
