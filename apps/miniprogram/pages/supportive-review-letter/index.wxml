<view class="p3-page sl-page" role="main" aria-label="回看信">
  <page-state wx:if="{{loading}}" kind="loading" title="正在整理回看信" />
  <page-state
    wx:elif="{{loadError}}"
    kind="error"
    title="暂时没有读取成功"
    description="{{loadError}}"
    action-label="重新读取"
    action-aria-label="重新读取回看信"
    bindaction="load"
  />

  <block wx:else>
    <view wx:if="{{risk && risk.show_emergency_resources && !safetyOnly}}" class="p3-notice {{risk.level === 'high' ? 'p3-notice--risk' : 'p3-notice--warm'}}" role="alert">
      <text class="p3-notice__body">{{risk.message}}</text>
      <button class="p3-btn {{risk.level === 'high' ? 'p3-btn--risk' : 'p3-btn--secondary'}} sl-risk-action" bindtap="openEmergencyResources">查看紧急求助资源</button>
    </view>

    <view class="sl-paper">
      <view class="sl-head">
        <text class="p3-serif-title p3-serif-title--open" role="heading" aria-level="1">{{letter.title}}</text>
        <text class="sl-opening">{{letter.opening}}</text>
      </view>

      <view
        wx:for="{{sections}}"
        wx:for-item="section"
        wx:for-index="sectionIndex"
        wx:key="id"
        class="sl-section {{section.id === 'safety' ? 'sl-section--safety' : ''}}"
      >
        <button wx:if="{{section.collapsed}}" class="sl-disclosure" aria-expanded="{{anglesOpen}}" bindtap="toggleAngles">
          <view class="sl-disclosure__copy">
            <p3-stage-header level="{{section.level || 3}}" title="{{section.title}}" subtitle="{{anglesOpen ? '' : '可以先不看'}}" />
          </view>
          <view class="sl-disclosure__chevron {{anglesOpen ? 'sl-disclosure__chevron--open' : ''}}" aria-hidden="true">
            <p3-icon name="chevron-right" size="24" tone="ink" />
          </view>
        </button>
        <p3-stage-header wx:else level="{{section.level || 1}}" title="{{section.title}}" subtitle="{{section.intro || ''}}" />
        <text wx:if="{{section.collapsed && anglesOpen && section.intro}}" class="sl-intro">{{section.intro}}</text>

        <block wx:if="{{!section.collapsed || anglesOpen}}">
          <view wx:for="{{section.items}}" wx:for-item="item" wx:for-index="itemIndex" wx:key="id" class="sl-item">
            <block wx:if="{{item.kind === 'quote'}}">
              <text class="p3-meta">{{item.label}}</text>
              <view class="sl-quote">
                <text class="sl-quote__mark" aria-hidden="true">“</text>
                <text class="p3-quote p3-quote--open sl-quote__text">{{item.text}}</text>
              </view>
            </block>
            <block wx:elif="{{item.kind === 'clue' || item.kind === 'fact'}}">
              <text class="sl-item__label">{{item.label}}</text>
              <text class="sl-item__text">{{item.text}}</text>
              <view wx:if="{{item.respondable}}" class="p3-segment p3-segment--paper" role="radiogroup" aria-label="这条线索像不像你">
                <button
                  wx:for="{{checkOptions}}"
                  wx:for-item="option"
                  wx:key="value"
                  class="p3-segment__item {{item.fit === option.value ? 'p3-segment__item--active' : ''}}"
                  role="radio"
                  aria-checked="{{item.fit === option.value}}"
                  data-section="{{sectionIndex}}"
                  data-item="{{itemIndex}}"
                  data-value="{{option.value}}"
                  bindtap="onFit"
                >{{option.label}}</button>
              </view>
            </block>
            <text wx:else class="sl-item__text">{{item.text}}</text>

            <block wx:if="{{item.respondable}}">
              <textarea
                wx:if="{{item.noteOpen}}"
                class="p3-field__input p3-field__input--auto"
                auto-height
                maxlength="300"
                value="{{item.note}}"
                placeholder="{{item.kind === 'prompt' ? '写下你的想法' : '举个例子，或改成更像你的说法'}}"
                placeholder-class="p3-field__placeholder"
                data-section="{{sectionIndex}}"
                data-item="{{itemIndex}}"
                aria-label="{{item.kind === 'prompt' ? '我的想法' : '补充说明'}}"
                bindinput="onNoteInput"
              />
              <button wx:else class="sl-note-toggle" data-section="{{sectionIndex}}" data-item="{{itemIndex}}" bindtap="openNote">＋ {{item.kind === 'prompt' ? '写下我的想法' : '补充一句'}}</button>
            </block>
          </view>
        </block>
      </view>

      <text wx:if="{{letter.closing && !safetyOnly}}" class="p3-quote sl-closing">{{letter.closing}}</text>
    </view>

    <text wx:if="{{errorMessage}}" class="p3-form-message p3-form-message--error" role="alert">{{errorMessage}}</text>

    <view class="sl-actions">
      <button wx:if="{{safetyOnly}}" class="p3-btn p3-btn--risk" bindtap="openEmergencyResources">查看紧急求助资源</button>
      <button wx:else class="p3-btn p3-btn--primary" loading="{{saving}}" disabled="{{saving}}" bindtap="onSave">{{primaryLabel}}</button>
      <button class="p3-btn p3-btn--quiet" disabled="{{saving}}" bindtap="goHub">回到目录</button>
      <text wx:if="{{saveStatus}}" class="sl-save-status" role="status">{{saveStatus}}</text>
    </view>
  </block>
</view>
