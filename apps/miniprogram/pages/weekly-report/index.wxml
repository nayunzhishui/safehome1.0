<view class="weekly-page" role="main" aria-label="本周复盘">
  <page-state wx:if="{{loading}}" kind="loading" title="正在整理本周复盘" />

  <page-state wx:elif="{{errorMessage}}" kind="error" title="周报暂时没有加载成功" description="{{errorMessage}}" action-label="重新加载" bind:action="refreshReport" />

  <block wx:else>
    <view class="weekly-range">
      <text class="weekly-range__label">记录范围</text>
      <text class="weekly-range__value">{{rangeText}}</text>
    </view>

    <view class="weekly-cells">
      <view wx:for="{{statCells}}" wx:key="label" class="weekly-cell">
        <text class="weekly-cell__value">{{item.value}}</text>
        <text class="weekly-cell__label">{{item.label}}</text>
      </view>
    </view>

    <view wx:if="{{progressSummary}}" class="weekly-section">
      <p3-section-header title="近 7 天阶段反馈" subtitle="整理近 7 天的记录、测评与练习" />
      <view class="weekly-progress">
        <status-pill class="weekly-progress__pill" label="{{progressSummary.statusText}}" tone="{{progressSummary.status === 'low_confidence' ? 'neutral' : 'success'}}" />
        <text class="weekly-progress__summary">{{progressSummary.summaryText}}</text>
        <text class="weekly-progress__next">下一步：{{progressSummary.nextAction}}</text>
      </view>
    </view>

    <view class="p3-notice">
      <text class="p3-notice__title">阶段性画像线索</text>
      <text class="p3-notice__body">{{report.profile_trend && report.profile_trend.profile_count ? '本周画像可以作为理解近期压力状态的补充线索。' : '本周还没有阶段性画像线索，也不影响你继续记录和练习。'}}</text>
      <text wx:if="{{profileTrendNamesText}}" class="p3-notice__body">{{profileTrendNamesText}}</text>
      <text wx:if="{{report.profile_trend && report.profile_trend.requires_review_count}}" class="p3-notice__body">有内容需要人工关注，请优先等待或提交人工支持。</text>
    </view>

    <view class="weekly-section">
      <p3-section-header title="本周测评记录" subtitle="只整理你完成过的测评" />
      <view class="p3-group weekly-group">
        <block wx:if="{{dimensionGroups.length}}">
          <view wx:for="{{dimensionGroups}}" wx:key="worksheetId" wx:for-item="group" class="weekly-assessment">
            <text class="weekly-assessment__title">{{group.worksheetTitle}}</text>
            <view wx:for="{{group.dimensions}}" wx:key="key" class="weekly-row {{index < group.dimensions.length - 1 ? 'weekly-row--divided' : ''}}">
              <text class="weekly-row__name">{{item.label}}</text>
              <text class="weekly-row__value">{{item.direction}} {{item.deltaText}}</text>
            </view>
          </view>
        </block>
        <text wx:elif="{{assessmentNamesText}}" class="weekly-group__text">{{assessmentNamesText}}</text>
        <text wx:else class="weekly-group__text weekly-group__text--muted">本周还没有测评记录。</text>
        <text wx:if="{{recommendedCardsText}}" class="weekly-group__note">推荐训练：{{recommendedCardsText}}</text>
      </view>
    </view>

    <view class="weekly-section">
      <p3-section-header title="情绪温度趋势" />
      <text class="weekly-text">{{report.thermometer_trend ? report.thermometer_trend.trend_text : '本周还没有情绪温度记录。'}}</text>
      <text wx:if="{{thermometerDetailText && thermometerDetailText !== '本周还没有情绪温度记录。'}}" class="weekly-text weekly-text--muted">{{thermometerDetailText}}</text>
    </view>

    <view class="weekly-section">
      <p3-section-header title="训练效用线索" subtitle="只看练习前后的记录" />
      <text class="weekly-text">{{trainingEffectivenessText}}</text>
      <text class="weekly-text weekly-text--muted">{{completedCardsText ? '已记录练习：' + completedCardsText : '本周还没有练习尝试记录。可以先选择一张容易练的训练卡。'}}</text>
    </view>

    <view class="weekly-section">
      <p3-section-header title="本周常见" subtitle="看看哪些情况重复出现" />
      <view wx:if="{{commonRows.length}}" class="p3-group weekly-group">
        <view wx:for="{{commonRows}}" wx:key="key" class="weekly-row {{index < commonRows.length - 1 ? 'weekly-row--divided' : ''}}">
          <text class="weekly-row__name">{{item.kind}} · {{item.name}}</text>
          <text class="weekly-row__value">{{item.count}} 次</text>
        </view>
      </view>
      <text wx:else class="weekly-text weekly-text--muted">本周记录较少，可以先从记录一次具体亲子互动开始。</text>
    </view>

    <view class="weekly-next">
      <text class="weekly-next__kicker">下周可以继续的一小步</text>
      <text class="weekly-next__text">{{report.next_week_suggestion}}</text>
    </view>

    <text class="p3-footnote">这份复盘只用于自己回看，不是诊断或评价。</text>

    <view class="weekly-actions">
      <button class="p3-btn p3-btn--secondary" bindtap="refreshReport">刷新复盘</button>
      <button class="p3-btn p3-btn--quiet" bindtap="goHome">回到首页</button>
    </view>
  </block>
</view>
