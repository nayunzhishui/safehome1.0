<view class="safe-page weekly-page" role="main" aria-label="本周复盘">
  <view class="weekly-hero">
    <view class="hero-copy">
      <text class="hero-title">本周复盘</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="state-card safe-card">
    <view class="loading-dot"></view>
    <text class="state-title">正在整理本周复盘</text>
  </view>

  <view wx:elif="{{errorMessage}}" class="state-card error-card">
    <text class="state-title">周报暂时没有加载成功</text>
    <text class="state-text">{{errorMessage}}</text>
    <button class="outline-button" bindtap="refreshReport">重新加载</button>
  </view>

  <view wx:else class="weekly-content">
    <view class="profile-card">
      <text class="profile-title">阶段性画像线索</text>
      <text class="profile-text">
        {{report.profile_trend && report.profile_trend.profile_count ? '本周画像可作为理解近期压力状态的补充线索，不代表固定判断。' : '本周还没有阶段性画像线索，也不影响你继续记录和练习。'}}
      </text>
      <text wx:if="{{profileTrendNamesText}}" class="profile-meta">{{profileTrendNamesText}}</text>
      <text wx:if="{{report.profile_trend && report.profile_trend.requires_review_count}}" class="profile-meta">有内容需要人工关注，请优先等待或提交人工支持。</text>
    </view>

    <view class="change-card safe-card">
      <text class="change-label">本周小变化</text>
      <text class="change-title">{{report.week_start}} 至 {{report.week_end}}</text>
      <text class="change-text">{{report.next_week_suggestion}}</text>
    </view>

    <view class="stats-grid">
      <view class="stat-card">
        <text class="stat-value">{{frequentScenes.length}}</text>
        <text class="stat-label">类常见场景</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{frequentEmotions.length}}</text>
        <text class="stat-label">类常见情绪</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{commonPatterns.length}}</text>
        <text class="stat-label">条互动线索</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{completedCardsText ? '已记' : '待记'}}</text>
        <text class="stat-label">练习尝试</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{report.assessment_trend ? report.assessment_trend.assessment_count : 0}}</text>
        <text class="stat-label">测评记录</text>
      </view>
      <view class="stat-card">
        <text class="stat-value">{{report.thermometer_trend ? report.thermometer_trend.record_count : 0}}</text>
        <text class="stat-label">温度记录</text>
      </view>
    </view>

    <view class="review-section">
      <view class="section-head">
        <text class="section-title">本周测评记录</text>
        <text class="section-hint">只整理你完成过的测评，不做固定判断</text>
      </view>
      <view class="review-card">
        <text wx:if="{{assessmentNamesText}}" class="row-desc">{{assessmentNamesText}}</text>
        <text wx:else class="muted">本周还没有测评记录。</text>
        <view wx:if="{{dimensionGroups.length}}" class="dimension-group-list">
          <view wx:for="{{dimensionGroups}}" wx:key="worksheetId" wx:for-item="group" class="dimension-group">
            <text class="dimension-group-title">{{group.worksheetTitle}}</text>
            <view wx:for="{{group.dimensions}}" wx:key="key" class="dimension-change-row">
              <text class="row-name">{{item.label}}</text>
              <text class="row-count">{{item.direction}} {{item.deltaText}}</text>
            </view>
          </view>
        </view>
        <text wx:if="{{recommendedCardsText}}" class="row-desc">推荐训练：{{recommendedCardsText}}</text>
      </view>
    </view>

    <view class="review-section">
      <view class="section-head">
        <text class="section-title">情绪温度趋势</text>
      </view>
      <view class="review-card">
        <text class="row-desc">{{report.thermometer_trend ? report.thermometer_trend.trend_text : '本周还没有情绪温度记录。'}}</text>
        <text class="row-desc">{{thermometerDetailText}}</text>
      </view>
    </view>

    <view class="review-section">
      <view class="section-head">
        <text class="section-title">训练效用线索</text>
        <text class="section-hint">只看练习前后记录，不承诺疗效</text>
      </view>
      <view class="review-card">
        <text class="row-desc">{{trainingEffectivenessText}}</text>
      </view>
    </view>

    <view class="review-section">
      <view class="section-head">
        <text class="section-title">本周高频场景</text>
        <text class="section-hint">只看重复出现的位置，不判断好坏</text>
      </view>
      <view class="review-card">
        <block wx:if="{{frequentScenes.length}}">
          <view wx:for="{{frequentScenes}}" wx:key="name" class="list-row">
            <text class="row-name">{{item.name}}</text>
            <text class="row-count">{{item.count}} 次</text>
          </view>
        </block>
        <text wx:else class="muted">本周记录较少，可以先从记录一次具体亲子互动开始。</text>
      </view>
    </view>

    <view class="review-section">
      <view class="section-head">
        <text class="section-title">本周常见情绪</text>
      </view>
      <view class="review-card">
        <block wx:if="{{frequentEmotions.length}}">
          <view wx:for="{{frequentEmotions}}" wx:key="name" class="list-row">
            <text class="row-name">{{item.name}}</text>
            <text class="row-count">{{item.count}} 次</text>
          </view>
        </block>
        <text wx:else class="muted">暂时还没有足够记录形成情绪复盘。</text>
      </view>
    </view>

    <view class="review-section">
      <view class="section-head">
        <text class="section-title">互动线索</text>
        <text class="section-hint">这些只是本周记录里可以继续观察的地方</text>
      </view>
      <view class="review-card">
        <block wx:if="{{commonPatterns.length}}">
          <view wx:for="{{commonPatterns}}" wx:key="name" class="list-row">
            <text class="row-name">{{item.name}}</text>
            <text class="row-count">{{item.count}} 次</text>
          </view>
        </block>
        <text wx:else class="muted">暂时还没有明显重复线索，可以继续积累记录。</text>
      </view>
    </view>

    <view class="practice-card">
      <text class="practice-title">已记录练习卡</text>
      <text class="practice-text">{{completedCardsText || '本周还没有练习尝试记录。可以先选择一张容易练的训练卡。'}}</text>
    </view>

    <view class="next-step-card">
      <text class="next-title">下周可以继续的一小步</text>
      <text class="next-text">{{report.next_week_suggestion}}</text>
    </view>

    <view class="action-area">
      <button class="primary-button" bindtap="refreshReport">刷新复盘</button>
      <button class="secondary-button" bindtap="goHome">回到首页</button>
    </view>
  </view>
</view>
