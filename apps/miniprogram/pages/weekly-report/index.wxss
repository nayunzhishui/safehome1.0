.weekly-page {
  padding-bottom: calc(52rpx + env(safe-area-inset-bottom));
}

.weekly-hero {
  position: relative;
  min-height: 300rpx;
  overflow: hidden;
}

.hero-copy {
  position: relative;
  z-index: 1;
  max-width: 480rpx;
}

.hero-kicker,
.hero-title,
.hero-summary,
.state-title,
.state-text,
.notice-title,
.notice-text,
.change-label,
.change-title,
.change-text,
.stat-value,
.stat-label,
.section-title,
.section-hint,
.row-name,
.row-count,
.muted,
.practice-title,
.practice-text,
.next-title,
.next-text {
  display: block;
}

.hero-kicker {
  margin-bottom: 10rpx;
  color: var(--safe-primary);
  font-size: 24rpx;
  font-weight: 800;
}

.hero-title {
  color: var(--safe-title);
  font-size: 42rpx;
  font-weight: 850;
  line-height: 1.28;
  letter-spacing: 0;
}

.hero-summary {
  margin-top: 16rpx;
  color: var(--safe-text);
  font-size: 28rpx;
  line-height: 1.7;
}

.hero-image {
  position: absolute;
  right: -20rpx;
  bottom: -18rpx;
  width: 250rpx;
  height: 220rpx;
  border-radius: var(--safe-radius-lg);
  opacity: 0.88;
}

.weekly-content {
  display: flex;
  flex-direction: column;
}

.state-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-top: 32rpx;
}

.loading-dot {
  width: 34rpx;
  height: 34rpx;
  margin-bottom: 18rpx;
  border: 6rpx solid var(--safe-primary-soft);
  border-top-color: var(--safe-primary);
  border-radius: 50%;
}

.state-title {
  color: var(--safe-title);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.45;
}

.state-text {
  margin-top: 10rpx;
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.65;
}

.error-card {
  border-color: rgba(215, 111, 103, 0.3);
  background: rgba(255, 244, 240, 0.94);
  box-shadow: none;
}

.outline-button {
  min-height: 72rpx;
  margin-top: 24rpx;
  padding: 0 30rpx;
  border: 1rpx solid var(--safe-orange);
  border-radius: var(--safe-radius-pill);
  background: var(--safe-card);
  color: var(--safe-orange);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 72rpx;
}

.outline-button::after {
  border: 0;
}

.notice-card {
  margin-top: 32rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid rgba(87, 139, 95, 0.18);
  border-radius: var(--safe-radius-md);
  background: rgba(233, 242, 223, 0.72);
}

.notice-title {
  margin-bottom: 8rpx;
  color: var(--safe-primary-deep);
  font-size: 26rpx;
  font-weight: 900;
}

.notice-text {
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.7;
}

.change-card {
  margin-top: 28rpx;
}

.change-label {
  color: var(--safe-primary);
  font-size: 24rpx;
  font-weight: 900;
}

.change-title {
  margin-top: 10rpx;
  color: var(--safe-title);
  font-size: 34rpx;
  font-weight: 850;
  line-height: 1.35;
}

.change-text {
  margin-top: 12rpx;
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.75;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 28rpx;
}

.stat-card {
  min-height: 132rpx;
  padding: 24rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: var(--safe-card);
  box-shadow: var(--safe-shadow-card);
}

.stat-value {
  color: var(--safe-primary-deep);
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.15;
}

.stat-label {
  margin-top: 10rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.45;
}

.review-section {
  margin-top: 40rpx;
}

.section-head {
  margin-bottom: 18rpx;
}

.section-title {
  color: var(--safe-title);
  font-size: 32rpx;
  font-weight: 850;
  line-height: 1.35;
}

.section-hint {
  margin-top: 6rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.55;
}

.review-card,
.practice-card,
.next-step-card {
  padding: 28rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: var(--safe-card);
  box-shadow: var(--safe-shadow-card);
}

.list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid var(--safe-border);
}

.list-row:first-of-type {
  border-top: 0;
  padding-top: 0;
}

.list-row:last-child {
  padding-bottom: 0;
}

.row-name {
  min-width: 0;
  color: var(--safe-title);
  font-size: 28rpx;
  line-height: 1.5;
}

.row-count {
  flex: 0 0 auto;
  color: var(--safe-primary);
  font-size: 26rpx;
  font-weight: 800;
}

.muted {
  color: var(--safe-muted);
  font-size: 26rpx;
  line-height: 1.7;
}

.practice-card {
  margin-top: 40rpx;
  background: var(--safe-bg-leaf);
}

.practice-title,
.next-title {
  color: var(--safe-title);
  font-size: 30rpx;
  font-weight: 850;
  line-height: 1.4;
}

.practice-text,
.next-text {
  margin-top: 10rpx;
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.75;
}

.next-step-card {
  margin-top: 24rpx;
  border-color: rgba(244, 127, 69, 0.22);
  background: var(--safe-orange-soft);
}

.action-area {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 32rpx;
}

.primary-button,
.secondary-button {
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  border-radius: var(--safe-radius-pill);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 88rpx;
}

.primary-button {
  background: linear-gradient(135deg, var(--safe-primary), var(--safe-primary-deep));
  color: #ffffff;
  box-shadow: 0 14rpx 28rpx rgba(87, 139, 95, 0.24);
}

.secondary-button {
  border: 1rpx solid rgba(244, 127, 69, 0.34);
  background: var(--safe-card);
  color: var(--safe-orange);
}

.primary-button::after,
.secondary-button::after {
  border: 0;
}
