.weekly-page {
  padding-bottom: calc(52rpx + env(safe-area-inset-bottom));
}

.weekly-hero {
  position: relative;
  overflow: hidden;
  padding: 8rpx 0 16rpx;
  text-align: center;
}

.hero-copy {
  position: relative;
  z-index: 1;
  max-width: none;
}

.hero-kicker,
.hero-title,
.hero-summary,
.state-title,
.state-text,
.notice-title,
.notice-text,
.profile-title,
.profile-text,
.profile-meta,
.change-label,
.change-title,
.change-text,
.stat-value,
.stat-label,
.section-title,
.section-hint,
.row-name,
.row-count,
.muted,
.practice-title,
.practice-text,
.next-title,
.next-text {
  display: block;
}

.hero-kicker {
  margin-bottom: 10rpx;
  color: var(--safe-primary);
  font-size: 24rpx;
  font-weight: 800;
}

.hero-title {
  color: var(--safe-title);
  font-size: 46rpx;
  font-weight: 850;
  line-height: 1.28;
  letter-spacing: 0;
}

.hero-summary {
  margin-top: 16rpx;
  color: var(--safe-text);
  font-size: 28rpx;
  line-height: 1.7;
}

.weekly-content {
  display: flex;
  flex-direction: column;
}

.state-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-top: 32rpx;
}

.loading-dot {
  width: 34rpx;
  height: 34rpx;
  margin-bottom: 18rpx;
  border: 6rpx solid var(--safe-primary-soft);
  border-top-color: var(--safe-primary);
  border-radius: 50%;
}

.state-title {
  color: var(--safe-title);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.45;
}

.state-text {
  margin-top: 10rpx;
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.65;
}

.error-card {
  border-color: rgba(215, 111, 103, 0.3);
  background: rgba(255, 244, 240, 0.94);
  box-shadow: none;
}

.outline-button {
  min-height: 72rpx;
  margin-top: 24rpx;
  padding: 0 30rpx;
  border: 1rpx solid var(--safe-orange);
  border-radius: var(--safe-radius-pill);
  background: var(--safe-card);
  color: var(--safe-orange);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 72rpx;
}

.outline-button::after {
  border: 0;
}

.notice-card {
  margin-top: 32rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid rgba(87, 139, 95, 0.18);
  border-radius: var(--safe-radius-md);
  background: rgba(233, 242, 223, 0.72);
}

.profile-card {
  margin-top: 20rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid rgba(244, 127, 69, 0.2);
  border-radius: var(--safe-radius-md);
  background: rgba(255, 245, 235, 0.82);
}

.profile-title {
  margin-bottom: 8rpx;
  color: var(--safe-orange);
  font-size: 26rpx;
  font-weight: 900;
}

.profile-text,
.profile-meta {
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.7;
}

.profile-meta {
  margin-top: 8rpx;
  color: var(--safe-muted);
}

.notice-title {
  margin-bottom: 8rpx;
  color: var(--safe-primary-deep);
  font-size: 26rpx;
  font-weight: 900;
}

.notice-text {
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.7;
}

.change-card {
  margin-top: 28rpx;
}

.change-label {
  color: var(--safe-primary);
  font-size: 24rpx;
  font-weight: 900;
}

.change-title {
  margin-top: 10rpx;
  color: var(--safe-title);
  font-size: 34rpx;
  font-weight: 850;
  line-height: 1.35;
}

.change-text {
  margin-top: 12rpx;
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.75;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 28rpx;
}

.stat-card {
  min-height: 132rpx;
  padding: 24rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: var(--safe-card);
  box-shadow: var(--safe-shadow-card);
}

.stat-value {
  color: var(--safe-primary-deep);
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.15;
}

.stat-label {
  margin-top: 10rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.45;
}

.review-section {
  margin-top: 40rpx;
}

.section-head {
  margin-bottom: 18rpx;
}

.section-title {
  color: var(--safe-title);
  font-size: 32rpx;
  font-weight: 850;
  line-height: 1.35;
}

.section-hint {
  margin-top: 6rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.55;
}

.review-card,
.practice-card,
.next-step-card {
  padding: 28rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: var(--safe-card);
  box-shadow: var(--safe-shadow-card);
}

.list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid var(--safe-border);
}

.list-row:first-of-type {
  border-top: 0;
  padding-top: 0;
}

.list-row:last-child {
  padding-bottom: 0;
}

.dimension-group-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 14rpx;
}

.dimension-group {
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-sm);
  background: var(--safe-bg-leaf);
}

.dimension-group-title {
  display: block;
  color: var(--safe-title);
  font-size: 26rpx;
  font-weight: 850;
  line-height: 1.55;
  overflow-wrap: anywhere;
}

.dimension-change-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid var(--safe-border);
}

.dimension-change-row:first-of-type {
  margin-top: 10rpx;
}

.row-name {
  min-width: 0;
  color: var(--safe-title);
  font-size: 28rpx;
  line-height: 1.5;
}

.row-desc {
  display: block;
  margin-top: 6rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.55;
}

.row-count {
  flex: 0 0 auto;
  color: var(--safe-primary);
  font-size: 26rpx;
  font-weight: 800;
}

.muted {
  color: var(--safe-muted);
  font-size: 26rpx;
  line-height: 1.7;
}

.practice-card {
  margin-top: 40rpx;
  background: var(--safe-bg-leaf);
}

.practice-title,
.next-title {
  color: var(--safe-title);
  font-size: 30rpx;
  font-weight: 850;
  line-height: 1.4;
}

.practice-text,
.next-text {
  margin-top: 10rpx;
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.75;
}

.next-step-card {
  margin-top: 24rpx;
  border-color: rgba(244, 127, 69, 0.22);
  background: var(--safe-orange-soft);
}

.action-area {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 32rpx;
}

.primary-button,
.secondary-button {
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  border-radius: var(--safe-radius-pill);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 88rpx;
}

.primary-button {
  background: var(--safe-primary);
  color: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(87, 139, 95, 0.18);
}

.secondary-button {
  border: 1rpx solid rgba(244, 127, 69, 0.34);
  background: var(--safe-card);
  color: var(--safe-orange);
}

.primary-button::after,
.secondary-button::after {
  border: 0;
}

/* UIproduct2: task-scoped visual refinement, no business behavior. */
.ui2-page { --ui2-section-accent-display:none; --safe-shadow-card:none; --safe-shadow-float:none; box-sizing:border-box; background:var(--ui2-canvas); padding:48rpx 40rpx calc(64rpx + env(safe-area-inset-bottom)); }
.ui2-page .page-title,.ui2-page .hero-title,.ui2-page .history-title,.ui2-page .result-title { font-size:44rpx; line-height:1.6; font-weight:700; text-align:center; color:var(--ui2-ink); }
.ui2-page .safe-primary-button,.ui2-page .safe-outline-button { min-height:96rpx; padding:22rpx 24rpx; border-radius:24rpx; font-size:30rpx; line-height:1.6; box-shadow:none; }
.ui2-page .ui2-placeholder { color:var(--ui2-muted); }
.ui2-page .weekly-hero { padding:0 0 32rpx; }
.ui2-page .profile-card,.ui2-page .change-card,.ui2-page .review-card,.ui2-page .practice-card { padding:24rpx 0; border:0; border-bottom:1rpx solid var(--ui2-line); border-radius:0; background:transparent; box-shadow:none; }
.ui2-page .profile-title,.ui2-page .section-title,.ui2-page .practice-title,.ui2-page .next-title { font-size:32rpx; line-height:1.6; font-weight:700; }
.ui2-page .profile-text,.ui2-page .row-desc,.ui2-page .row-name,.ui2-page .practice-text,.ui2-page .next-text,.ui2-page .muted { font-size:30rpx; line-height:1.7; }
.ui2-page .profile-meta,.ui2-page .section-hint,.ui2-page .change-label { font-size:28rpx; line-height:1.7; }
.ui2-page .change-title { font-size:28rpx; line-height:1.6; }
.ui2-page .stats-grid { grid-template-columns:repeat(2,minmax(0,1fr)); gap:0 24rpx; }
.ui2-page .stat-card { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:12rpx; padding:24rpx 0; border:0; border-bottom:1rpx solid var(--ui2-line); border-radius:0; background:transparent; text-align:left; box-shadow:none; }
.ui2-page .stat-value { font-size:30rpx; font-weight:700; line-height:1.6; order:2; }
.ui2-page .stat-label { font-size:26rpx; margin:0; }
.ui2-page .dimension-group { padding:24rpx 0; border:0; border-bottom:1rpx solid var(--ui2-line); background:transparent; }
.ui2-page .dimension-group-title { font-size:30rpx; line-height:1.6; }
.ui2-page .list-row,.ui2-page .dimension-change-row { flex-wrap:wrap; gap:16rpx; }
.ui2-page .row-count { font-size:28rpx; }
.ui2-page .next-step-card { padding:28rpx; border:0; border-radius:24rpx; background:var(--ui2-soft); }
.ui2-page .primary-button,.ui2-page .secondary-button,.ui2-page .outline-button { min-height:96rpx; padding:22rpx 24rpx; border-radius:24rpx; font-size:30rpx; line-height:1.6; }
.ui2-page .primary-button { background:var(--ui2-primary); color:white; }
.ui2-page .secondary-button { background:transparent; border:2rpx solid var(--ui2-control-border); color:var(--ui2-primary); }
.ui2-page .state-title { font-size:32rpx; }
.ui2-page .state-text { font-size:30rpx; line-height:1.7; }

.ui2-page .profile-title { color:var(--ui2-ink); }
.ui2-page .primary-button { box-shadow:none; }
