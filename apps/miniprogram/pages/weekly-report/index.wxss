/* 本周复盘（Figma 648:1333）：记录范围；数字格直接展示计数；近 7 天阶段反馈；分区列表；“下周可以继续的一小步”浅青瓷；无实心按钮。 */
page {
  background: var(--p3-paper);
}

.weekly-page {
  display: flex;
  flex-direction: column;
  gap: var(--p3-section);
  box-sizing: border-box;
  min-height: 100vh;
  padding: 16rpx var(--p3-page-x) calc(72rpx + env(safe-area-inset-bottom));
  background: var(--p3-paper);
  overflow-x: hidden;
}

.weekly-range {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.weekly-range__label {
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

.weekly-range__value {
  color: var(--p3-ink);
  font-family: var(--p3-font-serif);
  font-size: 48rpx;
  line-height: 64rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

/* 数据格（Figma 646:974）：三个一行等宽，宋体数字 + 一行说明。 */
.weekly-cells {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--p3-stack);
}

.weekly-cell {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
  padding: 28rpx;
  border-radius: var(--p3-radius-group);
  background: var(--p3-surface);
}

.weekly-cell__value {
  color: var(--p3-ink);
  font-family: var(--p3-font-serif);
  font-size: 48rpx;
  line-height: 64rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  white-space: nowrap;
}

.weekly-cell__label {
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

.weekly-section {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
  min-width: 0;
}

.weekly-progress {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--p3-tight);
  padding: 32rpx;
  border-radius: var(--p3-radius-group);
  background: var(--p3-surface);
}

.weekly-progress__summary {
  color: var(--p3-ink);
  font-size: 30rpx;
  line-height: 52rpx;
}

.weekly-progress__next {
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

.weekly-group {
  padding: 8rpx 32rpx;
}

.weekly-assessment {
  display: flex;
  flex-direction: column;
  padding-top: 16rpx;
}

.weekly-assessment__title {
  color: var(--p3-ink);
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: 500;
}

.weekly-row {
  display: flex;
  align-items: center;
  gap: var(--p3-tight);
  padding: 22rpx 0;
}

.weekly-row--divided {
  box-shadow: inset 0 -2rpx 0 var(--p3-hairline);
}

.weekly-row__name {
  flex: 1 0 0;
  min-width: 0;
  color: var(--p3-ink);
  font-size: 28rpx;
  line-height: 44rpx;
}

.weekly-row__value {
  flex: 0 0 auto;
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
  white-space: nowrap;
}

.weekly-group__text {
  display: block;
  padding: 22rpx 0;
  color: var(--p3-ink);
  font-size: 28rpx;
  line-height: 44rpx;
}

.weekly-group__text--muted {
  color: var(--p3-muted);
}

.weekly-group__note {
  display: block;
  padding: 0 0 22rpx;
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

.weekly-text {
  display: block;
  color: var(--p3-ink);
  font-size: 28rpx;
  line-height: 44rpx;
}

.weekly-text--muted {
  color: var(--p3-muted);
}

.weekly-next {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
  padding: var(--p3-card);
  border-radius: var(--p3-radius-card);
  background: var(--p3-soft);
}

.weekly-next__kicker {
  color: var(--p3-primary);
  font-size: 26rpx;
  line-height: 40rpx;
}

.weekly-next__text {
  color: var(--p3-ink);
  font-size: 40rpx;
  line-height: 56rpx;
  font-weight: 500;
}

.weekly-actions {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
}
