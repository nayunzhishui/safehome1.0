.page {
  min-height: 100vh;
  padding: 32rpx;
  background: #fff7f0;
}

.panel {
  padding: 32rpx;
  border: 1rpx solid #dce6db;
  border-radius: 24rpx;
  background: #ffffff;
}

.eyebrow {
  display: block;
  margin-bottom: 12rpx;
  color: #3c7a49;
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  display: block;
  margin-bottom: 24rpx;
  color: #1d2b22;
  font-size: 46rpx;
  font-weight: 700;
  text-align: center;
}

.section {
  margin-bottom: 24rpx;
  padding: 20rpx;
  border: 1rpx solid #e1eadf;
  border-radius: 18rpx;
  background: #f7faf6;
}

.section-title {
  display: block;
  margin-bottom: 10rpx;
  color: #1d2b22;
  font-size: 28rpx;
  font-weight: 700;
}

.line,
.pre {
  display: block;
  color: #526258;
  font-size: 24rpx;
  line-height: 1.55;
  word-break: break-all;
  white-space: pre-wrap;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.primary-button,
.secondary-button {
  width: 100%;
  border-radius: 999rpx;
  font-size: 28rpx;
}

.primary-button {
  background: #2f7d45;
  color: #ffffff;
}

.secondary-button {
  border: 1rpx solid #b8d2c0;
  background: #ffffff;
  color: #2f7d45;
}

.status,
.error-card {
  margin-top: 20rpx;
  padding: 20rpx;
  border: 1rpx solid #dce6db;
  border-radius: 8rpx;
  background: #eef3ed;
}

.status.success {
  background: #edf8ee;
  border-color: #b8dfbe;
}

.status.error,
.error-card {
  background: #fff1f1;
  border-color: #efb4b4;
}
