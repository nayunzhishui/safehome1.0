.page {
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: var(--safe-bg);
}

.hero {
  margin-bottom: 28rpx;
  padding: 8rpx 0 4rpx;
  text-align: center;
}

.eyebrow {
  display: block;
  margin-bottom: 10rpx;
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  display: block;
  color: var(--safe-title);
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.32;
}

.summary {
  display: block;
  color: var(--safe-text);
  font-size: 28rpx;
  line-height: 1.7;
}

.panel {
  padding: 32rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: #ffffff;
  box-shadow: var(--safe-shadow-card);
}

.selected-card {
  margin-bottom: 30rpx;
  padding: 24rpx;
  border: 1rpx solid #efe7dc;
  border-radius: 20rpx;
  background: #fffdf9;
}

.tip-box {
  margin-bottom: 28rpx;
  padding: 22rpx;
  border: 1rpx solid #dbeed6;
  border-radius: 20rpx;
  background: #eef8e9;
}

.tip-title {
  display: block;
  margin-bottom: 8rpx;
  color: #4caf7d;
  font-size: 28rpx;
  font-weight: 700;
}

.tip-text {
  display: block;
  color: #555555;
  font-size: 26rpx;
  line-height: 1.7;
}

.meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.meta-pill {
  display: inline-block;
  padding: 8rpx 16rpx;
  border: 1rpx solid #dbeed6;
  border-radius: 999rpx;
  background: #ffffff;
  color: #4caf7d;
  font-size: 24rpx;
  line-height: 1.4;
}

.field {
  margin-bottom: 28rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  color: #333333;
  font-size: 28rpx;
  font-weight: 700;
}

.card-title {
  display: block;
  color: #4caf7d;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.5;
}

.textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 150rpx;
  padding: 20rpx;
  border: 1rpx solid #e9e3d8;
  border-radius: 18rpx;
  background: #fffdf9;
  color: #333333;
  font-size: 28rpx;
  line-height: 1.6;
}

.helpfulness-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.helpfulness-chip {
  min-height: 64rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 1rpx solid #e9e3d8;
  border-radius: 999rpx;
  background: #fffdf9;
  color: #555555;
  font-size: 25rpx;
  line-height: 64rpx;
}

.helpfulness-chip--active {
  border-color: var(--safe-primary);
  background: var(--safe-primary-pale);
  color: var(--safe-primary-deep);
}

.helpfulness-chip::after {
  border: 0;
}

.pause-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 76rpx;
  padding: 0 20rpx;
  border: 1rpx solid #e9e3d8;
  border-radius: 18rpx;
  background: #fffdf9;
  color: #333333;
  font-size: 26rpx;
}

.reflection-prompts {
  margin-bottom: 16rpx;
  padding: 18rpx;
  border: 1rpx solid #dbeed6;
  border-radius: 18rpx;
  background: #f7fbf4;
}

.prompt-title,
.prompt-item {
  display: block;
  color: #555555;
  font-size: 26rpx;
  line-height: 1.7;
}

.prompt-title {
  margin-bottom: 6rpx;
  color: #333333;
  font-weight: 700;
}

.status {
  margin-bottom: 24rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.status.success {
  border: 1rpx solid #b8dfbe;
  background: #edf8ee;
  color: #1d2b22;
}

.status.error {
  border: 1rpx solid #efb4b4;
  background: #fff1f1;
  color: #8a2f2f;
}

.primary-button {
  min-height: 88rpx;
  margin-top: 8rpx;
  border-radius: var(--safe-radius-pill);
  background: var(--safe-primary);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 18rpx rgba(87, 139, 95, 0.18);
}

.secondary-button {
  min-height: 88rpx;
  margin-top: 20rpx;
  border: 1rpx solid #ffb26b;
  border-radius: 44rpx;
  background: #ffffff;
  color: #f28b38;
  font-size: 28rpx;
  font-weight: 700;
}

/* UIproduct2: task-scoped visual refinement, no business behavior. */
.ui2-page { --ui2-section-accent-display:none; --safe-shadow-card:none; --safe-shadow-float:none; box-sizing:border-box; background:var(--ui2-canvas); padding:48rpx 40rpx calc(64rpx + env(safe-area-inset-bottom)); }
.ui2-page .page-title,.ui2-page .hero-title,.ui2-page .history-title,.ui2-page .result-title { font-size:44rpx; line-height:1.6; font-weight:700; text-align:center; color:var(--ui2-ink); }
.ui2-page .safe-primary-button,.ui2-page .safe-outline-button { min-height:96rpx; padding:22rpx 24rpx; border-radius:24rpx; font-size:30rpx; line-height:1.6; box-shadow:none; }
.ui2-page .ui2-placeholder { color:var(--ui2-muted); }
.ui2-page.page { min-height:100vh; }
.ui2-page .hero { padding:0 0 32rpx; text-align:center; }
.ui2-page .title { display:block; font-size:44rpx; line-height:1.6; font-weight:700; color:var(--ui2-ink); }
.ui2-page .panel { padding:0; border:0; background:transparent; box-shadow:none; }
.ui2-page .tip-box { padding:20rpx 0; background:transparent; border:0; }
.ui2-page .tip-text,.ui2-page .prompt-item { font-size:30rpx; line-height:1.7; color:var(--ui2-muted); }
.ui2-page .selected-card { padding:28rpx; border:0; border-radius:24rpx; background:var(--ui2-soft); }
.ui2-page .card-title { font-size:32rpx; line-height:1.6; color:var(--ui2-ink); }
.ui2-page .field { margin-top:32rpx; padding:24rpx 0; border-bottom:1rpx solid var(--ui2-line); }
.ui2-page .label { font-size:30rpx; line-height:1.7; color:var(--ui2-ink); }
.ui2-page .helpfulness-row { display:flex; flex-wrap:wrap; gap:16rpx; }
.ui2-page .helpfulness-chip { min-height:96rpx; padding:20rpx 24rpx; border:2rpx solid var(--ui2-control-border); border-radius:24rpx; background:transparent; font-size:30rpx; line-height:1.6; color:var(--ui2-primary); }
.ui2-page .helpfulness-chip--active { background:var(--ui2-soft); border-bottom-width:6rpx; }
.ui2-page .pause-input,.ui2-page .textarea { box-sizing:border-box; width:100%; min-height:104rpx; padding:24rpx; border:2rpx solid var(--ui2-control-border); border-radius:24rpx; background:var(--ui2-surface); font-size:30rpx; line-height:1.7; color:var(--ui2-ink); }
.ui2-page .textarea { min-height:240rpx; }
.ui2-page .primary-button,.ui2-page .secondary-button { width:100%; min-height:96rpx; padding:22rpx 24rpx; border-radius:24rpx; font-size:30rpx; line-height:1.6; }
.ui2-page .primary-button { background:var(--ui2-primary); color:white; }
.ui2-page .primary-button[disabled] { background:var(--ui2-soft); color:var(--ui2-muted); opacity:1; }
.ui2-page .secondary-button { background:transparent; border:2rpx solid var(--ui2-control-border); color:var(--ui2-primary); }
.ui2-page .status { font-size:30rpx; line-height:1.7; }
.ui2-page .draft-status { font-size:26rpx; }
.ui2-page .draft-status--slow { font-size:28rpx; }

.ui2-page .primary-button { box-shadow:none; }
.ui2-page .reflection-prompts { border:0; background:transparent; padding:0; }
