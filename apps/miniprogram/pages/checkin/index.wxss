.page {
  min-height: 100vh;
  padding: 32rpx;
  background: #f6f8f4;
}

.hero {
  padding: 20rpx 4rpx 28rpx;
}

.eyebrow {
  display: block;
  margin-bottom: 10rpx;
  color: #3c7a49;
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  display: block;
  margin-bottom: 14rpx;
  color: #1d2b22;
  font-size: 40rpx;
  font-weight: 700;
}

.summary {
  display: block;
  color: #5b6b60;
  font-size: 28rpx;
  line-height: 1.7;
}

.panel {
  padding: 32rpx;
  border: 1rpx solid #dce6db;
  border-radius: 8rpx;
  background: #ffffff;
}

.selected-card {
  margin-bottom: 30rpx;
  padding: 24rpx;
  border: 1rpx solid #dce6db;
  border-radius: 8rpx;
  background: #f9fbf8;
}

.tip-box {
  margin-bottom: 28rpx;
  padding: 22rpx;
  border: 1rpx solid #cfe1cf;
  border-radius: 8rpx;
  background: #edf8ee;
}

.tip-title {
  display: block;
  margin-bottom: 8rpx;
  color: #245b34;
  font-size: 28rpx;
  font-weight: 700;
}

.tip-text {
  display: block;
  color: #466650;
  font-size: 26rpx;
  line-height: 1.7;
}

.meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.meta-pill {
  display: inline-block;
  padding: 8rpx 16rpx;
  border: 1rpx solid #cfe1cf;
  border-radius: 8rpx;
  background: #ffffff;
  color: #2f7d45;
  font-size: 24rpx;
  line-height: 1.4;
}

.field {
  margin-bottom: 28rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  color: #1d2b22;
  font-size: 28rpx;
  font-weight: 700;
}

.card-title {
  display: block;
  color: #2f7d45;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.5;
}

.textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 150rpx;
  padding: 20rpx;
  border: 1rpx solid #dce6db;
  border-radius: 8rpx;
  background: #f9fbf8;
  color: #1d2b22;
  font-size: 28rpx;
  line-height: 1.6;
}

.status {
  margin-bottom: 24rpx;
  padding: 20rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.status.success {
  border: 1rpx solid #b8dfbe;
  background: #edf8ee;
  color: #1d2b22;
}

.status.error {
  border: 1rpx solid #efb4b4;
  background: #fff1f1;
  color: #8a2f2f;
}

.primary-button {
  margin-top: 8rpx;
  background: #2f7d45;
  color: #ffffff;
  border-radius: 8rpx;
}

.secondary-button {
  margin-top: 20rpx;
  border: 1rpx solid #c9d9c8;
  background: #eef3ed;
  color: #2f7d45;
  border-radius: 8rpx;
}
