.page {
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: var(--safe-bg);
}

.hero {
  margin-bottom: 28rpx;
  padding: 32rpx;
  border: 1rpx solid var(--safe-border);
  border-left: 8rpx solid var(--safe-primary);
  border-radius: var(--safe-radius-md);
  background: var(--safe-card);
  box-shadow: var(--safe-shadow-card);
}

.eyebrow {
  display: block;
  margin-bottom: 10rpx;
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  display: block;
  margin-bottom: 14rpx;
  color: var(--safe-title);
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.32;
}

.summary {
  display: block;
  color: var(--safe-text);
  font-size: 28rpx;
  line-height: 1.7;
}

.panel {
  padding: 32rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: #ffffff;
  box-shadow: var(--safe-shadow-card);
}

.selected-card {
  margin-bottom: 30rpx;
  padding: 24rpx;
  border: 1rpx solid #efe7dc;
  border-radius: 20rpx;
  background: #fffdf9;
}

.tip-box {
  margin-bottom: 28rpx;
  padding: 22rpx;
  border: 1rpx solid #dbeed6;
  border-radius: 20rpx;
  background: #eef8e9;
}

.tip-title {
  display: block;
  margin-bottom: 8rpx;
  color: #4caf7d;
  font-size: 28rpx;
  font-weight: 700;
}

.tip-text {
  display: block;
  color: #555555;
  font-size: 26rpx;
  line-height: 1.7;
}

.meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 18rpx;
}

.meta-pill {
  display: inline-block;
  padding: 8rpx 16rpx;
  border: 1rpx solid #dbeed6;
  border-radius: 999rpx;
  background: #ffffff;
  color: #4caf7d;
  font-size: 24rpx;
  line-height: 1.4;
}

.field {
  margin-bottom: 28rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  color: #333333;
  font-size: 28rpx;
  font-weight: 700;
}

.card-title {
  display: block;
  color: #4caf7d;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.5;
}

.textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 150rpx;
  padding: 20rpx;
  border: 1rpx solid #e9e3d8;
  border-radius: 18rpx;
  background: #fffdf9;
  color: #333333;
  font-size: 28rpx;
  line-height: 1.6;
}

.reflection-prompts {
  margin-bottom: 16rpx;
  padding: 18rpx;
  border: 1rpx solid #dbeed6;
  border-radius: 18rpx;
  background: #f7fbf4;
}

.prompt-title,
.prompt-item {
  display: block;
  color: #555555;
  font-size: 26rpx;
  line-height: 1.7;
}

.prompt-title {
  margin-bottom: 6rpx;
  color: #333333;
  font-weight: 700;
}

.status {
  margin-bottom: 24rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.status.success {
  border: 1rpx solid #b8dfbe;
  background: #edf8ee;
  color: #1d2b22;
}

.status.error {
  border: 1rpx solid #efb4b4;
  background: #fff1f1;
  color: #8a2f2f;
}

.primary-button {
  min-height: 88rpx;
  margin-top: 8rpx;
  border-radius: var(--safe-radius-pill);
  background: var(--safe-primary);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 18rpx rgba(87, 139, 95, 0.18);
}

.secondary-button {
  min-height: 88rpx;
  margin-top: 20rpx;
  border: 1rpx solid #ffb26b;
  border-radius: 44rpx;
  background: #ffffff;
  color: #f28b38;
  font-size: 28rpx;
  font-weight: 700;
}
