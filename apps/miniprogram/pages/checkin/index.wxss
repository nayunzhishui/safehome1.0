/* 记录尝试（Figma 648:1271）：本次练习青瓷卡；练习前后 0–10 强度；帮助程度；暂停原因；练习复盘；保存后“已记录”。 */
page {
  background: var(--p3-paper);
}

.checkin-page {
  display: flex;
  flex-direction: column;
  gap: var(--p3-section);
  box-sizing: border-box;
  min-height: 100vh;
  padding: 16rpx var(--p3-page-x) calc(72rpx + env(safe-area-inset-bottom));
  background: var(--p3-paper);
  overflow-x: hidden;
}

.checkin-card {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
  padding: 32rpx 36rpx;
  border-radius: var(--p3-radius-group);
  background: var(--p3-soft);
}

.checkin-card__kicker {
  color: var(--p3-primary);
  font-size: 26rpx;
  line-height: 40rpx;
}

.checkin-card__title {
  color: var(--p3-ink);
  font-size: 40rpx;
  line-height: 56rpx;
  font-weight: 500;
  overflow-wrap: anywhere;
}

.checkin-card__body {
  color: var(--p3-muted);
  font-size: 28rpx;
  line-height: 44rpx;
}

.checkin-section {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
  min-width: 0;
}

.checkin-slider {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
}

.checkin-slider__label {
  color: var(--p3-ink);
  font-size: 28rpx;
  line-height: 44rpx;
}

.checkin-label {
  display: block;
  color: var(--p3-ink);
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: 500;
}

.checkin-chips {
  display: flex;
  flex-wrap: wrap;
  gap: var(--p3-tight);
}

.checkin-prompts {
  display: block;
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

.checkin-save {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
}

.checkin-save__status {
  display: block;
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}
