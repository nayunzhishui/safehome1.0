<view class="page">
  <view class="hero">
    <text class="eyebrow">第四步</text>
    <text class="title">记录一次尝试</text>
    <text class="summary">练完后简单复盘一下，帮助你观察练习前后的变化。</text>
  </view>

  <view class="panel">
    <view class="tip-box">
      <text class="tip-title">这是一次轻复盘</text>
      <text class="tip-text">只记录你有没有试着练一次，以及练习前后感受有没有一点变化。隔几天再练也可以，不需要评价自己做得好不好。</text>
    </view>

    <view class="selected-card">
      <text class="label">本次练习</text>
      <text class="card-title">{{cardTitle}}</text>
      <view class="meta-row">
        <text wx:if="{{cardId}}" class="meta-pill">训练卡：{{cardId}}</text>
        <text wx:if="{{diaryId}}" class="meta-pill">关联记录：{{diaryId}}</text>
      </view>
    </view>

    <view class="field">
      <text class="label">练习前情绪强度：{{emotionBefore}} / 10</text>
      <slider min="0" max="10" step="1" value="{{emotionBefore}}" activeColor="#2f7d45" bindchange="onEmotionBeforeChange" />
    </view>

    <view class="field">
      <text class="label">练习后情绪强度：{{emotionAfter}} / 10</text>
      <slider min="0" max="10" step="1" value="{{emotionAfter}}" activeColor="#2f7d45" bindchange="onEmotionAfterChange" />
    </view>

    <view class="field">
      <text class="label">这次练习对你有帮助吗？</text>
      <view class="helpfulness-row">
        <button
          wx:for="{{helpfulnessOptions}}"
          wx:key="value"
          class="helpfulness-chip {{helpfulnessRating === item.value ? 'helpfulness-chip--active' : ''}}"
          data-value="{{item.value}}"
          bindtap="chooseHelpfulness"
        >
          {{item.label}}
        </button>
      </view>
    </view>

    <view class="field">
      <text class="label">如果暂时不想完成，可以写一个原因（可选）</text>
      <input class="pause-input" value="{{skipReason}}" placeholder="例如：今天太累，先暂停一下。" bindinput="onSkipReasonInput" />
    </view>

    <view class="field">
      <text class="label">练习复盘</text>
      <view class="reflection-prompts">
        <text class="prompt-title">可以围绕这三个问题写：</text>
        <text wx:for="{{reflectionPrompts}}" wx:key="*this" class="prompt-item">{{item}}</text>
      </view>
      <textarea class="textarea" value="{{reflection}}" placeholder="例如：这次我先停了一下，说话慢了一点。下次想先从少说一句开始。" bindinput="onReflectionInput" />
    </view>

    <view wx:if="{{successMessage}}" class="status success">
      <text>{{successMessage}}</text>
    </view>

    <view wx:if="{{errorMessage}}" class="status error">
      <text>{{errorMessage}}</text>
    </view>

    <button class="primary-button" bindtap="submitCheckin" disabled="{{submitting}}">
      {{submitting ? '保存中...' : '记录这次尝试'}}
    </button>

    <button class="secondary-button" bindtap="goHome">回到首页</button>
  </view>
</view>
