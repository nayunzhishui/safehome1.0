.page-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 80rpx 48rpx calc(56rpx + env(safe-area-inset-bottom));
  background: var(--safe-bg);
  color: var(--safe-title);
}

.page-header {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 48rpx;
}

.page-kicker,
.page-title,
.page-summary,
.section-title,
.section-copy,
.message-label,
.message-content,
.citation-title,
.citation-item,
.inline-error {
  display: block;
}

.page-kicker {
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  line-height: 36rpx;
}

.page-title {
  color: var(--safe-title);
  font-size: 40rpx;
  font-weight: 600;
  line-height: 56rpx;
}

.page-summary {
  color: var(--safe-muted);
  font-size: 28rpx;
  line-height: 44rpx;
}

.boundary-note,
.unavailable,
.composer {
  box-sizing: border-box;
  border: 1rpx solid var(--safe-border);
  border-radius: 24rpx;
  background: var(--safe-card);
  box-shadow: none;
}

.boundary-note,
.unavailable {
  padding: 48rpx;
}

.section-title {
  color: var(--safe-title);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 44rpx;
}

.section-copy {
  margin-top: 24rpx;
  color: var(--safe-muted);
  font-size: 28rpx;
  line-height: 44rpx;
}

.consent-button,
.send-button {
  width: 100%;
  min-height: var(--safe-touch);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0 32rpx;
  border: 0;
  border-radius: var(--safe-radius-md);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 40rpx;
}

.consent-button {
  margin-top: 48rpx;
  background: var(--safe-orange);
  color: var(--safe-title);
}

.send-button {
  background: var(--safe-primary);
  color: var(--safe-card);
}

.consent-button[disabled],
.send-button[disabled] {
  background: #b8cbc4;
  color: rgba(255, 255, 255, 0.9);
  opacity: 1;
}

.button-pressed {
  transform: scale(0.985);
  opacity: 0.92;
}

.consent-status {
  min-height: 40rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  line-height: 36rpx;
}

.consent-check {
  width: 36rpx;
  height: 36rpx;
  flex: 0 0 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 2rpx solid var(--safe-primary);
  border-radius: 50%;
  color: var(--safe-primary);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.conversation {
  margin-top: 48rpx;
}

.message {
  padding-bottom: 32rpx;
  border-bottom: 1rpx solid var(--safe-border);
}

.message + .message {
  margin-top: 32rpx;
}

.message-label {
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  line-height: 36rpx;
}

.message-content {
  margin-top: 16rpx;
  color: var(--safe-title);
  font-size: 28rpx;
  line-height: 44rpx;
  white-space: pre-wrap;
  word-break: break-word;
}

.citations {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--safe-border);
}

.citation-title {
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}

.citation-item {
  margin-top: 8rpx;
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  line-height: 36rpx;
  word-break: break-word;
}

.composer {
  min-height: 600rpx;
  margin-top: 48rpx;
  padding: 48rpx;
}

.composer-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.composer-label {
  min-width: 0;
  color: var(--safe-title);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 44rpx;
}

.composer-counter {
  flex: none;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 36rpx;
}

.question-input {
  width: 100%;
  height: 224rpx;
  min-height: 224rpx;
  box-sizing: border-box;
  margin: 24rpx 0;
  padding: 32rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: var(--safe-card);
  color: var(--safe-title);
  font-size: 28rpx;
  line-height: 44rpx;
}

.question-placeholder {
  color: var(--safe-muted);
}

.inline-error {
  margin: 0 0 24rpx;
  color: var(--experience-danger);
  font-size: 24rpx;
  line-height: 36rpx;
}

.boundary-note > .inline-error {
  margin: 24rpx 0 0;
}

@media (prefers-reduced-motion: reduce) {
  .button-pressed {
    transform: none;
  }
}
