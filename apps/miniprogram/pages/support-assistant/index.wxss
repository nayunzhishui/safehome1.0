.page-shell {
  --ui2-composer-padding: 0;
  --ui2-composer-border: 0;
  --ui2-composer-bg: transparent;
  --ui2-consent-bg: var(--ui2-primary);
  --ui2-consent-text: #ffffff;
  --ui2-boundary-bg: var(--ui2-soft);
  --ui2-conversation-border: 0;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 48rpx 48rpx calc(56rpx + env(safe-area-inset-bottom));
  background: var(--safe-bg);
  color: var(--safe-title);
}
.page-header {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 24rpx;
  text-align: center;
}
.page-kicker, .page-title, .page-summary, .section-title, .section-copy { display: block; }
.page-kicker { color: var(--safe-primary-deep); font-size: 26rpx; line-height: 40rpx; }
.page-title { color: var(--safe-title); font-size: 44rpx; font-weight: 700; line-height: 60rpx; }
.mode-note { margin-bottom: 32rpx; padding: 24rpx 0; border-bottom: 1rpx solid var(--safe-border); }
.page-summary, .section-copy { color: var(--safe-muted); font-size: 30rpx; line-height: 48rpx; }
.unavailable { padding: 40rpx; border: 1rpx solid var(--safe-border); border-radius: 24rpx; background: var(--safe-card); }
.section-title { font-size: 32rpx; font-weight: 600; line-height: 48rpx; }
.section-copy { margin-top: 16rpx; }
.conversation { margin-top: 32rpx; }
@media (max-width: 340px) { .page-shell { padding-left: 32rpx; padding-right: 32rpx; } }
