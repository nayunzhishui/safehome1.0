/* AI 支持性问答（Figma 671:3117）：标题、使用边界脚注、对话记录（原话引用 + 支持性整理）、提问卡。 */
.assistant-page {
  display: flex;
  flex-direction: column;
  gap: var(--p3-section);
  padding-top: 16rpx;
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
}

.assistant-head {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.assistant-head__kicker {
  color: var(--p3-primary);
  font-size: 26rpx;
  line-height: 40rpx;
}

.assistant-head__summary {
  color: var(--p3-muted);
  font-size: 30rpx;
  line-height: 52rpx;
}

.assistant-conversation {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
}
