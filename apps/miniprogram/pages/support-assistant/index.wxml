<view class="page-shell" aria-label="支持性问答页面">
  <view class="intro-card">
    <text class="eyebrow">支持性问答</text>
    <text class="title">把问题缩小到下一步</text>
    <text class="subtitle">只检索已审核内容，不评价你、孩子或关系的好坏。</text>
  </view>

  <page-state
    wx:if="{{loading}}"
    state="loading"
    title="正在读取问答状态"
  />

  <page-state
    wx:elif="{{error && !enabled}}"
    state="error"
    title="暂时无法打开支持性问答"
    description="{{error}}"
    actionText="重新读取"
    bind:action="loadStatus"
  />

  <view wx:elif="{{!enabled}}" class="notice-card">
    <text class="notice-title">当前未开放</text>
    <text class="notice-text">你仍可使用记录、训练卡和人工支持。</text>
  </view>

  <block wx:else>
    <view class="boundary-card">
      <text class="boundary-title">使用边界</text>
      <text class="boundary-text">{{boundary}}</text>
      <button
        wx:if="{{!consented}}"
        class="consent-button"
        aria-label="确认已阅读使用边界并同意AI辅助处理"
        disabled="{{sending}}"
        bindtap="enableConsent"
      >我已阅读并同意AI辅助处理</button>
      <text wx:else class="consent-done">已记录本次选择</text>
    </view>

    <view wx:if="{{messages.length}}" class="conversation" aria-live="polite">
      <view
        wx:for="{{messages}}"
        wx:key="id"
        class="message message--{{item.role}}"
      >
        <text class="message-label">{{item.role === 'user' ? '你' : '支持性内容助手'}}</text>
        <text class="message-content">{{item.content}}</text>
        <view wx:if="{{item.citations && item.citations.length}}" class="citations">
          <text class="citation-title">参考内容</text>
          <text wx:for="{{item.citations}}" wx:key="version_id" class="citation-item">• {{item.title}}</text>
        </view>
      </view>
    </view>

    <view class="composer">
      <view class="composer-head">
        <text class="composer-label">你的问题或想法</text>
        <text class="composer-counter">{{question.length}}/1000</text>
      </view>
      <textarea
        class="question-input"
        aria-label="输入你的问题或想法，最多一千字"
        value="{{question}}"
        maxlength="1000"
        placeholder="例如：情绪升高时，我可以先做什么？"
        bindinput="onQuestionInput"
        disabled="{{sending}}"
      />
      <text wx:if="{{error}}" class="inline-error">{{error}}</text>
      <button
        class="send-button"
        aria-label="整理一个小步骤"
        disabled="{{sending || !question || !consented}}"
        bindtap="sendQuestion"
      >{{sending ? '正在整理' : '整理一个小步骤'}}</button>
    </view>
  </block>
</view>
