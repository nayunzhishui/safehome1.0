<view class="p3-page assistant-page" role="main" aria-label="{{eyebrow}}页面">
  <view class="assistant-head">
    <text class="assistant-head__kicker">{{eyebrow}}</text>
    <text class="p3-serif-title" role="heading" aria-level="1">{{title}}</text>
    <text class="assistant-head__summary">{{subtitle}}</text>
  </view>

  <page-state
    wx:if="{{loading}}"
    kind="loading"
    title="正在读取问答状态"
  />

  <page-state
    wx:elif="{{error && !enabled}}"
    kind="error"
    title="暂时无法打开支持性问答"
    description="{{error}}"
    action-label="重新读取"
    action-aria-label="重新读取支持性问答状态"
    bind:action="loadStatus"
  />

  <page-state wx:elif="{{!enabled}}" kind="empty" title="当前未开放" description="你仍可使用情绪记录、训练卡和人工支持。" />

  <block wx:else>
    <boundary-note text="{{boundary}}" consented="{{consented}}" sending="{{sending}}" error="{{error}}" bind:confirm="enableConsent" />

    <view wx:if="{{messages.length}}" class="assistant-conversation" aria-live="polite">
      <conversation-entry wx:for="{{messages}}" wx:key="id" message="{{item}}" />
    </view>

    <question-composer value="{{question}}" sending="{{sending}}" disabled="{{!question || !consented}}" guidance="{{!consented ? '先阅读使用边界并确认，再整理问题。' : (!question ? '写下一个具体问题后即可整理。' : '')}}" error="{{error && consented ? error : ''}}" bind:input="onQuestionInput" bind:submit="sendQuestion" />
  </block>
</view>
