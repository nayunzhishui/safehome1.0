<view class="page-shell" aria-label="{{eyebrow}}页面">
  <view class="page-header">
    <text class="page-kicker">{{eyebrow}}</text>
    <text class="page-title">{{title}}</text>
  </view>
  <view class="mode-note">
    <text class="page-summary">{{subtitle}}</text>
    <text class="pipeline-note">问答生成与知识检索共用同一套边界、引用和降级规则。</text>
  </view>

  <page-state
    wx:if="{{loading}}"
    kind="loading"
    title="正在读取问答状态"
    description="正在确认当前是否开放支持性问答。"
  />

  <page-state
    wx:elif="{{error && !enabled}}"
    kind="error"
    title="暂时无法打开支持性问答"
    description="{{error}}"
    actionLabel="重新读取"
    actionAriaLabel="重新读取支持性问答状态"
    bind:action="loadStatus"
  />

  <view wx:elif="{{!enabled}}" class="unavailable" role="status">
    <text class="section-title">当前未开放</text>
    <text class="section-copy">你仍可使用情绪记录、训练卡和人工支持。</text>
  </view>

  <block wx:else>
    <boundary-note text="{{boundary}}" consented="{{consented}}" sending="{{sending}}" error="{{error}}" bind:confirm="enableConsent" />

    <view wx:if="{{messages.length}}" class="conversation" aria-live="polite">
      <conversation-entry wx:for="{{messages}}" wx:key="id" message="{{item}}" />
    </view>

    <question-composer value="{{question}}" sending="{{sending}}" disabled="{{!question || !consented}}" error="{{error && consented ? error : ''}}" bind:input="onQuestionInput" bind:submit="sendQuestion" />
  </block>
</view>
