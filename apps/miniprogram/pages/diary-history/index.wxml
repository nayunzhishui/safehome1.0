<view class="safe-page diary-history-page" role="main" aria-label="情绪记录">
  <view class="history-header">
    <text class="history-title">情绪记录</text>
    <text class="history-count">{{loading ? '正在读取' : (errorMessage ? (errorKind === 'network' ? '网络不可用' : '读取失败') : '当前显示 ' + records.length + ' 条')}}</text>
  </view>

  <page-state
    wx:if="{{loading}}"
    kind="loading"
    title="正在读取情绪记录"
    description="正在同步已经保存的真实记录，请稍候。"
  />

  <page-state
    wx:elif="{{errorMessage}}"
    kind="error"
    title="{{errorTitle}}"
    description="{{errorMessage}}"
    action-label="重新加载"
    action-aria-label="重新加载情绪记录"
    bind:action="retry"
  />

  <view wx:elif="{{records.length}}" class="record-list" role="list" aria-label="已保存的情绪记录">
    <view wx:for="{{records}}" wx:key="id" class="record-row" role="listitem">
      <view class="record-time">
        <text class="record-date">{{item.dateText}}</text>
        <text class="record-clock">{{item.timeText}}</text>
      </view>
      <view class="record-axis" aria-hidden="true">
        <view class="record-axis-line"></view>
        <view class="record-axis-dot"></view>
      </view>
      <view class="record-content">
        <text class="record-scene">{{item.sceneText}}</text>
        <text class="record-description">{{item.descriptionText}}</text>
        <view class="record-meta">
          <text class="record-emotion">{{item.emotionText}}</text>
          <text class="record-intensity-label">{{item.intensityText}}</text>
        </view>
        <view class="intensity-scale" aria-label="{{item.intensityText}}">
          <view
            wx:for="{{item.intensityMarks}}"
            wx:for-item="mark"
            wx:key="key"
            class="intensity-tick {{mark.active ? 'intensity-tick--active' : ''}}"
          ></view>
        </view>
      </view>
    </view>

    <button class="record-action" bindtap="startDiary">记录一件事</button>
  </view>

  <page-state
    wx:else
    kind="empty"
    title="还没有保存的记录"
    description="记录一次具体事件，会更容易看见当时的情绪与互动。"
    action-label="记录一件事"
    action-aria-label="新建一条情绪事件记录"
    bind:action="startDiary"
  />

  <text class="history-boundary">这里只展示已经保存的记录，用于支持性观察，不替代专业诊断。</text>
</view>
