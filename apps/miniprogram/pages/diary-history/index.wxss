/* 情绪记录（Figma 647:1213）：每条一节竹；日期列 62；“我/孩子”情绪与强度；10 格强度刻度用 intensity 色。 */
page {
  background: var(--p3-paper);
}

.history-page {
  display: flex;
  flex-direction: column;
  gap: var(--p3-section);
  box-sizing: border-box;
  min-height: 100vh;
  padding: 16rpx var(--p3-page-x) calc(72rpx + env(safe-area-inset-bottom));
  background: var(--p3-paper);
  overflow-x: hidden;
}

.history-count {
  display: block;
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

.history-list {
  display: flex;
  flex-direction: column;
}

.history-row {
  display: flex;
  align-items: stretch;
  gap: var(--p3-stack);
}

.history-row__time {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  width: 124rpx;
  flex: 0 0 auto;
  font-size: 26rpx;
  line-height: 40rpx;
  white-space: nowrap;
}

.history-row__date {
  color: var(--p3-ink);
}

.history-row__clock {
  color: var(--p3-muted);
}

.history-row__rail {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  width: 24rpx;
  flex: 0 0 auto;
}

.history-row__joint {
  width: 16rpx;
  height: 36rpx;
  flex: 0 0 auto;
  border-radius: 999rpx;
  background: var(--p3-primary);
}

.history-row__line {
  flex: 1 0 0;
  width: 4rpx;
  background: var(--p3-primary);
  opacity: 0.22;
}

.history-row__content {
  flex: 1 0 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  overflow-wrap: anywhere;
}

.history-row__content--spaced {
  padding-bottom: 44rpx;
}

.history-row__scene {
  color: var(--p3-ink);
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: 500;
}

.history-row__description {
  color: var(--p3-muted);
  font-size: 28rpx;
  line-height: 44rpx;
}

.history-row__meta {
  display: flex;
  align-items: center;
  gap: var(--p3-tight);
  font-size: 26rpx;
  line-height: 40rpx;
}

.history-row__emotion {
  flex: 1 0 0;
  min-width: 0;
  color: var(--p3-ink);
}

.history-row__level {
  flex: 0 0 auto;
  color: var(--p3-muted);
  white-space: nowrap;
}

.intensity-scale {
  display: flex;
  gap: 6rpx;
}

.intensity-tick {
  flex: 1 0 0;
  min-width: 0;
  height: 12rpx;
  border-radius: 999rpx;
  background: var(--p3-mist);
}
