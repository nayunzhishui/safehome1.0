<view class="safe-page relationship-task-page">
  <view class="safe-card safe-card--hero">
    <text class="task-meta">线上探索材料</text>
    <text class="task-heading">{{isDrawing ? '关系隐喻互动绘画' : '如果……会怎样'}}</text>
    <text class="task-copy">{{isDrawing ? '用线条、形状或位置表达此刻的关系感受，再配一两句画外音。系统不会解释象征或潜意识。' : '只回答你愿意回答的情境。没有标准答案，也不要求全部填写。'}}</text>
    <view class="save-state {{saving ? 'is-saving' : ''}}"><text class="save-dot"></text><text>{{saveStatus}}</text></view>
    <view wx:if="{{draftRestored}}" class="draft-notice">已恢复上次未提交的本机草稿，你可以接着完成。</view>
  </view>

  <view wx:if="{{isDrawing}}" class="safe-card drawing-card">
    <view class="canvas-label-row"><text class="canvas-label">画布</text><text class="canvas-help">可撤销、重做，草稿自动留在本机</text></view>
    <canvas canvas-id="relationshipCanvas" class="drawing-canvas" disable-scroll="true" aria-label="关系感受绘画画布，可使用下方按钮撤销、重做或清空" bindtouchstart="startStroke" bindtouchmove="moveStroke" bindtouchend="endStroke"></canvas>
    <view class="canvas-tools">
      <button class="tool-button" disabled="{{!canUndo || saving}}" bindtap="undoStroke">撤销</button>
      <button class="tool-button" disabled="{{!canRedo || saving}}" bindtap="redoStroke">重做</button>
      <button class="tool-button danger" disabled="{{!canUndo || saving}}" bindtap="clearCanvas">清空</button>
    </view>
    <label class="field-block">
      <text class="field-label">给这幅画写一两句画外音</text>
      <textarea class="task-textarea" maxlength="240" placeholder="例如：我站在这里，想靠近，也想保留一点距离" bindinput="onNarrationInput" value="{{narration}}"></textarea>
      <text class="char-count">{{narrationCount}}/240</text>
    </label>
  </view>

  <view wx:else class="sentence-list">
    <view wx:for="{{contextItems}}" wx:key="key" class="sentence-section">
      <button class="sentence-toggle" data-key="{{item.key}}" aria-expanded="{{item.expanded}}" bindtap="toggleContext">
        <view class="sentence-heading"><text>{{item.label}}</text><text wx:if="{{item.answered}}" class="answered-chip">已填写</text></view>
        <text class="sentence-arrow">{{item.expanded ? '收起' : '展开'}}</text>
      </button>
      <view wx:if="{{item.expanded}}" class="sentence-editor">
        <text class="sentence-prompt">如果在“{{item.label}}”的情境里，会怎样？</text>
        <textarea class="task-textarea" data-key="{{item.key}}" maxlength="300" value="{{item.value}}" placeholder="我会…… / 我担心…… / 我希望……" bindinput="onSentenceInput"></textarea>
        <view class="editor-meta"><text>本题可以跳过</text><text>{{item.count}}/300</text></view>
      </view>
    </view>
  </view>

  <checkbox-group bindchange="toggleConsent">
    <label class="consent-row"><checkbox value="agree" checked="{{consent}}" />我同意将这份敏感叙事材料用于本次试点评估与人工复核；默认不导出原文。</label>
  </checkbox-group>
  <view class="boundary-card">材料只作为访谈和共同理解的线索，不自动解释潜意识、人格、依恋类型或病理模式。</view>
  <button class="safe-primary-button submit-button" loading="{{saving}}" disabled="{{saving}}" bindtap="saveTask">提交这份材料</button>
</view>
