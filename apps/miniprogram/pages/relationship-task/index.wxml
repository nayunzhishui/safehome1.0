<view wx:if="{{!serviceReady}}" class="p3-page task-page" role="main" aria-label="功能知情说明">
  <page-state kind="error" title="使用前请阅读本功能说明" description="{{errorMessage || '确认数据用途后，再填写和保存；暂不同意可以返回。'}}" action-label="重新确认" bind:action="retryServiceEntry" />
  <button class="p3-btn p3-btn--primary" bindtap="returnToPrivacyHome">返回首页阅读隐私说明</button>
</view>
<block wx:if="{{serviceReady}}">
<view class="p3-page task-page" role="main" aria-label="关系探索任务">
  <view class="task-head">
    <view class="task-head__row">
      <text class="p3-serif-title task-head__title" role="heading" aria-level="1">{{isDrawing ? '关系隐喻互动绘画' : '如果……会怎样'}}</text>
      <status-pill label="{{saveStatus}}" tone="{{saveStatus === '草稿已保存在本机' || saveStatus === '已提交' || saveStatus === '已恢复本机草稿' ? 'success' : (saveStatus === '本机草稿保存失败，请先不要退出' || saveStatus === '提交未完成，草稿已保存在本机' ? 'warning' : 'neutral')}}" />
    </view>
    <text class="task-head__intro">{{isDrawing ? '用线条、形状或位置表达此刻的关系感受，再配一两句画外音。系统不会解释象征或潜意识。' : '只回答你愿意回答的情境。没有标准答案，也不要求全部填写。'}}</text>
    <view wx:if="{{draftRestored}}" class="p3-notice" role="status">
      <text class="p3-notice__body">已恢复上次未提交的本机草稿，你可以接着完成。</text>
    </view>
  </view>

  <view wx:if="{{isDrawing}}" class="task-drawing">
    <view class="task-canvas__label">
      <text class="p3-item-title">画布</text>
      <text class="p3-meta">草稿自动留在本机</text>
    </view>
    <view class="task-canvas">
      <canvas canvas-id="relationshipCanvas" class="task-canvas__surface" disable-scroll="true" aria-label="关系感受绘画画布，可使用下方按钮撤销、重做或清空" bindtouchstart="startStroke" bindtouchmove="moveStroke" bindtouchend="endStroke"></canvas>
    </view>
    <view class="task-tools">
      <button class="p3-chip task-tool" disabled="{{!canUndo || saving}}" bindtap="undoStroke">撤销</button>
      <button class="p3-chip task-tool" disabled="{{!canRedo || saving}}" bindtap="redoStroke">重做</button>
      <button class="p3-chip task-tool task-tool--warm" disabled="{{!canUndo || saving}}" bindtap="clearCanvas">清空</button>
    </view>
    <view class="p3-field">
      <text class="p3-field__label">给这幅画写一两句画外音</text>
      <textarea class="p3-field__input p3-field__input--multi" aria-label="给这幅画写一两句画外音" placeholder-class="p3-field__placeholder" maxlength="240" placeholder="例如：我站在这里，想靠近，也想保留一点距离" bindinput="onNarrationInput" value="{{narration}}"></textarea>
      <text class="p3-field__hint">{{narrationCount}}/240</text>
    </view>
  </view>

  <view wx:else class="task-contexts">
    <view wx:for="{{contextItems}}" wx:key="key" class="task-context {{index < contextItems.length - 1 ? 'task-context--divided' : ''}}">
      <button class="task-context__toggle {{item.expanded ? 'task-context__toggle--open' : ''}}" data-key="{{item.key}}" aria-expanded="{{item.expanded}}" aria-label="{{item.label}}{{item.answered ? '，已填写' : ''}}，{{item.expanded ? '收起' : '展开'}}" bindtap="toggleContext">
        <text class="p3-item-title">{{item.label}}</text>
        <status-pill wx:if="{{item.answered}}" label="已填写" tone="success" />
        <view class="task-context__spacer"></view>
        <text class="p3-meta">{{item.expanded ? '收起' : '展开'}}</text>
        <view class="task-context__chevron {{item.expanded ? 'task-context__chevron--open' : ''}}" aria-hidden="true">
          <p3-icon name="chevron-down" size="24" tone="ink" />
        </view>
      </button>
      <view wx:if="{{item.expanded}}" class="task-context__body">
        <text class="task-context__prompt">如果在“{{item.label}}”的情境里，会怎样？</text>
        <view class="p3-field">
          <text class="p3-field__label">我的回答（可以跳过）</text>
          <textarea class="p3-field__input p3-field__input--multi" aria-label="{{item.label}}情境，可以跳过" placeholder-class="p3-field__placeholder" data-key="{{item.key}}" maxlength="300" value="{{item.value}}" placeholder="我会…… / 我担心…… / 我希望……" bindinput="onSentenceInput"></textarea>
          <text class="p3-field__hint">本题可以跳过 · {{item.count}}/300</text>
        </view>
      </view>
    </view>
  </view>

  <view class="task-submit">
    <checkbox-group class="p3-agreement" aria-label="材料用途确认" bindchange="toggleConsent">
      <label class="p3-agreement__box {{consent ? 'p3-agreement__box--checked' : ''}}">
        <checkbox class="p3-agreement__native" value="agree" checked="{{consent}}" aria-label="我同意将这份敏感叙事材料用于本次试点评估与人工复核；默认不导出原文" />
        <image wx:if="{{consent}}" class="p3-agreement__tick" src="/assets/icons/p3/tick-14-white.svg" aria-hidden="true" />
      </label>
      <text class="p3-agreement__text" bindtap="flipConsent">我同意将这份敏感叙事材料用于本次试点评估与人工复核；默认不导出原文。</text>
    </checkbox-group>
    <text class="p3-meta">材料只作为访谈和共同理解的线索，不自动解释潜意识、人格、依恋类型或病理模式。</text>
    <button class="p3-btn p3-btn--primary" loading="{{saving}}" disabled="{{saving}}" bindtap="saveTask">提交这份材料</button>
  </view>
</view>
</block>
