/* 关系探索任务（Figma 667:2907 绘画 / 667:2958 句子补全）：标题与本机草稿状态、画布或七个可折叠情境、同意与提交。 */
.task-page {
  display: flex;
  flex-direction: column;
  gap: var(--p3-section);
  padding-top: 16rpx;
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
}

.task-head,
.task-drawing {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
}

.task-head__row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: var(--p3-tight);
}

.task-head__title {
  flex: 0 1 auto;
  min-width: 0;
}

.task-head__intro {
  color: var(--p3-muted);
  font-size: 30rpx;
  line-height: 52rpx;
}

.task-canvas__label {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--p3-tight);
}

/* 画布：纸白、细线、分组圆角，高 250 */
.task-canvas {
  overflow: hidden;
  height: 500rpx;
  border-radius: var(--p3-radius-group);
  background: var(--p3-surface);
  box-shadow: inset 0 0 0 2rpx var(--p3-hairline);
}

.task-canvas__surface {
  display: block;
  width: 100%;
  height: 500rpx;
}

.task-tools {
  display: flex;
  gap: var(--p3-tight);
}

.task-tool {
  flex: 1 0 0;
  min-width: 0;
  color: var(--p3-ink);
  font-size: 28rpx;
  line-height: 44rpx;
}

.task-tool--warm {
  color: var(--p3-warm-ink);
}

.task-tool[disabled] {
  opacity: 0.45;
}

/* 七个情境：纸白分组，每项细线分隔，可折叠 */
.task-contexts {
  display: flex;
  flex-direction: column;
  padding: 0 32rpx;
  border-radius: var(--p3-radius-group);
  background: var(--p3-surface);
}

.task-context {
  display: flex;
  flex-direction: column;
}

.task-context--divided {
  border-bottom: 2rpx solid var(--p3-hairline);
}

/* 整行可点（上下各 14，触控高度 52）；展开后与题干间距 8 */
.task-context__toggle {
  display: flex;
  align-items: center;
  gap: var(--p3-tight);
  width: 100%;
  min-height: 0;
  padding: 28rpx 0;
  text-align: left;
}

.task-context__toggle--open {
  padding-bottom: 16rpx;
}

.task-context__body {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
  padding-bottom: 28rpx;
}

.task-context__spacer {
  flex: 1 0 0;
}

.task-context__chevron {
  display: flex;
  transition: transform 0.2s ease;
}

.task-context__chevron--open {
  transform: rotate(180deg);
}

.task-context__prompt {
  color: var(--p3-ink);
  font-size: 30rpx;
  line-height: 52rpx;
}

.task-submit {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
}
