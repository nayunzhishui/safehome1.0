<view class="p3-page action-page" role="main" aria-label="行动回看">
  <page-state wx:if="{{loading}}" kind="loading" title="正在读取行动" />
  <page-state wx:elif="{{error}}" kind="error" title="还需要处理" description="{{error}}" action-label="重新读取" bindaction="load" />

  <view wx:elif="{{action}}" class="action-card">
    <view class="action-plan">
      <view class="action-spine">
        <view class="action-spine__rail" aria-hidden="true"><view class="action-spine__joint"></view><view class="action-spine__line"></view></view>
        <view class="action-spine__copy">
          <text class="action-spine__label">原计划</text>
          <text class="p3-item-title">{{action.action_text}}</text>
          <text wx:if="{{action.purpose_text}}" class="action-spine__body">{{action.purpose_text}}</text>
        </view>
      </view>
      <view wx:if="{{action.stop_conditions.length}}" class="action-stops">
        <text class="p3-meta">停止条件</text>
        <text wx:for="{{action.stop_conditions}}" wx:key="*this" class="action-stops__item">· {{item}}</text>
      </view>
    </view>

    <view class="action-field">
      <text class="p3-field__label">这次的状态</text>
      <view class="p3-segment p3-segment--paper" role="radiogroup" aria-label="行动状态">
        <button class="p3-segment__item {{status === 'completed' ? 'p3-segment__item--active' : ''}}" data-value="completed" role="radio" aria-checked="{{status === 'completed'}}" bindtap="selectStatus">尝试过</button>
        <button class="p3-segment__item {{status === 'stopped' ? 'p3-segment__item--active' : ''}}" data-value="stopped" role="radio" aria-checked="{{status === 'stopped'}}" bindtap="selectStatus">中途停止</button>
        <button class="p3-segment__item {{status === 'declined' ? 'p3-segment__item--active' : ''}}" data-value="declined" role="radio" aria-checked="{{status === 'declined'}}" bindtap="selectStatus">决定不做</button>
      </view>
    </view>

    <view class="action-field">
      <text class="p3-field__label">把这次内容记成</text>
      <view class="p3-segment p3-segment--paper" role="radiogroup" aria-label="随访类型">
        <button class="p3-segment__item {{followupKind === 'O' ? 'p3-segment__item--active' : ''}}" data-value="O" role="radio" aria-checked="{{followupKind === 'O'}}" bindtap="selectKind">新的观察</button>
        <button class="p3-segment__item {{followupKind === 'U' ? 'p3-segment__item--active' : ''}}" data-value="U" role="radio" aria-checked="{{followupKind === 'U'}}" bindtap="selectKind">仍待了解</button>
      </view>
    </view>

    <view class="p3-field">
      <label for="action-note" class="p3-field__label">这次发生了什么</label>
      <textarea id="action-note" placeholder-class="p3-field__placeholder" class="p3-field__input p3-field__input--multi" maxlength="1000" value="{{note}}" aria-label="行动回看内容" placeholder="写下发生了什么、你注意到什么，或仍不确定什么。" bindinput="onNoteInput"></textarea>
      <text class="p3-field__hint">{{note.length || 0}} / 1000</text>
    </view>

    <view class="action-buttons">
      <text wx:if="{{submitError}}" class="p3-form-message p3-form-message--error" role="alert">{{submitError}}</text>
      <button wx:if="{{action.training_card_id}}" class="p3-btn p3-btn--secondary" bindtap="openTrainingCard">打开关联训练卡</button>
      <button class="p3-btn p3-btn--primary" loading="{{saving}}" disabled="{{saving}}" bindtap="submit">保存这次回看</button>
      <text class="action-buttons__note">一次记录，不是疗效证明。</text>
    </view>
  </view>
</view>
