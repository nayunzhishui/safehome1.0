.action-page { display: grid; align-content: start; gap: 48rpx; padding: 48rpx 40rpx calc(64rpx + env(safe-area-inset-bottom)); background: var(--ui2-canvas); }
.action-hero { text-align: center; }
.action-hero .safe-h1 { display: block; margin: 0; font-size: 44rpx; font-weight: 700; line-height: 1.6; }
.action-card { display: grid; gap: 48rpx; }
.action-plan { padding: 40rpx; border-radius: 24rpx; background: var(--ui2-soft); }
.action-plan__content { display: grid; gap: 24rpx; min-width: 0; }
.plan-label, .action-boundary__title { color: var(--ui2-primary); font-size: 30rpx; font-weight: 700; line-height: 1.6; }
.action-plan .safe-h3 { margin: 0; color: var(--ui2-ink); font-size: 34rpx; font-weight: 700; line-height: 1.6; }
.action-purpose, .action-boundary__item { display: block; margin: 0; color: var(--ui2-ink); font-size: 30rpx; line-height: 1.6; overflow-wrap: anywhere; }
.field-group { display: grid; gap: 24rpx; }
.field-label { display: block; color: var(--ui2-ink); font-size: 30rpx; font-weight: 700; line-height: 1.6; }
.option-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16rpx; }
.option-row--kind { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.option-row button { min-height: 96rpx; display: flex; align-items: center; justify-content: center; padding: 20rpx 8rpx; border: 2rpx solid var(--ui2-control-border); border-radius: 24rpx; background: var(--ui2-surface); color: var(--ui2-primary); font-size: 30rpx; line-height: 1.5; }
.option-row button.selected { border-color: var(--ui2-primary); background: var(--ui2-soft); font-weight: 700; }
.action-textarea { box-sizing: border-box; width: 100%; min-height: 280rpx; padding: 24rpx; border: 2rpx solid var(--ui2-control-border); border-radius: 24rpx; background: var(--ui2-surface); color: var(--ui2-ink); font-size: 30rpx; line-height: 1.6; }
.action-placeholder, .action-note { color: var(--ui2-muted); font-size: 30rpx; line-height: 1.6; }
.option-row button:focus-visible { outline: 4rpx solid var(--ui2-primary); outline-offset: 4rpx; }
