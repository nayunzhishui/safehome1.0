.course-page {
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.course-hero {
  padding: 24rpx 0 8rpx;
  text-align: center;
}

.hero-title,
.progress-number,
.progress-text {
  display: block;
}

.hero-title {
  color: var(--safe-title);
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.28;
  letter-spacing: 0;
}

.progress-card {
  position: relative;
  min-height: 142rpx;
  overflow: hidden;
  padding: 28rpx;
  border: 1rpx solid rgba(87, 139, 95, 0.18);
  border-radius: 20rpx;
  background: var(--safe-card);
  box-shadow: var(--safe-shadow-card);
}

.progress-number,
.progress-text {
  position: relative;
  z-index: 1;
}

.progress-number {
  color: var(--safe-title);
  font-size: 32rpx;
  font-weight: 850;
  line-height: 1.35;
}

.progress-text {
  max-width: 500rpx;
  margin-top: 12rpx;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.6;
}

.progress-mark {
  position: absolute;
  right: 28rpx;
  top: 50%;
  width: 86rpx;
  height: 10rpx;
  margin-top: -5rpx;
  border-radius: 999rpx;
  background: var(--safe-primary-deep);
}

.category-scroll {
  width: 100%;
  margin-top: 20rpx;
  white-space: nowrap;
}

.category-list {
  display: inline-flex;
  gap: 14rpx;
  padding-right: 24rpx;
}

.category-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 68rpx;
  padding: 0 18rpx;
  border: 0;
  border-bottom: 4rpx solid transparent;
  border-radius: 0;
  background: transparent;
  color: var(--safe-text);
  font-size: 24rpx;
  font-weight: 700;
}

.category-chip::after {
  border: 0;
}

.category-chip.active {
  border-bottom-color: var(--safe-primary-deep);
  background: transparent;
  color: var(--safe-primary-deep);
  font-weight: 900;
}

.course-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 20rpx;
}

.course-state-card,
.boundary-card {
  padding: 24rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: var(--safe-card);
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.6;
  box-shadow: var(--safe-shadow-card);
}

.retry-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 58rpx;
  margin-top: 16rpx;
  padding: 0 22rpx;
  border: 1rpx solid var(--safe-border-strong);
  border-radius: var(--safe-radius-pill);
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 800;
}
