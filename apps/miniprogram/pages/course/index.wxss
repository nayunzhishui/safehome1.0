.course-page {
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.course-hero {
  padding: 24rpx 0 8rpx;
  text-align: center;
}

.hero-title,
.progress-number,
.progress-text {
  display: block;
}

.hero-title {
  color: var(--safe-title);
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.28;
  letter-spacing: 0;
}

.progress-card {
  position: relative;
  min-height: 142rpx;
  overflow: hidden;
  padding: 28rpx;
  border: 1rpx solid rgba(87, 139, 95, 0.18);
  border-radius: 20rpx;
  background: var(--safe-card);
  box-shadow: var(--safe-shadow-card);
}

.progress-number,
.progress-text {
  position: relative;
  z-index: 1;
}

.progress-number {
  color: var(--safe-title);
  font-size: 32rpx;
  font-weight: 850;
  line-height: 1.35;
}

.progress-text {
  max-width: 500rpx;
  margin-top: 12rpx;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.6;
}

.progress-mark {
  position: absolute;
  right: 28rpx;
  top: 50%;
  width: 86rpx;
  height: 10rpx;
  margin-top: -5rpx;
  border-radius: 999rpx;
  background: var(--safe-primary-deep);
}

.category-scroll {
  width: 100%;
  margin-top: 20rpx;
  white-space: nowrap;
}

.category-list {
  display: inline-flex;
  gap: 14rpx;
  padding-right: 24rpx;
}

.category-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 68rpx;
  padding: 0 18rpx;
  border: 0;
  border-bottom: 4rpx solid transparent;
  border-radius: 0;
  background: transparent;
  color: var(--safe-text);
  font-size: 24rpx;
  font-weight: 700;
}

.category-chip::after {
  border: 0;
}

.category-chip.active {
  border-bottom-color: var(--safe-primary-deep);
  background: transparent;
  color: var(--safe-primary-deep);
  font-weight: 900;
}

.course-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 20rpx;
}

.course-state-card,
.boundary-card {
  padding: 24rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: var(--safe-card);
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.6;
  box-shadow: var(--safe-shadow-card);
}

.retry-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 58rpx;
  margin-top: 16rpx;
  padding: 0 22rpx;
  border: 1rpx solid var(--safe-border-strong);
  border-radius: var(--safe-radius-pill);
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 800;
}
.ui2-page.course-page { background:var(--ui2-canvas); padding-top:48rpx; gap:40rpx; }
.ui2-page .course-hero { padding:0 0 32rpx; text-align:center; border-bottom:1rpx solid var(--ui2-line); }
.ui2-page .hero-title { font-size:44rpx; font-weight:700; line-height:1.6; }
.ui2-page .progress-card { padding:32rpx; border:0; border-radius:24rpx; background:var(--ui2-soft); }
.ui2-page .progress-number { font-size:32rpx; font-weight:700; line-height:1.6; }
.ui2-page .progress-text,.ui2-page .course-state-card,.ui2-page .boundary-card { font-size:30rpx; line-height:1.6; color:var(--ui2-muted); }
.ui2-page .category-chip { min-height:96rpx; padding:20rpx 24rpx; border:2rpx solid var(--ui2-control-border); border-radius:24rpx; background:transparent; color:var(--ui2-primary); font-size:30rpx; }
.ui2-page .category-chip.active { background:var(--ui2-soft); border-color:var(--ui2-primary); font-weight:700; }
.ui2-page .safe-section { padding:0; }
.ui2-page.course-page { --ui2-course-shadow:none; }
.ui2-page .progress-card { min-height:0; box-shadow:none; }
.ui2-page .progress-text { max-width:none; }
.ui2-page .category-chip { margin:0; flex-shrink:0; line-height:1.6; }
.ui2-page .category-chip.active { border-bottom-width:5rpx; }
.ui2-page .course-state-card,.ui2-page .boundary-card { border:0; box-shadow:none; background:transparent; padding:20rpx 0; }
.ui2-page .retry-button { min-height:96rpx; font-size:30rpx; }

/* Quiet page ending; not a progress indicator or interaction target. */
.ui2-page .quiet-arc-footer { position:relative; height:96rpx; margin-top:40rpx; overflow:hidden; pointer-events:none; }
.ui2-page .quiet-arc-footer::before,.ui2-page .quiet-arc-footer::after { content:''; position:absolute; width:78%; height:160rpx; border:2rpx solid var(--ui2-line); border-radius:50%; }
.ui2-page .quiet-arc-footer::before { left:8%; top:60rpx; }
.ui2-page .quiet-arc-footer::after { left:28%; top:36rpx; }

.ui2-page.course-page { --ui2-reading-line:1.6; }

.ui2-page { --ui2-section-accent-display:none; }
