.course-page {
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.course-hero {
  position: relative;
  min-height: 300rpx;
  overflow: hidden;
}

.hero-copy {
  position: relative;
  z-index: 1;
  max-width: 480rpx;
}

.hero-kicker,
.hero-title,
.hero-summary,
.progress-number,
.progress-text {
  display: block;
}

.hero-kicker {
  margin-bottom: 10rpx;
  color: var(--safe-primary);
  font-size: 24rpx;
  font-weight: 800;
}

.hero-title {
  color: var(--safe-title);
  font-size: 42rpx;
  font-weight: 850;
  line-height: 1.28;
  letter-spacing: 0;
}

.hero-summary {
  margin-top: 16rpx;
  color: var(--safe-text);
  font-size: 28rpx;
  line-height: 1.7;
}

.hero-image {
  position: absolute;
  right: -20rpx;
  bottom: -18rpx;
  width: 250rpx;
  height: 220rpx;
  border-radius: var(--safe-radius-lg);
  opacity: 0.9;
}

.progress-card {
  position: relative;
  min-height: 164rpx;
  overflow: hidden;
  padding: 28rpx;
  border: 1rpx solid rgba(87, 139, 95, 0.18);
  border-radius: var(--safe-radius-lg);
  background: linear-gradient(135deg, var(--safe-primary-pale), var(--safe-card));
  box-shadow: var(--safe-shadow-card);
}

.progress-number,
.progress-text {
  position: relative;
  z-index: 1;
}

.progress-number {
  color: var(--safe-title);
  font-size: 32rpx;
  font-weight: 850;
  line-height: 1.35;
}

.progress-text {
  max-width: 500rpx;
  margin-top: 12rpx;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.6;
}

.progress-mark {
  position: absolute;
  right: 28rpx;
  bottom: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: rgba(255, 253, 248, 0.82);
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 900;
}

.category-scroll {
  width: 100%;
  margin-top: 20rpx;
  white-space: nowrap;
}

.category-list {
  display: inline-flex;
  gap: 14rpx;
  padding-right: 24rpx;
}

.category-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 62rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-pill);
  background: var(--safe-card);
  color: var(--safe-text);
  font-size: 24rpx;
  font-weight: 700;
}

.category-chip::after {
  border: 0;
}

.category-chip.active {
  border-color: rgba(87, 139, 95, 0.36);
  background: var(--safe-primary-soft);
  color: var(--safe-primary-deep);
  font-weight: 900;
}

.course-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 20rpx;
}
