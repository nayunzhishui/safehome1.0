.course-page {
  padding-bottom: 48rpx;
}

.page-head {
  padding: 32rpx;
  border: 1rpx solid #efe7dc;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f7faf4 100%);
  box-shadow: 0 12rpx 32rpx rgba(80, 64, 45, 0.08);
}

.page-title,
.page-subtitle {
  display: block;
}

.page-title {
  color: #333333;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.3;
}

.page-subtitle {
  margin-top: 12rpx;
  color: #666666;
  font-size: 26rpx;
  line-height: 1.6;
}

.head-image {
  width: 100%;
  height: 300rpx;
  display: block;
  margin-top: 24rpx;
  overflow: hidden;
  border-radius: 22rpx;
  background: #fffaf3;
}

.progress-card {
  position: relative;
  min-height: 164rpx;
  overflow: hidden;
  padding: 28rpx;
  border: 1rpx solid #e7eddc;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #f2faec, #fff7e7);
  box-shadow: 0 12rpx 30rpx rgba(82, 112, 64, 0.1);
}

.progress-number,
.progress-text {
  position: relative;
  z-index: 1;
  display: block;
}

.progress-number {
  color: #333333;
  font-size: 32rpx;
  font-weight: 800;
}

.progress-text {
  max-width: 500rpx;
  margin-top: 12rpx;
  color: #5f6d59;
  font-size: 24rpx;
  line-height: 1.55;
}

.progress-plant {
  position: absolute;
  right: 34rpx;
  bottom: 0;
  width: 82rpx;
  height: 118rpx;
  border-radius: 80rpx 80rpx 0 0;
  background: #8bcf86;
  box-shadow: -34rpx 34rpx 0 -8rpx #ffb26b;
}

.category-scroll {
  width: 100%;
  margin-top: 20rpx;
  white-space: nowrap;
}

.category-list {
  display: inline-flex;
  gap: 14rpx;
  padding-right: 24rpx;
}

.category-chip {
  min-height: 58rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  border: 1rpx solid #efe7dc;
  border-radius: 29rpx;
  background: #ffffff;
  color: #666666;
  font-size: 24rpx;
  font-weight: 600;
}

.category-chip.active {
  border-color: #6fbc6b;
  background: #6fbc6b;
  color: #ffffff;
}

.course-list {
  display: grid;
  gap: 20rpx;
  margin-top: 20rpx;
}
