<view class="safe-page safe-page--with-tabbar course-page">
  <view class="course-hero safe-card safe-card--hero">
    <view class="hero-copy">
      <text class="hero-kicker">练习内容目录</text>
      <text class="hero-title">按需要慢慢看</text>
      <text class="hero-summary">这里整理一些陪伴练习相关内容。可以先选一个主题看一小节，不需要一次学完。</text>
    </view>
  </view>

  <view class="safe-section">
    <view class="progress-card">
      <view>
        <text class="progress-number">本周已查看 {{weeklyProgress.learnedLessons}} 小节</text>
        <text class="progress-text">{{weeklyProgress.suggestion}}</text>
      </view>
      <view class="progress-mark">轻量</view>
    </view>
  </view>

  <view class="safe-section">
    <section-title title="内容主题" subtitle="按当前最需要的主题选择，不需要按顺序完成" />
    <scroll-view class="category-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="category-list">
        <button
          wx:for="{{categories}}"
          wx:key="*this"
          class="category-chip {{activeCategory === item ? 'active' : ''}}"
          data-category="{{item}}"
          bindtap="selectCategory"
        >
          {{item}}
        </button>
      </view>
    </scroll-view>
  </view>

  <view class="safe-section">
    <section-title title="可选内容" subtitle="更像说明和练习参考，不是必须完成的课程任务" />
    <view class="course-list">
      <course-card
        wx:for="{{visibleCourses}}"
        wx:key="title"
        title="{{item.title}}"
        description="{{item.description}}"
        category="{{item.category}}"
        lesson-count="{{item.lessonCount}}"
        progress="{{item.progress}}"
        button-text="查看内容"
        bind:tapcard="openCourse"
      />
    </view>
  </view>

  <view class="safe-section">
    <bottom-tip-card text="先选一个能用得上的小内容，看完后可以回到训练页做一次练习。" />
  </view>
</view>
