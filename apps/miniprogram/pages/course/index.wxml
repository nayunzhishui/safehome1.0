<view class="safe-page ui2-page safe-page--with-tabbar course-page" role="main" aria-label="课程列表">
  <view class="course-hero">
    <text class="hero-title">课程</text>
  </view>

  <view class="safe-section">
    <view class="progress-card">
      <view>
        <text class="progress-number">从一小节开始</text>
        <text class="progress-text">{{weeklyProgress.suggestion}}</text>
      </view>
    </view>
  </view>

  <view class="safe-section">
    <section-title title="内容主题" />
    <scroll-view class="category-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="category-list">
        <button
          wx:for="{{categories}}"
          wx:key="*this"
          class="category-chip {{activeCategory === item ? 'active' : ''}}"
          data-category="{{item}}"
          bindtap="selectCategory"
          aria-pressed="{{activeCategory === item}}"
        >
          {{item}}
        </button>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{errorMessage}}" class="safe-section">
    <view class="course-state-card">
      <text>{{errorMessage}}</text>
      <button class="retry-button" bindtap="retryLoadCourses">重新加载</button>
    </view>
  </view>

  <view wx:if="{{loading}}" class="safe-section">
    <view class="course-state-card">
      <text>正在读取课程内容...</text>
    </view>
  </view>

  <view wx:if="{{!loading && !errorMessage}}" class="safe-section">
    <section-title title="可选内容" />
    <view class="course-list">
      <course-card
        wx:for="{{visibleCourses}}"
        wx:key="id"
        course-id="{{item.id}}"
        title="{{item.title}}"
        description="{{item.description}}"
        category="{{item.category}}"
        lesson-count="{{item.lessonCount}}"
        progress="{{item.progress}}"
        show-progress="{{false}}"
        button-text="查看内容"
        bind:tapcard="openCourse"
      />
    </view>
    <page-state wx:if="{{!visibleCourses.length}}" kind="empty" title="当前主题暂无可选内容" description="可以切换其他主题；课程开放以审核状态为准。" />
  </view>

  <view wx:if="{{boundaryNotice}}" class="safe-section">
    <view class="boundary-card">{{boundaryNotice}}</view>
  </view>

  <view class="quiet-arc-footer" aria-hidden="true"></view>
</view>
