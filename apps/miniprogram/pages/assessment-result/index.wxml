<view class="safe-page assessment-result-page">
  <view wx:if="{{loading}}" class="state-box">
    <text>正在读取结果...</text>
  </view>

  <view wx:elif="{{result}}">
    <view class="result-hero">
      <text class="result-kicker">测一测已保存</text>
      <text class="result-title">{{result.worksheet_title}}</text>
      <text class="result-summary">{{result.result_summary}}</text>
    </view>

    <view class="safe-section">
      <alert-card
        type="info"
        title="结果边界"
        content="{{profileSummary ? '这里显示的是阶段性支持画像，只用于理解本次填写中的线索，不代表固定标签。如提示需要人工关注，请优先联系现实中的可信成年人、学校老师或专业支持。' : '这里显示的是本次填写记录和维度数据，只用于自我观察和练习参考，不替代心理咨询、医学诊断、危机干预或法律判断。'}}"
      />
    </view>

    <view wx:if="{{profileSummary}}" class="safe-section">
      <section-title title="阶段性画像" subtitle="基于本次填写生成，仅用于支持性理解" />
      <view class="profile-result-card {{profileSummary.riskLevel === 'high' ? 'high-risk' : ''}}">
        <text class="profile-name">{{profileSummary.profileName}}</text>
        <text class="profile-code">规则编码：{{profileSummary.profileCode || '未设置'}}</text>
        <view class="profile-metrics">
          <view class="profile-metric">
            <text class="cell-label">匹配置信度</text>
            <text class="cell-value">{{profileSummary.confidenceText}}</text>
          </view>
          <view class="profile-metric">
            <text class="cell-label">关注提示</text>
            <text class="cell-value">{{profileSummary.riskLevelText}}</text>
          </view>
        </view>
        <text wx:if="{{profileSummary.requiresReview}}" class="review-tip">本次结果建议人工关注，系统暂不把它当作普通练习建议处理。</text>
      </view>
    </view>

    <view wx:if="{{profileSummary && profileSummary.supportiveExplanation}}" class="safe-section">
      <section-title title="支持性解释" subtitle="帮助你理解本次填写，不做固定标签" />
      <view class="profile-copy-card">
        <text class="profile-copy-text">{{profileSummary.supportiveExplanation}}</text>
      </view>
    </view>

    <view wx:if="{{profileSummary && profileSummary.dimensions.length}}" class="safe-section">
      <section-title title="维度观察" subtitle="只表示本次填写中的线索" />
      <view class="dimension-list">
        <view wx:for="{{profileSummary.dimensions}}" wx:key="key" class="dimension-card">
          <text class="dimension-title">{{item.label}}</text>
          <text class="dimension-level">{{item.level}}</text>
          <text class="dimension-summary">{{item.summary}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{profileSummary && (profileSummary.strengthNote || profileSummary.smallStep)}}" class="safe-section">
      <section-title title="下一小步" subtitle="先做一个能完成的练习动作" />
      <view class="next-step-card">
        <text wx:if="{{profileSummary.strengthNote}}" class="next-step-label">优势提示</text>
        <text wx:if="{{profileSummary.strengthNote}}" class="next-step-text">{{profileSummary.strengthNote}}</text>
        <text wx:if="{{profileSummary.smallStep}}" class="next-step-label">可以先做</text>
        <text wx:if="{{profileSummary.smallStep}}" class="next-step-text">{{profileSummary.smallStep}}</text>
      </view>
    </view>

    <view wx:if="{{profileSummary && profileSummary.requiresReview}}" class="safe-section">
      <view class="support-card">
        <text class="support-title">优先联系现实支持</text>
        <text class="support-text">如果你现在处在明显痛苦或安全风险中，请先联系现实中的可信成年人、学校老师、专业机构或当地紧急服务。本系统不能替代危机干预。</text>
      </view>
    </view>

    <view class="safe-section">
      <section-title title="填写摘要" subtitle="用于自我观察和后续练习" />
      <view class="result-grid">
        <view class="result-cell">
          <text class="cell-label">分类</text>
          <text class="cell-value">{{result.category || '未分类'}}</text>
        </view>
        <view class="result-cell">
          <text class="cell-label">分数记录</text>
          <text class="cell-value">{{totalScoreText}}</text>
        </view>
        <view class="result-cell wide">
          <text class="cell-label">后续练习</text>
          <text class="cell-value">{{recommendedCardsText}}</text>
        </view>
      </view>
    </view>

    <button wx:if="{{!profileSummary || profileSummary.canOpenRecommendedCards}}" class="safe-primary-button action-button" bindtap="openRecommendedCards">查看可练习任务</button>
    <button class="safe-secondary-button action-button" bindtap="backToAssessment">返回测一测</button>

    <view class="safe-section">
      <bottom-tip-card text="这份结果只是一次观察记录，可以过一段时间再看有没有变化。" />
    </view>
  </view>

  <view wx:else class="state-box error">
    <text>{{errorMessage || '没有找到结果。'}}</text>
  </view>
</view>
