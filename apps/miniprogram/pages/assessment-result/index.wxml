<view class="safe-page assessment-result-page">
  <view wx:if="{{loading}}" class="state-box">
    <text>正在读取结果...</text>
  </view>

  <view wx:elif="{{result}}">
    <view class="result-head">
      <text class="result-title">{{result.worksheet_title}}</text>
      <text class="result-meta">{{result.result_summary}}</text>
    </view>

    <view wx:if="{{riskSummary}}" class="risk-strip {{riskSummary.riskLevel === 'high' ? 'high' : ''}}">
      <text class="risk-title">{{riskSummary.title}}</text>
      <text class="risk-text">{{riskSummary.text}}</text>
    </view>

    <view wx:if="{{profilePosition}}" class="safe-section">
      <view class="profile-card">
        <text class="profile-display-name">{{profilePosition.profileName}}</text>
        <text class="profile-confidence">与既往样本的接近度 {{profilePosition.confidenceText}}</text>
        <text wx:if="{{!profilePosition.canUseInterpretation}}" class="profile-warning">{{profilePosition.reliabilityText}}</text>
        <text wx:if="{{profilePosition.nCasesText}}" class="profile-meta">参照 {{profilePosition.nCasesText}}</text>
        <text wx:if="{{profilePosition.featureText}}" class="profile-meta">{{profilePosition.featureText}}</text>
        <canvas wx:if="{{profilePosition.userPoint}}" canvas-id="profilePlotCanvas" class="position-canvas"></canvas>
        <canvas wx:if="{{profilePosition.radarFeatures.length >= 3}}" canvas-id="profileRadarCanvas" class="radar-canvas"></canvas>
        <text wx:if="{{profilePosition.explanation}}" class="profile-explanation">{{profilePosition.explanation}}</text>
        <view wx:if="{{profilePosition.strengthNote || profilePosition.smallStep}}" class="profile-steps">
          <view wx:if="{{profilePosition.strengthNote}}" class="profile-step">
            <text class="step-label">优势提示</text>
            <text class="step-text">{{profilePosition.strengthNote}}</text>
          </view>
          <view wx:if="{{profilePosition.smallStep}}" class="profile-step">
            <text class="step-label">可以先做</text>
            <text class="step-text">{{profilePosition.smallStep}}</text>
          </view>
        </view>
        <text class="profile-boundary">{{profilePosition.boundaryNotice}}</text>
      </view>
    </view>

    <view wx:if="{{profileSummary}}" class="safe-section">
      <view class="profile-card {{profileSummary.riskLevel === 'high' ? 'high-risk' : ''}}">
        <text class="profile-display-name">{{profileSummary.profileName}}</text>
        <text wx:if="{{profileSummary.supportiveExplanation}}" class="profile-explanation">{{profileSummary.supportiveExplanation}}</text>
        <view wx:if="{{profileSummary.strengthNote || profileSummary.smallStep}}" class="profile-steps">
          <view wx:if="{{profileSummary.strengthNote}}" class="profile-step">
            <text class="step-label">优势提示</text>
            <text class="step-text">{{profileSummary.strengthNote}}</text>
          </view>
          <view wx:if="{{profileSummary.smallStep}}" class="profile-step">
            <text class="step-label">可以先做</text>
            <text class="step-text">{{profileSummary.smallStep}}</text>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{!profileSummary && scaleDimensions.length}}" class="safe-section">
      <section-title title="维度得分" subtitle="各维度分开看，不相加、不比高低" />
      <view class="dimension-list">
        <view wx:for="{{scaleDimensions}}" wx:key="key" class="dimension-row">
          <text class="dimension-label">{{item.label}}</text>
          <text class="dimension-score">{{item.score}} 分</text>
        </view>
      </view>
    </view>

    <view wx:if="{{trainingRecommendation}}" class="safe-section">
      <section-title title="推荐训练卡" subtitle="先选今天能做的一张" />
      <view class="recommendation-block">
        <text wx:if="{{trainingRecommendation.todaySuggestion}}" class="rec-suggestion">{{trainingRecommendation.todaySuggestion}}</text>
        <view class="rec-card-list">
          <view wx:for="{{trainingRecommendation.recommendedCards}}" wx:key="id" class="rec-card-row">
            <text class="rec-role">{{item.role}}</text>
            <view class="rec-card-copy">
              <text class="rec-card-title">{{item.title}}</text>
              <text wx:if="{{item.purpose}}" class="rec-card-purpose">{{item.purpose}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="result-actions">
      <button wx:if="{{!profileSummary || profileSummary.canOpenRecommendedCards}}" class="safe-primary-button action-button" bindtap="openRecommendedCards">查看可练习任务</button>
      <button class="safe-outline-button action-button" bindtap="backToAssessment">返回测一测</button>
    </view>

    <view class="safe-section">
      <bottom-tip-card text="这份结果只是一次观察记录，可以过一段时间再看有没有变化。" />
    </view>
  </view>

  <view wx:else class="state-box error">
    <text>{{errorMessage || '没有找到结果。'}}</text>
  </view>
</view>
