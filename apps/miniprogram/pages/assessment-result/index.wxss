/* 测一测结果（Figma 651:1684 / 679:3477 / 679:3683）：衬线标题；风险提示条；画像位置卡（散点 + 轮廓雷达）；
   综合分在雷达上方；3–8 维雷达；维度行（分数 → 看的是 → 量尺条 → 量尺·题数·位置 → 提示块）；推荐训练卡唯一实心。 */
page {
  background: var(--p3-paper);
}

.result-page {
  display: flex;
  flex-direction: column;
  gap: var(--p3-section);
  box-sizing: border-box;
  min-height: 100vh;
  padding: 16rpx var(--p3-page-x) calc(72rpx + env(safe-area-inset-bottom));
  background: var(--p3-paper);
  overflow-x: hidden;
}

.result-head {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.result-title {
  overflow-wrap: anywhere;
}

.result-meta {
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

.risk-strip {
  gap: var(--p3-tight);
}

.risk-action {
  margin-top: 8rpx;
}

.result-section {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
  min-width: 0;
}

.result-summary-text {
  display: block;
  color: var(--p3-ink);
  font-size: 28rpx;
  line-height: 44rpx;
}

/* 画像位置卡（Figma 679:3889） */
.result-card {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
  padding: var(--p3-card);
  border-radius: var(--p3-radius-card);
  background: var(--p3-surface);
}

.profile-card--risk {
  box-shadow: inset 0 0 0 2rpx var(--p3-risk-ink);
}

.profile-card__head {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.profile-card__kicker,
.profile-card__meta {
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

.profile-display-name {
  color: var(--p3-ink);
  font-family: var(--p3-font-serif);
  font-size: 48rpx;
  line-height: 64rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  overflow-wrap: anywhere;
}

.profile-card__label {
  color: var(--p3-ink);
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.profile-warning {
  color: var(--p3-warm-ink);
  font-size: 28rpx;
  line-height: 44rpx;
}

.position-frame {
  overflow: hidden;
  border-radius: var(--p3-radius-group);
  background: var(--p3-paper);
}

.position-canvas {
  display: block;
  width: 100%;
  height: 360rpx;
}

.radar-canvas {
  display: block;
  width: 100%;
  height: 400rpx;
}

.chart-legend {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.legend-row {
  display: flex;
  align-items: center;
  gap: var(--p3-tight);
}

.legend-mark {
  position: relative;
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 auto;
}

.legend-mark__image {
  position: absolute;
  left: 0;
  top: 0;
  width: 32rpx;
  height: 32rpx;
}

.legend-mark__index {
  position: absolute;
  left: 0;
  right: 0;
  top: -4rpx;
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
  text-align: center;
}

.legend-label {
  flex: 1 0 0;
  min-width: 0;
  color: var(--p3-ink);
  font-size: 28rpx;
  line-height: 44rpx;
}

/* 轮廓雷达图例：两列编号，列距 12、行距 4（Figma 679:3889） */
.radar-legend {
  flex-direction: row;
  gap: 24rpx;
}

.radar-legend__column {
  flex: 1 1 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.radar-legend__row {
  gap: 12rpx;
}

.legend-index {
  flex: 0 0 auto;
  color: var(--p3-ink);
  font-size: 28rpx;
  line-height: 44rpx;
}

.profile-meta,
.profile-boundary {
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

.profile-divider {
  height: 2rpx;
  background: var(--p3-hairline);
}

.profile-explanation {
  color: var(--p3-ink);
  font-size: 30rpx;
  line-height: 52rpx;
}

.profile-steps {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
  padding: 24rpx 28rpx;
  border-radius: var(--p3-radius-group);
  background: var(--p3-paper);
}

.profile-step {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.step-label {
  color: var(--p3-primary);
  font-size: 26rpx;
  line-height: 40rpx;
}

.step-text {
  color: var(--p3-ink);
  font-size: 28rpx;
  line-height: 44rpx;
}

/* 维度行（Figma 651:1712）：标题与宋体分数 → 看的是 → 量尺条（中点竖线）→ 量尺·题数·位置 → 提示块 */
.dimension-group {
  display: flex;
  flex-direction: column;
  padding: 8rpx 36rpx;
  border-radius: var(--p3-radius-group);
  background: var(--p3-surface);
}

.dimension-row {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 32rpx 0;
}

.dimension-row--divided {
  box-shadow: inset 0 -2rpx 0 var(--p3-hairline);
}

.dimension-row-head {
  display: flex;
  align-items: center;
  gap: var(--p3-tight);
}

.dimension-label {
  flex: 1 1 auto;
  min-width: 0;
  color: var(--p3-ink);
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: 500;
  overflow-wrap: anywhere;
}

.dimension-score {
  flex: 0 0 auto;
  color: var(--p3-ink);
  font-family: var(--p3-font-serif);
  font-size: 48rpx;
  line-height: 64rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  white-space: nowrap;
}

.dimension-max {
  flex: 0 0 auto;
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
  white-space: nowrap;
}

.dimension-definition {
  color: var(--p3-muted);
  font-size: 28rpx;
  line-height: 44rpx;
}

.dimension-progress {
  position: relative;
  height: 28rpx;
}

.dimension-progress::before {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 6rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: var(--p3-mist);
}

.dimension-progress-value {
  position: absolute;
  left: 0;
  top: 6rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: var(--p3-primary);
  opacity: 0.75;
}

.dimension-progress-midpoint {
  position: absolute;
  left: 50%;
  top: 0;
  width: 4rpx;
  height: 28rpx;
  margin-left: -2rpx;
  background: var(--p3-ink);
  opacity: 0.35;
}

.dimension-meta-row {
  display: flex;
  align-items: flex-start;
  gap: var(--p3-tight);
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

.dimension-meta-row__range {
  flex: 1 0 0;
  min-width: 0;
}

.dimension-meta-row__position {
  flex: 0 0 auto;
  white-space: nowrap;
}

.dimension-hint {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--p3-radius-group);
  background: var(--p3-paper);
}

.dimension-hint-label {
  color: var(--p3-ink);
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.dimension-hint-text {
  color: var(--p3-ink);
  font-size: 28rpx;
  line-height: 44rpx;
}

.dimension-hint--plain .dimension-hint-text {
  color: var(--p3-muted);
}

/* 维度雷达（Figma 679:3648）：卡内宽 × 228，图例在下方居中 */
.dimension-chart-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--p3-tight);
  padding: 36rpx 36rpx 28rpx;
  border-radius: var(--p3-radius-group);
  background: var(--p3-surface);
}

.dimension-radar-canvas {
  display: block;
  width: 100%;
  height: 456rpx;
}

.dimension-chart-legend {
  display: flex;
  align-items: center;
  gap: var(--p3-stack);
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

.dimension-legend-item {
  display: flex;
  align-items: center;
  gap: var(--p3-tight);
}

.dimension-legend-swatch {
  width: 36rpx;
  height: 12rpx;
}

.dimension-chart-note,
.dimension-guide-boundary {
  display: block;
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

/* 近期情绪与互动线索 */
.exploratory-card {
  display: flex;
  flex-direction: column;
  padding: 8rpx 36rpx;
  border-radius: var(--p3-radius-group);
  background: var(--p3-surface);
}

.exploratory-row {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 28rpx 0;
}

.exploratory-row + .exploratory-row {
  box-shadow: inset 0 2rpx 0 var(--p3-hairline);
}

.exploratory-status {
  color: var(--p3-ink);
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: 500;
}

.exploratory-reason,
.exploratory-empty {
  color: var(--p3-muted);
  font-size: 28rpx;
  line-height: 44rpx;
}

.exploratory-label {
  color: var(--p3-primary);
  font-size: 26rpx;
  line-height: 40rpx;
}

.exploratory-pair {
  display: flex;
  align-items: center;
  gap: var(--p3-tight);
}

.exploratory-pair__title {
  flex: 1 0 0;
  min-width: 0;
  color: var(--p3-ink);
  font-size: 28rpx;
  line-height: 44rpx;
}

.exploratory-pair__meta {
  flex: 0 0 auto;
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

.exploratory-link {
  color: var(--p3-ink);
  font-size: 28rpx;
  line-height: 44rpx;
}

/* 推荐训练卡（唯一实心按钮） */
.result-recommend {
  gap: var(--p3-stack);
}

.result-recommend__kicker {
  display: block;
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

.result-recommend__today {
  display: block;
  color: var(--p3-ink);
  font-size: 30rpx;
  line-height: 52rpx;
}

.result-recommend__cards {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.result-recommend__row {
  display: flex;
  align-items: center;
  gap: var(--p3-stack);
}

.result-recommend__role {
  flex: 0 0 auto;
}

.result-recommend__title {
  flex: 1 0 0;
  min-width: 0;
  color: var(--p3-ink);
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: 500;
}

.result-footer {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
}

.result-footer__text {
  display: block;
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

.result-missing {
  display: flex;
  flex-direction: column;
}
