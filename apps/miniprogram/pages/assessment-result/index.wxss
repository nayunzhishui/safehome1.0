.assessment-result-page {
  padding-bottom: 48rpx;
}

.result-hero {
  padding: 34rpx;
  border: 1rpx solid #dcebd8;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #eef8e9 0%, #fff8ed 100%);
  box-shadow: 0 14rpx 34rpx rgba(82, 112, 64, 0.12);
}

.result-kicker,
.result-title,
.result-summary,
.cell-label,
.cell-value,
.state-box {
  display: block;
}

.result-kicker {
  color: #4caf7d;
  font-size: 24rpx;
  font-weight: 800;
}

.result-title {
  margin-top: 12rpx;
  color: #25372c;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.35;
}

.result-summary {
  margin-top: 16rpx;
  color: #596a5b;
  font-size: 26rpx;
  line-height: 1.7;
}

.result-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 20rpx;
}

.result-cell {
  padding: 24rpx;
  border: 1rpx solid #e8efdf;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 26rpx rgba(80, 64, 45, 0.08);
}

.result-cell.wide {
  grid-column: 1 / -1;
}

.cell-label {
  color: #7a8777;
  font-size: 23rpx;
  line-height: 1.4;
}

.cell-value {
  margin-top: 10rpx;
  color: #25372c;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.45;
}

.action-button {
  margin-top: 24rpx;
}

.state-box {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  color: #596a5b;
  font-size: 26rpx;
  line-height: 1.7;
  box-shadow: 0 10rpx 26rpx rgba(80, 64, 45, 0.08);
}

.state-box.error {
  border: 1rpx solid #efb4b4;
  background: #fff1f1;
  color: #8a2f2f;
}
