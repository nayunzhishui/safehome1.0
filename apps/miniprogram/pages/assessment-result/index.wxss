.assessment-result-page {
  padding-bottom: 48rpx;
}

.result-head {
  padding: 10rpx 0 18rpx;
  border-bottom: 1rpx solid var(--safe-border);
  text-align: center;
}

.result-title,
.result-meta,
.state-box {
  display: block;
}

.result-title {
  color: var(--safe-title);
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.35;
}

.result-meta {
  margin-top: 8rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.6;
}

.risk-strip {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid rgba(192, 131, 59, 0.3);
  border-radius: var(--safe-radius-sm);
  background: var(--safe-orange-soft);
}

.risk-strip.high {
  border-color: rgba(196, 75, 75, 0.32);
  background: #fff0f0;
}

.risk-title, .risk-text { display: block; }

.risk-title {
  color: var(--safe-title);
  font-size: 26rpx;
  font-weight: 800;
}

.risk-text {
  margin-top: 6rpx;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.65;
}

.profile-card {
  padding: 26rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-lg);
  background: var(--safe-card);
  box-shadow: var(--safe-shadow-float);
}

.profile-card.high-risk {
  border-color: #f5c2c2;
  background: #fff6f6;
}

.profile-display-name {
  display: block;
  color: var(--safe-primary-deep);
  font-size: 38rpx;
  font-weight: 850;
  line-height: 1.2;
}

.profile-confidence, .profile-meta, .profile-explanation, .profile-boundary, .profile-warning { display: block; }

.profile-confidence {
  margin-top: 6rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
}

.profile-warning {
  margin-top: 12rpx;
  padding: 12rpx 14rpx;
  border: 1rpx solid #ead6ad;
  border-radius: 8rpx;
  background: #fff5df;
  color: #7a5b2e;
  font-size: 24rpx;
  line-height: 1.5;
}

.profile-meta {
  margin-top: 4rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
}

.profile-explanation {
  margin-top: 16rpx;
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.7;
}

.position-canvas {
  width: 100%;
  height: 300rpx;
  margin-top: 16rpx;
  border-radius: var(--safe-radius-sm);
}

.radar-canvas {
  width: 100%;
  height: 360rpx;
  margin-top: 20rpx;
}

.chart-legend {
  display: grid;
  gap: 8rpx 18rpx;
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-sm);
  background: var(--safe-bg);
}

.cluster-legend,
.radar-legend {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.legend-row {
  display: flex;
  align-items: flex-start;
  min-width: 0;
  gap: 8rpx;
}

.legend-index {
  display: flex;
  flex: 0 0 30rpx;
  align-items: center;
  justify-content: center;
  height: 30rpx;
  border-radius: 50%;
  background: #e8f0ea;
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 800;
}

.legend-current-dot {
  flex: 0 0 20rpx;
  width: 20rpx;
  height: 20rpx;
  margin: 5rpx;
  border-radius: 50%;
  background: var(--safe-primary);
}

.legend-label {
  min-width: 0;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.profile-steps {
  margin-top: 20rpx;
  display: grid;
  gap: 14rpx;
}

.profile-questions {
  position: relative;
  margin-top: 20rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-sm);
  background: var(--safe-primary-soft);
}

.profile-questions::before {
  content: "";
  display: block;
  width: 42rpx;
  height: 6rpx;
  margin-bottom: 12rpx;
  border-radius: 999rpx;
  background: var(--safe-primary);
}

.profile-question {
  display: block;
  margin-top: 8rpx;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.6;
}

.profile-step {
  padding: 16rpx 18rpx;
  border-radius: var(--safe-radius-md);
  background: var(--safe-bg);
}

.step-label, .step-text { display: block; }

.step-label {
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 800;
}

.step-text {
  margin-top: 4rpx;
  color: var(--safe-text);
  font-size: 25rpx;
  line-height: 1.65;
}

.profile-boundary {
  margin-top: 16rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.55;
}

.dimension-list {
  margin-top: 16rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  overflow: hidden;
  background: var(--safe-card);
}

.dimension-chart-card {
  margin-top: 16rpx;
  padding: 10rpx 14rpx 18rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-lg);
  background: #fffdf8;
  box-shadow: var(--safe-shadow-float);
}

.dimension-radar-canvas {
  width: 100%;
  height: 500rpx;
}

.dimension-chart-legend {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  color: var(--safe-text);
  font-size: 24rpx;
}

.dimension-legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.dimension-legend-swatch {
  width: 30rpx;
  height: 8rpx;
  border-radius: var(--safe-radius-pill);
}

.dimension-legend-swatch.current { background: var(--safe-primary); }
.dimension-legend-swatch.midpoint { background: #74add7; }

.dimension-chart-note {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: var(--safe-radius-sm);
  background: #f3f7f4;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.55;
}

.dimension-row {
  display: block;
  padding: 20rpx;
  border-bottom: 1rpx solid var(--safe-border);
}

.dimension-row:last-child { border-bottom: none; }

.dimension-label {
  flex: 1;
  min-width: 0;
  padding-right: 18rpx;
  color: var(--safe-title);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.dimension-score {
  flex: 0 0 auto;
  color: var(--safe-primary-deep);
  font-size: 26rpx;
  font-weight: 800;
}

.dimension-row-head,
.dimension-meta-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.dimension-progress {
  position: relative;
  height: 14rpx;
  margin-top: 16rpx;
  overflow: hidden;
  border-radius: var(--safe-radius-pill);
  background: #e8eeea;
}

.dimension-progress-value {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  border-radius: var(--safe-radius-pill);
  background: var(--safe-primary);
}

.dimension-progress-midpoint {
  position: absolute;
  z-index: 2;
  top: -3rpx;
  bottom: -3rpx;
  left: 50%;
  width: 3rpx;
  background: #74add7;
}

.dimension-meta-row {
  margin-top: 10rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.45;
}

.dimension-summary {
  display: block;
  margin-top: 10rpx;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.55;
}

.recommendation-block { margin-top: 16rpx; }

.exploratory-card {
  display: grid;
  gap: 18rpx;
  padding: 22rpx;
  border: 1rpx solid var(--safe-border);
  border-left: 7rpx solid var(--safe-primary);
  border-radius: var(--safe-radius-md);
  background: var(--safe-card);
}

.exploratory-card.withheld { border-left-color: var(--safe-danger); }
.exploratory-card.insufficient,
.exploratory-card.ineligible { border-left-color: var(--safe-warning); }

.exploratory-head,
.exploratory-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 18rpx;
}

.exploratory-status,
.exploratory-label {
  color: var(--safe-title);
  font-size: 27rpx;
  font-weight: 800;
}

.exploratory-count,
.exploratory-row-meta {
  color: var(--safe-muted);
  font-size: 23rpx;
}

.exploratory-content,
.exploratory-group { display: grid; gap: 12rpx; }

.exploratory-group {
  padding-top: 14rpx;
  border-top: 1rpx solid var(--safe-border);
}

.exploratory-row-title {
  color: var(--safe-text);
  font-size: 25rpx;
  font-weight: 700;
}

.exploratory-link,
.exploratory-empty,
.exploratory-reason,
.exploratory-boundary {
  display: block;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.65;
}

.exploratory-link + .exploratory-link { margin-top: 8rpx; }
.exploratory-empty,
.exploratory-boundary { color: var(--safe-muted); }
.exploratory-boundary { font-size: 22rpx; }

.rec-suggestion {
  display: block;
  margin-bottom: 16rpx;
  color: var(--safe-text);
  font-size: 25rpx;
  line-height: 1.65;
}

.rec-card-list { display: grid; gap: 12rpx; }

.rec-card-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: var(--safe-card);
}

.rec-role {
  flex: 0 0 auto;
  padding: 4rpx 12rpx;
  border-radius: var(--safe-radius-pill);
  background: var(--safe-primary-soft);
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 800;
}

.rec-card-copy { flex: 1; min-width: 0; }

.rec-card-title {
  display: block;
  color: var(--safe-title);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.4;
}

.rec-card-purpose {
  display: block;
  margin-top: 4rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.55;
}

.result-actions {
  display: grid;
  gap: 14rpx;
  margin-top: 36rpx;
}

.state-box {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: var(--safe-radius-md);
  background: var(--safe-card);
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.7;
}

.state-box.error {
  border: 1rpx solid #efb4b4;
  background: #fff1f1;
  color: #8a2f2f;
}

/* UIproduct2: task-scoped visual refinement, no business behavior. */
.ui2-page { --ui2-section-accent-display:none; --safe-shadow-card:none; --safe-shadow-float:none; box-sizing:border-box; background:var(--ui2-canvas); padding:48rpx 40rpx calc(64rpx + env(safe-area-inset-bottom)); }
.ui2-page .page-title,.ui2-page .hero-title,.ui2-page .history-title,.ui2-page .result-title { font-size:44rpx; line-height:1.6; font-weight:700; text-align:center; color:var(--ui2-ink); }
.ui2-page .safe-primary-button,.ui2-page .safe-outline-button { min-height:96rpx; padding:22rpx 24rpx; border-radius:24rpx; font-size:30rpx; line-height:1.6; box-shadow:none; }
.ui2-page .ui2-placeholder { color:var(--ui2-muted); }
.ui2-page .result-head { padding:0 0 32rpx; }
.ui2-page .profile-card { padding:24rpx 0; border:0; border-bottom:1rpx solid var(--ui2-line); border-radius:0; background:transparent; box-shadow:none; }
.ui2-page .profile-display-name { font-size:36rpx; line-height:1.6; }
.ui2-page .profile-confidence,.ui2-page .profile-meta,.ui2-page .dimension-meta-row,.ui2-page .exploratory-count { font-size:26rpx; line-height:1.6; }
.ui2-page .profile-explanation,.ui2-page .profile-warning,.ui2-page .profile-boundary,.ui2-page .risk-text,.ui2-page .step-text,.ui2-page .profile-question,.ui2-page .dimension-summary,.ui2-page .dimension-chart-note,.ui2-page .exploratory-reason,.ui2-page .exploratory-boundary,.ui2-page .rec-suggestion { font-size:30rpx; line-height:1.7; }
.ui2-page .step-label,.ui2-page .risk-title,.ui2-page .dimension-label,.ui2-page .exploratory-status,.ui2-page .rec-card-title { font-size:32rpx; line-height:1.6; font-weight:700; }
.ui2-page .profile-questions { padding:24rpx 0; background:transparent; border:0; border-top:1rpx solid var(--ui2-line); }
.ui2-page .profile-questions::before { display:none; }
.ui2-page .profile-warning { background:var(--ui2-warm); color:#765323; }
.ui2-page .high-risk .profile-warning,.ui2-page .risk-strip.high { background:#fff4f1; color:#a5453f; }
.ui2-page .dimension-row,.ui2-page .rec-card-row { border:0; border-bottom:1rpx solid var(--ui2-line); border-radius:0; padding:24rpx 0; background:transparent; }
.ui2-page .dimension-row-head,.ui2-page .dimension-meta-row,.ui2-page .exploratory-head { flex-wrap:wrap; gap:16rpx; }
.ui2-page .dimension-score { font-size:30rpx; }
.ui2-page .exploratory-card { padding:24rpx; border:0; border-radius:24rpx; background:var(--ui2-soft); }
.ui2-page .exploratory-link,.ui2-page .exploratory-row-meta,.ui2-page .exploratory-empty,.ui2-page .rec-card-purpose { font-size:28rpx; line-height:1.7; }
.ui2-page .rec-role { font-size:26rpx; }
.ui2-page .result-actions { display:grid; grid-template-columns:1fr; gap:16rpx; }
.ui2-page .action-button { width:100%; }
.ui2-page .source-notice { padding:24rpx 0; border-top:1rpx solid var(--ui2-line); }
.ui2-page .source-title,.ui2-page .source-copy { display:block; color:var(--ui2-ink); font-size:28rpx; line-height:1.7; }
.ui2-page .source-title { margin-bottom:12rpx; font-size:32rpx; font-weight:700; }
.ui2-page .state-box { font-size:30rpx; line-height:1.7; }

.ui2-page .dimension-list { padding:0; border:0; border-radius:0; background:transparent; box-shadow:none; }
.ui2-page .dimension-chart-card { border:0; box-shadow:none; background:transparent; }
