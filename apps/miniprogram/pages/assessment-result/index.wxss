.assessment-result-page {
  padding-bottom: 48rpx;
}

.result-head {
  padding: 4rpx 0 16rpx;
  border-bottom: 1rpx solid var(--safe-border);
}

.result-title,
.result-meta,
.state-box {
  display: block;
}

.result-title {
  color: var(--safe-title);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.35;
}

.result-meta {
  margin-top: 8rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.6;
}

.risk-strip {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-left: 5rpx solid var(--safe-warning);
  border-radius: var(--safe-radius-sm);
  background: var(--safe-orange-soft);
}

.risk-strip.high {
  border-left-color: var(--safe-danger);
  background: #fff0f0;
}

.risk-title, .risk-text { display: block; }

.risk-title {
  color: var(--safe-title);
  font-size: 26rpx;
  font-weight: 800;
}

.risk-text {
  margin-top: 6rpx;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.65;
}

.profile-card {
  padding: 26rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-lg);
  background: var(--safe-card);
  box-shadow: var(--safe-shadow-float);
}

.profile-card.high-risk {
  border-color: #f5c2c2;
  background: #fff6f6;
}

.profile-display-name {
  display: block;
  color: var(--safe-primary-deep);
  font-size: 38rpx;
  font-weight: 850;
  line-height: 1.2;
}

.profile-confidence, .profile-meta, .profile-explanation, .profile-boundary, .profile-warning { display: block; }

.profile-confidence {
  margin-top: 6rpx;
  color: var(--safe-muted);
  font-size: 22rpx;
}

.profile-warning {
  margin-top: 12rpx;
  padding: 12rpx 14rpx;
  border: 1rpx solid #ead6ad;
  border-radius: 8rpx;
  background: #fff5df;
  color: #7a5b2e;
  font-size: 24rpx;
  line-height: 1.5;
}

.profile-meta {
  margin-top: 4rpx;
  color: var(--safe-muted);
  font-size: 21rpx;
}

.profile-explanation {
  margin-top: 16rpx;
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.7;
}

.position-canvas {
  width: 100%;
  height: 180rpx;
  margin-top: 16rpx;
  border-radius: var(--safe-radius-sm);
}

.radar-canvas {
  width: 100%;
  height: 220rpx;
  margin-top: 8rpx;
}

.profile-steps {
  margin-top: 20rpx;
  display: grid;
  gap: 14rpx;
}

.profile-step {
  padding: 16rpx 18rpx;
  border-radius: var(--safe-radius-md);
  background: var(--safe-bg);
}

.step-label, .step-text { display: block; }

.step-label {
  color: var(--safe-primary-deep);
  font-size: 22rpx;
  font-weight: 800;
}

.step-text {
  margin-top: 4rpx;
  color: var(--safe-text);
  font-size: 25rpx;
  line-height: 1.65;
}

.profile-boundary {
  margin-top: 16rpx;
  color: var(--safe-muted);
  font-size: 21rpx;
  line-height: 1.55;
}

.dimension-list {
  margin-top: 16rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  overflow: hidden;
  background: var(--safe-card);
}

.dimension-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid var(--safe-border);
}

.dimension-row:last-child { border-bottom: none; }

.dimension-label {
  color: var(--safe-title);
  font-size: 26rpx;
  font-weight: 700;
}

.dimension-score {
  color: var(--safe-primary-deep);
  font-size: 26rpx;
  font-weight: 800;
}

.recommendation-block { margin-top: 16rpx; }

.rec-suggestion {
  display: block;
  margin-bottom: 16rpx;
  color: var(--safe-text);
  font-size: 25rpx;
  line-height: 1.65;
}

.rec-card-list { display: grid; gap: 12rpx; }

.rec-card-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 16rpx 18rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: var(--safe-card);
}

.rec-role {
  flex: 0 0 auto;
  padding: 4rpx 12rpx;
  border-radius: var(--safe-radius-pill);
  background: var(--safe-primary-soft);
  color: var(--safe-primary-deep);
  font-size: 20rpx;
  font-weight: 800;
}

.rec-card-copy { flex: 1; min-width: 0; }

.rec-card-title {
  display: block;
  color: var(--safe-title);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.4;
}

.rec-card-purpose {
  display: block;
  margin-top: 4rpx;
  color: var(--safe-muted);
  font-size: 23rpx;
  line-height: 1.55;
}

.result-actions {
  display: grid;
  gap: 14rpx;
  margin-top: 36rpx;
}

.state-box {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: var(--safe-radius-md);
  background: var(--safe-card);
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.7;
}

.state-box.error {
  border: 1rpx solid #efb4b4;
  background: #fff1f1;
  color: #8a2f2f;
}
