.emergency-page {
  padding-bottom: 72rpx;
}

.page-kicker,
.page-title,
.page-summary,
.step-text,
.warning-title,
.warning-text {
  display: block;
}

.page-kicker {
  color: #9F3E38;
  font-size: 24rpx;
  font-weight: 850;
}

.page-title {
  margin-top: 12rpx;
  color: var(--safe-title);
  font-size: 42rpx;
  font-weight: 900;
}

.page-summary {
  margin-top: 16rpx;
  color: var(--safe-text);
  font-size: 27rpx;
  line-height: 1.75;
}

.step-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 18rpx;
}

.step-row {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
  padding: 20rpx 22rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: var(--safe-card);
}

.step-number {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  flex: 0 0 38rpx;
  border-radius: 50%;
  background: var(--safe-primary-soft);
  color: var(--safe-primary-deep);
  font-size: 20rpx;
  font-weight: 900;
}

.step-text {
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.65;
}

.warning-card {
  padding: 24rpx 28rpx;
  border: 1rpx solid rgba(215, 111, 103, 0.26);
  border-radius: var(--safe-radius-md);
  background: rgba(255, 244, 240, 0.92);
}

.warning-title {
  color: #9F3E38;
  font-size: 27rpx;
  font-weight: 900;
}

.warning-text {
  margin-top: 10rpx;
  color: var(--safe-text);
  font-size: 25rpx;
  line-height: 1.75;
}

.bottom-action {
  margin-top: 32rpx;
}
