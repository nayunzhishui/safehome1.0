.emergency-page {
  box-sizing: border-box;
  padding: 48rpx 48rpx calc(320rpx + env(safe-area-inset-bottom));
}

.page-kicker,
.page-title,
.page-summary,
.section-heading,
.section-note,
.action-number,
.step-text,
.boundary-title,
.boundary-text {
  display: block;
}

.emergency-header {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  align-items: center;
  text-align: center;
}

.page-kicker {
  color: var(--experience-danger);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.page-title {
  color: var(--experience-ink);
  font-size: 44rpx;
  font-weight: 700;
  line-height: 60rpx;
  text-align: center;
}

.page-summary {
  color: var(--experience-muted);
  font-size: var(--experience-font-body);
  line-height: 44rpx;
}

.safety-rule {
  width: 112rpx;
  height: 4rpx;
  background: var(--experience-danger);
}

.safety-intro {
  margin-top: 32rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid var(--safe-border);
  border-bottom: 1rpx solid var(--safe-border);
  color: var(--experience-ink);
  font-size: 30rpx;
  line-height: 1.65;
}

.emergency-section {
  margin-top: 48rpx;
}

.section-heading {
  color: var(--experience-ink);
  font-size: var(--experience-font-title);
  font-weight: 700;
  line-height: 56rpx;
}

.section-note {
  margin-top: 16rpx;
  color: var(--experience-muted);
  font-size: var(--experience-font-caption);
  line-height: 36rpx;
}

.action-list {
  display: flex;
  flex-direction: column;
  margin-top: 16rpx;
}

.action-row {
  min-height: 160rpx;
  display: flex;
  gap: 32rpx;
  align-items: flex-start;
  padding: 32rpx 8rpx;
  border-bottom: 1rpx solid var(--experience-line);
}

.action-number {
  width: 100rpx;
  flex: 0 0 100rpx;
  color: var(--experience-primary-deep);
  font-size: 44rpx;
  font-weight: 700;
  line-height: 60rpx;
}

.step-text {
  min-width: 0;
  flex: 1;
  color: var(--experience-ink);
  font-size: var(--experience-font-body);
  line-height: 44rpx;
  overflow-wrap: anywhere;
}

.boundary-note {
  margin-top: 48rpx;
  padding-top: 32rpx;
}

.boundary-rule {
  height: 1rpx;
  margin-bottom: 16rpx;
  background: var(--experience-line);
}

.boundary-title {
  color: var(--experience-ink);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.boundary-text {
  margin-top: 16rpx;
  color: var(--experience-muted);
  font-size: var(--experience-font-caption);
  line-height: 36rpx;
}

.safety-action-dock {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 8;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 32rpx 48rpx calc(40rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--experience-line);
  background: var(--experience-surface);
}

.safety-action {
  width: 100%;
  border-radius: 24rpx;
}

@media (max-width: 340px) {
  .action-number {
    width: 84rpx;
    flex-basis: 84rpx;
  }
}

.safety-intro { padding: 28rpx; border: 0; border-radius: 24rpx; background: var(--ui2-warm); }
.boundary-text { font-size:30rpx; line-height:48rpx; }
.safety-action-dock { box-sizing:border-box; padding-top:24rpx; padding-bottom:calc(24rpx + env(safe-area-inset-bottom)); gap:12rpx; }
@media(max-width:340px){.emergency-page{padding-left:32rpx;padding-right:32rpx}.safety-action-dock{padding-left:32rpx;padding-right:32rpx}}
