/* 人工支持（Figma 671:3332）：先确认边界（暖色提示 + 风险红字）、请求表单卡（关联记录单选、三个字段、提交）。 */
.supervision-page {
  display: flex;
  flex-direction: column;
  gap: var(--p3-section);
  padding-top: 16rpx;
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
}

.supervision-boundary {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
}

.supervision-risk {
  color: var(--p3-risk-ink);
  font-size: 28rpx;
  line-height: 44rpx;
}

.supervision-form {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
  padding: var(--p3-card);
  border-radius: var(--p3-radius-card);
  background: var(--p3-surface);
}

.supervision-sources {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
}

.supervision-source-error {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
