.page {
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: var(--safe-bg);
}

.hero {
  margin-bottom: 28rpx;
  padding: 32rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: 16rpx;
  background: linear-gradient(135deg, #fffdf8 0%, #edf6e8 100%);
  box-shadow: 0 14rpx 34rpx rgba(52, 66, 58, 0.08);
}

.eyebrow {
  display: block;
  margin-bottom: 10rpx;
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  display: block;
  margin-bottom: 14rpx;
  color: var(--safe-title);
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.32;
}

.summary,
.notice-text,
.meta-text {
  display: block;
  color: var(--safe-text);
  font-size: 28rpx;
  line-height: 1.7;
}

.hero-image {
  width: 100%;
  height: 300rpx;
  display: block;
  margin-top: 24rpx;
  overflow: hidden;
  border-radius: 16rpx;
  background: #fff4e8;
}

.notice-box {
  margin-bottom: 24rpx;
  padding: 22rpx;
  border: 1rpx solid #f5d8aa;
  border-radius: 16rpx;
  background: #fff4e8;
}

.notice-title {
  display: block;
  margin-bottom: 8rpx;
  color: #735b21;
  font-size: 28rpx;
  font-weight: 700;
}

.panel {
  padding: 32rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: 16rpx;
  background: var(--safe-card);
  box-shadow: 0 14rpx 34rpx rgba(52, 66, 58, 0.08);
}

.field {
  margin-bottom: 28rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  color: var(--safe-title);
  font-size: 28rpx;
  font-weight: 700;
}

.input,
.textarea {
  box-sizing: border-box;
  width: 100%;
  padding: 20rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: 16rpx;
  background: #fffdf8;
  color: var(--safe-title);
  font-size: 28rpx;
  line-height: 1.6;
}

.input {
  min-height: 80rpx;
}

.textarea {
  min-height: 160rpx;
}

.status {
  margin-bottom: 24rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.status.success {
  border: 1rpx solid #cddfc5;
  background: #edf6e8;
  color: #1d2b22;
}

.status.error {
  border: 1rpx solid #efd0cc;
  background: #fbe8e2;
  color: #8a2f2f;
}

.primary-button {
  min-height: 88rpx;
  margin-top: 8rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, var(--safe-primary), var(--safe-primary-deep));
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 14rpx 28rpx rgba(78, 124, 107, 0.22);
}

.secondary-button {
  min-height: 88rpx;
  margin-top: 20rpx;
  border: 1rpx solid var(--safe-primary);
  border-radius: 44rpx;
  background: var(--safe-card);
  color: var(--safe-primary-deep);
  font-size: 28rpx;
  font-weight: 700;
}
