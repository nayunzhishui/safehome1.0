.page {
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: #fff7ec;
}

.hero {
  margin-bottom: 28rpx;
  padding: 32rpx;
  border: 1rpx solid #efe7dc;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f7faf4 100%);
  box-shadow: 0 12rpx 32rpx rgba(80, 64, 45, 0.08);
}

.eyebrow {
  display: block;
  margin-bottom: 10rpx;
  color: #4caf7d;
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  display: block;
  margin-bottom: 14rpx;
  color: #333333;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.32;
}

.summary,
.notice-text,
.meta-text {
  display: block;
  color: #555555;
  font-size: 28rpx;
  line-height: 1.7;
}

.notice-box {
  margin-bottom: 24rpx;
  padding: 22rpx;
  border: 1rpx solid #f2ddc3;
  border-radius: 20rpx;
  background: #fff9e8;
}

.notice-title {
  display: block;
  margin-bottom: 8rpx;
  color: #735b21;
  font-size: 28rpx;
  font-weight: 700;
}

.panel {
  padding: 32rpx;
  border: 1rpx solid #efe7dc;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(80, 64, 45, 0.08);
}

.field {
  margin-bottom: 28rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  color: #333333;
  font-size: 28rpx;
  font-weight: 700;
}

.input,
.textarea {
  box-sizing: border-box;
  width: 100%;
  padding: 20rpx;
  border: 1rpx solid #e9e3d8;
  border-radius: 18rpx;
  background: #fffdf9;
  color: #333333;
  font-size: 28rpx;
  line-height: 1.6;
}

.input {
  min-height: 80rpx;
}

.textarea {
  min-height: 160rpx;
}

.status {
  margin-bottom: 24rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.status.success {
  border: 1rpx solid #b8dfbe;
  background: #edf8ee;
  color: #1d2b22;
}

.status.error {
  border: 1rpx solid #efb4b4;
  background: #fff1f1;
  color: #8a2f2f;
}

.primary-button {
  min-height: 88rpx;
  margin-top: 8rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #7ccb8a, #4caf7d);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 26rpx rgba(76, 175, 125, 0.22);
}

.secondary-button {
  min-height: 88rpx;
  margin-top: 20rpx;
  border: 1rpx solid #ffb26b;
  border-radius: 44rpx;
  background: #ffffff;
  color: #f28b38;
  font-size: 28rpx;
  font-weight: 700;
}
