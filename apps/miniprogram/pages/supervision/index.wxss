.supervision-page {
  padding-bottom: 72rpx;
}

.supervision-hero {
  position: relative;
  overflow: hidden;
  margin-bottom: 28rpx;
  padding: 32rpx;
  border: 1rpx solid var(--safe-border);
  border: 0;
  border-radius: var(--safe-radius-md);
  background: var(--safe-card);
  box-shadow: var(--safe-shadow-card);
  text-align: center;
}

.hero-copy {
  position: relative;
  z-index: 1;
}

.eyebrow {
  display: block;
  margin-bottom: 10rpx;
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 800;
}

.title {
  display: block;
  margin-bottom: 14rpx;
  color: var(--safe-title);
  font-size: 46rpx;
  font-weight: 850;
  line-height: 1.32;
}

.summary,
.notice-text,
.meta-text {
  display: block;
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.7;
}

.boundary-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
  border: 1rpx solid #efc09d;
  border-radius: var(--safe-radius-md);
  background: var(--safe-orange-soft);
}

.boundary-title {
  display: block;
  margin-bottom: 10rpx;
  color: #8a5a2f;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.45;
}

.boundary-text {
  display: block;
  color: #7a4d25;
  font-size: 25rpx;
  line-height: 1.7;
}

.boundary-text.strong {
  margin-top: 10rpx;
  font-weight: 700;
}

.form-card {
  padding: 32rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: var(--safe-card);
  box-shadow: var(--safe-shadow-card);
}

.field {
  margin-bottom: 28rpx;
}

.linked-record {
  padding: 20rpx;
  border: 1rpx solid #dcebd8;
  border-radius: 20rpx;
  background: #f9fcf6;
}

.source-list {
  max-height: 420rpx;
  margin-top: 18rpx;
}

.source-option {
  width: 100%;
  min-height: 96rpx;
  margin: 0 0 12rpx;
  padding: 16rpx 18rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: 18rpx;
  background: var(--safe-card);
  text-align: left;
}

.source-option--active {
  border-color: var(--safe-primary);
  background: var(--safe-primary-pale);
}

.source-option::after {
  border: 0;
}

.source-copy {
  min-width: 0;
  flex: 1;
}

.source-title,
.source-meta {
  display: block;
}

.source-title {
  color: var(--safe-title);
  font-size: 24rpx;
  font-weight: 800;
}

.source-meta {
  margin-top: 4rpx;
  overflow: hidden;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.source-check {
  flex: 0 0 auto;
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 800;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  color: var(--safe-title);
  font-size: 27rpx;
  font-weight: 800;
}

.input,
.textarea {
  box-sizing: border-box;
  width: 100%;
  padding: 20rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: 20rpx;
  background: #fffdf8;
  color: var(--safe-title);
  font-size: 26rpx;
  line-height: 1.6;
}

.input {
  min-height: 80rpx;
}

.textarea {
  min-height: 160rpx;
}

.status {
  margin-bottom: 24rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  line-height: 1.6;
}

.status.success {
  border: 1rpx solid #cddfc5;
  background: #edf6e8;
  color: #1d2b22;
}

.status.error {
  border: 1rpx solid #efd0cc;
  background: #fbe8e2;
  color: #8a2f2f;
}

.submit-button {
  margin-top: 8rpx;
}

.back-button {
  margin-top: 20rpx;
}

.draft-status {
  display: block;
  margin-bottom: 14rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.55;
}

.draft-status--slow {
  color: #8a5a2f;
}
