<view class="safe-page supervision-page" role="main" aria-label="人工支持">
  <view class="supervision-hero">
    <view class="hero-copy">
      <text class="title">人工支持</text>
    </view>
  </view>

  <view class="boundary-card">
    <text class="boundary-title">先确认边界</text>
    <text class="boundary-text">人工反馈可能需要等待，适合补充理解一条记录，不适合处理紧急安全风险。</text>
    <text class="boundary-text strong">如果你或孩子正在经历自伤、自杀、暴力、失控或其他安全风险，请先联系身边可信赖的人、当地紧急服务或线下专业机构。</text>
  </view>

  <view class="form-card">
    <view class="field linked-record">
      <text class="label">选择想请老师一起看的记录</text>
      <scroll-view scroll-y class="source-list">
        <button
          wx:for="{{sourceOptions}}"
          wx:key="id"
          class="source-option {{item.selected ? 'source-option--active' : ''}}"
          data-type="{{item.type}}"
          data-id="{{item.id}}"
          bindtap="selectSource"
        >
          <view class="source-copy">
            <text class="source-title">{{item.title}}</text>
            <text class="source-meta">{{item.meta}}</text>
          </view>
          <text class="source-check">{{item.selected ? '已选择' : '选择'}}</text>
        </button>
      </scroll-view>
    </view>

    <view class="field">
      <text class="label">想请老师补充看的内容</text>
      <textarea
        class="textarea"
        value="{{message}}"
        placeholder="例如：这次记录里，我想知道可以先从哪个小动作开始练。"
        bindinput="onTextInput"
        data-key="message"
      />
    </view>

    <view class="field">
      <text class="label">可选联系方式</text>
      <input
        class="input"
        value="{{contact}}"
        placeholder="可不填。只填写你愿意用于后续沟通的信息。"
        bindinput="onTextInput"
        data-key="contact"
      />
    </view>

    <view class="field">
      <text class="label">可选风险提示</text>
      <textarea
        class="textarea"
        value="{{riskHint}}"
        placeholder="可不填。如果有需要老师特别留意的安全或压力信息，可以简单写一句。紧急情况请先找现实支持。"
        bindinput="onTextInput"
        data-key="riskHint"
      />
    </view>

    <view wx:if="{{successMessage}}" class="status success">
      <text>{{successMessage}}</text>
    </view>

    <view wx:if="{{errorMessage}}" class="status error">
      <text>{{errorMessage}}</text>
    </view>

    <text class="draft-status" aria-live="polite">{{draftRestored ? '已恢复：' : ''}}{{saveStatus}}</text>
    <text wx:if="{{slowSubmitting}}" class="draft-status draft-status--slow">网络响应较慢；草稿仍在本机，请不要重复点击。</text>

    <button class="safe-primary-button submit-button" bindtap="submitSupervision" disabled="{{submitting}}">
      {{submitting ? '提交中...' : '提交给老师补充看看'}}
    </button>

    <button class="safe-secondary-button back-button" bindtap="goHome">回到首页</button>
  </view>
</view>
