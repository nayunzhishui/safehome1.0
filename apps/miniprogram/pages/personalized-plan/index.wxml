<view class="p3-page plan-page" role="main" aria-label="个性化训练方案">
  <view class="p3-card plan-rhythm">
    <view class="plan-rhythm__head">
      <text class="p3-action-title plan-rhythm__title" role="heading" aria-level="1">安排练习节奏</text>
      <status-pill label="{{assignment.agreement_status === 'researcher_confirmed' ? '已共同确认' : '本人设置'}}" tone="success" />
    </view>
    <text class="p3-body-compact">先选一个当前可承受的频率，之后可以随时调整。</text>

    <text class="p3-meta">当前阶段</text>
    <view class="p3-segment" role="radiogroup" aria-label="当前阶段">
      <button
        wx:for="{{phaseOptions}}"
        wx:key="value"
        class="p3-segment__item {{assignment.phase === item.value ? 'p3-segment__item--active' : ''}}"
        role="radio"
        aria-checked="{{assignment.phase === item.value}}"
        data-field="phase"
        data-value="{{item.value}}"
        bindtap="selectAssignmentOption"
      >{{item.label}}</button>
    </view>

    <text class="p3-meta">练习频率</text>
    <view class="plan-chips" role="radiogroup" aria-label="练习频率">
      <button
        wx:for="{{cadenceOptions}}"
        wx:key="value"
        class="p3-chip {{assignment.cadence === item.value ? 'p3-chip--selected' : ''}}"
        role="radio"
        aria-checked="{{assignment.cadence === item.value}}"
        data-field="cadence"
        data-value="{{item.value}}"
        bindtap="selectAssignmentOption"
      >{{item.label}}</button>
    </view>

    <view class="p3-field">
      <text class="p3-field__label">开始日期</text>
      <picker aria-label="选择练习开始日期" mode="date" value="{{assignment.start_date}}" bindchange="onStartDateChange">
        <view class="p3-field__input plan-date">{{startDateText}}</view>
      </picker>
    </view>

    <text class="p3-meta">计划状态</text>
    <view class="p3-segment" role="radiogroup" aria-label="计划状态">
      <button
        wx:for="{{statusOptions}}"
        wx:key="value"
        class="p3-segment__item {{assignment.status === item.value ? 'p3-segment__item--active' : ''}}"
        role="radio"
        aria-checked="{{assignment.status === item.value}}"
        data-field="status"
        data-value="{{item.value}}"
        bindtap="selectAssignmentOption"
      >{{item.label}}</button>
    </view>

    <view class="p3-field">
      <label for="plan-goal" class="p3-field__label">这一阶段的小目标（可选）</label>
      <textarea
        id="plan-goal"
        class="p3-field__input p3-field__input--multi"
        aria-label="这一阶段的小目标，可选，最多200字"
        placeholder-class="p3-field__placeholder"
        value="{{assignment.goal_text}}"
        maxlength="200"
        placeholder="可选：写下这一阶段最想练习的一小步"
        bindinput="onGoalInput"
      />
      <text class="p3-field__hint">{{goalCount}} / 200</text>
    </view>

    <button class="p3-btn p3-btn--primary" loading="{{savingAssignment}}" disabled="{{savingAssignment}}" bindtap="saveAssignment">保存练习节奏</button>

    <view wx:if="{{assignment.due_reason}}" class="plan-cadence">
      <text class="plan-cadence__title">{{assignment.is_due_today ? '今天可以练一次' : assignment.cadence_label}}</text>
      <text class="plan-cadence__text">{{assignment.due_reason}}</text>
    </view>
    <text class="p3-footnote">{{assignment.boundary_notice || '练习节奏由用户自行设置，研究者共同确认前不代表正式干预安排。'}}</text>
  </view>

  <view wx:if="{{plan && plan.assignment}}" class="plan-reminder">
    <view class="plan-reminder__head">
      <view class="plan-reminder__badge" aria-hidden="true">
        <p3-icon name="bell" size="20" tone="primary" />
      </view>
      <view class="plan-reminder__copy">
        <text class="p3-item-title" role="heading" aria-level="2">微信练习提醒</text>
        <text class="p3-meta">只在你主动授权后发送；关闭提醒不影响训练。</text>
      </view>
    </view>
    <text class="plan-reminder__state">{{reminder.title}} · {{reminder.text}}</text>
    <button wx:if="{{reminder.showRequest}}" class="p3-btn p3-btn--secondary" loading="{{requestingReminder}}" disabled="{{requestingReminder}}" bindtap="requestTrainingReminder">开启一次微信提醒</button>
    <button wx:if="{{reminder.showSettings}}" class="p3-btn p3-btn--secondary" bindtap="openNotificationSettings">前往微信设置</button>
  </view>

  <page-state wx:if="{{loading}}" kind="loading" title="正在读取训练方案" />
  <page-state wx:elif="{{errorMessage}}" kind="error" title="暂时没能读取训练方案" description="{{errorMessage}}" action-label="重试" bind:action="loadPlan" />

  <block wx:else>
    <view wx:if="{{plan && !plan.has_assessment}}" class="plan-empty">
      <text class="p3-item-title">{{plan.next_action.title}}</text>
      <text class="p3-body-compact">{{plan.next_action.description}}</text>
      <button class="p3-btn p3-btn--secondary" bindtap="openAssessment">去测一测</button>
    </view>

    <view wx:for="{{planItems}}" wx:key="source_result_id" class="plan-item">
      <view class="plan-item__source">
        <status-pill label="{{item.sourceLabel}}" tone="success" />
        <text class="p3-meta plan-item__worksheet">{{item.source_worksheet.title}}</text>
      </view>
      <text wx:if="{{item.cluster_name}}" class="p3-item-title">{{item.cluster_name}}</text>
      <text class="plan-item__reason">{{item.reason}}</text>
      <view class="p3-group p3-group--course">
        <button
          wx:for="{{item.cards}}"
          wx:for-item="card"
          wx:for-index="cardIndex"
          wx:key="id"
          class="plan-item__card"
          data-card-id="{{card.id}}"
          aria-label="打开训练卡：{{card.title}}"
          bindtap="openSingleCard"
        >
          <p3-course-row title="{{card.title}}" scene="{{card.sceneText}}" meta="{{card.metaText}}" show-divider="{{cardIndex < item.cards.length - 1}}" />
        </button>
      </view>
      <text wx:if="{{item.boundary_notice}}" class="p3-footnote">{{item.boundary_notice}}</text>
    </view>

    <view wx:if="{{plan && plan.has_assessment && !planItems.length}}" class="plan-empty">
      <text class="p3-item-title">{{plan.assignment && !plan.assignment.is_due_today ? '今天不用赶进度' : '暂未匹配到训练卡'}}</text>
      <text class="p3-body-compact">{{plan.assignment && !plan.assignment.is_due_today ? plan.assignment.due_reason : '可以先从通用训练里选择一张最容易完成的卡。'}}</text>
    </view>
  </block>

  <text class="p3-footnote">{{boundaryNotice}}</text>
</view>
