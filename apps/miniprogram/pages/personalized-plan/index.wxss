.plan-page {
  display: flex;
  flex-direction: column;
  gap: 26rpx;
}

.page-head {
  padding: 26rpx 0 4rpx;
  border: 0;
  box-shadow: none;
  background: transparent;
}

.empty-card,
.item-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.assignment-panel {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.assignment-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.assignment-state {
  flex: 0 0 auto;
  padding: 6rpx 14rpx;
  border-radius: var(--safe-radius-pill);
  background: var(--safe-blue-soft);
  color: var(--safe-blue);
  font-size: 22rpx;
  font-weight: 800;
}

.assignment-label {
  color: var(--safe-title);
  font-size: 24rpx;
  font-weight: 800;
}

.segmented-control {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}

.segmented-control--wrap {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.segment-button {
  min-height: var(--safe-touch);
  padding: 0 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-sm);
  background: #ffffff;
  color: var(--safe-text);
  font-size: 24rpx;
  font-weight: 750;
  line-height: 1.35;
  text-align: center;
}

.segment-button--active {
  border-color: var(--safe-primary);
  background: var(--safe-primary-soft);
  color: var(--safe-primary-deep);
}

.assignment-field {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.picker-value,
.goal-input {
  box-sizing: border-box;
  width: 100%;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-sm);
  background: #ffffff;
  color: var(--safe-title);
  font-size: 25rpx;
}

.cadence-summary {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 18rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-sm);
  background: var(--safe-bg-soft);
  text-align: center;
}

.cadence-summary--due {
  border-color: var(--safe-primary);
  background: var(--safe-primary-pale);
}

.cadence-summary-title {
  color: var(--safe-primary-deep);
  font-size: 25rpx;
  font-weight: 850;
}

.cadence-summary-text {
  color: var(--safe-text);
  font-size: 23rpx;
  line-height: 1.55;
}

.picker-value {
  min-height: var(--safe-touch);
  display: flex;
  align-items: center;
  padding: 0 20rpx;
}

.goal-input {
  min-height: 144rpx;
  padding: 20rpx;
  line-height: 1.6;
}

.item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.item-tag {
  padding: 6rpx 14rpx;
  border-radius: var(--safe-radius-pill);
  background: var(--safe-primary-soft);
  color: var(--safe-primary-deep);
  font-size: 22rpx;
  font-weight: 850;
}

.item-source {
  flex: 1;
  min-width: 0;
  color: var(--safe-muted);
  font-size: 23rpx;
  text-align: right;
}

.item-title {
  color: var(--safe-title);
  font-size: 30rpx;
  font-weight: 850;
}

.item-reason,
.item-boundary,
.boundary-note {
  color: var(--safe-text);
  font-size: 25rpx;
  line-height: 1.65;
}

.card-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.card-chip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-sm);
  background: var(--safe-bg-leaf);
  text-align: left;
  line-height: 1.45;
}

.reminder-panel {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.reminder-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.reminder-icon {
  width: 84rpx;
  height: 68rpx;
  flex: 0 0 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: var(--safe-primary-soft);
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 900;
}

.reminder-copy {
  min-width: 0;
  flex: 1;
}

.reminder-state {
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-sm);
  background: var(--safe-bg-soft);
}

.reminder-state--active {
  border-color: rgba(87, 139, 95, 0.32);
  background: var(--safe-primary-pale);
}

.reminder-state--muted {
  background: #f6f6f3;
}

.reminder-state-title,
.reminder-state-text {
  display: block;
}

.reminder-state-title {
  color: var(--safe-title);
  font-size: 25rpx;
  font-weight: 850;
}

.reminder-state-text {
  margin-top: 6rpx;
  color: var(--safe-text);
  font-size: 23rpx;
  line-height: 1.55;
}

.reminder-button {
  min-height: var(--safe-touch);
  border-radius: var(--safe-radius-pill);
  background: var(--safe-primary);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 850;
  line-height: var(--safe-touch);
}

.reminder-button::after {
  border: 0;
}

.reminder-button--secondary {
  border: 1rpx solid var(--safe-primary);
  background: #ffffff;
  color: var(--safe-primary-deep);
}

.card-chip::after {
  border: 0;
}

.chip-copy {
  min-width: 0;
  flex: 1;
}

.chip-title {
  color: var(--safe-title);
  font-size: 26rpx;
  font-weight: 800;
}

.chip-meta {
  display: block;
  margin-top: 6rpx;
  color: var(--safe-muted);
  font-size: 23rpx;
}

.chip-action {
  flex: 0 0 auto;
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 850;
}

.boundary-note {
  padding: 22rpx;
  border-radius: var(--safe-radius-sm);
  background: var(--safe-orange-soft);
}
