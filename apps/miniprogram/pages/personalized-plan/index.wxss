.plan-page {
  display: flex;
  flex-direction: column;
  gap: 26rpx;
}

.page-head {
  padding: 26rpx 0 4rpx;
  border: 0;
  box-shadow: none;
  background: transparent;
}

.empty-card,
.item-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.assignment-panel {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.assignment-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.assignment-state {
  flex: 0 0 auto;
  padding: 6rpx 14rpx;
  border-radius: var(--safe-radius-pill);
  background: var(--safe-blue-soft);
  color: var(--safe-blue);
  font-size: 22rpx;
  font-weight: 800;
}

.assignment-label {
  color: var(--safe-title);
  font-size: 24rpx;
  font-weight: 800;
}

.segmented-control {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}

.segmented-control--wrap {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.segmented-control--compact {
  grid-template-columns: 1fr;
}

.segment-button {
  min-height: var(--safe-touch);
  padding: 0 14rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-sm);
  background: #ffffff;
  color: var(--safe-text);
  font-size: 24rpx;
  font-weight: 750;
}

.segment-button--active {
  border-color: var(--safe-primary);
  background: var(--safe-primary-soft);
  color: var(--safe-primary-deep);
}

.assignment-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 18rpx;
}

.assignment-field {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.picker-value,
.goal-input {
  box-sizing: border-box;
  width: 100%;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-sm);
  background: #ffffff;
  color: var(--safe-title);
  font-size: 25rpx;
}

.picker-value {
  min-height: var(--safe-touch);
  display: flex;
  align-items: center;
  padding: 0 20rpx;
}

.goal-input {
  min-height: 144rpx;
  padding: 20rpx;
  line-height: 1.6;
}

.item-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.item-tag {
  padding: 6rpx 14rpx;
  border-radius: var(--safe-radius-pill);
  background: var(--safe-primary-soft);
  color: var(--safe-primary-deep);
  font-size: 22rpx;
  font-weight: 850;
}

.item-source {
  flex: 1;
  min-width: 0;
  color: var(--safe-muted);
  font-size: 23rpx;
  text-align: right;
}

.item-title {
  color: var(--safe-title);
  font-size: 30rpx;
  font-weight: 850;
}

.item-reason,
.item-boundary,
.boundary-note {
  color: var(--safe-text);
  font-size: 25rpx;
  line-height: 1.65;
}

.card-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.card-chip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-sm);
  background: var(--safe-bg-leaf);
}

.chip-title {
  color: var(--safe-title);
  font-size: 26rpx;
  font-weight: 800;
}

.chip-meta {
  color: var(--safe-muted);
  font-size: 23rpx;
}

.boundary-note {
  padding: 22rpx;
  border-radius: var(--safe-radius-sm);
  background: var(--safe-orange-soft);
}
