/* 个性化方案（Figma 655:1676）：节奏卡（唯一实心按钮）→ 微信提醒 → 方案条目 → 边界说明。 */
.plan-page {
  display: flex;
  flex-direction: column;
  gap: var(--p3-section);
  padding-top: 16rpx;
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
}

.plan-rhythm {
  gap: var(--p3-stack);
}

.plan-rhythm__head,
.plan-item__source {
  display: flex;
  align-items: center;
  gap: var(--p3-tight);
}

.plan-rhythm__title,
.plan-item__worksheet {
  flex: 1 0 0;
  min-width: 0;
}

.plan-chips {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--p3-tight);
}

.plan-date {
  display: flex;
  align-items: center;
  color: var(--p3-ink);
}

.plan-cadence {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 28rpx 32rpx;
  border-radius: var(--p3-radius-group);
  background: var(--p3-soft);
}

.plan-cadence__title {
  color: var(--p3-primary);
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: 500;
}

.plan-cadence__text,
.plan-reminder__state,
.plan-item__reason {
  color: var(--p3-ink);
  font-size: 28rpx;
  line-height: 44rpx;
}

/* 微信提醒：纸白组块，36px 青瓷浅底圆章 + 铃铛 */
.plan-reminder,
.plan-empty {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
  padding: 36rpx;
  border-radius: var(--p3-radius-group);
  background: var(--p3-surface);
}

.plan-reminder__head {
  display: flex;
  align-items: center;
  gap: var(--p3-stack);
}

.plan-reminder__badge {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 72rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: var(--p3-soft);
}

.plan-reminder__copy {
  display: flex;
  flex: 1 0 0;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.plan-item {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
}

.plan-item__card {
  display: block;
  width: 100%;
  min-height: 0;
  text-align: left;
}
