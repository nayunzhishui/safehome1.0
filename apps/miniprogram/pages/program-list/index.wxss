/* 项目测试（Figma 665:2619）：每个项目一张纸白卡——状态与小节数、标题与箭头、受众、练习方向、第一节米色块。 */
.program-list-page {
  display: flex;
  flex-direction: column;
  gap: var(--p3-section);
  padding-top: 16rpx;
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
}

.program-card {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
  width: 100%;
  min-height: 0;
  padding: var(--p3-card);
  border-radius: var(--p3-radius-card);
  background: var(--p3-surface);
  text-align: left;
}

.program-card--pressed {
  background: var(--p3-paper);
}

.program-card__status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--p3-tight);
}

.program-card__title-row {
  display: flex;
  align-items: center;
  gap: var(--p3-tight);
}

.program-card__title {
  flex: 1 0 0;
  min-width: 0;
}

/* text-v2 新增的项目简介：标题下两行摘要，全文在详情页 */
.program-card__summary {
  display: -webkit-box;
  overflow: hidden;
  color: var(--p3-muted);
  font-size: 28rpx;
  line-height: 44rpx;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.program-card__direction {
  color: var(--p3-primary);
  font-size: 26rpx;
  line-height: 40rpx;
}

.program-card__first {
  padding: 20rpx 24rpx;
  border-radius: var(--p3-radius-group);
  background: var(--p3-paper);
}

.program-card__first-text {
  color: var(--p3-ink);
  font-size: 28rpx;
  line-height: 44rpx;
}

.program-pending {
  text-align: center;
}
