.program-list-page {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.page-head {
  min-height: 0;
  padding: 32rpx 0 40rpx;
  border: 0;
  box-shadow: none;
  background: transparent;
  text-align: center;
}

.program-list-page .safe-h1 {
  font-size: 48rpx;
  line-height: 1.25;
  letter-spacing: -1rpx;
  text-align: center;
}

.program-list-page .safe-subtitle {
  margin-top: 10rpx;
  font-size: 28rpx;
  line-height: 1.55;
}

.preview-notice {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 26rpx;
  padding: 28rpx 30rpx 28rpx 22rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-sm);
  background: var(--safe-primary-soft);
}

.editorial-marker {
  flex: 0 0 auto;
  width: 6rpx;
  height: 88rpx;
  border-radius: var(--safe-radius-pill);
  background: var(--safe-primary);
}

.preview-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 6rpx;
}

.preview-label {
  color: var(--safe-primary-deep);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.4;
}

.preview-text {
  color: var(--safe-text);
  font-size: 28rpx;
  line-height: 1.55;
}

.program-card {
  display: flex;
  min-height: 232rpx;
  flex-direction: column;
  gap: 20rpx;
  padding: 34rpx 0;
  border-top: 1rpx solid var(--safe-border);
  background: transparent;
  transition: background-color 120ms ease;
}

.program-card:last-of-type {
  border-bottom: 1rpx solid var(--safe-border);
}

.program-card--pressed {
  background: var(--safe-primary-soft);
}

.program-card--preview .program-status {
  color: var(--safe-orange-deep, #8d4a1e);
}

.program-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.program-status,
.program-count {
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.4;
}

.program-count {
  color: var(--safe-muted);
  font-weight: 500;
}

.program-body {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.program-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 12rpx;
}

.program-title {
  color: var(--safe-title);
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
}

.program-meta,
.program-first {
  color: var(--safe-text);
  font-size: 28rpx;
  line-height: 1.55;
}

.pending-count {
  margin-top: 20rpx;
  color: var(--safe-primary-deep);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.6;
}

.construct-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
  color: var(--safe-muted);
  font-size: 26rpx;
  line-height: 1.55;
}

.construct-label,
.construct-chip {
  color: inherit;
  font-size: inherit;
  line-height: inherit;
}

.construct-chip + .construct-chip::before {
  margin-right: 16rpx;
  color: var(--safe-border-strong, #b7c3bc);
  content: "·";
}

.program-chevron {
  flex: 0 0 auto;
  color: var(--safe-primary-deep);
  font-size: 48rpx;
  font-weight: 400;
  line-height: 1;
}

.boundary-note {
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
  margin-top: 34rpx;
  padding: 26rpx 28rpx 26rpx 20rpx;
  border-radius: var(--safe-radius-sm);
  background: var(--safe-primary-soft);
}

.boundary-note .editorial-marker {
  height: 76rpx;
}

.boundary-copy {
  min-width: 0;
  flex: 1;
  color: var(--safe-muted);
  font-size: 26rpx;
  line-height: 1.6;
}
