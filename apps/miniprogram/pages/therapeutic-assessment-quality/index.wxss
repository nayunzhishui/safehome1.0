.quality-page {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
  background: var(--safe-bg);
}

.quality-hero {
  padding: 16rpx 0 28rpx;
  text-align: center;
}

.quality-kicker,
.quality-title,
.section-kicker,
.section-title,
.runtime-title,
.runtime-copy,
.state-title,
.state-copy,
.detail-title,
.dimension-title,
.boundary-copy,
.submission-consequence,
.page-boundary,
.field-heading,
.item-meta {
  display: block;
}

.quality-kicker,
.section-kicker {
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 750;
  letter-spacing: 1rpx;
}

.quality-title {
  margin-top: 16rpx;
  color: var(--safe-title);
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1.25;
  text-align: center;
}

.quality-card,
.runtime-card,
.state-card {
  box-sizing: border-box;
  width: 100%;
}

.quality-card {
  padding: 36rpx 0;
  border-top: 1rpx solid var(--safe-border);
  background: transparent;
}

.runtime-card,
.state-card {
  padding: 24rpx 28rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: var(--safe-primary-pale);
}

.runtime-card--paused,
.state-card--error {
  border-color: var(--safe-warning);
  background: #fff7e8;
}

.state-card--notice {
  background: var(--safe-primary-pale);
}

.runtime-title,
.state-title {
  color: var(--safe-title);
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.5;
}

.runtime-copy,
.state-copy,
.boundary-copy,
.submission-consequence,
.page-boundary {
  color: var(--safe-muted);
  font-size: 26rpx;
  line-height: 1.65;
}

.runtime-copy,
.state-copy {
  margin-top: 8rpx;
}

.section-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.section-title {
  margin-top: 10rpx;
  color: var(--safe-title);
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.4;
}

.count-pill {
  flex: none;
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 750;
  line-height: 1.5;
}

.gate-grid {
  display: grid;
  margin-top: 26rpx;
  border-top: 1rpx solid var(--safe-border);
}

.gate-item {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 0;
  border: 0;
  border-bottom: 1rpx solid var(--safe-border);
  border-radius: 0;
  background: transparent;
}

.gate-label {
  color: var(--safe-title);
  font-size: 28rpx;
  font-weight: 750;
}

.field-heading {
  margin-top: 30rpx;
  color: var(--safe-title);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.45;
}

.record-select-row,
.review-summary {
  min-width: 0;
  display: grid;
  grid-template-columns: 36rpx minmax(0, 1fr);
  align-items: stretch;
  margin-top: 14rpx;
}

.record-select-row picker {
  min-width: 0;
}

.record-spine {
  position: relative;
  min-height: 96rpx;
}

.record-spine__stem {
  position: absolute;
  top: 10rpx;
  bottom: 8rpx;
  left: 12rpx;
  width: 3rpx;
  border-radius: var(--safe-radius-pill);
  background: var(--safe-primary);
}

.record-spine__joint {
  position: absolute;
  left: 7rpx;
  width: 13rpx;
  height: 13rpx;
  border-radius: 50%;
  background: var(--safe-primary);
}

.record-spine__joint--top { top: 4rpx; }
.record-spine__joint--bottom { bottom: 2rpx; }

.record-spine__tick {
  position: absolute;
  top: 47rpx;
  left: 0;
  width: 27rpx;
  height: 3rpx;
  border-radius: var(--safe-radius-pill);
  background: var(--safe-primary);
}

.picker-field,
.text-input,
.text-area {
  box-sizing: border-box;
  width: 100%;
  margin-top: 14rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid var(--safe-border-strong);
  border-radius: var(--safe-radius-md);
  background: var(--safe-card);
  color: var(--safe-title);
  font-size: 28rpx;
  line-height: 1.55;
}

.record-select-row .picker-field {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  margin-top: 0;
}

.text-area {
  min-height: 260rpx;
  line-height: 1.65;
}

.text-area--short { min-height: 200rpx; }

.field-label {
  display: block;
  margin-top: 30rpx;
  color: var(--safe-title);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.45;
}

.primary-button,
.outline-button {
  min-height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
  border-radius: var(--safe-radius-md);
  font-size: 29rpx;
  font-weight: 850;
}

.primary-button {
  border: 0;
  background: var(--safe-primary-deep);
  color: var(--safe-card);
}

.outline-button {
  border: 2rpx solid var(--safe-primary);
  background: transparent;
  color: var(--safe-primary-deep);
}

.submission-consequence {
  margin-top: 20rpx;
  color: var(--safe-primary-deep);
  text-align: center;
}

.item-tabs {
  width: 100%;
  margin-top: 24rpx;
  white-space: nowrap;
}

.item-tab {
  min-width: 220rpx;
  min-height: 96rpx;
  display: inline-flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  margin-right: 16rpx;
  padding: 14rpx 18rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: var(--safe-card);
  color: var(--safe-title);
  text-align: left;
}

.item-tab.is-active {
  border-color: var(--safe-primary);
  background: var(--safe-primary-pale);
}

.item-meta {
  margin-top: 6rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.5;
}

.quality-detail {
  margin-top: 30rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid var(--safe-border);
}

.review-summary {
  margin-top: 0;
}

.review-summary__copy {
  min-width: 0;
  padding: 8rpx 0 18rpx;
}

.detail-title,
.dimension-title {
  color: var(--safe-title);
  font-size: 29rpx;
  font-weight: 800;
  line-height: 1.5;
}

.dimension-card,
.participant-incident {
  margin-top: 0;
  padding: 24rpx 0;
  border: 0;
  border-bottom: 1rpx solid var(--safe-border);
  border-radius: 0;
  background: transparent;
}

.resolution-card {
  margin-top: 24rpx;
  padding: 24rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: var(--safe-primary-pale);
}

.dimension-fields {
  display: grid;
  gap: 12rpx;
}

.empty-state {
  padding: 48rpx 0 18rpx;
  text-align: center;
}

.production-gate-card .boundary-copy {
  margin-top: 24rpx;
}

.page-boundary {
  padding: 16rpx 0 0;
  border-top: 1rpx solid var(--safe-border);
  text-align: center;
}

@media (max-width: 360px) {
  .section-heading { align-items: flex-start; }
  .quality-title { font-size: 48rpx; }
}
