.assessment-page {
  padding-bottom: 72rpx;
}

.assessment-head {
  padding: 8rpx 0 2rpx;
}

.page-title,
.page-subtitle {
  display: block;
}

.page-title {
  color: var(--safe-title);
  font-size: 36rpx;
  font-weight: 850;
  line-height: 1.28;
}

.page-subtitle {
  margin-top: 10rpx;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.55;
}

.head-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.head-tags text {
  min-height: 42rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 16rpx;
  border: 1rpx solid rgba(87, 139, 95, 0.16);
  border-radius: var(--safe-radius-pill);
  background: rgba(233, 242, 223, 0.54);
  color: var(--safe-primary-deep);
  font-size: 22rpx;
  font-weight: 800;
}

.assessment-intro-card {
  position: relative;
  min-height: 0;
  overflow: hidden;
  margin-top: 24rpx;
  padding: 26rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: var(--safe-card);
  box-shadow: var(--safe-shadow-card);
}

.art-copy {
  position: relative;
  z-index: 1;
  width: 100%;
}

.art-title,
.art-text {
  display: block;
}

.art-title {
  color: var(--safe-title);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}

.art-text {
  margin-top: 12rpx;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.55;
}

.info-card {
  display: grid;
  gap: 14rpx;
  margin-top: 20rpx;
  padding: 20rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: 22rpx;
  background: var(--safe-card);
  box-shadow: 0 8rpx 18rpx rgba(52, 66, 58, 0.05);
}

.info-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #fffaf3;
}

.info-label {
  flex: 0 0 auto;
  color: var(--safe-primary);
  font-size: 24rpx;
  font-weight: 800;
}

.info-value {
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.5;
  text-align: right;
}

.assessment-controls {
  display: grid;
  gap: 18rpx;
}

.audience-tabs {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
}

.audience-tab {
  min-height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 10rpx;
  border: 1rpx solid #e4eadc;
  border-radius: 14rpx;
  background: #ffffff;
  color: #596a5b;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.2;
}

.audience-tab.active {
  border-color: #9ed5a6;
  background: var(--safe-primary-pale);
  color: var(--safe-primary-deep);
}

.search-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 76rpx;
  padding: 0 16rpx;
  border: 1rpx solid #e4eadc;
  border-radius: 16rpx;
  background: #ffffff;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  color: var(--safe-title);
  font-size: 25rpx;
}

.search-clear {
  flex: 0 0 auto;
  min-height: 52rpx;
  padding: 0 16rpx;
  border: 1rpx solid #d9e5d4;
  border-radius: 999rpx;
  background: #f8fbf5;
  color: #4f7356;
  font-size: 22rpx;
  font-weight: 800;
}

.entry-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 20rpx;
}

.worksheet-list,
.recent-list {
  display: grid;
  gap: 18rpx;
  margin-top: 20rpx;
}

.worksheet-card,
.recent-card,
.loading-box,
.error-box {
  border-radius: var(--safe-radius-md);
  background: var(--safe-card);
  box-shadow: var(--safe-shadow-card);
}

.worksheet-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #e8efdf;
}

.worksheet-card.reference {
  border-color: #d8e8f7;
  background: #f7fbff;
}

.worksheet-card.student-profile {
  border-color: #bfe3c4;
  border-left: 8rpx solid var(--safe-primary);
  background: var(--safe-card);
}

.worksheet-card.disabled {
  border-color: #e4e0d6;
  background: #fbfaf6;
  opacity: 0.78;
}

.worksheet-main {
  flex: 1;
  min-width: 0;
}

.profile-badge-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.profile-badge {
  display: inline-flex;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: var(--safe-primary);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.2;
}

.profile-badge.ghost {
  border: 1rpx solid #bfe3c4;
  background: var(--safe-primary-pale);
  color: #3e7f5d;
}

.profile-badge.soft {
  border: 1rpx solid #e6d8be;
  background: #fff8ed;
  color: #8a6a36;
}

.empty-section-card {
  margin-top: 20rpx;
  padding: 22rpx;
  border: 1rpx dashed #d7cfbf;
  border-radius: 20rpx;
  background: #fffaf3;
  color: #7a6b54;
  font-size: 24rpx;
  line-height: 1.6;
}

.worksheet-title,
.worksheet-meta,
.worksheet-desc,
.worksheet-action,
.recent-title,
.recent-meta,
.recent-summary,
.loading-box,
.error-box {
  display: block;
}

.worksheet-title,
.recent-title {
  color: var(--safe-title);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.45;
}

.worksheet-meta,
.recent-meta {
  margin-top: 8rpx;
  color: #7a8777;
  font-size: 22rpx;
  line-height: 1.45;
}

.worksheet-desc,
.recent-summary {
  margin-top: 12rpx;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.worksheet-action {
  flex: 0 0 auto;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: var(--safe-primary-soft);
  color: var(--safe-primary);
  font-size: 22rpx;
  font-weight: 800;
}

.recent-card {
  padding: 22rpx;
  border: 1rpx solid var(--safe-border);
}

.loading-box,
.error-box {
  margin-top: 24rpx;
  padding: 22rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.loading-box {
  color: #596a5b;
}

.error-box {
  border: 1rpx solid #efb4b4;
  background: #fff1f1;
  color: #8a2f2f;
}

.error-action {
  min-height: 64rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  padding: 0 22rpx;
  border: 1rpx solid #efb4b4;
  border-radius: 999rpx;
  background: #fffdf8;
  color: #8a2f2f;
  font-size: 23rpx;
  font-weight: 800;
}
