.assessment-page {
  padding-bottom: 72rpx;
}

.assessment-head {
  padding: 8rpx 0 4rpx;
}

.page-title,
.page-subtitle {
  display: block;
}

.page-title {
  color: var(--safe-title);
  font-size: 36rpx;
  font-weight: 850;
  line-height: 1.28;
}

.page-subtitle {
  margin-top: 10rpx;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.55;
}

.family-art-card {
  position: relative;
  min-height: 236rpx;
  overflow: hidden;
  margin-top: 24rpx;
  padding: 26rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: 28rpx;
  background: linear-gradient(135deg, var(--safe-primary-pale) 0%, var(--safe-card) 72%);
  box-shadow: 0 14rpx 34rpx rgba(82, 112, 64, 0.12);
}

.art-copy {
  position: relative;
  z-index: 1;
  width: 58%;
}

.art-title,
.art-text {
  display: block;
}

.art-title {
  color: var(--safe-title);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
}

.art-text {
  margin-top: 12rpx;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.55;
}

.family-art {
  position: absolute;
  right: 18rpx;
  bottom: 0;
  width: 232rpx;
  height: 196rpx;
}

.sun {
  position: absolute;
  right: 34rpx;
  top: 4rpx;
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background: var(--safe-yellow);
}

.adult-left,
.adult-right,
.child {
  position: absolute;
  bottom: 34rpx;
  border-radius: 999rpx 999rpx 22rpx 22rpx;
}

.adult-left {
  left: 38rpx;
  width: 58rpx;
  height: 94rpx;
  background: var(--safe-orange);
}

.adult-right {
  right: 44rpx;
  width: 62rpx;
  height: 108rpx;
  background: var(--safe-primary);
}

.child {
  left: 112rpx;
  width: 50rpx;
  height: 72rpx;
  background: var(--safe-blue);
}

.adult-left::before,
.adult-right::before,
.child::before {
  content: "";
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  border-radius: 50%;
  background: #f2bf8c;
}

.adult-left::before,
.adult-right::before {
  top: -34rpx;
  width: 48rpx;
  height: 48rpx;
}

.child::before {
  top: -28rpx;
  width: 38rpx;
  height: 38rpx;
}

.grass {
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  bottom: 0;
  height: 44rpx;
  border-radius: 44rpx 44rpx 0 0;
  background: #cfe6bd;
}

.info-card {
  display: grid;
  gap: 14rpx;
  margin-top: 20rpx;
  padding: 20rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: 24rpx;
  background: var(--safe-card);
  box-shadow: 0 10rpx 26rpx rgba(80, 64, 45, 0.08);
}

.info-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #fffaf3;
}

.info-label {
  flex: 0 0 auto;
  color: var(--safe-primary);
  font-size: 24rpx;
  font-weight: 800;
}

.info-value {
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.5;
  text-align: right;
}

.entry-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 20rpx;
}

.worksheet-list,
.recent-list {
  display: grid;
  gap: 18rpx;
  margin-top: 20rpx;
}

.worksheet-card,
.recent-card,
.loading-box,
.error-box {
  border-radius: 24rpx;
  background: var(--safe-card);
  box-shadow: 0 10rpx 26rpx rgba(80, 64, 45, 0.08);
}

.worksheet-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #e8efdf;
}

.worksheet-card.reference {
  border-color: #d8e8f7;
  background: #f7fbff;
}

.worksheet-card.student-profile {
  border-color: #bfe3c4;
  background: linear-gradient(135deg, var(--safe-primary-pale) 0%, var(--safe-card) 72%);
}

.worksheet-main {
  flex: 1;
  min-width: 0;
}

.profile-badge-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.profile-badge {
  display: inline-flex;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: var(--safe-primary);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.2;
}

.profile-badge.ghost {
  border: 1rpx solid #bfe3c4;
  background: var(--safe-primary-pale);
  color: #3e7f5d;
}

.worksheet-title,
.worksheet-meta,
.worksheet-desc,
.worksheet-action,
.recent-title,
.recent-meta,
.recent-summary,
.loading-box,
.error-box {
  display: block;
}

.worksheet-title,
.recent-title {
  color: var(--safe-title);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.45;
}

.worksheet-meta,
.recent-meta {
  margin-top: 8rpx;
  color: #7a8777;
  font-size: 22rpx;
  line-height: 1.45;
}

.worksheet-desc,
.recent-summary {
  margin-top: 12rpx;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.6;
}

.worksheet-action {
  flex: 0 0 auto;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: var(--safe-primary-soft);
  color: var(--safe-primary);
  font-size: 22rpx;
  font-weight: 800;
}

.recent-card {
  padding: 22rpx;
  border: 1rpx solid var(--safe-border);
}

.loading-box,
.error-box {
  margin-top: 24rpx;
  padding: 22rpx;
  font-size: 24rpx;
  line-height: 1.6;
}

.loading-box {
  color: #596a5b;
}

.error-box {
  border: 1rpx solid #efb4b4;
  background: #fff1f1;
  color: #8a2f2f;
}

.error-action {
  min-height: 64rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 16rpx;
  padding: 0 22rpx;
  border: 1rpx solid #efb4b4;
  border-radius: 999rpx;
  background: #fffdf8;
  color: #8a2f2f;
  font-size: 23rpx;
  font-weight: 800;
}
