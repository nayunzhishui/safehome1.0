<view class="safe-page assessment-page" role="main" aria-label="支持性测评">
  <view class="assessment-head">
    <text class="page-title">支持性测评</text>
  </view>

  <view class="safe-section">
    <view class="assessment-controls">
      <view class="audience-tabs">
        <button
          wx:for="{{tabs}}"
          wx:key="key"
          class="audience-tab {{activeAudience === item.key ? 'active' : ''}}"
          data-key="{{item.key}}"
          bindtap="switchAudience"
        >{{item.label}}</button>
      </view>
      <view class="search-row">
        <input class="search-input" value="{{searchKeyword}}" placeholder="搜索量表、主题或关键词" bindinput="onSearchInput" />
        <button wx:if="{{searchKeyword}}" class="search-clear" bindtap="clearSearch">清除</button>
      </view>
    </view>
  </view>

  <view wx:if="{{errorMessage}}" class="error-box">
    <text>{{errorMessage}}</text>
    <button class="error-action" bindtap="openIntegrationTest">打开联调测试页</button>
  </view>

  <view wx:if="{{loading}}" class="loading-box">
    <text>正在读取测一测内容...</text>
  </view>

  <view wx:for="{{categories}}" wx:key="key" class="safe-section">
    <section-title title="{{item.title}}" />
    <view wx:if="{{!item.items.length && item.emptyText}}" class="empty-section-card">
      <text>{{item.emptyText}}</text>
    </view>
    <view class="worksheet-list">
      <view
        wx:for="{{item.items}}"
        wx:for-item="worksheet"
        wx:key="id"
        class="worksheet-card {{worksheet.is_student_profile ? 'student-profile' : ''}} {{worksheet.is_enabled_for_user ? '' : 'disabled'}}"
        data-id="{{worksheet.id}}"
        data-enabled="{{worksheet.is_enabled_for_user}}"
        role="button"
        aria-label="打开测评：{{worksheet.display_title}}"
        bindtap="openAssessmentEntry"
      >
        <view class="worksheet-main">
          <text class="worksheet-title">{{worksheet.display_title}}</text>
          <text class="worksheet-meta">{{worksheet.topic_label}} · {{worksheet.question_count}} 项 · 约{{worksheet.estimated_minutes}}分钟</text>
          <text class="worksheet-desc">{{worksheet.instructions}}</text>
        </view>
        <text class="worksheet-action">{{worksheet.action_text}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{recentResults.length}}" class="safe-section">
    <section-title title="最近记录" />
    <view class="recent-list">
      <view
        wx:for="{{recentResults}}"
        wx:key="id"
        class="recent-card clickable {{item.is_profile ? 'recent-card--profile' : ''}}"
        data-id="{{item.id}}"
        data-worksheet-id="{{item.worksheet_id}}"
        role="button"
        aria-label="查看测评记录：{{item.worksheet_title}}"
        bindtap="openRecentResult"
      >
        <view class="recent-head">
          <text class="recent-badge">{{item.badge_text}}</text>
          <text class="recent-action">查看</text>
        </view>
        <text class="recent-title">{{item.worksheet_title}}</text>
        <text class="recent-meta">{{item.created_at}}</text>
        <text class="recent-summary">{{item.result_summary}}</text>
      </view>
    </view>
  </view>

  <view wx:elif="{{recentLoginTip}}" class="safe-section">
    <section-title title="最近记录" />
    <view class="recent-login-card">
      <text>{{recentLoginTip}}</text>
      <button class="login-link-button" bindtap="goLogin">去登录</button>
    </view>
  </view>

  <view class="safe-section">
    <bottom-tip-card text="测一测之后，先选一个能完成的小动作，不需要一次改变很多。" />
  </view>
</view>
