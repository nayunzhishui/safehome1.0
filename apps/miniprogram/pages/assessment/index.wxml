<view class="assessment-page" role="main" aria-label="测一测">
  <view class="assessment-filters">
    <view class="assessment-search">
      <p3-icon name="search" size="20" tone="muted" />
      <input class="assessment-search__input" aria-label="搜索测评内容" placeholder-class="assessment-search__placeholder" value="{{searchKeyword}}" placeholder="搜索量表、主题或关键词" bindinput="onSearchInput" />
      <button wx:if="{{searchKeyword}}" class="assessment-search__clear" bindtap="clearSearch">清除</button>
    </view>
    <view class="assessment-chips" role="radiogroup" aria-label="适用人群">
      <button
        wx:for="{{tabs}}"
        wx:key="key"
        class="p3-chip {{activeAudience === item.key ? 'p3-chip--selected' : ''}}"
        role="radio"
        aria-checked="{{activeAudience === item.key}}"
        data-key="{{item.key}}"
        bindtap="switchAudience"
      >{{item.label}}</button>
    </view>
    <text wx:if="{{!loading && !errorMessage && visibleCount}}" class="assessment-count">{{visibleCount}} 份问卷 · 按情绪反射弧的位置分组</text>
  </view>

  <page-state wx:if="{{loading}}" kind="loading" title="正在读取测一测内容" />
  <view wx:elif="{{errorMessage}}" class="assessment-error">
    <page-state kind="error" title="测一测内容暂时没有加载成功" description="{{errorMessage}}" />
    <button class="p3-btn p3-btn--secondary error-action" bindtap="loadAssessments">重新加载</button>
  </view>
  <block wx:else>
    <view wx:for="{{categories}}" wx:key="key" class="assessment-section">
      <p3-section-header title="{{item.title}}" subtitle="{{item.subtitle}}" />
      <view wx:if="{{!item.items.length && item.emptyText}}" class="p3-notice empty-section-card">
        <text class="p3-notice__body">{{item.emptyText}}</text>
      </view>
      <view wx:if="{{item.items.length}}" class="assessment-group">
        <button
          wx:for="{{item.items}}"
          wx:for-item="worksheet"
          wx:for-index="rowIndex"
          wx:key="id"
          class="assessment-row {{worksheet.is_enabled_for_user ? '' : 'assessment-row--disabled'}}"
          aria-label="打开测评：{{worksheet.display_title}}"
          data-id="{{worksheet.id}}"
          data-enabled="{{worksheet.is_enabled_for_user}}"
          bindtap="openAssessmentEntry"
        >
          <p3-course-row title="{{worksheet.display_title}}" scene="{{worksheet.row_scene}}" meta="{{worksheet.row_meta}}" show-divider="{{rowIndex < item.items.length - 1}}" />
        </button>
      </view>
    </view>
  </block>

  <view wx:if="{{recentResults.length}}" class="assessment-section">
    <p3-section-header title="最近记录" />
    <view class="p3-group">
      <button
        wx:for="{{recentResults}}"
        wx:key="id"
        class="assessment-recent"
        aria-label="查看测评记录：{{item.worksheet_title}}"
        data-id="{{item.id}}"
        data-worksheet-id="{{item.worksheet_id}}"
        bindtap="openRecentResult"
      >
        <p3-group-row icon="check" title="{{item.worksheet_title}}" subtitle="{{item.row_subtitle}}" show-divider="{{index < recentResults.length - 1}}" />
      </button>
    </view>
  </view>
  <view wx:elif="{{recentLoginTip}}" class="assessment-section">
    <p3-section-header title="最近记录" />
    <view class="p3-group assessment-login">
      <text class="assessment-login__text">{{recentLoginTip}}</text>
      <button class="p3-link" bindtap="goLogin">去登录 ›</button>
    </view>
  </view>

  <text wx:if="{{boundaryNotice}}" class="p3-footnote">{{boundaryNotice}}</text>
</view>
