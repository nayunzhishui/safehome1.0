<view class="safe-page assessment-page">
  <view class="page-head">
    <text class="page-title">家庭关系测一测</text>
    <text class="page-subtitle">查看已授权工作表，保存自己的观察和练习记录</text>
  </view>

  <view class="family-art-card">
    <view class="art-copy">
          <text class="art-title">从一次温和观察开始</text>
          <text class="art-text">这里收纳量表、阶段性画像、情绪觉察、行为练习和进展记录。</text>
    </view>
    <view class="family-art">
      <view class="sun"></view>
      <view class="adult-left"></view>
      <view class="child"></view>
      <view class="adult-right"></view>
      <view class="grass"></view>
    </view>
  </view>

  <view class="safe-section">
    <section-title title="测一测说明" subtitle="原文展示，结果用于自我观察和练习记录" />
    <view class="info-card">
      <view wx:for="{{infoItems}}" wx:key="label" class="info-row">
        <text class="info-label">{{item.label}}</text>
        <text class="info-value">{{item.value}}</text>
      </view>
    </view>
  </view>

  <view class="safe-section">
    <alert-card
      type="info"
      title="边界提示"
      content="{{boundaryNotice || '本内容用于自我观察和练习记录，不用于诊断，不替代心理咨询、医学诊断、危机干预或法律判断。'}}"
    />
  </view>

  <view wx:if="{{errorMessage}}" class="error-box">
    <text>{{errorMessage}}</text>
  </view>

  <view wx:if="{{loading}}" class="loading-box">
    <text>正在读取测一测内容...</text>
  </view>

  <view wx:for="{{categories}}" wx:key="category" class="safe-section">
    <section-title title="{{item.category}}" subtitle="点击进入原工作表填写" />
    <view class="worksheet-list">
      <view
        wx:for="{{item.items}}"
        wx:for-item="worksheet"
        wx:key="id"
        class="worksheet-card {{worksheet.is_reference ? 'reference' : ''}} {{worksheet.is_student_profile ? 'student-profile' : ''}}"
        data-id="{{worksheet.id}}"
        bindtap="openAssessmentEntry"
      >
        <view class="worksheet-main">
          <view wx:if="{{worksheet.is_student_profile}}" class="profile-badge-row">
            <text class="profile-badge">学生支持性画像</text>
            <text class="profile-badge ghost">非诊断</text>
          </view>
          <text class="worksheet-title">{{worksheet.display_title}}</text>
          <text class="worksheet-meta">{{worksheet.source_file}} · {{worksheet.pages}} 页 · {{worksheet.question_count}} 个填写项</text>
          <text class="worksheet-desc">{{worksheet.instructions}}</text>
        </view>
        <text class="worksheet-action">{{worksheet.action_text}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{recentResults.length}}" class="safe-section">
    <section-title title="最近保存" subtitle="只显示最近 3 条记录" />
    <view class="recent-list">
      <view wx:for="{{recentResults}}" wx:key="id" class="recent-card">
        <text class="recent-title">{{item.worksheet_title}}</text>
        <text class="recent-meta">{{item.created_at}}</text>
        <text class="recent-summary">{{item.result_summary}}</text>
      </view>
    </view>
  </view>

  <view class="safe-section">
    <bottom-tip-card text="完成测一测后，可以把观察连接到一个更小的练习动作。" />
  </view>
</view>
