<view class="safe-page message-detail-page">
  <view wx:if="{{loading}}" class="safe-card state-card">正在打开消息...</view>
  <view wx:elif="{{errorMessage}}" class="safe-card state-card">{{errorMessage}}</view>
  <view wx:else class="safe-card safe-card--hero">
    <text class="detail-kicker">{{message.message_type === 'supervision_feedback' ? '人工补充反馈' : '消息提醒'}}</text>
    <text class="detail-title">{{message.title}}</text>
    <text class="detail-time">{{message.created_at}}</text>
    <text class="detail-body">{{message.body || '暂无更多内容。'}}</text>
  </view>

  <button wx:if="{{message.source_type === 'relationship_screening_report'}}" class="safe-primary-button bottom-action" bindtap="openSource">查看关系健康初筛报告</button>
  <button wx:if="{{message.source_type === 'relationship_narrative'}}" class="safe-primary-button bottom-action" bindtap="openSource">查看已确认探索手记</button>

  <view wx:if="{{canEvaluate}}" class="safe-section">
    <feedback-rating value="{{feedbackEvaluation}}" disabled="{{feedbackEvaluationSaving}}" prompt="这条反馈与你的实际情况相符吗？" bind:select="submitFeedbackEvaluation" />
  </view>

  <view class="safe-section">
    <view class="boundary-card">
      <text class="boundary-title">先确认边界</text>
      <text class="boundary-text">这里的内容适合补充理解一条记录，不适合处理紧急安全风险。如正在经历自伤、自杀、暴力、失控或其他安全风险，请先找现实支持。</text>
    </view>
  </view>

  <button class="safe-primary-button bottom-action" bindtap="goMessages">返回消息列表</button>
</view>
