<view class="p3-page detail-page" role="main" aria-label="消息详情">
  <page-state wx:if="{{loading}}" kind="loading" title="正在打开消息" description="内容只会在你的账号中显示。" />
  <page-state wx:elif="{{errorMessage}}" kind="error" title="消息暂时没有打开" description="{{errorMessage}}" action-label="{{id ? '重新打开' : '返回消息列表'}}" bind:action="handleStateAction" />
  <block wx:else>
    <view class="detail-letter {{message.is_withdrawn ? 'detail-letter--withdrawn' : ''}}">
      <view class="detail-head">
        <text class="detail-kicker">{{message.message_type === 'supervision_feedback' ? '人工补充反馈' : message.message_type === 'assessment_invitation' ? '填写邀请' : '消息提醒'}}</text>
        <text class="p3-serif-title p3-serif-title--open detail-title" role="heading" aria-level="1">{{message.title}}</text>
        <text class="p3-meta">{{message.message_type === 'assessment_invitation' ? '来源：研究团队 · ' : message.sender_role ? '来源：研究者补充 · ' : ''}}{{messageTime}}{{message.delivery_version ? ' · 第 ' + message.delivery_version + ' 版' : ''}}</text>
      </view>
      <view class="p3-divider" aria-hidden="true"></view>
      <text wx:if="{{message.is_withdrawn}}" class="detail-body">研究者已撤回这条内容，请忽略此前版本。</text>
      <block wx:else>
        <text wx:for="{{bodyParagraphs}}" wx:key="*this" class="detail-body">{{item}}</text>
      </block>
    </view>

    <button wx:if="{{canOpenSource}}" class="p3-btn p3-btn--primary" bindtap="openSource">{{sourceButtonLabel}}</button>

    <feedback-rating wx:if="{{canEvaluate}}" editorial="{{true}}" value="{{feedbackEvaluation}}" disabled="{{feedbackEvaluationSaving}}" prompt="这条反馈与你的实际情况相符吗？" bind:select="submitFeedbackEvaluation" />

    <view class="p3-boundary">
      <view class="p3-boundary__rule" aria-hidden="true"></view>
      <text class="p3-boundary__title">使用边界</text>
      <text class="p3-meta">这里的内容适合补充理解一条记录，不适合处理紧急安全风险。如正在经历自伤、自杀、暴力、失控或其他安全风险，请先找现实支持。</text>
    </view>

    <button class="safe-outline-button return-action" bindtap="goMessages">返回消息列表</button>
  </block>
</view>
