.message-detail-page {
  padding: 40rpx 48rpx calc(72rpx + env(safe-area-inset-bottom));
}

.detail-kicker,
.detail-title,
.detail-time,
.detail-body,
.boundary-title,
.boundary-text {
  display: block;
}

.detail-kicker {
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.5;
  text-align: center;
}

.detail-title {
  margin-top: 16rpx;
  color: var(--safe-title);
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1.28;
  text-align: center;
}

.detail-time {
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.5;
}

.detail-body-copy {
  min-width: 0;
  display: grid;
  gap: 20rpx;
}

.detail-body-layout {
  display: grid;
  grid-template-columns: 6rpx minmax(0, 1fr);
  gap: 32rpx;
  margin-top: 24rpx;
  padding: 32rpx 0;
}

.detail-body-rule {
  width: 6rpx;
  min-height: 100%;
  border-radius: 4rpx;
  background: var(--safe-primary);
}

.detail-body {
  color: var(--safe-text);
  font-size: 30rpx;
  line-height: 1.67;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.source-action,
.return-action {
  border-radius: 32rpx;
}

.source-action {
  margin-top: 32rpx;
}

.feedback-section {
  margin-top: 24rpx;
}

.boundary-note {
  margin-top: 32rpx;
}

.boundary-rule {
  height: 1rpx;
  background: var(--safe-border);
}

.boundary-copy {
  padding-top: 32rpx;
}

.boundary-title {
  color: var(--safe-title);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.54;
}

.boundary-text {
  margin-top: 12rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.58;
}

.return-action {
  margin-top: 32rpx;
}
