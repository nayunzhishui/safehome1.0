.relationship-report-page { padding-bottom: calc(56rpx + env(safe-area-inset-bottom)); }
.report-kicker, .report-title, .report-meta, .report-profile, .report-copy, .section-title, .section-eyebrow, .section-help, .list-line, .attention-title, .hypothesis-text, .hypothesis-state, .download-help { display: block; }
.report-head { display: grid; gap: 12rpx; }
.report-status-row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.report-kicker, .section-eyebrow { color: var(--safe-primary-deep); font-size: 22rpx; font-weight: 800; letter-spacing: 1rpx; }
.version-chip { max-width: 300rpx; overflow: hidden; color: var(--safe-muted); font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }
.report-title { color: var(--safe-title); font-size: 38rpx; font-weight: 900; }
.report-meta { color: var(--safe-muted); font-size: 21rpx; }
.report-profile { margin-top: 10rpx; color: var(--safe-primary-deep); font-size: 30rpx; font-weight: 850; }
.report-copy { color: var(--safe-text); font-size: 25rpx; line-height: 1.7; }
.status-track { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8rpx; margin: 12rpx 0 4rpx; }
.status-step { display: grid; justify-items: center; gap: 8rpx; color: var(--safe-muted); font-size: 19rpx; text-align: center; }
.status-dot { width: 18rpx; height: 18rpx; border: 2rpx solid var(--safe-border); border-radius: 50%; background: var(--safe-card); }
.status-step--complete { color: var(--safe-primary-deep); }
.status-step--complete .status-dot { border-color: var(--safe-primary); background: var(--safe-primary); }
.status-step--current { color: #72552f; font-weight: 800; }
.status-step--current .status-dot { border-color: var(--safe-warning); background: var(--safe-orange-soft); }
.attention-notice { padding: 18rpx; border: 1rpx solid rgba(184, 127, 45, 0.35); border-radius: var(--safe-radius-sm); background: var(--safe-orange-soft); color: var(--safe-text); font-size: 22rpx; line-height: 1.6; }
.attention-title { margin-bottom: 6rpx; color: #72552f; font-weight: 850; }
.section-title { margin: 6rpx 0 12rpx; color: var(--safe-title); font-size: 29rpx; font-weight: 850; }
.section-help { margin-bottom: 16rpx; color: var(--safe-muted); font-size: 22rpx; line-height: 1.6; }
.radar-list { display: grid; gap: 16rpx; }
.radar-label-row { display: flex; justify-content: space-between; color: var(--safe-text); font-size: 23rpx; }
.radar-track { height: 14rpx; overflow: hidden; border-radius: 999rpx; background: var(--safe-border); }
.radar-fill { height: 100%; border-radius: 999rpx; background: var(--safe-primary); }
.tension-axis { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 12rpx; margin: 18rpx 0; color: var(--safe-title); font-size: 22rpx; font-weight: 750; text-align: center; }
.axis-connector { padding: 6rpx 12rpx; border-radius: 999rpx; background: var(--safe-primary-soft); color: var(--safe-primary-deep); font-size: 18rpx; }
.tension-clue { margin-top: 12rpx; padding: 16rpx; border: 1rpx solid var(--safe-border); border-radius: var(--safe-radius-sm); color: var(--safe-text); font-size: 23rpx; line-height: 1.6; }
.hypothesis-card { margin-top: 16rpx; padding: 18rpx; border: 1rpx solid var(--safe-border); border-radius: var(--safe-radius-sm); background: #fbfcfb; }
.hypothesis-text { color: var(--safe-text); font-size: 23rpx; line-height: 1.65; }
.hypothesis-state { margin-top: 10rpx; color: var(--safe-muted); font-size: 20rpx; }
.feedback-options { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; margin-top: 14rpx; }
.feedback-option { min-height: 76rpx; padding: 8rpx; border: 1rpx solid var(--safe-border); border-radius: var(--safe-radius-sm); background: var(--safe-card); color: var(--safe-text); font-size: 21rpx; line-height: 1.2; }
.feedback-option::after { border: 0; }
.feedback-option--active { border-color: var(--safe-primary); background: var(--safe-primary-soft); color: var(--safe-primary-deep); font-weight: 800; }
.list-line { margin-top: 10rpx; color: var(--safe-text); font-size: 24rpx; line-height: 1.6; }
.boundary-card { margin: 24rpx 0; padding: 20rpx; border: 1rpx solid rgba(184, 127, 45, 0.3); border-radius: var(--safe-radius-sm); background: var(--safe-orange-soft); color: var(--safe-text); font-size: 23rpx; line-height: 1.6; }
.download-help { margin-top: 12rpx; color: var(--safe-muted); font-size: 21rpx; line-height: 1.55; text-align: center; }
.share-canvas { position: fixed; left: -10000px; top: 0; pointer-events: none; }
