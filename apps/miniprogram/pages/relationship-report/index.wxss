.relationship-report-page {
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}

.report-title,
.report-meta,
.report-profile,
.report-copy,
.section-title,
.section-eyebrow,
.section-help,
.list-line,
.attention-title,
.hypothesis-text,
.hypothesis-state,
.download-help,
.boundary-title {
  display: block;
}

.report-head {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 18rpx 0 40rpx;
  border-bottom: 1rpx solid var(--safe-border);
}

.report-head--pending {
  min-height: 520rpx;
}

.report-pending-body {
  display: grid;
  gap: 20rpx;
  margin-top: 24rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid var(--safe-border);
}

.report-status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.section-eyebrow {
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.version-chip {
  max-width: 340rpx;
  overflow: hidden;
  color: var(--safe-muted);
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.report-title {
  color: var(--safe-title);
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.35;
  text-align: center;
}

.report-meta {
  color: var(--safe-muted);
  font-size: 24rpx;
}

.report-meta-group {
  min-width: 0;
  display: grid;
  gap: 4rpx;
  justify-items: end;
  text-align: right;
}

.report-profile {
  margin-top: 8rpx;
  color: var(--safe-title);
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.4;
}

.report-copy {
  color: var(--safe-text);
  font-size: 28rpx;
  line-height: 1.7;
}

.status-track {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
  margin: 12rpx 0 4rpx;
}

.status-step {
  position: relative;
  display: grid;
  justify-items: center;
  gap: 10rpx;
  color: var(--safe-muted);
  font-size: 23rpx;
  text-align: center;
}

.status-step:not(:last-child)::after {
  position: absolute;
  top: 11rpx;
  left: calc(50% + 18rpx);
  width: calc(100% - 28rpx);
  height: 2rpx;
  background: var(--safe-border);
  content: "";
}

.status-dot {
  position: relative;
  z-index: 1;
  width: 24rpx;
  height: 24rpx;
  border: 2rpx solid var(--safe-border);
  border-radius: 50%;
  background: var(--safe-bg);
}

.status-step--complete {
  color: var(--safe-primary-deep);
}

.status-step--complete .status-dot {
  border-color: var(--safe-primary);
  background: var(--safe-primary);
}

.status-step--current {
  color: #72552f;
  font-weight: 700;
}

.status-step--current .status-dot {
  border-color: var(--safe-warning);
  background: var(--safe-orange-soft);
}

.attention-notice,
.boundary-note {
  padding: 24rpx;
  border-radius: var(--safe-radius-sm);
  background: var(--safe-orange-soft);
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.65;
}

.attention-title,
.boundary-title {
  margin-bottom: 8rpx;
  color: #72552f;
  font-weight: 700;
}

.profile-excerpt {
  margin-top: 8rpx;
  padding: 28rpx;
  border-radius: var(--safe-radius-md);
  background: var(--safe-primary-soft);
}

.report-section {
  padding: 40rpx 0;
  border-bottom: 1rpx solid var(--safe-border);
}

.report-feedback-section {
  padding-top: 32rpx;
}

.section-title {
  margin: 8rpx 0 14rpx;
  color: var(--safe-title);
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.4;
}

.section-help {
  margin-bottom: 22rpx;
  color: var(--safe-muted);
  font-size: 25rpx;
  line-height: 1.65;
}

.radar-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.radar-label-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  color: var(--safe-text);
  font-size: 26rpx;
}

.radar-track {
  height: 12rpx;
  margin-top: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: var(--safe-border);
}

.radar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--safe-primary);
}

.tension-axis {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 12rpx;
  margin: 22rpx 0;
  color: var(--safe-title);
  font-size: 25rpx;
  font-weight: 700;
  text-align: center;
}

.axis-connector {
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  background: var(--safe-primary-soft);
  color: var(--safe-primary-deep);
  font-size: 22rpx;
}

.tension-clue {
  padding: 18rpx 0;
  border-top: 1rpx solid var(--safe-border);
  color: var(--safe-text);
  font-size: 27rpx;
  line-height: 1.65;
}

.hypothesis-card {
  padding: 24rpx 0;
  border-top: 1rpx solid var(--safe-border);
}

.hypothesis-text {
  color: var(--safe-text);
  font-size: 27rpx;
  line-height: 1.65;
}

.hypothesis-state {
  margin-top: 12rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
}

.feedback-options {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 18rpx;
}

.feedback-option {
  min-height: 88rpx;
  padding: 12rpx 8rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-sm);
  background: transparent;
  color: var(--safe-text);
  font-size: 25rpx;
  line-height: 1.25;
}

.feedback-option::after {
  border: 0;
}

.feedback-option--active {
  border-color: var(--safe-primary);
  background: var(--safe-primary-soft);
  color: var(--safe-primary-deep);
  font-weight: 700;
}

.list-line {
  padding: 10rpx 0;
  color: var(--safe-text);
  font-size: 27rpx;
  line-height: 1.65;
}

.report-export {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-top: 40rpx;
}

.download-help {
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.6;
  text-align: center;
}

.share-canvas {
  position: fixed;
  top: 0;
  left: -10000px;
  pointer-events: none;
}
