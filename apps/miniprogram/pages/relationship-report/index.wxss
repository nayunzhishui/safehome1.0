/* 阶段性报告（Figma 675:3478）：报告头与三段进度、核对卡、一张纸正文（细线分节）、边界脚注与长图导出。 */
.report-page {
  display: flex;
  flex-direction: column;
  gap: var(--p3-section);
  padding-top: 16rpx;
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
}

.report-head {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: var(--p3-stack);
}

.report-head__titles {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

/* 已生成 → 已确认 → 已发送：3px 青瓷短条 + 小字，未到的步骤用细线色 */
.report-steps {
  display: flex;
  gap: var(--p3-tight);
}

.report-step {
  display: flex;
  flex: 1 0 0;
  flex-direction: column;
  gap: 12rpx;
  min-width: 0;
}

.report-step__bar {
  height: 6rpx;
  border-radius: 999rpx;
  background: var(--p3-hairline);
}

.report-step__label {
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
  white-space: nowrap;
}

.report-step--complete .report-step__bar {
  background: var(--p3-primary);
}

.report-step--complete .report-step__label {
  color: var(--p3-primary);
}

.report-excerpt {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding-top: 8rpx;
}

.report-body {
  display: block;
  color: var(--p3-ink);
  font-size: 30rpx;
  line-height: 52rpx;
  overflow-wrap: anywhere;
}

.report-body--muted {
  color: var(--p3-muted);
}

/* 报告正文：一张纸白卡，节与节之间一条细线 */
.report-paper {
  display: flex;
  flex-direction: column;
  padding: 8rpx var(--p3-card);
  border-radius: var(--p3-radius-card);
  background: var(--p3-surface);
}

.report-paper--padded {
  padding: var(--p3-card);
}

.report-section {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
  padding: 36rpx 0;
}

.report-section + .report-section {
  border-top: 2rpx solid var(--p3-hairline);
}

.report-bar {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-top: 12rpx;
}

.report-bar__label {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--p3-tight);
}

.report-bar__name {
  min-width: 0;
  color: var(--p3-ink);
  font-size: 28rpx;
  line-height: 44rpx;
}

.report-bar__track {
  overflow: hidden;
  height: 12rpx;
  border-radius: 999rpx;
  background: var(--p3-paper);
}

.report-bar__fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--p3-primary);
}

/* 两种需要：青瓷“靠近”与暖棕“保护”之间以细线和“同时”相连 */
.report-axis {
  display: flex;
  align-items: center;
  gap: var(--p3-tight);
  font-size: 28rpx;
  line-height: 44rpx;
  white-space: nowrap;
}

.report-axis__near {
  color: var(--p3-primary);
}

.report-axis__guard {
  color: var(--p3-warm-ink);
}

.report-axis__line {
  flex: 1 0 0;
  min-width: 16rpx;
  height: 2rpx;
  background: var(--p3-hairline);
}

.report-hypothesis {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
}

.report-hypothesis + .report-hypothesis {
  padding-top: 24rpx;
  border-top: 2rpx solid var(--p3-hairline);
}

.report-export {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
}

.report-export__help {
  text-align: center;
}

.share-canvas {
  position: fixed;
  top: 0;
  left: -10000px;
  pointer-events: none;
}
