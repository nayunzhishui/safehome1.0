<view class="safe-page safe-page--with-tabbar home-page" role="main" aria-label="安心陪伴首页">
  <view class="home-header">
    <text class="home-title">安心陪伴</text>
    <button class="notice-button" aria-label="打开消息中心{{unreadMessageCount > 0 ? '，有未读消息' : ''}}" bindtap="openMessages">
      <view class="notice-icon" aria-hidden="true">
        <view class="notice-icon-dome"></view>
        <view class="notice-icon-base"></view>
        <view class="notice-icon-clapper"></view>
      </view>
      <view wx:if="{{unreadMessageCount > 0}}" class="notice-dot"></view>
    </button>
  </view>

  <view class="home-divider"></view>

  <entry-row class="thermometer-entry" icon="thermometer" title="情绪温度计" subtitle="今天已记录 {{thermometerRecordCount}} 次{{thermometerRecordReady ? '' : '，联网后更新'}}" bind:action="openThermometer" />

  <page-state
    wx:if="{{homeOverviewError}}"
    kind="error"
    title="首页摘要暂时不可用"
    description="{{homeOverviewError}}"
    action-label="重新加载"
    bind:action="retryHomeData"
  />

  <dual-entry left-key="assessment" left-icon="assessment" left-title="测一测" left-subtitle="了解此刻状态" right-key="diary" right-icon="diary" right-title="情绪日记" right-subtitle="记录具体小事" bind:action="openCoreEntry" />

  <journey-action-card
    class="today-step-entry"
    loading="{{todayJourneyLoading}}"
    error-message="{{todayJourneyError}}"
    state="{{todayJourney ? todayJourney.state : 'not_due'}}"
    state-label="{{todayJourney ? todayJourney.stateLabel : '按节奏进行'}}"
    title="{{todayJourney ? todayJourney.title : '继续今天的一小步'}}"
    description="{{todayJourney ? todayJourney.description : ''}}"
    meta-text="{{todayJourney ? todayJourney.metaText : ''}}"
    button-label="{{todayJourney ? todayJourney.buttonLabel : '继续'}}"
    action-aria-label="{{todayJourney ? todayJourney.actionAriaLabel : '继续今天的一小步'}}"
    bind:action="openTodayAction"
    bind:retry="retryTodayJourney"
  />

  <entry-row class="how-to-entry" icon="start" title="如何开始" subtitle="记录 · 反馈 · 练习" bind:action="openGettingStarted" />

  <view class="home-section">
    <section-heading title="更多" />
    <entry-row icon="feedback" title="支持性反馈" subtitle="记录后获得对应反馈" action-key="feedback" bind:action="openCoreEntry" />
    <entry-row icon="training" title="训练中心" subtitle="查看训练计划与练习" action-key="training" bind:action="openCoreEntry" />
    <entry-row icon="person" title="人工支持" subtitle="提交非实时支持请求" action-key="supervision" bind:action="openCoreEntry" />
  </view>

  <view class="home-section">
    <section-heading title="最近记录" />
    <page-state
      wx:if="{{!latestRecordReady && !latestRecordError}}"
      kind="loading"
      title="正在读取最近记录"
    />
    <page-state
      wx:elif="{{latestRecordError}}"
      kind="error"
      title="暂时无法读取最近记录"
      description="{{latestRecordError}}"
      action-label="重新加载"
      bind:action="retryHomeData"
    />
    <entry-row wx:elif="{{latestRecord}}" class="summary-entry" icon="diary" title="{{latestRecord.time}} · {{latestRecord.trigger}}" subtitle="{{latestRecord.mood}}" action-label="{{latestRecord.status}}" expanded wrap-title bind:action="openDiaryHistory" />
    <entry-row wx:else class="summary-entry" icon="diary" title="还没有保存的记录" subtitle="可以先写下一件刚发生的小事" action-label="去记录" expanded bind:action="startDiary" />
  </view>

  <view class="home-section">
    <section-heading title="阶段性反馈" />
    <page-state
      wx:if="{{!progressSummaryReady && !progressSummaryError}}"
      kind="loading"
      title="正在读取阶段性反馈"
    />
    <entry-row wx:elif="{{progressSummary}}" class="summary-entry" icon="feedback" title="{{progressSummary.summaryText}}" subtitle="{{progressSummary.nextAction}}" expanded wrap-title bind:action="openWeeklyReport" />
    <page-state
      wx:elif="{{progressSummaryError}}"
      kind="error"
      title="暂时无法读取阶段性反馈"
      description="{{progressSummaryError}}"
      action-label="重新加载"
      bind:action="retryHomeData"
    />
    <entry-row wx:else class="summary-entry" icon="feedback" title="记录还不够，继续观察" subtitle="完成更多记录后，这里会呈现阶段摘要" action-label="查看说明" expanded bind:action="openWeeklyReport" />
  </view>

  <view wx:if="{{showDevEntry}}" class="dev-entry-section">
    <button class="dev-entry" bindtap="openIntegrationTest">进入联调测试页</button>
  </view>
</view>
