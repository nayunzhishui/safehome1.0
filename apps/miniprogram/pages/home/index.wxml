<view class="safe-page safe-page--with-tabbar home-page" role="main" aria-label="安心陪伴首页">
  <view class="home-header">
    <text class="home-title">安心陪伴</text>
    <button class="notice-button" aria-label="打开消息中心{{unreadMessageCount > 0 ? '，有未读消息' : ''}}" bindtap="openMessages">
      <view class="notice-icon" aria-hidden="true">
        <view class="notice-icon-dome"></view>
        <view class="notice-icon-base"></view>
        <view class="notice-icon-clapper"></view>
      </view>
      <view wx:if="{{unreadMessageCount > 0}}" class="notice-dot"></view>
    </button>
  </view>

  <view class="home-divider"></view>

  <button class="entry-row thermometer-entry" bindtap="openThermometer">
    <view class="line-icon line-icon--thermometer" aria-hidden="true">
      <view class="thermometer-stem"></view>
      <view class="thermometer-bulb"></view>
    </view>
    <view class="entry-copy">
      <text class="entry-title">情绪温度计</text>
      <text class="entry-subtitle">今天已记录 {{thermometerRecordCount}} 次{{thermometerRecordReady ? '' : '，联网后更新'}}</text>
    </view>
    <text class="entry-arrow" aria-hidden="true">›</text>
  </button>

  <view class="dual-entries" role="group" aria-label="主要记录入口">
    <button class="dual-entry dual-entry--accent" data-key="assessment" bindtap="openCoreEntry">
      <view class="line-icon line-icon--assessment" aria-hidden="true"><view class="check-mark"></view></view>
      <view class="entry-copy">
        <text class="entry-title">测一测</text>
        <text class="entry-subtitle">了解此刻状态</text>
      </view>
    </button>
    <view class="dual-divider" aria-hidden="true"></view>
    <button class="dual-entry" data-key="diary" bindtap="openCoreEntry">
      <view class="line-icon line-icon--diary" aria-hidden="true"><view class="diary-line"></view></view>
      <view class="entry-copy">
        <text class="entry-title">情绪日记</text>
        <text class="entry-subtitle">记录具体小事</text>
      </view>
    </button>
  </view>

  <journey-action-card
    class="today-step-entry"
    loading="{{todayJourneyLoading}}"
    error-message="{{todayJourneyError}}"
    state="{{todayJourney ? todayJourney.state : 'not_due'}}"
    state-label="{{todayJourney ? todayJourney.stateLabel : '按节奏进行'}}"
    title="{{todayJourney ? todayJourney.title : '继续今天的一小步'}}"
    description="{{todayJourney ? todayJourney.description : ''}}"
    meta-text="{{todayJourney ? todayJourney.metaText : ''}}"
    button-label="{{todayJourney ? todayJourney.buttonLabel : '继续'}}"
    action-aria-label="{{todayJourney ? todayJourney.actionAriaLabel : '继续今天的一小步'}}"
    boundary-notice="{{todayJourney ? todayJourney.boundaryNotice : ''}}"
    bind:action="openTodayAction"
    bind:retry="retryTodayJourney"
  />

  <button class="entry-row how-to-entry" bindtap="openGettingStarted">
    <text class="start-mark" aria-hidden="true">›</text>
    <view class="entry-copy">
      <text class="entry-title">如何开始</text>
      <text class="entry-subtitle">记录 · 反馈 · 练习</text>
    </view>
    <text class="entry-arrow" aria-hidden="true">›</text>
  </button>

  <view class="home-section">
    <view class="section-heading"><text>更多</text></view>
    <button class="entry-row" data-key="feedback" bindtap="openCoreEntry">
      <view class="line-icon line-icon--feedback" aria-hidden="true"><view class="feedback-tail"></view></view>
      <view class="entry-copy">
        <text class="entry-title">支持性反馈</text>
        <text class="entry-subtitle">记录后获得对应反馈</text>
      </view>
      <text class="entry-arrow" aria-hidden="true">›</text>
    </button>
    <button class="entry-row" data-key="training" bindtap="openCoreEntry">
      <view class="line-icon line-icon--training" aria-hidden="true"><view class="training-base"></view></view>
      <view class="entry-copy">
        <text class="entry-title">训练中心</text>
        <text class="entry-subtitle">查看训练计划与练习</text>
      </view>
      <text class="entry-arrow" aria-hidden="true">›</text>
    </button>
    <button class="entry-row" data-key="supervision" bindtap="openCoreEntry">
      <view class="line-icon line-icon--person" aria-hidden="true"><view class="person-head"></view><view class="person-body"></view></view>
      <view class="entry-copy">
        <text class="entry-title">人工支持</text>
        <text class="entry-subtitle">提交非实时支持请求</text>
      </view>
      <text class="entry-arrow" aria-hidden="true">›</text>
    </button>
  </view>

  <view class="home-section">
    <view class="section-heading"><text>最近记录</text></view>
    <page-state
      wx:if="{{!latestRecordReady && !latestRecordError}}"
      kind="loading"
      title="正在读取最近记录"
      description="正在同步已经保存的真实记录，请稍候。"
    />
    <page-state
      wx:elif="{{latestRecordError}}"
      kind="error"
      title="暂时无法读取最近记录"
      description="{{latestRecordError}}"
      action-label="重新加载"
      bind:action="retryHomeData"
    />
    <button wx:elif="{{latestRecord}}" class="entry-row summary-entry" bindtap="openDiaryHistory">
      <view class="line-icon line-icon--diary" aria-hidden="true"><view class="diary-line"></view></view>
      <view class="entry-copy">
        <text class="entry-title entry-title--wrap">{{latestRecord.time}} · {{latestRecord.trigger}}</text>
        <text class="entry-subtitle">{{latestRecord.mood}}</text>
      </view>
      <text class="entry-action">{{latestRecord.status}}</text>
      <text class="entry-arrow" aria-hidden="true">›</text>
    </button>
    <button wx:else class="entry-row summary-entry" bindtap="startDiary">
      <view class="line-icon line-icon--diary" aria-hidden="true"><view class="diary-line"></view></view>
      <view class="entry-copy">
        <text class="entry-title">还没有保存的记录</text>
        <text class="entry-subtitle">可以先写下一件刚发生的小事</text>
      </view>
      <text class="entry-action">去记录</text>
      <text class="entry-arrow" aria-hidden="true">›</text>
    </button>
  </view>

  <view class="home-section">
    <view class="section-heading"><text>阶段性反馈</text></view>
    <page-state
      wx:if="{{!progressSummaryReady && !progressSummaryError}}"
      kind="loading"
      title="正在读取阶段性反馈"
      description="正在汇总已有记录，请稍候。"
    />
    <button wx:elif="{{progressSummary}}" class="entry-row summary-entry summary-entry--expanded" bindtap="openWeeklyReport">
      <view class="line-icon line-icon--feedback" aria-hidden="true"><view class="feedback-tail"></view></view>
      <view class="entry-copy">
        <text class="entry-title entry-title--wrap">{{progressSummary.summaryText}}</text>
        <text class="entry-subtitle">{{progressSummary.statusText}} · 测评 {{progressSummary.assessmentCount}} · 练习 {{progressSummary.checkinCount}} · 温度 {{progressSummary.thermometerCount}}</text>
        <text class="summary-detail">常见场景：{{progressSummary.topScene}} · 常见情绪：{{progressSummary.topEmotion}}</text>
        <text class="summary-next">{{progressSummary.nextAction}}</text>
        <text class="summary-boundary">{{progressSummary.boundaryNotice}}</text>
      </view>
      <text class="entry-arrow" aria-hidden="true">›</text>
    </button>
    <page-state
      wx:elif="{{progressSummaryError}}"
      kind="error"
      title="暂时无法读取阶段性反馈"
      description="{{progressSummaryError}}"
      action-label="重新加载"
      bind:action="retryHomeData"
    />
    <button wx:else class="entry-row summary-entry" bindtap="openWeeklyReport">
      <view class="line-icon line-icon--feedback" aria-hidden="true"><view class="feedback-tail"></view></view>
      <view class="entry-copy">
        <text class="entry-title">记录还不够，继续观察</text>
        <text class="entry-subtitle">完成更多记录后，这里会呈现阶段摘要</text>
      </view>
      <text class="entry-action">查看说明</text>
      <text class="entry-arrow" aria-hidden="true">›</text>
    </button>
  </view>

  <view wx:if="{{showDevEntry}}" class="dev-entry-section">
    <button class="dev-entry" bindtap="openIntegrationTest">进入联调测试页</button>
  </view>
</view>
