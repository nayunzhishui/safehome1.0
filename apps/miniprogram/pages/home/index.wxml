<view class="safe-page home-page">
  <view class="home-hero">
    <view class="home-topline">
      <view>
        <text class="home-greeting">早上好，妈妈</text>
        <text class="home-subtitle">新的 一天，记得先照顾自己哦</text>
      </view>
      <button class="notice-button" aria-label="查看提醒">
        <view class="notice-dot"></view>
      </button>
    </view>

    <view class="mood-panel">
      <view class="mood-copy">
        <text class="mood-label">今日情绪状态</text>
        <view class="mood-main">
          <text class="mood-face">☺</text>
          <view>
            <text class="mood-title">还可以</text>
            <text class="mood-text">轻度压力</text>
          </view>
        </view>
        <button class="mood-action" bindtap="startDiary">记录我的情绪</button>
      </view>
      <image class="mood-image" src="/assets/illustrations/home-family-care.png" mode="aspectFill" />
    </view>
  </view>

  <view class="safe-section">
    <section-title
      title="快速入口"
      subtitle="核心功能快捷进入，降低操作成本"
      more-text="更多"
      bind:more="openHotTopics"
    />
    <view class="quick-entry-grid">
      <button
        wx:for="{{coreEntries}}"
        wx:key="key"
        class="quick-entry"
        data-key="{{item.key}}"
        bindtap="openCoreEntry"
      >
        <view class="quick-icon" style="background: {{item.accentBg}}; color: {{item.accentColor}};">
          {{item.iconText}}
        </view>
        <text class="quick-title">{{item.title}}</text>
        <text class="quick-subtitle">{{item.subtitle}}</text>
      </button>
    </view>
  </view>

  <view class="safe-section">
    <section-title title="今日推荐训练" subtitle="根据情绪状态推荐一个可以开始的小练习" more-text="查看全部" bind:more="openRecommendedTraining" />
    <button class="daily-training-card" bindtap="openRecommendedTraining">
      <image class="daily-training-image" src="/assets/illustrations/course-cover-emotion.png" mode="aspectFill" />
      <view class="daily-training-copy">
        <text class="daily-training-title">5分钟呼吸放松练习</text>
        <text class="daily-training-text">缓解紧张情绪，找回平静</text>
        <view class="training-tags">
          <text>5分钟</text>
          <text>初级</text>
        </view>
      </view>
      <view class="play-button"></view>
    </button>
  </view>

  <view class="safe-section">
    <section-title title="最近记录" subtitle="方便继续查看与跟进" more-text="查看全部" bind:more="openWeeklyReport" />
    <button class="recent-record-card" bindtap="openWeeklyReport">
      <text class="recent-face">☹</text>
      <view class="recent-copy">
        <text class="recent-time">{{latestRecord.time}}</text>
        <text class="recent-title">{{latestRecord.mood}}，{{latestRecord.trigger}}</text>
        <text class="recent-meta">触发事件：{{latestRecord.trigger}}</text>
      </view>
      <text class="recent-status">{{latestRecord.status}} ›</text>
    </button>
  </view>

  <view class="safe-section">
    <view class="home-tip-card">
      <view>
        <text class="tip-title">安心小贴士</text>
        <text class="tip-text">允许自己有情绪，照顾好自己，才能更好地陪伴孩子。</text>
      </view>
      <image class="tip-image" src="/assets/illustrations/weekly-growth.png" mode="aspectFill" />
    </view>
  </view>

  <view class="safe-section dev-entry-section">
    <button class="dev-entry" bindtap="openIntegrationTest">进入联调测试页</button>
  </view>
</view>
