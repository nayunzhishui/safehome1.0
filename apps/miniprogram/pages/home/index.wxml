<view class="home-page" role="main" aria-hidden="{{tourVisible}}" aria-label="安心陪伴首页">
  <view class="home-hero" style="padding-top: {{hero.greetingTop}}px;">
    <view wx:if="{{hero.offset > 0}}" class="home-hero__sky" style="height: {{hero.offset}}px;" aria-hidden="true"></view>
    <image class="home-hero__art" src="/assets/art/home-hero.svg" style="top: {{hero.offset}}px;" aria-hidden="true" />
    <button class="home-bell" style="top: {{hero.bellTop}}px;" aria-label="打开消息中心{{unreadMessageCount > 0 ? '，有未读消息' : ''}}" bindtap="openMessages">
      <p3-icon name="bell" size="20" tone="ink" />
      <view wx:if="{{unreadMessageCount > 0}}" class="home-bell__dot" aria-hidden="true"></view>
    </button>
    <text class="p3-greeting home-greeting" role="heading" aria-level="1">{{greeting}}</text>
    <text class="home-date">{{dateText}} · 安心陪伴</text>

    <view class="home-thermo" id="guide-thermometer">
      <view class="home-thermo__head">
        <text class="home-thermo__title">情绪温度计</text>
        <text class="home-thermo__count">{{thermometerCountText}}</text>
      </view>
      <text class="home-thermo__hint">此刻的情绪有多强？点一个刻度记下来</text>
      <p3-thermometer value="{{thermometerLatest}}" aria-label="情绪温度计，点一个刻度去记录" bind:pick="pickThermometer" />
    </view>
  </view>

  <view class="home-content">
    <view wx:if="{{privacyNoticeVisible}}" class="home-privacy" aria-label="首次隐私说明">
      <text class="home-privacy__title">使用前，先了解记录与隐私</text>
      <text class="home-privacy__copy">你提交的记录可与账号关联，用于反馈与复盘。这里不做诊断，也不提供实时监护或紧急救助。</text>
      <text class="home-privacy__copy">查看说明或点“知道了”不代表同意研究、模型训练等可选用途。</text>
      <view class="home-privacy__actions">
        <button class="p3-link" bindtap="openPrivacyNotice">查看隐私与删除说明</button>
        <button class="p3-btn p3-btn--secondary home-privacy__ok" bindtap="acknowledgePrivacyNotice">知道了</button>
      </view>
    </view>

    <page-state
      wx:if="{{homeOverviewError}}"
      kind="error"
      title="首页摘要暂时不可用"
      description="{{homeOverviewError}}"
      action-label="重新加载"
      bind:action="retryHomeData"
    />

    <journey-action-card
      id="guide-today"
      class="today-step-entry"
      loading="{{todayJourneyLoading}}"
      error-message="{{todayJourneyError}}"
      state="{{todayJourney ? todayJourney.state : 'not_due'}}"
      state-label="{{todayJourney ? todayJourney.stateLabel : '按节奏进行'}}"
      title="{{todayJourney ? todayJourney.title : '继续今天的一小步'}}"
      description="{{todayJourney ? todayJourney.description : ''}}"
      meta-text="{{todayJourney ? todayJourney.metaText : ''}}"
      button-label="{{todayJourney ? todayJourney.buttonLabel : '继续'}}"
      action-aria-label="{{todayJourney ? todayJourney.actionAriaLabel : '继续今天的一小步'}}"
      bind:action="openTodayAction"
      bind:retry="retryTodayJourney"
    />

    <view class="home-capture" id="guide-capture">
      <button
        wx:for="{{quickActions}}"
        wx:key="key"
        class="home-quick"
        aria-label="{{item.title}}，{{item.subtitle}}"
        data-key="{{item.key}}"
        bindtap="openCoreEntry"
      >
        <view class="home-quick__badge home-quick__badge--{{item.badge}}">
          <p3-icon name="{{item.icon}}" size="24" tone="ink" />
        </view>
        <text class="home-quick__title">{{item.title}}</text>
        <text class="home-quick__subtitle">{{item.subtitle}}</text>
      </button>
    </view>

    <view class="home-section">
      <p3-section-header title="最近" />
      <button wx:if="{{homeLoginRequired}}" class="home-recent" aria-label="登录后查看最近记录" bindtap="openLogin">
        <image class="home-recent__art" src="/assets/art/empty-sprout.svg" aria-hidden="true" />
        <view class="home-recent__text">
          <text class="home-recent__title">登录后查看最近记录</text>
          <text class="home-recent__subtitle">登录后可以接着看你写过的小事</text>
        </view>
        <text class="home-recent__action">去登录 ›</text>
      </button>
      <view wx:elif="{{!latestRecordReady && !latestRecordError}}" class="home-recent" role="status" aria-live="polite">
        <image class="home-recent__art" src="/assets/art/empty-sprout.svg" aria-hidden="true" />
        <view class="home-recent__text">
          <text class="home-recent__title">正在读取最近记录</text>
        </view>
      </view>
      <button wx:elif="{{latestRecordError}}" class="home-recent" aria-label="暂时无法读取最近记录，重新加载" bindtap="retryHomeData">
        <image class="home-recent__art" src="/assets/art/empty-sprout.svg" aria-hidden="true" />
        <view class="home-recent__text">
          <text class="home-recent__title">暂时无法读取最近记录</text>
          <text class="home-recent__subtitle">{{latestRecordError}}</text>
        </view>
        <text class="home-recent__action">重新加载 ›</text>
      </button>
      <button wx:elif="{{latestRecord}}" class="home-recent" aria-label="最近记录：{{latestRecord.time}} {{latestRecord.trigger}}，{{latestRecord.status}}" bindtap="openDiaryHistory">
        <view class="home-recent__badge" aria-hidden="true">
          <p3-icon name="diary" size="24" tone="ink" />
        </view>
        <view class="home-recent__text">
          <text class="home-recent__title">{{latestRecord.trigger}}</text>
          <text class="home-recent__subtitle">{{latestRecord.time}} · {{latestRecord.mood}}</text>
        </view>
        <text class="home-recent__action">{{latestRecord.status}} ›</text>
      </button>
      <button wx:else class="home-recent" aria-label="还没有记录，去写一件刚发生的小事" bindtap="startDiary">
        <image class="home-recent__art" src="/assets/art/empty-sprout.svg" aria-hidden="true" />
        <view class="home-recent__text">
          <text class="home-recent__title">还没有记录</text>
          <text class="home-recent__subtitle">写下一件刚发生的小事</text>
        </view>
        <text class="home-recent__action">去写 ›</text>
      </button>
    </view>

    <view class="home-footer">
      <view class="home-footer__links">
        <button id="guide-start" class="home-footer__link" bindtap="openGettingStarted">三步开始</button>
        <text class="home-footer__dot" aria-hidden="true">·</text>
        <button id="guide-support" class="home-footer__link" data-key="supervision" bindtap="openCoreEntry">人工支持</button>
        <text class="home-footer__dot" aria-hidden="true">·</text>
        <button id="guide-emergency" class="home-footer__link home-footer__link--risk" bindtap="openEmergencyGuide">紧急求助</button>
      </view>
      <button id="guide-replay" class="home-footer__link home-footer__replay" bindtap="startGuide">重看使用教程</button>
    </view>

    <view wx:if="{{showDevEntry}}" class="dev-entry-section">
      <button class="p3-btn p3-btn--secondary" bindtap="openIntegrationTest">进入联调测试页</button>
    </view>
  </view>
</view>

<onboarding-guide visible="{{tourVisible}}" step="{{tourStep}}" index="{{tourIndex}}" total="{{tourTotal}}" rect="{{tourRect}}" position="{{tourPosition}}" bind:next="nextGuide" bind:previous="previousGuide" bind:skip="endGuide" />
