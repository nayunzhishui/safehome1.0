.home-page {
  --journey-bg: #174b38;
  --journey-border: #174b38;
  --journey-accent: #174b38;
  --journey-title: #ffffff;
  --journey-copy: rgba(255, 255, 255, 0.9);
  --journey-muted: rgba(255, 255, 255, 0.76);
  --journey-kicker: #ffffff;
  --journey-marker-bg: rgba(255, 255, 255, 0.16);
  --journey-marker-text: #ffffff;
  --journey-button-bg: var(--safe-orange);
  --journey-button-text: var(--safe-title);
  padding: 48rpx;
  padding-bottom: calc(176rpx + env(safe-area-inset-bottom));
}

.home-header {
  min-height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.home-title {
  color: var(--safe-title);
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.3;
}

.home-divider {
  height: 1rpx;
  background: var(--safe-border);
}

.notice-button {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  min-height: 88rpx;
  flex: 0 0 auto;
  border: 1rpx solid var(--safe-border);
  border-radius: 50%;
  background: var(--safe-card);
}

.notice-icon {
  position: absolute;
  left: 25rpx;
  top: 23rpx;
  width: 38rpx;
  height: 42rpx;
}

.notice-icon-dome {
  position: absolute;
  left: 6rpx;
  top: 2rpx;
  width: 26rpx;
  height: 28rpx;
  border: 3rpx solid var(--safe-title);
  border-bottom: 0;
  border-radius: 16rpx 16rpx 6rpx 6rpx;
  box-sizing: border-box;
}

.notice-icon-base {
  position: absolute;
  left: 3rpx;
  top: 29rpx;
  width: 32rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: var(--safe-title);
}

.notice-icon-clapper {
  position: absolute;
  left: 16rpx;
  top: 34rpx;
  width: 7rpx;
  height: 5rpx;
  border-radius: 0 0 8rpx 8rpx;
  background: var(--safe-title);
}

.notice-dot {
  position: absolute;
  top: 10rpx;
  right: 12rpx;
  width: 16rpx;
  height: 16rpx;
  border: 3rpx solid var(--safe-card);
  border-radius: 50%;
  background: var(--safe-danger);
}

.entry-row,
.dual-entry {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 24rpx;
  text-align: left;
}

.entry-row {
  position: relative;
  min-height: 144rpx;
  border-bottom: 1rpx solid var(--safe-border);
}

.entry-row:active,
.dual-entry:active {
  background: var(--safe-bg-soft);
}

.entry-copy {
  min-width: 0;
  flex: 1;
}

.entry-title,
.entry-subtitle,
.summary-detail,
.summary-next,
.summary-boundary {
  display: block;
}

.entry-title {
  overflow: hidden;
  color: var(--safe-title);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entry-title--wrap {
  display: -webkit-box;
  white-space: normal;
  overflow-wrap: anywhere;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.entry-subtitle {
  margin-top: 4rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.5;
}

.entry-arrow {
  flex: 0 0 auto;
  color: var(--safe-title);
  font-size: 44rpx;
  font-weight: 500;
  line-height: 1;
}

.entry-action {
  flex: 0 0 auto;
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 700;
  white-space: nowrap;
}

.line-icon {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 auto;
  color: var(--safe-title);
}

.line-icon--thermometer .thermometer-stem {
  position: absolute;
  left: 18rpx;
  top: 2rpx;
  width: 12rpx;
  height: 32rpx;
  border: 3rpx solid currentColor;
  border-bottom: 0;
  border-radius: 10rpx 10rpx 0 0;
  box-sizing: border-box;
}

.line-icon--thermometer .thermometer-bulb {
  position: absolute;
  left: 13rpx;
  bottom: 3rpx;
  width: 22rpx;
  height: 22rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}

.line-icon--assessment {
  border: 3rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}

.check-mark {
  position: absolute;
  left: 12rpx;
  top: 14rpx;
  width: 18rpx;
  height: 10rpx;
  border-left: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  transform: rotate(-45deg);
}

.line-icon--diary {
  width: 34rpx;
  height: 42rpx;
  margin: 3rpx 7rpx;
  border: 3rpx solid currentColor;
  border-radius: 3rpx;
  box-sizing: border-box;
}

.diary-line,
.line-icon--diary::before,
.line-icon--diary::after {
  position: absolute;
  left: 8rpx;
  width: 15rpx;
  height: 2rpx;
  background: currentColor;
  content: "";
}

.line-icon--diary::before { top: 11rpx; }
.diary-line { top: 19rpx; }
.line-icon--diary::after { top: 27rpx; }

.line-icon--feedback {
  width: 40rpx;
  height: 34rpx;
  margin: 4rpx;
  border: 3rpx solid currentColor;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.feedback-tail {
  position: absolute;
  left: 6rpx;
  bottom: -9rpx;
  width: 12rpx;
  height: 12rpx;
  border-left: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  background: var(--safe-bg);
  transform: skewY(-35deg);
}

.line-icon--training {
  width: 38rpx;
  height: 38rpx;
  margin: 5rpx;
  border: 3rpx solid currentColor;
  border-radius: 6rpx;
  box-sizing: border-box;
}

.training-base {
  position: absolute;
  left: 8rpx;
  bottom: 8rpx;
  width: 16rpx;
  height: 9rpx;
  border-left: 3rpx solid currentColor;
  border-right: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
}

.person-head {
  position: absolute;
  left: 15rpx;
  top: 3rpx;
  width: 18rpx;
  height: 18rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}

.person-body {
  position: absolute;
  left: 8rpx;
  bottom: 2rpx;
  width: 32rpx;
  height: 18rpx;
  border: 3rpx solid currentColor;
  border-bottom: 0;
  border-radius: 20rpx 20rpx 0 0;
  box-sizing: border-box;
}

.dual-entries {
  position: relative;
  display: grid;
  grid-template-columns: 1fr 1rpx 1fr;
  align-items: center;
  min-height: 208rpx;
}

.dual-entry {
  min-width: 0;
  min-height: 160rpx;
  padding: 24rpx 28rpx;
}

.dual-entry--accent .entry-title,
.dual-entry--accent .line-icon {
  color: var(--safe-primary-deep);
}

.dual-divider {
  width: 1rpx;
  height: 112rpx;
  background: var(--safe-border);
}

.today-step-entry {
  display: block;
  margin-top: 0;
}

.how-to-entry {
  margin-top: 12rpx;
}

.start-mark {
  width: 48rpx;
  color: var(--safe-title);
  font-size: 48rpx;
  line-height: 1;
  text-align: center;
}

.home-section {
  margin-top: 12rpx;
}

.section-heading {
  min-height: 104rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid var(--safe-border);
  color: var(--safe-title);
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.4;
}

.summary-entry {
  min-height: 224rpx;
}

.summary-entry--expanded {
  align-items: flex-start;
  padding: 24rpx 0;
}

.summary-detail,
.summary-next,
.summary-boundary {
  margin-top: 10rpx;
  color: var(--safe-muted);
  font-size: 22rpx;
  line-height: 1.55;
}

.summary-next {
  color: var(--safe-title);
  font-weight: 700;
}

.summary-boundary {
  padding-top: 10rpx;
  border-top: 1rpx solid var(--safe-border);
}

.home-section > page-state {
  display: block;
  margin-top: 24rpx;
}

.dev-entry-section {
  margin-top: 32rpx;
}

.dev-entry {
  width: 100%;
  min-height: 88rpx;
  border: 1rpx dashed var(--safe-border);
  border-radius: var(--safe-radius-md);
  color: var(--safe-muted);
  font-size: 24rpx;
}

@media (max-width: 340px) {
  .home-page { padding-left: 32rpx; padding-right: 32rpx; }
  .dual-entry { padding-left: 18rpx; padding-right: 18rpx; }
  .entry-title { font-size: 30rpx; }
  .entry-action { display: none; }
}
