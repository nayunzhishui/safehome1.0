.home-page {
  box-sizing: border-box;
  --journey-bg: var(--ui2-soft);
  --journey-border: transparent;
  --journey-accent: transparent;
  --journey-title: var(--ui2-ink);
  --journey-copy: var(--ui2-muted);
  --journey-muted: var(--ui2-muted);
  --journey-kicker: var(--ui2-muted);
  --journey-button-bg: var(--ui2-primary);
  --journey-button-text: #ffffff;
  padding: 48rpx;
  padding-bottom: calc(176rpx + env(safe-area-inset-bottom));
}

.home-header {
  position: relative;
  min-height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.home-title {
  display: block;
  width: 100%;
  padding: 0 104rpx;
  box-sizing: border-box;
  color: var(--safe-title);
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.3;
  text-align: center;
}

.notice-button {
  position: absolute;
  right: 0;
  width: 88rpx;
  height: 88rpx;
  min-height: 88rpx;
  flex: 0 0 auto;
  border: 1rpx solid var(--safe-border);
  border-radius: 50%;
  background: var(--safe-card);
}

.notice-icon {
  position: absolute;
  left: 25rpx;
  top: 23rpx;
  width: 38rpx;
  height: 42rpx;
}

.notice-icon-dome {
  position: absolute;
  left: 6rpx;
  top: 2rpx;
  width: 26rpx;
  height: 28rpx;
  border: 3rpx solid var(--safe-title);
  border-bottom: 0;
  border-radius: 16rpx 16rpx 6rpx 6rpx;
  box-sizing: border-box;
}

.notice-icon-base {
  position: absolute;
  left: 3rpx;
  top: 29rpx;
  width: 32rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: var(--safe-title);
}

.notice-icon-clapper {
  position: absolute;
  left: 16rpx;
  top: 34rpx;
  width: 7rpx;
  height: 5rpx;
  border-radius: 0 0 8rpx 8rpx;
  background: var(--safe-title);
}

.notice-dot {
  position: absolute;
  top: 10rpx;
  right: 12rpx;
  width: 16rpx;
  height: 16rpx;
  border: 3rpx solid var(--safe-card);
  border-radius: 50%;
  background: var(--safe-danger);
}

.today-step-entry {
  display: block;
  margin-top: 32rpx;
}

.home-capture {
  margin-top: 24rpx;
}

.how-to-entry {
  display: block;
  margin-top: 24rpx;
}

.home-section {
  margin-top: 40rpx;
}

.home-section > page-state {
  display: block;
  margin-top: 24rpx;
}

.dev-entry-section {
  margin-top: 32rpx;
}

.dev-entry {
  width: 100%;
  min-height: 88rpx;
  border: 1rpx dashed var(--safe-border);
  border-radius: var(--safe-radius-md);
  color: var(--safe-muted);
  font-size: 24rpx;
}

@media (max-width: 340px) {
  .home-page { padding-left: 32rpx; padding-right: 32rpx; }
}

.home-more {
  padding: 8rpx 32rpx 16rpx;
  border: 1rpx solid var(--ui2-line);
  border-radius: 24rpx;
  background: var(--ui2-surface);
}
.summary-entry {
  --ui2-entry-subtitle-size: 30rpx;
  --ui2-entry-subtitle-leading: 48rpx;
  --ui2-entry-action-display: none;
  --ui2-entry-title-lines: unset;
}
