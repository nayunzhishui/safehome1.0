.home-page {
  --journey-bg: #174b38;
  --journey-border: #174b38;
  --journey-accent: #174b38;
  --journey-title: #ffffff;
  --journey-copy: rgba(255, 255, 255, 0.9);
  --journey-muted: rgba(255, 255, 255, 0.76);
  --journey-kicker: #ffffff;
  --journey-marker-bg: rgba(255, 255, 255, 0.16);
  --journey-marker-text: #ffffff;
  --journey-button-bg: var(--safe-orange);
  --journey-button-text: var(--safe-title);
  padding: 48rpx;
  padding-bottom: calc(176rpx + env(safe-area-inset-bottom));
}

.home-header {
  position: relative;
  min-height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.home-title {
  display: block;
  width: 100%;
  color: var(--safe-title);
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.3;
  text-align: center;
}

.home-divider {
  height: 1rpx;
  background: var(--safe-border);
}

.notice-button {
  position: absolute;
  right: 0;
  width: 88rpx;
  height: 88rpx;
  min-height: 88rpx;
  flex: 0 0 auto;
  border: 1rpx solid var(--safe-border);
  border-radius: 50%;
  background: var(--safe-card);
}

.notice-icon {
  position: absolute;
  left: 25rpx;
  top: 23rpx;
  width: 38rpx;
  height: 42rpx;
}

.notice-icon-dome {
  position: absolute;
  left: 6rpx;
  top: 2rpx;
  width: 26rpx;
  height: 28rpx;
  border: 3rpx solid var(--safe-title);
  border-bottom: 0;
  border-radius: 16rpx 16rpx 6rpx 6rpx;
  box-sizing: border-box;
}

.notice-icon-base {
  position: absolute;
  left: 3rpx;
  top: 29rpx;
  width: 32rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: var(--safe-title);
}

.notice-icon-clapper {
  position: absolute;
  left: 16rpx;
  top: 34rpx;
  width: 7rpx;
  height: 5rpx;
  border-radius: 0 0 8rpx 8rpx;
  background: var(--safe-title);
}

.notice-dot {
  position: absolute;
  top: 10rpx;
  right: 12rpx;
  width: 16rpx;
  height: 16rpx;
  border: 3rpx solid var(--safe-card);
  border-radius: 50%;
  background: var(--safe-danger);
}

.today-step-entry {
  display: block;
  margin-top: 0;
}

.how-to-entry {
  margin-top: 12rpx;
}

.home-section {
  margin-top: 12rpx;
}

.home-section > page-state {
  display: block;
  margin-top: 24rpx;
}

.dev-entry-section {
  margin-top: 32rpx;
}

.dev-entry {
  width: 100%;
  min-height: 88rpx;
  border: 1rpx dashed var(--safe-border);
  border-radius: var(--safe-radius-md);
  color: var(--safe-muted);
  font-size: 24rpx;
}

@media (max-width: 340px) {
  .home-page { padding-left: 32rpx; padding-right: 32rpx; }
}
