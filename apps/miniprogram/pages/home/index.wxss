.home-page {
  padding-bottom: 48rpx;
}

/* ── 顶栏 ─────────────────────────────────────────── */
.home-topline {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 4rpx 2rpx 0;
}

.home-greeting,
.home-subtitle {
  display: block;
}

.home-greeting {
  color: var(--safe-title);
  font-size: 40rpx;
  font-weight: 850;
  line-height: 1.2;
}

.home-subtitle {
  margin-top: 6rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
}

.notice-button {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  flex: 0 0 auto;
  border: 1rpx solid var(--safe-border);
  border-radius: 50%;
  background: rgba(255, 253, 248, 0.86);
}

.notice-button::before {
  content: "";
  position: absolute;
  left: 22rpx;
  top: 18rpx;
  width: 26rpx;
  height: 30rpx;
  border: 4rpx solid #5f6661;
  border-radius: 22rpx 22rpx 14rpx 14rpx;
}

.notice-dot {
  position: absolute;
  right: 14rpx;
  top: 14rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #d76f67;
}

/* ── 情绪天气紧凑横条 ──────────────────────────────── */
.mood-strip {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid var(--safe-border);
  border-left: 6rpx solid var(--safe-primary);
  border-radius: var(--safe-radius-md);
  background: var(--safe-card);
  box-shadow: var(--safe-shadow-card);
  text-align: left;
}

.mood-strip:active { transform: scale(0.99); }

.mood-strip-left {
  flex: 1;
  min-width: 0;
}

.mood-strip-label,
.mood-strip-sub {
  display: block;
}

.mood-strip-label {
  color: var(--safe-title);
  font-size: 26rpx;
  font-weight: 800;
}

.mood-strip-sub {
  margin-top: 2rpx;
  color: var(--safe-muted);
  font-size: 21rpx;
}

.mood-strip-face {
  font-size: 32rpx;
  flex: 0 0 auto;
}

.mood-strip-action {
  flex: 0 0 auto;
  color: var(--safe-primary-deep);
  font-size: 23rpx;
  font-weight: 800;
}

/* ── 核心入口 ─────────────────────────────────────── */
.core-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 32rpx;
}

.core-btn {
  min-height: 148rpx;
  display: grid;
  align-content: center;
  justify-items: center;
  gap: 7rpx;
  padding: 20rpx 16rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-lg);
  background: var(--safe-card);
  box-shadow: var(--safe-shadow-card);
  text-align: center;
}

.core-btn:active { transform: scale(0.98); }

.core-btn--primary {
  border-color: var(--safe-primary);
}

.core-btn--secondary {}

.core-btn-title,
.core-btn-sub {
  display: block;
}

.core-btn-title {
  font-size: 32rpx;
  font-weight: 850;
  line-height: 1.25;
}

.core-btn--primary .core-btn-title { color: var(--safe-primary-deep); }
.core-btn--secondary .core-btn-title { color: var(--safe-title); }

.core-btn-sub {
  font-size: 22rpx;
  line-height: 1.4;
}

.core-btn--primary .core-btn-sub { color: var(--safe-muted); }
.core-btn--secondary .core-btn-sub { color: var(--safe-muted); }

/* ── 三步开始 ────────────────────────────────────── */
.step-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  margin-top: 14rpx;
}

.step-chip {
  display: grid;
  align-content: center;
  justify-items: center;
  gap: 6rpx;
  padding: 16rpx 10rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: var(--safe-card);
  box-shadow: var(--safe-shadow-card);
  text-align: center;
}

.step-chip:active { transform: scale(0.98); }

.step-chip-num,
.step-chip-title,
.step-chip-action {
  display: block;
}

.step-chip-num {
  width: 34rpx;
  height: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--safe-primary-soft);
  color: var(--safe-primary-deep);
  font-size: 20rpx;
  font-weight: 900;
}

.step-chip-title {
  color: var(--safe-title);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.3;
}

.step-chip-action {
  color: var(--safe-primary-deep);
  font-size: 20rpx;
  font-weight: 700;
}

/* ── 其他入口 ──────────────────────────────────── */
.quick-list {
  margin-top: 14rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: var(--safe-card);
  box-shadow: var(--safe-shadow-card);
  overflow: hidden;
}

.quick-list-row {
  min-height: 80rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid var(--safe-border);
  text-align: left;
}

.quick-list-row:last-child { border-bottom: none; }
.quick-list-row:active { background: var(--safe-bg-soft); }

.quick-list-icon {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  border-radius: var(--safe-radius-sm);
  font-size: 28rpx;
}

.quick-list-copy {
  flex: 1;
  min-width: 0;
}

.quick-list-title,
.quick-list-sub {
  display: block;
}

.quick-list-title {
  color: var(--safe-title);
  font-size: 27rpx;
  font-weight: 800;
}

.quick-list-sub {
  margin-top: 2rpx;
  color: var(--safe-muted);
  font-size: 21rpx;
}

.quick-list-arrow {
  flex: 0 0 auto;
  color: var(--safe-primary-deep);
  font-size: 32rpx;
  font-weight: 800;
}

/* ── 最近记录 ─────────────────────────────────────── */
.recent-record-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 14rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: var(--safe-card);
  box-shadow: var(--safe-shadow-card);
  text-align: left;
}

.recent-record-card:active { transform: scale(0.99); }

.recent-record-card--empty {
  border-style: dashed;
  background: rgba(255, 253, 248, 0.72);
}

.recent-face {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  border-radius: 50%;
  background: #f1c86d;
  color: #5f4a1d;
  font-size: 34rpx;
}

.recent-copy {
  min-width: 0;
  flex: 1;
}

.recent-time,
.recent-title,
.recent-meta {
  display: block;
}

.recent-time {
  color: var(--safe-muted);
  font-size: 21rpx;
}

.recent-title {
  margin-top: 4rpx;
  color: var(--safe-title);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.4;
}

.recent-meta {
  margin-top: 4rpx;
  color: var(--safe-muted);
  font-size: 21rpx;
}

.recent-status {
  max-width: 150rpx;
  color: var(--safe-primary-deep);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.4;
  text-align: right;
}

/* ── 阶段性反馈 ───────────────────────────────────── */
.progress-card {
  margin-top: 14rpx;
  padding: 20rpx;
  border: 1rpx solid var(--safe-border);
  border-left: 6rpx solid var(--safe-primary);
  border-radius: var(--safe-radius-md);
  background: var(--safe-card);
  box-shadow: var(--safe-shadow-card);
}

.progress-card--empty {
  border-left-color: var(--safe-border);
  background: rgba(255, 253, 248, 0.72);
}

.progress-card-head {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.progress-copy {
  flex: 1;
  min-width: 0;
}

.progress-kicker,
.progress-title,
.progress-period,
.progress-line,
.progress-boundary {
  display: block;
}

.progress-kicker {
  color: var(--safe-primary-deep);
  font-size: 22rpx;
  font-weight: 850;
}

.progress-title {
  margin-top: 6rpx;
  color: var(--safe-title);
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.45;
}

.progress-period {
  margin-top: 6rpx;
  color: var(--safe-muted);
  font-size: 21rpx;
}

.progress-badge {
  min-width: 62rpx;
  height: 62rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--safe-primary-soft);
  color: var(--safe-primary-deep);
  font-size: 28rpx;
  font-weight: 900;
}

.progress-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  margin-top: 18rpx;
}

.progress-metric {
  min-width: 0;
  padding: 14rpx 10rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-sm);
  background: var(--safe-bg-soft);
}

.progress-number,
.progress-label {
  display: block;
  text-align: center;
}

.progress-number {
  color: var(--safe-primary-deep);
  font-size: 30rpx;
  font-weight: 900;
}

.progress-label {
  margin-top: 4rpx;
  color: var(--safe-muted);
  font-size: 20rpx;
}

.progress-lines {
  display: grid;
  gap: 8rpx;
  margin-top: 18rpx;
}

.progress-line {
  color: var(--safe-text);
  font-size: 22rpx;
  line-height: 1.5;
}

.progress-line--strong {
  color: var(--safe-title);
  font-weight: 800;
}

.progress-boundary {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--safe-border);
  color: var(--safe-muted);
  font-size: 20rpx;
  line-height: 1.5;
}

.progress-empty-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 18rpx;
}

.progress-empty-btn {
  min-height: 64rpx;
  border: 1rpx solid var(--safe-primary);
  border-radius: 999rpx;
  background: var(--safe-primary);
  color: #fff;
  font-size: 22rpx;
  font-weight: 800;
}

.progress-empty-btn--secondary {
  background: var(--safe-card);
  color: var(--safe-primary-deep);
}

/* ── dev 入口 ─────────────────────────────────────── */
.dev-entry-section { margin-top: 20rpx; }

.dev-entry {
  width: 100%;
  min-height: 72rpx;
  border: 1rpx dashed var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: var(--safe-card);
  color: var(--safe-muted);
  font-size: 24rpx;
}
