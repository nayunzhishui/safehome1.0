.researcher-dashboard-page { display: grid; gap: 22rpx; padding-bottom: 48rpx; }
.dashboard-kicker, .dashboard-title, .dashboard-copy, .section-title, .detail-line, .material-title, .boundary-line { display: block; }
.dashboard-kicker { color: var(--safe-primary-deep); font-size: 22rpx; font-weight: 800; }
.dashboard-title { margin-top: 8rpx; color: var(--safe-title); font-size: 36rpx; font-weight: 900; }
.dashboard-copy { margin-top: 10rpx; color: var(--safe-text); font-size: 24rpx; line-height: 1.65; }
.dossier-tabs { white-space: nowrap; }
.dossier-tab { display: inline-block; width: auto; margin-right: 12rpx; padding: 12rpx 18rpx; border: 1rpx solid var(--safe-border); border-radius: 999rpx; background: var(--safe-card); color: var(--safe-text); font-size: 22rpx; }
.dossier-tab.active { border-color: var(--safe-primary); background: var(--safe-primary-soft); color: var(--safe-primary-deep); }
.dossier-card { display: grid; gap: 12rpx; margin-top: 18rpx; }
.section-title { color: var(--safe-title); font-size: 29rpx; font-weight: 850; }
.detail-line { color: var(--safe-text); font-size: 23rpx; line-height: 1.65; }
.action-row { display: flex; flex-wrap: wrap; gap: 12rpx; }
.small-action { width: auto; margin: 0; padding: 10rpx 20rpx; border: 1rpx solid var(--safe-border); background: #fff; color: var(--safe-text); font-size: 22rpx; }
.small-action.primary { border-color: var(--safe-primary); background: var(--safe-primary); color: #fff; }
.material-card { padding: 14rpx; border-radius: var(--safe-radius-sm); background: var(--safe-bg); }
.material-title { color: var(--safe-primary-deep); font-size: 23rpx; font-weight: 800; }
.material-canvas { width: 100%; height: 360rpx; border: 1rpx solid var(--safe-border); border-radius: var(--safe-radius-sm); background: #fff; }
.boundary-line { color: var(--safe-muted); font-size: 21rpx; line-height: 1.55; }
.note-input { box-sizing: border-box; width: 100%; min-height: 150rpx; padding: 16rpx; border: 1rpx solid var(--safe-border); border-radius: var(--safe-radius-sm); background: #fff; color: var(--safe-text); font-size: 23rpx; }
.feedback-field { display: grid; gap: 8rpx; }
.feedback-label { color: var(--safe-title); font-size: 23rpx; font-weight: 750; }
.required-mark { margin-left: 8rpx; color: var(--safe-primary-deep); font-size: 19rpx; font-weight: 650; }
.narrative-box { display: grid; gap: 12rpx; padding: 16rpx; border: 1rpx solid rgba(184, 127, 45, 0.3); border-radius: var(--safe-radius-sm); background: var(--safe-orange-soft); }
.error-card { color: var(--safe-danger); }
