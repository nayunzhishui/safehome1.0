/* 研究者工作台（Figma 673:3398 待处理 / 674:3451 参与者）：同步行、工作区标签、运行状态合为一组、三格摘要、待办列表与详情；其余工作区沿用同一套纸白卡、标签与细线。 */
.researcher-dashboard-page {
  display: flex;
  flex-direction: column;
  gap: var(--p3-section);
  padding-top: 16rpx;
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
}

/* 窄屏和大字号下不出现横向滚动：所有直接子块不超宽，长串文字可断行 */
.researcher-dashboard-page > view,
.researcher-dashboard-page > scroll-view,
.workspace-panel > view {
  box-sizing: border-box;
  max-width: 100%;
  min-width: 0;
}

.researcher-dashboard-page text {
  overflow-wrap: anywhere;
}

/* 1 同步与工作区 */
.rd-head {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
}

.sync-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--p3-tight);
  min-height: 88rpx;
}

.sync-copy {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.sync-label {
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

.sync-time {
  color: var(--p3-ink);
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: 500;
}

.sync-action,
.rd-link {
  flex: 0 0 auto;
  color: var(--p3-primary);
  font-size: 28rpx;
  line-height: 44rpx;
}

.rd-link {
  width: auto;
  min-height: 88rpx;
  margin: -22rpx 0;
  padding: 0;
}

.workbench-boundary {
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

.workspace-tabs,
.dossier-tabs,
.window-chips,
.assessment-case-tabs {
  width: 100%;
  white-space: nowrap;
}

.chip-row {
  display: inline-flex;
  gap: var(--p3-tight);
}

.chip-row .p3-chip {
  flex: 0 0 auto;
}

.tab-badge {
  margin-left: 8rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: var(--p3-warm-soft);
  color: var(--p3-warm-ink);
  font-size: 22rpx;
  line-height: 32rpx;
}

.workspace-panel {
  display: flex;
  flex-direction: column;
  gap: var(--p3-section);
}

/* 纸白分组与卡片 */
.rd-group {
  display: flex;
  flex-direction: column;
  padding: 0 32rpx;
  border-radius: var(--p3-radius-group);
  background: var(--p3-surface);
}

.rd-row--divided {
  border-bottom: 2rpx solid var(--p3-hairline);
}

.rd-card,
.safe-card {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
  box-sizing: border-box;
  padding: var(--p3-card);
  border: 0;
  border-radius: var(--p3-radius-card);
  background: var(--p3-surface);
  box-shadow: none;
}

.rd-section {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
}

.rd-section__head,
.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--p3-tight);
}

.rd-section__head--top,
.section-heading {
  align-items: flex-start;
}

.rd-titles {
  display: flex;
  flex: 1 0 0;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

/* UIproduct3/SectionLabel：14/20 字距 1 */
.rd-label,
.participant-analysis-label,
.analysis-section-kicker,
.insight-block-title {
  display: block;
  color: var(--p3-ink);
  font-size: 28rpx;
  line-height: 40rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

/* 2 运行状态：原三张卡合为一组 */
.status-row {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 28rpx 0;
}

.status-row + .status-row {
  border-top: 2rpx solid var(--p3-hairline);
}

.status-row__eyebrow,
.status-row__meta {
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

.status-row__title {
  color: var(--p3-ink);
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: 500;
}

.status-row--ok .status-row__title {
  color: var(--p3-primary);
}

.status-row--paused .status-row__title {
  color: var(--p3-warm-ink);
}

/* 3 三格摘要：宋体数字 + 一行说明（P3/StatCell） */
.summary-grid {
  display: flex;
  gap: var(--p3-tight);
  padding: 28rpx 16rpx;
  border-radius: var(--p3-radius-card);
  background: var(--p3-surface);
}

.summary-card {
  display: flex;
  flex: 1 0 0;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
  padding: 28rpx;
}

.summary-value {
  color: var(--p3-ink);
  font-family: var(--p3-font-serif);
  font-size: 48rpx;
  line-height: 64rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  font-variant-numeric: tabular-nums;
}

.summary-label {
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

/* 4 现在需要留意 */
.queue-item {
  display: flex;
  align-items: center;
  gap: var(--p3-tight);
  min-height: 88rpx;
  padding: 28rpx 0;
}

.priority-dot {
  flex: 0 0 auto;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--p3-control);
}

.priority-dot--urgent {
  background: var(--p3-risk-ink);
}

.priority-dot--attention {
  background: var(--p3-warm-ink);
}

.queue-main {
  display: flex;
  flex: 1 0 0;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.queue-title {
  overflow: hidden;
  color: var(--p3-ink);
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.queue-meta {
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

.queue-due--overdue {
  color: var(--p3-risk-ink);
}

.queue-active {
  flex: 0 0 auto;
  color: var(--p3-primary);
  font-size: 26rpx;
  line-height: 40rpx;
}

.rd-empty {
  gap: 8rpx;
  padding: 40rpx 32rpx;
}

.list-more {
  height: auto;
  min-height: 88rpx;
}

/* 5 待办详情 */
.work-item-lines {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.work-item-line {
  color: var(--p3-ink);
  font-size: 28rpx;
  line-height: 44rpx;
}

.work-item-line--muted {
  color: var(--p3-muted);
}

.work-item-line--overdue {
  color: var(--p3-risk-ink);
}

.work-item-actions,
.action-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--p3-tight);
}

.small-action {
  min-height: 84rpx;
}

.small-action.primary {
  background: var(--p3-primary);
  box-shadow: none;
  color: var(--p3-on-primary);
}

.rd-select {
  display: flex;
  align-items: center;
  gap: var(--p3-tight);
  box-sizing: border-box;
  min-height: 96rpx;
  padding: 22rpx 28rpx;
  border-radius: 28rpx;
  background: var(--p3-surface);
  box-shadow: inset 0 0 0 2rpx var(--p3-control);
}

.rd-select__value {
  flex: 1 0 0;
  min-width: 0;
  color: var(--p3-ink);
  font-size: 30rpx;
  line-height: 52rpx;
}

.rd-pair {
  display: flex;
  gap: var(--p3-tight);
}

.rd-pair .p3-btn {
  flex: 1 0 0;
  min-width: 0;
  padding: 0 16rpx;
}

.work-item-section {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
  padding-top: 32rpx;
  border-top: 2rpx solid var(--p3-hairline);
}

.work-item-section--trail {
  gap: 8rpx;
}

/* 参与者：搜索、头像行、按需档案 */
.rd-search {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
}

.search-box {
  display: flex;
  align-items: center;
  gap: var(--p3-tight);
  min-height: 88rpx;
  padding: 0 32rpx;
  border-radius: var(--p3-radius-pill);
  background: var(--p3-surface);
  box-shadow: inset 0 0 0 2rpx var(--p3-hairline);
}

.search-input {
  flex: 1 0 0;
  min-width: 0;
  height: 76rpx;
  color: var(--p3-ink);
  font-size: 30rpx;
}

.participant-card {
  display: flex;
  align-items: center;
  gap: var(--p3-tight);
  min-height: 88rpx;
  padding: 28rpx 0;
}

.participant-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--p3-soft);
  color: var(--p3-primary);
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: 500;
}

.participant-main {
  display: flex;
  flex: 1 0 0;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.participant-name {
  overflow: hidden;
  color: var(--p3-ink);
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.participant-meta,
.diagnostic-copy,
.boundary-line,
.state-copy,
.metric-hint,
.headline-label,
.insight-block-hint,
.assessment-method-limit,
.delivery-boundary,
.analysis-suppressed {
  display: block;
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

.participant-count {
  flex: 0 0 auto;
  color: var(--p3-primary);
  font-size: 26rpx;
  line-height: 40rpx;
}

.module-result-list {
  display: flex;
  flex-direction: column;
}

.module-result-list > .rd-label {
  padding-bottom: 8rpx;
}

.module-result-card {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 24rpx 0;
}

.module-result-card + .module-result-card {
  border-top: 2rpx solid var(--p3-hairline);
}

.module-line {
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

.module-line--lead {
  color: var(--p3-ink);
  font-size: 28rpx;
  line-height: 44rpx;
}

/* 通用文字层级（其余工作区） */
.section-eyebrow,
.analysis-section-kicker {
  display: block;
}

.section-eyebrow {
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

.section-title,
.error-title,
.state-title,
.analysis-job-title,
.material-title,
.delivery-preview-title,
.link-title {
  display: block;
  color: var(--p3-ink);
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: 500;
}

.analysis-job-title,
.material-title,
.delivery-preview-title,
.link-title {
  font-size: 28rpx;
  line-height: 44rpx;
}

.detail-line,
.error-copy,
.insight-summary,
.assessment-question,
.assessment-evidence-content,
.assessment-evidence-summary__copy,
.knowledge-excerpt,
.delivery-preview-body,
.analysis-quality {
  display: block;
  color: var(--p3-ink);
  font-size: 28rpx;
  line-height: 44rpx;
}

.assessment-question {
  font-size: 30rpx;
  line-height: 52rpx;
}

.error-title {
  color: var(--p3-risk-ink);
}

.state-card,
.empty-state {
  align-items: center;
  text-align: center;
}

.empty-symbol {
  color: var(--p3-control);
  font-size: 40rpx;
  line-height: 56rpx;
}

.state-orbit {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--p3-soft);
  border-top-color: var(--p3-primary);
  border-radius: 50%;
}

.state-banner {
  gap: 8rpx;
}

.state-banner--partial {
  background: var(--p3-warm-soft);
  color: var(--p3-warm-ink);
}

.inline-retry {
  align-self: flex-start;
  width: auto;
  min-height: 88rpx;
  padding: 0;
  color: var(--p3-primary);
  font-size: 28rpx;
}

.error-actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--p3-tight);
}

.error-actions button {
  flex: 1 1 240rpx;
  min-width: 0;
}

/* 旧按钮类在本页统一成 P3 外观 */
.researcher-dashboard-page .safe-primary-button,
.researcher-dashboard-page .safe-outline-button {
  box-sizing: border-box;
  width: 100%;
  height: var(--p3-button);
  min-height: var(--p3-button);
  margin: 0;
  padding: 0 32rpx;
  border: 0;
  border-radius: var(--p3-radius-pill);
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: 500;
}

.researcher-dashboard-page .safe-primary-button {
  background: var(--p3-primary);
  color: var(--p3-on-primary);
}

.researcher-dashboard-page .safe-outline-button {
  background: transparent;
  box-shadow: inset 0 0 0 2rpx var(--p3-control);
  color: var(--p3-primary);
}

.icon-refresh,
.engineering-toggle {
  flex: 0 0 auto;
  width: auto;
  min-height: 88rpx;
  margin: -22rpx 0;
  padding: 0;
  color: var(--p3-primary);
  font-size: 28rpx;
  line-height: 44rpx;
}

.engineering-toggle {
  align-self: flex-start;
  margin: 0;
}

/* 输入框（备注、检索、消息） */
.note-input {
  box-sizing: border-box;
  width: 100%;
  height: 256rpx;
  padding: 24rpx 28rpx;
  border: 2rpx solid var(--p3-control);
  border-radius: 28rpx;
  background: var(--p3-surface);
  color: var(--p3-ink);
  font-size: 30rpx;
  line-height: 52rpx;
}

.note-input--single {
  height: 96rpx;
  padding: 0 28rpx;
}

.assessment-filter,
.analysis-picker {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 88rpx;
  padding: 0 28rpx;
  border-radius: 28rpx;
  background: var(--p3-surface);
  box-shadow: inset 0 0 0 2rpx var(--p3-control);
  color: var(--p3-ink);
  font-size: 28rpx;
  line-height: 44rpx;
}

.assessment-filter-row {
  display: flex;
  gap: var(--p3-tight);
}

.assessment-filter-row picker {
  flex: 1 0 0;
  min-width: 0;
}

.feedback-field {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
}

.feedback-label {
  display: block;
  color: var(--p3-ink);
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: 500;
}

.required-mark {
  margin-left: 8rpx;
  color: var(--p3-warm-ink);
  font-size: 24rpx;
  font-weight: 400;
}

/* 状态小标签 */
.priority-pill {
  flex: 0 0 auto;
  padding: 4rpx 20rpx;
  border-radius: 999rpx;
  background: var(--p3-soft);
  color: var(--p3-primary);
  font-size: 24rpx;
  line-height: 36rpx;
  white-space: nowrap;
}

/* 在线分析、评估证据、试点等子块：米纸块与细线 */
.analysis-section,
.insight-block,
.assessment-evidence-summary,
.assessment-question-card,
.assessment-draft,
.analysis-shadow-summary,
.knowledge-retrieval-summary,
.delivery-preview,
.narrative-box,
.material-card,
.participant-analysis-result {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
}

.insight-block,
.analysis-section {
  padding-top: 28rpx;
  border-top: 2rpx solid var(--p3-hairline);
}

.assessment-question-card,
.assessment-evidence-summary,
.analysis-gate,
.delivery-preview,
.narrative-box,
.material-card,
.knowledge-retrieval-summary {
  padding: 24rpx 28rpx;
  border-radius: var(--p3-radius-group);
  background: var(--p3-paper);
}

.analysis-gate {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

.analysis-job-card,
.assessment-evidence-card {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 24rpx 0;
  border-top: 2rpx solid var(--p3-hairline);
}

.analysis-job-heading,
.participant-analysis-head,
.assessment-evidence-summary__heading,
.mine-row,
.bar-row-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--p3-tight);
}

.participant-analysis-status {
  color: var(--p3-primary);
  font-size: 28rpx;
  line-height: 44rpx;
}

.participant-analysis-groups {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
}

.assessment-evidence-summary__counts {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 24rpx;
  color: var(--p3-primary);
  font-size: 26rpx;
  line-height: 40rpx;
}

.assessment-hypothesis-grid {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 16rpx 24rpx;
  border-radius: 24rpx;
  background: var(--p3-paper);
  color: var(--p3-ink);
  font-size: 26rpx;
  line-height: 40rpx;
}

.mine-row {
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--p3-hairline);
  color: var(--p3-ink);
  font-size: 28rpx;
  line-height: 44rpx;
}

/* 群体情绪与网络：数据格、条形、指标 */
.headline-grid,
.metric-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--p3-tight);
}

.headline-cell,
.metric-cell {
  display: flex;
  flex: 1 1 180rpx;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
  padding: 24rpx;
  border-radius: var(--p3-radius-group);
  background: var(--p3-paper);
}

.headline-value,
.metric-value {
  color: var(--p3-ink);
  font-family: var(--p3-font-serif);
  font-size: 44rpx;
  line-height: 60rpx;
  font-weight: 500;
  font-variant-numeric: tabular-nums;
}

.headline-unit {
  margin-left: 4rpx;
  color: var(--p3-muted);
  font-family: inherit;
  font-size: 24rpx;
}

.metric-label {
  color: var(--p3-ink);
  font-size: 26rpx;
  line-height: 40rpx;
}

.bar-row {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.bar-row-label {
  min-width: 0;
  overflow: hidden;
  color: var(--p3-ink);
  font-size: 28rpx;
  line-height: 44rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bar-row-value {
  flex: 0 0 auto;
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
  font-variant-numeric: tabular-nums;
}

.bar-row-track {
  overflow: hidden;
  height: 12rpx;
  border-radius: 999rpx;
  background: var(--p3-paper);
}

.bar-row-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--p3-primary);
}

.bar-row-fill--scene {
  background: var(--p3-control);
}

.bar-row-fill--low {
  background: var(--p3-intensity-2);
}

.bar-row-fill--middle {
  background: var(--p3-intensity-5);
}

.bar-row-fill--high {
  background: var(--p3-intensity-9);
}

.link-row {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 16rpx 0;
  border-top: 2rpx solid var(--p3-hairline);
}

/* 试点：交付进度四步 */
.dashboard-layout {
  display: flex;
  flex-direction: column;
  gap: var(--p3-section);
}

.dossier-card + .dossier-card {
  margin-top: var(--p3-section);
}

.delivery-rail {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.delivery-step {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

.delivery-step.active {
  color: var(--p3-primary);
}

.delivery-line {
  flex: 1 0 0;
  height: 2rpx;
  background: var(--p3-hairline);
}

.delivery-receipt {
  color: var(--p3-primary);
  font-size: 26rpx;
  line-height: 40rpx;
}

.material-canvas {
  width: 100%;
  height: 400rpx;
  border-radius: var(--p3-radius-group);
  background: var(--p3-surface);
  box-shadow: inset 0 0 0 2rpx var(--p3-hairline);
}

.work-item-error {
  display: block;
}

/* 档案里的发消息、写备注；项目与评估的二级切换；时间线一行可点开对应标签。 */
.dossier-tools,
.dossier-composer {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
}

.project-switch {
  display: flex;
  flex-wrap: wrap;
}

.timeline-row {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 4rpx;
  min-height: 88rpx;
}
