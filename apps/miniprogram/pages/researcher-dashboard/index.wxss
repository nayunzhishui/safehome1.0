.researcher-dashboard-page {
  box-sizing: border-box;
  display: grid;
  width: 100%;
  min-width: 0;
  gap: 24rpx;
  padding-bottom: 64rpx;
  overflow-x: hidden;
  background: var(--safe-bg);
}

.researcher-dashboard-page > view,
.researcher-dashboard-page > scroll-view {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  max-width: 100%;
}

.analysis-job-card {
  margin-top: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #dbe4de;
  border-radius: 24rpx;
  background: #fbfdfb;
}

.analysis-job-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.analysis-job-title {
  color: #183d31;
  font-size: 28rpx;
  font-weight: 700;
}

.workbench-hero {
  box-sizing: border-box;
  display: grid;
  grid-template-columns: 1fr;
  width: 100%;
  min-width: 0;
  align-items: start;
  gap: 20rpx;
  padding: 18rpx 0 8rpx;
  background: transparent;
  text-align: center;
}

.workbench-title-group { text-align: center; }

.dashboard-kicker,
.dashboard-title,
.dashboard-copy,
.section-eyebrow,
.section-title,
.detail-line,
.material-title,
.boundary-line,
.state-title,
.state-copy,
.summary-value,
.summary-label,
.queue-title,
.queue-meta,
.participant-name,
.participant-meta,
.development-access-title,
.development-access-copy,
.capability-scope-title,
.capability-scope-copy,
.error-title,
.error-copy,
.diagnostic-copy,
.sync-label,
.sync-time {
  display: block;
}

.dashboard-kicker,
.section-eyebrow {
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.dashboard-title {
  margin-top: 8rpx;
  color: var(--safe-title);
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.25;
}

.sync-row {
  min-height: 88rpx;
  padding: 12rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid var(--safe-border);
}

.sync-action {
  color: var(--safe-primary-deep);
  font-size: 26rpx;
  font-weight: 800;
}

.workbench-boundary {
  padding: 20rpx 24rpx;
  border-radius: var(--safe-radius-sm);
  background: var(--safe-primary-soft);
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.6;
}

.dashboard-copy {
  margin-top: 12rpx;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.65;
  overflow-wrap: anywhere;
}

.sync-label { color: var(--safe-muted); font-size: 24rpx; }
.sync-time { margin-top: 4rpx; color: var(--safe-primary-deep); font-size: 24rpx; font-weight: 850; }

.development-access-banner,
.capability-scope-card,
.state-banner {
  display: grid;
  gap: 7rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
}

.development-access-banner {
  border: 1rpx solid rgba(184, 127, 45, 0.34);
  background: var(--safe-orange-soft);
}

.development-access-title { color: #7a4c13; font-size: 26rpx; font-weight: 850; }
.development-access-copy { color: #6a5439; font-size: 24rpx; line-height: 1.6; }

.capability-scope-card {
  border: 1rpx solid var(--safe-border);
  background: var(--safe-primary-soft);
}

.capability-scope-title { color: var(--safe-primary-deep); font-size: 26rpx; font-weight: 800; }
.capability-scope-copy { color: var(--safe-text); font-size: 24rpx; line-height: 1.55; }

.state-banner--offline { border-left: 7rpx solid #9a6a28; background: #fff7e9; }
.state-banner--partial { border-left: 7rpx solid #b87f2d; background: #fffaf0; }

.workspace-tabs {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  padding: 4rpx 0;
  white-space: nowrap;
}

.workspace-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: auto;
  min-height: 88rpx;
  margin: 0 30rpx 0 0;
  padding: 0 4rpx;
  border-bottom: 5rpx solid transparent;
  background: transparent;
  color: var(--safe-text);
  font-size: 24rpx;
  font-weight: 700;
}

.workspace-tab.active {
  border-bottom-color: var(--safe-primary);
  color: var(--safe-primary-deep);
}

.workspace-panel { display: grid; gap: 22rpx; min-width: 0; }

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.summary-grid--two { grid-template-columns: repeat(2, minmax(0, 1fr)); }

.summary-card {
  min-width: 0;
  padding: 24rpx 14rpx;
  border-right: 1rpx solid var(--safe-border);
  background: transparent;
  text-align: center;
}

.summary-card:last-child { border-right: 0; }

.summary-card--primary { background: transparent; }
.summary-card--urgent { background: transparent; }
.summary-value { color: var(--safe-title); font-size: 42rpx; font-weight: 900; line-height: 1.1; }
.summary-label { margin-top: 9rpx; color: var(--safe-text); font-size: 24rpx; line-height: 1.35; }

.workspace-card,
.dossier-card,
.state-card,
.error-card,
.participant-card {
  border-radius: var(--safe-radius-sm);
  box-shadow: none;
}

.workspace-card,
.dossier-card,
.state-card,
.error-card { display: grid; gap: 16rpx; }

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.section-title { color: var(--safe-title); font-size: 30rpx; font-weight: 880; line-height: 1.35; }
.detail-line { color: var(--safe-text); font-size: 26rpx; line-height: 1.68; overflow-wrap: anywhere; }

.icon-refresh,
.inline-retry {
  box-sizing: border-box;
  width: auto;
  min-height: 88rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 1rpx solid rgba(78, 124, 107, 0.28);
  border-radius: 999rpx;
  background: #fff;
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 750;
}

.queue-item {
  display: grid;
  grid-template-columns: 18rpx minmax(0, 1fr) auto;
  align-items: center;
  gap: 16rpx;
  min-height: 92rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(78, 124, 107, 0.12);
}

.queue-item:last-child { border-bottom: 0; }
.priority-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: #9aa7a1; }
.priority-dot--urgent { background: #b7524b; }
.priority-dot--attention { background: #b87f2d; }
.priority-dot--routine { background: var(--safe-primary); }
.queue-main { min-width: 0; }
.queue-title { color: var(--safe-title); font-size: 24rpx; font-weight: 800; }
.queue-meta { margin-top: 5rpx; color: var(--safe-muted); font-size: 24rpx; }
.priority-pill { padding: 8rpx 12rpx; border-radius: 10rpx; font-size: 24rpx; white-space: nowrap; }
.priority-pill--urgent { color: #8d3731; background: #fde9e6; }
.priority-pill--attention { color: #80581e; background: #fff0d7; }
.priority-pill--routine { color: var(--safe-primary-deep); background: var(--safe-primary-soft); }

.list-more { margin-top: 16rpx; }
.boundary-line { color: var(--safe-muted); font-size: 24rpx; line-height: 1.6; }

.empty-state,
.state-card {
  align-items: center;
  justify-items: center;
  padding: 42rpx 26rpx;
  text-align: center;
}

.empty-symbol {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: var(--safe-primary-soft);
  color: var(--safe-primary-deep);
  font-size: 34rpx;
  font-weight: 850;
}

.state-copy { color: var(--safe-text); font-size: 24rpx; line-height: 1.6; }
.state-orbit { width: 44rpx; height: 44rpx; border: 5rpx solid var(--safe-primary-soft); border-top-color: var(--safe-primary); border-radius: 50%; }

.search-box {
  display: grid;
  grid-template-columns: 44rpx minmax(0, 1fr);
  align-items: center;
  min-height: 88rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: 22rpx;
  background: #fff;
}

.search-icon { color: var(--safe-primary-deep); font-size: 30rpx; }
.search-box input { width: 100%; min-height: 88rpx; color: var(--safe-title); font-size: 24rpx; }
.participant-list { display: grid; gap: 14rpx; }

.participant-card {
  display: grid;
  grid-template-columns: 72rpx minmax(0, 1fr) auto;
  align-items: center;
  gap: 16rpx;
  min-height: 112rpx;
}

.participant-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: var(--safe-primary-soft);
  color: var(--safe-primary-deep);
  font-size: 27rpx;
  font-weight: 850;
}

.participant-main { min-width: 0; }
.participant-name { overflow: hidden; color: var(--safe-title); font-size: 24rpx; font-weight: 820; text-overflow: ellipsis; white-space: nowrap; }
.participant-meta { margin-top: 5rpx; color: var(--safe-muted); font-size: 24rpx; line-height: 1.4; }
.participant-count { color: var(--safe-primary-deep); font-size: 24rpx; white-space: nowrap; }

.mine-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 76rpx;
  border-bottom: 1rpx solid rgba(78, 124, 107, 0.12);
  color: var(--safe-text);
  font-size: 24rpx;
}

.dossier-tabs { white-space: nowrap; }
.dossier-tab {
  display: inline-flex;
  align-items: center;
  box-sizing: border-box;
  width: auto;
  min-height: 88rpx;
  margin-right: 12rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: 999rpx;
  background: var(--safe-card);
  color: var(--safe-text);
  font-size: 24rpx;
}
.dossier-tab.active { border-color: var(--safe-primary); background: var(--safe-primary-soft); color: var(--safe-primary-deep); }
.dossier-card { margin-top: 18rpx; }
.action-row { display: flex; flex-wrap: wrap; gap: 12rpx; }
.small-action {
  box-sizing: border-box;
  width: auto;
  min-height: 88rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: 999rpx;
  background: #fff;
  color: var(--safe-text);
  font-size: 24rpx;
}
.small-action.primary { border-color: var(--safe-primary); background: var(--safe-primary); color: #fff; }
.material-card { padding: 18rpx; border-radius: 20rpx; background: var(--safe-bg); }
.material-title { color: var(--safe-primary-deep); font-size: 26rpx; font-weight: 800; }
.material-canvas { width: 100%; height: 360rpx; border: 1rpx solid var(--safe-border); border-radius: 20rpx; background: #fff; }
.note-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 150rpx;
  padding: 18rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: 20rpx;
  background: #fff;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.6;
}
.note-input--single { min-height: 88rpx; }
.feedback-field { display: grid; gap: 9rpx; }
.feedback-label { color: var(--safe-title); font-size: 26rpx; font-weight: 750; }
.required-mark { margin-left: 8rpx; color: var(--safe-primary-deep); font-size: 24rpx; font-weight: 650; }
.narrative-box { display: grid; gap: 12rpx; padding: 18rpx; border: 1rpx solid rgba(184, 127, 45, 0.3); border-radius: 20rpx; background: var(--safe-orange-soft); }

.error-card { border-left: 7rpx solid var(--safe-danger); }
.error-title { color: var(--safe-title); font-size: 29rpx; font-weight: 850; }
.error-copy { color: var(--safe-text); font-size: 24rpx; line-height: 1.6; }
.diagnostic-copy { color: var(--safe-muted); font-size: 24rpx; line-height: 1.55; overflow-wrap: anywhere; }
.error-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  width: 100%;
  min-width: 0;
  gap: 12rpx;
}
.error-actions button,
.safe-primary-button,
.safe-outline-button {
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  min-height: 88rpx;
  padding-right: 14rpx;
  padding-left: 14rpx;
  overflow-wrap: anywhere;
}

@media (min-width: 720px) {
  .researcher-dashboard-page { max-width: 980rpx; margin: 0 auto; }
  .workbench-hero { padding: 40rpx; }
  .workspace-panel { grid-template-columns: minmax(0, 1fr); }
  .summary-card { padding: 30rpx 20rpx; }
}

@media (prefers-reduced-motion: reduce) {
  .state-orbit { border-top-color: var(--safe-primary-soft); }
}
/* T36-F05：参与者详情按标签加载，保持移动端低认知负荷。 */
.participant-card {
  min-height: 112rpx;
}

.participant-dossier-panel {
  margin-top: 24rpx;
}

.module-result-list {
  margin-top: 20rpx;
}

.module-result-card {
  margin-top: 16rpx;
  padding: 20rpx;
  border: 1rpx solid #dce5df;
  border-radius: 20rpx;
  background: #fbfdfb;
}

/* T36-F06：交付轨道把高风险的发送动作拆成可核对的四步。 */
.delivery-rail {
  display: flex;
  align-items: flex-start;
  margin: 8rpx 0 18rpx;
}

.delivery-step {
  display: grid;
  flex: 0 0 72rpx;
  justify-items: center;
  gap: 6rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
}

.delivery-step text:first-child {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border: 2rpx solid var(--safe-border);
  border-radius: 50%;
  background: #fff;
  font-weight: 800;
}

.delivery-step.active { color: var(--safe-primary-deep); }
.delivery-step.active text:first-child { border-color: var(--safe-primary); background: var(--safe-primary-soft); }
.delivery-line { flex: 1; height: 2rpx; margin-top: 24rpx; background: var(--safe-border); }

.delivery-preview {
  display: grid;
  gap: 10rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(78, 124, 107, 0.25);
  border-radius: 22rpx;
  background: #f8fbf8;
}

.delivery-preview-title { color: var(--safe-title); font-size: 24rpx; font-weight: 820; }
.delivery-preview-body { white-space: pre-wrap; }
.delivery-boundary { color: var(--safe-muted); font-size: 24rpx; line-height: 1.55; }
.delivery-receipt { padding: 16rpx 20rpx; border-radius: 18rpx; background: var(--safe-primary-soft); color: var(--safe-primary-deep); font-size: 24rpx; line-height: 1.5; }

.analysis-gate {
  display: grid;
  gap: 6rpx;
  margin: 18rpx 0;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: var(--safe-orange-soft);
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.5;
}

.analysis-section {
  display: grid;
  gap: 16rpx;
  padding-top: 12rpx;
}

.analysis-section + .analysis-section {
  margin-top: 10rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(78, 124, 107, 0.18);
}

.analysis-section-heading {
  display: grid;
  gap: 4rpx;
}

.analysis-section-kicker {
  display: block;
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 850;
  letter-spacing: 1rpx;
}

.analysis-shadow-summary {
  display: grid;
  gap: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #d9e7df;
  border-radius: 22rpx;
  background: #f8fcfa;
}

.knowledge-retrieval-summary {
  display: grid;
  gap: 8rpx;
  margin: 14rpx 0;
  padding: 18rpx 20rpx;
  border-left: 5rpx solid var(--safe-primary);
  border-radius: 16rpx;
  background: var(--safe-primary-pale);
}

.analysis-quality {
  margin-top: 10rpx;
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 700;
}

.analysis-suppressed {
  margin-top: 8rpx;
  color: #805b28;
  font-size: 24rpx;
}

.analysis-picker {
  box-sizing: border-box;
  min-height: 88rpx;
  margin-top: 12rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: 20rpx;
  background: #fff;
  color: var(--safe-text);
  font-size: 24rpx;
}

.knowledge-excerpt {
  display: block;
  margin-top: 12rpx;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.6;
}

.assessment-case-tabs {
  margin: 18rpx 0;
  white-space: nowrap;
}

.assessment-case-tab {
  display: inline-block;
  box-sizing: border-box;
  width: 360rpx;
  min-height: 78rpx;
  margin-right: 12rpx;
  padding: 16rpx 20rpx;
  overflow: hidden;
  border: 1rpx solid var(--safe-border);
  border-radius: 22rpx;
  background: #fff;
  color: var(--safe-text);
  font-size: 24rpx;
  text-align: left;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.assessment-case-tab.active {
  border-color: var(--safe-primary);
  background: var(--safe-primary-soft);
  color: var(--safe-primary-deep);
}

.assessment-question-card {
  display: grid;
  gap: 10rpx;
  padding: 22rpx;
  border: 1rpx solid #cadbd1;
  border-radius: 22rpx;
  background: #f6faf7;
}

.assessment-question {
  color: var(--safe-title);
  font-size: 28rpx;
  font-weight: 820;
  line-height: 1.55;
}

.assessment-evidence-summary {
  display: grid;
  gap: 12rpx;
  margin-top: 18rpx;
  padding: 22rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: 20rpx;
  background: #fff;
}

.assessment-evidence-summary__heading,
.assessment-evidence-summary__counts {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 10rpx 18rpx;
}

.assessment-evidence-summary__copy {
  color: var(--safe-title);
  font-size: 25rpx;
  font-weight: 750;
  line-height: 1.6;
}

.assessment-evidence-summary__counts {
  color: var(--safe-text);
  font-size: 24rpx;
}

.assessment-filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 18rpx 0;
}

.assessment-filter {
  min-height: 68rpx;
  padding: 0 22rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: 999rpx;
  background: #fff;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 68rpx;
}

.assessment-evidence-card {
  display: grid;
  gap: 9rpx;
  margin-top: 16rpx;
  padding: 22rpx;
  border-left: 7rpx solid var(--safe-primary);
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 8rpx 28rpx rgba(27, 67, 52, 0.07);
}

.assessment-evidence-content {
  color: var(--safe-title);
  font-size: 24rpx;
  line-height: 1.7;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}

.assessment-method-limit {
  padding: 12rpx 14rpx;
  border-radius: 14rpx;
  background: var(--safe-orange-soft);
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.55;
}

.assessment-hypothesis-grid {
  display: grid;
  gap: 10rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #f6f8f5;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.55;
}

.assessment-draft {
  display: grid;
  gap: 10rpx;
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 22rpx;
}

.assessment-draft--internal {
  border: 1rpx solid #e3d5bd;
  background: #fff9ef;
}

.assessment-draft--participant {
  border: 1rpx solid #c8ddd1;
  background: #f3faf6;
}

.queue-runtime-card {
  border-top: 4rpx solid var(--safe-primary);
}

.queue-runtime-card--paused {
  border-top-color: var(--safe-danger);
  background: #fff8f6;
}

.participant-analysis-result,
.participant-analysis-groups {
  display: grid;
  gap: 18rpx;
}

.participant-analysis-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.participant-analysis-status,
.participant-analysis-label {
  display: block;
  color: var(--safe-title);
  font-size: 26rpx;
  font-weight: 800;
}

.participant-analysis-label { margin-bottom: 8rpx; }
