        <button class="safe-outline-button" bindtap="loadAssessmentCases">重新加载</button>
      </view>
      <view wx:elif="{{assessmentLoading}}" class="empty-state"><text class="state-copy">正在读取证据时间线…</text></view>
      <view wx:elif="{{!assessmentCases.length}}" class="empty-state">
        <text class="empty-symbol">○</text>
        <text class="state-title">当前没有可查看的评估议题</text>
      </view>
      <view wx:elif="{{assessmentWorkbench}}">
        <view class="assessment-question-card">
          <text class="section-eyebrow">当前议题</text>
          <text class="assessment-question">{{assessmentWorkbench.case.working_question || assessmentWorkbench.case.assessment_question}}</text>
          <text class="participant-meta">共享范围：{{assessmentWorkbench.case.sharedScopeText}}</text>
        </view>
        <view class="state-banner {{assessmentAuthorization.authorized ? '' : 'state-banner--partial'}}">
          <text class="state-title">工作台写入：{{assessmentAuthorization.authorized ? assessmentAuthorization.competency_level + ' 已授权' : '未授权'}}</text>
          <text class="state-copy">{{assessmentAuthorization.authorized ? '授权仅对当前任务、对象范围和有效期生效。' : (assessmentAuthorization.reason || '账号角色和临时展示权限不能替代正式任务授权。')}}</text>
        </view>
        <view wx:if="{{assessmentWorkbench.evidence_summary}}" class="assessment-evidence-summary">
          <view class="assessment-evidence-summary__heading">
            <text class="section-eyebrow">议题全量摘要</text>
            <text class="participant-meta">不随下方筛选变化</text>
          </view>
          <text class="assessment-evidence-summary__copy">{{assessmentWorkbench.evidence_summary.summary_text}}</text>
          <view class="assessment-evidence-summary__counts">
            <text>观察 {{assessmentWorkbench.evidence_summary.kind_counts.O}}</text>
            <text>模式 {{assessmentWorkbench.evidence_summary.kind_counts.P}}</text>
            <text>假设 {{assessmentWorkbench.evidence_summary.kind_counts.H}}</text>
            <text>未知 {{assessmentWorkbench.evidence_summary.kind_counts.U}}</text>
          </view>
          <text class="boundary-line">下一步核对：{{assessmentWorkbench.evidence_summary.next_check_text}}</text>
          <text class="boundary-line">{{assessmentWorkbench.evidence_summary.boundary_notice}}</text>
        </view>
        <view class="assessment-filter-row">
          <picker mode="selector" range="{{['全部类型','观察 O','模式 P','人工假设 H','未知 U']}}" bindchange="onAssessmentFilter" data-key="kind">
            <view class="assessment-filter">类型：{{assessmentFilters.kind || '全部'}}</view>
          </picker>
          <picker mode="selector" range="{{['全部范围','参与者','研究团队','督导']}}" bindchange="onAssessmentFilter" data-key="visibility">
            <view class="assessment-filter">权限：{{assessmentFilters.visibility || '全部'}}</view>
          </picker>
        </view>
        <view wx:if="{{!assessmentWorkbench.evidence_items.length}}" class="empty-state">
          <text class="state-title">当前条件下没有证据</text>
          <text class="state-copy">可以换一个筛选条件看看。</text>
        </view>
        <view wx:for="{{assessmentWorkbench.evidence_items}}" wx:key="id" class="assessment-evidence-card">
          <view class="analysis-job-heading">
            <text class="analysis-job-title">{{item.kind}} · {{item.kindLabel}}</text>
            <text class="priority-pill">{{item.reviewStatusText}}</text>
          </view>
          <text class="assessment-evidence-content">{{item.content}}</text>
          <text wx:if="{{item.source_ref}}" class="participant-meta">来源：{{item.source_ref}}</text>
          <text wx:if="{{item.observedText}}" class="participant-meta">时间：{{item.observedText}}</text>
          <text wx:if="{{item.provider_id}}" class="participant-meta">提供者：{{item.provider_id}}</text>
          <text wx:if="{{item.context}}" class="participant-meta">情境：{{item.context}}</text>
          <text class="participant-meta">权限：{{item.visibilityText}}</text>
          <text class="assessment-method-limit">方法限制：{{item.method_limitations}}</text>
          <view wx:if="{{item.kind === 'H'}}" class="assessment-hypothesis-grid">
            <text>支持依据：{{item.supportingText || '待补充'}}</text>
            <text>反证：{{item.counterText || '待补充'}}</text>
            <text>其它可能：{{item.alternativesText || '待补充'}}</text>
            <text>参与者识别：{{item.participant_recognition || '尚未核对'}}</text>
          </view>
        </view>
        <view class="assessment-draft assessment-draft--internal">
          <text class="feedback-label">内部工作备注</text>
          <text class="boundary-line">仅研究团队可见，不会发送给参与者。</text>
          <textarea class="note-input" value="{{assessmentInternalNotes}}" data-key="assessmentInternalNotes" bindinput="onAssessmentDraftInput" maxlength="12000"></textarea>
        </view>
        <view class="assessment-draft assessment-draft--participant">
          <text class="feedback-label">参与者可见草稿</text>
          <text class="boundary-line">提交正式反馈后仍需另一位人工复核。</text>
          <textarea class="note-input" value="{{assessmentParticipantDraft}}" data-key="assessmentParticipantDraft" bindinput="onAssessmentDraftInput" maxlength="6000"></textarea>
        </view>
        <button class="safe-primary-button" loading="{{assessmentSaving}}" disabled="{{assessmentSaving || !assessmentAuthorization.authorized}}" bindtap="saveAssessmentDraft">保存工作台草稿</button>
      </view>
      <button class="safe-outline-button" bindtap="openAssessmentQuality">进入质量抽检与修复</button>
      <text class="boundary-line">工作台不生成诊断或疗效分数。</text>
    </view>
  </view>

  <view wx:if="{{activeWorkspace === 'analysis'}}" class="workspace-panel">
    <view class="safe-card workspace-card group-insights-card">
      <view class="section-heading">
        <view>
          <text class="section-eyebrow">真实记录 · 只含同意研究使用的成人</text>
          <text class="section-title">群体情绪与网络</text>
        </view>
        <button class="icon-refresh" bindtap="refreshGroupInsights" aria-label="刷新群体分析">刷新</button>
      </view>
      <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="window-chips" aria-label="选择时间范围">
        <view class="chip-row">
          <button wx:for="{{groupWindowOptions}}" wx:key="days" class="p3-chip window-chip {{groupWindow === item.days ? 'p3-chip--selected active' : ''}}" data-days="{{item.days}}" bindtap="selectGroupWindow" aria-label="查看{{item.label}}的群体结果">{{item.label}}</button>
        </view>
      </scroll-view>
      <view wx:if="{{groupInsightsLoading && !groupInsights}}" class="empty-state"><text class="state-copy">正在汇总群体记录…</text></view>
      <view wx:elif="{{groupInsightsError}}" class="error-card">
        <text class="error-title">群体分析暂时没有读取成功</text>
        <text class="error-copy">{{groupInsightsError}}</text>
        <button class="safe-outline-button" bindtap="refreshGroupInsights">重新加载</button>
      </view>
      <block wx:elif="{{groupInsights}}">
        <view wx:if="{{!groupInsights.available}}" class="empty-state">
          <text class="empty-symbol">○</text>
          <text class="state-title">{{groupInsights.windowText}}人数还不够，暂不显示</text>
          <text class="state-copy">{{groupInsights.reason}}</text>
        </view>
        <block wx:else>
          <text class="insight-summary">{{groupInsights.summaryText}}</text>
          <view class="headline-grid">
            <view wx:for="{{groupInsights.headline}}" wx:key="key" class="headline-cell">
              <text class="headline-value">{{item.value}}<text class="headline-unit">{{item.unit}}</text></text>
              <text class="headline-label">{{item.label}}</text>
            </view>
          </view>
          <text wx:if="{{groupInsights.excludedText}}" class="participant-meta">{{groupInsights.excludedText}}</text>

          <view class="insight-block">
            <text class="insight-block-title">情绪分布</text>
            <text class="insight-block-hint">按记录过这种情绪的人数排序</text>
            <view wx:for="{{groupInsights.emotionBars}}" wx:key="key" class="bar-row">
              <view class="bar-row-head"><text class="bar-row-label">{{item.label}}</text><text class="bar-row-value">{{item.valueText}}</text></view>
              <view class="bar-row-track"><view class="bar-row-fill" style="width: {{item.width}};"></view></view>
            </view>
          </view>

          <view class="insight-block">
            <text class="insight-block-title">常见场景</text>
            <view wx:for="{{groupInsights.sceneBars}}" wx:key="key" class="bar-row">
              <view class="bar-row-head"><text class="bar-row-label">{{item.label}}</text><text class="bar-row-value">{{item.valueText}}</text></view>
              <view class="bar-row-track"><view class="bar-row-fill bar-row-fill--scene" style="width: {{item.width}};"></view></view>
            </view>
            <text wx:if="{{groupInsights.hiddenText}}" class="boundary-line">{{groupInsights.hiddenText}}</text>
          </view>

          <view class="insight-block">
            <text class="insight-block-title">强度分布</text>
            <view wx:for="{{groupInsights.intensityBands}}" wx:key="key" class="bar-row">
              <view class="bar-row-head"><text class="bar-row-label">{{item.label}}</text><text class="bar-row-value">{{item.valueText}}</text></view>
              <view class="bar-row-track"><view class="bar-row-fill bar-row-fill--{{item.key}}" style="width: {{item.width}};"></view></view>
            </view>
          </view>

          <view wx:if="{{groupInsights.weeklyRows.length}}" class="insight-block">
            <text class="insight-block-title">按周变化</text>
            <text class="insight-block-hint">条形长度表示该周平均强度（满分 10）</text>
            <view wx:for="{{groupInsights.weeklyRows}}" wx:key="key" class="bar-row">
              <view class="bar-row-head"><text class="bar-row-label">{{item.label}}</text><text class="bar-row-value">{{item.valueText}}</text></view>
              <view class="bar-row-track"><view class="bar-row-fill" style="width: {{item.width}};"></view></view>
            </view>
            <text wx:if="{{groupInsights.weeklyNote}}" class="boundary-line">{{groupInsights.weeklyNote}}</text>
          </view>

          <view class="insight-block">
            <text class="insight-block-title">情绪共现网络</text>
            <text class="insight-block-hint">同一位参与者在这段时间里都记录过的两种情绪算一条关联 · {{groupInsights.networkSizeText}}</text>
            <view class="metric-grid">
              <view wx:for="{{groupInsights.networkMetrics}}" wx:key="key" class="metric-cell">
                <text class="metric-value">{{item.value}}</text>
                <text class="metric-label">{{item.label}}</text>
                <text class="metric-hint">{{item.hint}}</text>
              </view>
            </view>
            <text wx:if="{{groupInsights.centralText}}" class="detail-line">处在中心的情绪：{{groupInsights.centralText}}</text>
            <text wx:for="{{groupInsights.strongestRows}}" wx:key="key" class="detail-line">{{item.text}}</text>
            <text wx:if="{{!groupInsights.strongestRows.length}}" class="detail-line">暂时没有达到 3 人的情绪关联。</text>
          </view>

          <view class="insight-block">
            <text class="insight-block-title">场景—情绪关联</text>
            <text class="insight-block-hint">提升度大于 1：这种情绪在该场景里比整体更常见</text>
            <view wx:for="{{groupInsights.linkRows}}" wx:key="key" class="link-row">
              <text class="link-title">{{item.title}}</text>
              <text class="participant-meta">{{item.meta}}</text>
            </view>
            <text wx:if="{{!groupInsights.linkRows.length}}" class="detail-line">暂时没有达到 3 人的场景—情绪关联。</text>
          </view>

          <view wx:if="{{groupInsights.pairRows.length}}" class="insight-block">
            <text class="insight-block-title">家长与孩子的情绪组合</text>
            <text wx:for="{{groupInsights.pairRows}}" wx:key="key" class="detail-line">{{item.text}}</text>
            <text class="boundary-line">只说明两种情绪在同一次记录里一起出现，不代表谁引起了谁。</text>
          </view>
        </block>
        <text class="boundary-line">{{groupInsights.consentRule}}</text>
        <text class="boundary-line">{{groupInsights.thresholdText}}</text>
        <text class="boundary-line">{{groupInsights.boundaryNotice}}</text>
        <text class="participant-meta">{{groupInsights.windowText}} · {{groupInsights.scopeText}} · 生成于 {{groupInsights.generatedText}}</text>
      </block>
    </view>

    <view class="safe-card workspace-card">
      <view class="section-heading">
        <view>
          <text class="section-eyebrow">资料与技术检查</text>
          <text class="section-title">已审核资料</text>
        </view>
        <button class="icon-refresh" bindtap="loadAnalysisJobs">刷新</button>
      </view>
      <button class="engineering-toggle" bindtap="toggleEngineering" aria-label="{{showEngineering ? '收起技术检查' : '展开技术检查'}}">{{showEngineering ? '收起技术检查' : '技术检查（合成数据，不是真实结果）'}}</button>
      <view wx:if="{{showEngineering}}" class="analysis-section analysis-section--status">
        <view class="analysis-section-heading">
          <text class="analysis-section-kicker">运行护栏</text>
        </view>
      <view wx:if="{{analysisCatalog}}" class="analysis-gate">
        <text>以下为工程验收用的合成数据，不是真实参与者结果</text>
        <text>目录 {{analysisCatalog.catalog_version}}</text>
      </view>
      <view wx:if="{{analysisResilience}}" class="analysis-gate">
        <text>派生结果可受控删除 · 生产发布未批准</text>
      </view>
      <view class="analysis-shadow-summary">
        <view class="analysis-job-heading">
          <text class="analysis-job-title">情感模型影子版本</text>
          <text class="priority-pill">{{affectModelVersions.length}} 个版本</text>
        </view>
        <text class="detail-line">只读合成分析；不改参与者反馈、训练卡或个体决策。</text>
        <view wx:if="{{affectShadowRuns.length}}">
          <view wx:for="{{affectShadowRuns}}" wx:key="id" class="analysis-job-card">
            <view class="analysis-job-heading">
              <text class="analysis-job-title">{{item.model_version}}</text>
              <text class="priority-pill">{{item.shadowStatusText}}</text>
            </view>
            <text class="detail-line">{{item.shadowSummaryText}}</text>
            <text class="participant-meta">覆盖 {{item.coverageText}} · 未知率 {{item.unknownRateText}}</text>
            <text wx:if="{{item.reviewReasonText}}" class="participant-meta">复核原因：{{item.reviewReasonText}}</text>
            <text class="boundary-line">{{item.shadowNextCheck}}</text>
            <text class="participant-meta">{{item.createdText}} · 不含原文</text>
          </view>
        </view>
        <text wx:else class="state-copy">还没有影子运行记录。</text>
        <text class="boundary-line">人工复核队列 {{affectShadowReviewCount}} 条，仅显示合成案例代号，不显示原文。</text>
        <view wx:if="{{affectMonitoring}}" class="analysis-gate">
          <text>模型运行：{{affectMonitoring.runtime_control.mode}} · 控制版本 {{affectMonitoring.runtime_control.version}}</text>
          <text>{{affectMonitoring.recent_runs.length ? affectMonitoring.recent_runs[0].gate_status : '尚未演练'}}</text>
        </view>
        <text wx:if="{{affectMonitoring}}" class="boundary-line">{{affectMonitoring.boundary_notice}}</text>
        <view wx:if="{{affectReleaseGate}}" class="analysis-gate">
          <text>发布门禁：{{affectReleaseGate.latest ? affectReleaseGate.latest.status : '尚未生成证据包'}}</text>
          <text>阻断项 {{affectReleaseGate.latest ? affectReleaseGate.latest.blockers.length : 0}} · 生产批准：否</text>
        </view>
        <text wx:if="{{affectReleaseGate}}" class="boundary-line">{{affectReleaseGate.boundary_notice}}</text>
      </view>
      </view>
      <view class="analysis-section analysis-section--evidence">
        <view class="analysis-section-heading">
          <text class="analysis-section-kicker">已审核资料</text>
        </view>
        <view class="analysis-shadow-summary">
        <view class="analysis-job-heading">
          <text class="analysis-job-title">已审核知识库</text>
          <text class="priority-pill">{{knowledgeDocumentCount}} 份内容</text>
        </view>
        <text class="detail-line">研究者只读检索已审核、已发布内容；结果带来源和版本，不调用外部模型，不修改参与者记录。</text>
        <view wx:if="{{knowledgeInventory}}" class="analysis-gate">
          <text>索引状态：仅已发布内容 · 候选正文不入库</text>
          <text>当前索引 {{knowledgeInventory.activeDocumentCount}} 份 · 已撤回 {{knowledgeInventory.withdrawnDocumentCount}} 份 · 待审核候选 {{knowledgeInventory.candidateCount}} 条</text>
        </view>
        <input class="note-input note-input--single" maxlength="120" value="{{knowledgeQuery}}" bindinput="onKnowledgeQueryInput" placeholder="例如：情绪升高时如何暂停" />
        <picker mode="selector" range="{{knowledgeMethodOptions}}" bindchange="onKnowledgeMethodChange">
          <view class="analysis-picker">检索方式：{{knowledgeMethodText}}</view>
        </picker>
        <button class="safe-outline-button" loading="{{knowledgeLoading}}" disabled="{{knowledgeLoading}}" bindtap="searchKnowledge">检索已审核内容</button>
        <view wx:if="{{knowledgeError}}" class="error-card">
          <text class="error-copy">{{knowledgeError}}</text>
        </view>
        <view wx:elif="{{knowledgeResult}}">
          <text class="participant-meta">{{knowledgeResult.evidenceStatusText}} · 返回 {{knowledgeResult.citations.length}} 条内容</text>
          <view wx:if="{{knowledgeResult.retrieval_summary}}" class="knowledge-retrieval-summary">
            <text class="detail-line">{{knowledgeResult.retrieval_summary.summary_text}}</text>
            <text class="participant-meta">{{knowledgeResult.retrieval_summary.next_check_text}}</text>
            <text class="boundary-line">{{knowledgeResult.retrieval_summary.boundary_notice}}</text>
          </view>
          <view wx:for="{{knowledgeResult.citations}}" wx:key="chunk_id" class="analysis-job-card">
            <view class="analysis-job-heading">
              <text class="analysis-job-title">{{item.title}}</text>
              <text class="priority-pill">{{item.statusText}}</text>
            </view>
            <text class="participant-meta">{{item.sourceText}} · 版本 {{item.source_version}} · {{item.scoreText}}</text>
            <text class="participant-meta">适用：{{item.audiencesText}} · {{item.validityText}}</text>
            <text class="detail-line">位置：{{item.location}}</text>
            <text class="knowledge-excerpt">{{item.excerpt}}</text>
          </view>
          <text wx:if="{{!knowledgeResult.citations.length}}" class="state-copy">没有匹配到已审核来源，请换一个更具体的关键词。</text>
        </view>
        <text wx:else class="state-copy">输入关键词后，这里会显示已审核来源和证据状态。</text>
        <text class="boundary-line">知识库只支持研究者的证据查找，不自动生成诊断、风险结论或参与者反馈。</text>
        </view>
      </view>
      <view wx:if="{{showEngineering}}" class="analysis-section analysis-section--quality">
        <view class="analysis-section-heading">
          <text class="analysis-section-kicker">模型质量</text>
        </view>
        <view class="analysis-shadow-summary">
        <view class="analysis-job-heading">
          <text class="analysis-job-title">网络分析基准</text>
          <text class="priority-pill">{{offlineBenchmarkRuns.length}} 次运行</text>
        </view>
        <text class="detail-line">只显示合成群体聚合结果和工程状态；不显示个人中心性、关系质量、排名或原文。</text>
        <view wx:if="{{networkPolicy}}" class="analysis-gate">
          <text>隐私阈值：节点 ≥ {{networkPolicy.minimum_privacy_thresholds.nodes}} · 每窗口边 ≥ {{networkPolicy.minimum_privacy_thresholds.edges_per_window}}</text>
        </view>
        <view wx:if="{{offlineBenchmarkRuns.length}}">
          <view wx:for="{{offlineBenchmarkRuns}}" wx:key="id" class="analysis-job-card">
            <view class="analysis-job-heading">
              <text class="analysis-job-title">{{item.benchmarkTypeText}}</text>
              <text class="priority-pill">{{item.statusText}}</text>
            </view>
            <text class="participant-meta">{{item.evidenceText}} · 算法 {{item.algorithmText}}</text>
            <text class="detail-line">{{item.networkSummaryText}}</text>
            <text wx:if="{{item.networkDetailText}}" class="participant-meta">{{item.networkDetailText}}</text>
            <text wx:if="{{item.networkNextCheck}}" class="boundary-line">{{item.networkNextCheck}}</text>
            <text class="participant-meta">{{item.createdText}}</text>
            <text class="participant-meta">{{item.rawTextText}}</text>
          </view>
        </view>
        <text wx:else class="state-copy">还没有基准运行记录。</text>
        <text class="boundary-line">基准运行不能替代真实参与者研究证据，也不会改变参与者端反馈。</text>
        </view>
      </view>
      <view wx:if="{{showEngineering}}" class="analysis-section analysis-section--tasks">
        <view class="analysis-section-heading">
          <text class="analysis-section-kicker">任务明细</text>
        </view>
      <view wx:if="{{analysisLoading}}" class="empty-state"><text class="state-copy">正在读取任务摘要…</text></view>
      <view wx:elif="{{analysisError}}" class="error-card">
        <text class="error-title">任务暂时没有读取成功</text>
        <text class="error-copy">{{analysisError}}</text>
        <button class="safe-outline-button" bindtap="loadAnalysisJobs">重新加载</button>
      </view>
      <view wx:elif="{{!analysisJobs.length}}" class="empty-state">
        <text class="empty-symbol">○</text>
        <text class="state-title">暂时没有在线分析任务</text>
        <text class="state-copy">任务建立后会在这里显示状态，不会展示参与者原文。</text>
      </view>
      <view wx:else>
        <view wx:for="{{analysisJobs}}" wx:key="id" class="analysis-job-card">
          <view class="analysis-job-heading">
            <text class="analysis-job-title">{{item.analysisLabel}}</text>
            <text class="priority-pill">{{item.statusLabel}}</text>
          </view>
          <text class="participant-meta">版本 {{item.analysis_version}} · {{item.createdText}}</text>
          <text class="participant-meta">尝试 {{item.attempt_count}} / {{item.max_attempts}} · 影子模式</text>
          <text wx:if="{{item.qualityText}}" class="analysis-quality">{{item.qualityText}}</text>
          <text wx:if="{{item.suppressed}}" class="analysis-suppressed">小样本已抑制，不展示图形。</text>
        </view>
      </view>
      <text class="boundary-line">结果只作为聚合研究线索，不构成诊断、标签或个体自动决策。</text>
      </view>
    </view>
  </view>

  <view wx:if="{{activeWorkspace === 'manage'}}" class="workspace-panel">
    <staff-accounts />
  </view>

  <view wx:if="{{activeWorkspace === 'projects' && projectView === 'pilots'}}" class="workspace-panel">
    <view wx:if="{{pilotLoading && !items.length}}" class="safe-card state-card">
      <text class="state-title">正在读取试点项目</text>
    </view>
    <view wx:elif="{{pilotError}}" class="safe-card error-card">
      <text class="error-title">试点项目暂时没有读取成功</text>
      <text class="error-copy">{{pilotError}}</text>
      <text class="diagnostic-copy">请求编号：{{pilotDiagnostic.requestId || '未返回'}}</text>
      <view class="error-actions">
        <button class="safe-primary-button" bindtap="loadDashboard">重新加载</button>
        <button class="safe-outline-button" data-scope="pilot" bindtap="copyDiagnostic">复制诊断信息</button>
      </view>
    </view>
    <view wx:elif="{{!items.length}}" class="safe-card empty-state">
      <text class="empty-symbol">○</text>
      <text class="state-title">还没有关系试点参与者</text>
      <text class="state-copy">还没有人报名关系试点，或者还没有分给你。</text>
    </view>
    <view wx:else class="dashboard-layout">
      <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="dossier-tabs">
        <view class="chip-row">
          <button wx:for="{{items}}" wx:key="id" class="p3-chip dossier-tab {{selected.id === item.id ? 'p3-chip--selected active' : ''}}" data-id="{{item.id}}" bindtap="selectEnrollment">{{item.nickname || '匿名参与者'}} · {{item.scopeStatus === 'claimable' ? '可领取' : item.reviewStatusText}}</button>
        </view>
      </scroll-view>

      <view wx:if="{{selected}}">
        <view class="safe-card dossier-card">
          <text class="section-title">用户档案与报名</text>
          <text class="detail-line">用户：{{selected.nickname || selected.user_id}}</text>
          <text class="detail-line">参与状态：{{selected.statusText}}</text>
          <text class="detail-line">复核进度：{{selected.reviewStatusText}}</text>
          <text class="detail-line">测评来源：关系探索支持性测评</text>
          <text class="detail-line">画像：{{selected.profile.profile_name}}</text>
          <text class="detail-line">{{selected.profile.profile_description}}</text>
        </view>

        <view class="safe-card dossier-card">
          <text class="section-title">预设评估问题</text>
          <text wx:for="{{selected.profile.suggested_assessment_questions}}" wx:key="*this" class="detail-line">{{index + 1}}. {{item}}</text>
        </view>

        <view class="safe-card dossier-card">
          <text class="section-title">初筛报告</text>
          <view wx:if="{{selected.latestReport}}" class="action-row">
            <button class="small-action" bindtap="openReport">查看</button>
            <button wx:if="{{selected.latestReport.status === 'pending_review' || selected.latestReport.status === 'ready'}}" class="small-action" bindtap="confirmReport">人工确认</button>
            <button wx:if="{{selected.latestReport.status === 'confirmed' || selected.latestReport.status === 'updated'}}" class="small-action primary" bindtap="sendReport">发送用户</button>
            <text wx:if="{{selected.latestReport.status === 'sent'}}" class="detail-line">当前版本已发送</text>
          </view>
          <button wx:else class="safe-primary-button" bindtap="createReport">生成报告</button>
        </view>

        <view class="safe-card dossier-card">
          <text class="section-title">阶段性报告中的研究者反馈</text>
          <text class="detail-line">按“观察—依据—下一小步—待讨论问题”填写。内容会暂存在本机；发送后生成新报告版本并进入参与者消息列表。</text>
          <view class="feedback-field">
            <text class="feedback-label">近期可观察到的变化 <text class="required-mark">必填</text></text>
            <textarea class="note-input" maxlength="600" value="{{stageFeedbackForm.observation}}" data-key="observation" bindinput="onStageFeedbackInput" placeholder="描述本阶段可观察、可复述的变化，不做人格或关系结论"></textarea>
          </view>
          <view class="feedback-field">
            <text class="feedback-label">可供共同核对的依据</text>
            <textarea class="note-input" maxlength="600" value="{{stageFeedbackForm.evidence}}" data-key="evidence" bindinput="onStageFeedbackInput" placeholder="可引用练习完成情况、参与者原话或记录变化"></textarea>
          </view>
          <view class="feedback-field">
            <text class="feedback-label">可以先尝试的一小步 <text class="required-mark">必填</text></text>
            <textarea class="note-input" maxlength="600" value="{{stageFeedbackForm.nextStep}}" data-key="nextStep" bindinput="onStageFeedbackInput" placeholder="给出一个低负担、可选择、可暂停的小行动"></textarea>
          </view>
          <view class="feedback-field">
            <text class="feedback-label">后续可继续讨论</text>
            <textarea class="note-input" maxlength="400" value="{{stageFeedbackForm.openQuestion}}" data-key="openQuestion" bindinput="onStageFeedbackInput" placeholder="保留一个开放问题，邀请参与者补充自己的理解"></textarea>
          </view>
          <view class="delivery-rail" aria-label="阶段性反馈交付进度">
            <view class="delivery-step active"><text>1</text><text>草稿</text></view>
            <view class="delivery-line"></view>
            <view class="delivery-step {{stageFeedbackDelivery ? 'active' : ''}}"><text>2</text><text>预览</text></view>
            <view class="delivery-line"></view>
            <view class="delivery-step {{stageFeedbackDelivery.status === 'confirmed' || stageFeedbackDelivery.status === 'sent' ? 'active' : ''}}"><text>3</text><text>确认</text></view>
            <view class="delivery-line"></view>
            <view class="delivery-step {{stageFeedbackDelivery.status === 'sent' ? 'active' : ''}}"><text>4</text><text>发送</text></view>
          </view>
          <view wx:if="{{stageFeedbackDelivery}}" class="delivery-preview">
            <text class="delivery-preview-title">{{stageFeedbackDelivery.preview.title}} · 第 {{stageFeedbackDelivery.active_version.version_no}} 版</text>
            <text class="detail-line delivery-preview-body">{{stageFeedbackDelivery.preview.body}}</text>
            <text class="delivery-boundary">{{stageFeedbackDelivery.preview.boundary_notice}}</text>
          </view>
          <button wx:if="{{!stageFeedbackDelivery || stageFeedbackDelivery.status === 'draft' || stageFeedbackDelivery.status === 'previewed'}}" class="safe-primary-button" loading="{{sendingFeedback}}" disabled="{{sendingFeedback}}" bindtap="previewStageFeedback">生成并核对预览</button>
          <button wx:if="{{stageFeedbackDelivery.status === 'previewed'}}" class="safe-outline-button" loading="{{sendingFeedback}}" disabled="{{sendingFeedback}}" data-kind="stage" data-action="confirm" bindtap="runDeliveryStep">确认这个版本</button>
          <button wx:if="{{stageFeedbackDelivery.status === 'confirmed'}}" class="safe-primary-button" loading="{{sendingFeedback}}" disabled="{{sendingFeedback}}" data-kind="stage" data-action="send" bindtap="runDeliveryStep">发送到参与者消息</button>
          <text wx:if="{{stageFeedbackDelivery.status === 'sent'}}" class="delivery-receipt">已发送 · {{stageFeedbackDelivery.sentText}} · 参与者消息第 {{stageFeedbackDelivery.active_version.version_no}} 版</text>
        </view>

        <view class="safe-card dossier-card">
          <text class="section-title">发送参与者消息</text>
          <text class="detail-line">参与者可在“我的 → 消息”查看；移动端草稿按当前参与者恢复。</text>
          <input class="note-input note-input--single" maxlength="60" value="{{messageTitle}}" bindinput="onMessageTitleInput" placeholder="消息标题" />
          <textarea class="note-input" maxlength="2000" value="{{messageBody}}" bindinput="onMessageBodyInput" placeholder="消息正文"></textarea>
          <view class="delivery-rail" aria-label="参与者消息交付进度">
            <view class="delivery-step active"><text>1</text><text>草稿</text></view>
            <view class="delivery-line"></view>
            <view class="delivery-step {{participantMessageDelivery ? 'active' : ''}}"><text>2</text><text>预览</text></view>
            <view class="delivery-line"></view>
            <view class="delivery-step {{participantMessageDelivery.status === 'confirmed' || participantMessageDelivery.status === 'sent' ? 'active' : ''}}"><text>3</text><text>确认</text></view>
            <view class="delivery-line"></view>
            <view class="delivery-step {{participantMessageDelivery.status === 'sent' ? 'active' : ''}}"><text>4</text><text>发送</text></view>
          </view>
          <view wx:if="{{participantMessageDelivery}}" class="delivery-preview">
            <text class="delivery-preview-title">{{participantMessageDelivery.preview.title}} · 第 {{participantMessageDelivery.active_version.version_no}} 版</text>
            <text class="detail-line delivery-preview-body">{{participantMessageDelivery.preview.body}}</text>
          </view>
          <button wx:if="{{!participantMessageDelivery || participantMessageDelivery.status === 'draft' || participantMessageDelivery.status === 'previewed'}}" class="safe-outline-button" loading="{{sendingMessage}}" disabled="{{sendingMessage}}" bindtap="previewParticipantMessage">生成并核对预览</button>
          <button wx:if="{{participantMessageDelivery.status === 'previewed'}}" class="safe-outline-button" loading="{{sendingMessage}}" disabled="{{sendingMessage}}" data-kind="message" data-action="confirm" bindtap="runDeliveryStep">确认这个版本</button>
          <button wx:if="{{participantMessageDelivery.status === 'confirmed'}}" class="safe-primary-button" loading="{{sendingMessage}}" disabled="{{sendingMessage}}" data-kind="message" data-action="send" bindtap="runDeliveryStep">发送到参与者消息</button>
          <text wx:if="{{participantMessageDelivery.status === 'sent'}}" class="delivery-receipt">已发送 · {{participantMessageDelivery.sentText}} · 参与者消息第 {{participantMessageDelivery.active_version.version_no}} 版</text>
        </view>

        <view class="safe-card dossier-card">
          <text class="section-title">线上任务材料（{{selected.tasks.length}}）</text>
          <view wx:for="{{selected.tasks}}" wx:key="id" class="material-card">
            <text class="material-title">{{item.typeText}} · {{item.reviewStatusText}}</text>
            <text wx:if="{{item.narration}}" class="detail-line">画外音：{{item.narration}}</text>
            <text wx:for="{{item.answerRows}}" wx:for-item="answer" wx:key="context" class="detail-line">{{answer.context}}：{{answer.answer}}</text>
          </view>
          <canvas wx:if="{{selected.drawingTask}}" canvas-id="researchDrawingCanvas" class="material-canvas" aria-label="用户授权提交的关系绘画预览，材料仅用于人工复核"></canvas>
          <text class="boundary-line">绘画只作为叙事材料，不自动解释象征或潜意识。</text>
        </view>

        <view class="safe-card dossier-card">
          <text class="section-title">人工备注</text>
          <text wx:for="{{selected.research_notes}}" wx:key="id" class="detail-line">{{item.note}}</text>
          <textarea class="note-input" maxlength="1000" value="{{note}}" bindinput="onNoteInput" placeholder="写下待核对的问题或访谈线索，不覆盖用户原报告"></textarea>
          <button class="safe-outline-button" bindtap="saveNote">保存备注</button>
        </view>

        <view class="safe-card dossier-card">
          <text class="section-title">治疗性反馈会议材料</text>
          <button class="safe-outline-button" bindtap="draftNarrative">生成探索手记草稿</button>
          <view wx:if="{{narrative}}" class="narrative-box">
            <text class="detail-line">状态：{{narrative.status}}</text>
            <text class="detail-line">{{narrative.draft.boundary_notice}}</text>
            <button wx:if="{{narrative.status !== 'confirmed'}}" class="safe-primary-button" bindtap="confirmNarrative">确认后交付用户</button>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
