          <text class="section-title">协作式评估证据</text>
        </view>
        <button class="icon-refresh" bindtap="loadAssessmentCases">刷新</button>
      </view>
      <text class="detail-line">先选择参与者议题，再按时间查看观察、模式候选、人工假设与未知项。</text>
      <scroll-view wx:if="{{assessmentCases.length}}" scroll-x enhanced show-scrollbar="{{false}}" class="assessment-case-tabs">
        <view class="chip-row">
          <button wx:for="{{assessmentCases}}" wx:key="id" class="p3-chip assessment-case-tab {{assessmentCaseId === item.id ? 'p3-chip--selected active' : ''}}" data-id="{{item.id}}" bindtap="selectAssessmentCase">{{item.displayQuestion}}</button>
        </view>
      </scroll-view>
      <view wx:if="{{assessmentError}}" class="error-card">
        <text class="error-title">评估证据暂时没有读取成功</text>
