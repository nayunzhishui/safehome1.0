<view class="p3-page researcher-dashboard-page">
  <view class="rd-head">
    <view class="sync-row" bindtap="refreshActiveWorkspace" role="button" aria-label="刷新当前工作区">
      <view class="sync-copy">
        <text class="sync-label">最近同步</text>
        <text class="sync-time">{{lastSyncText}}</text>
      </view>
      <text class="sync-action">重新同步</text>
    </view>
    <text wx:if="{{capabilityScope}}" class="workbench-boundary">{{roleText || '研究人员'}} · 能看：{{scopeText || '分配给我的参与者'}}</text>
    <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="workspace-tabs" aria-label="研究者工作区导航">
      <view class="chip-row">
        <button wx:for="{{workspaces}}" wx:key="id" class="p3-chip workspace-tab {{activeWorkspace === item.id ? 'p3-chip--selected active' : ''}}" data-id="{{item.id}}" bindtap="switchWorkspace" aria-label="{{item.label}}{{item.badge ? '，' + item.badge + ' 项待处理' : ''}}">{{item.label}}<text wx:if="{{item.badge}}" class="tab-badge">{{item.badge}}</text></button>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{offline}}" class="p3-notice p3-notice--warm state-banner">
    <text class="p3-notice__title">当前离线</text>
    <text class="p3-notice__body">已读取内容会保留；联网后下拉刷新或点“重新同步”。</text>
  </view>
  <view wx:if="{{developmentFullAccess}}" class="p3-notice p3-notice--warm development-access-banner">
    <text class="p3-notice__title">开发全权限模式</text>
    <text class="p3-notice__body">测试账号临时开放研究能力；正式发布前必须关闭。</text>
  </view>

  <view wx:if="{{loading && !operations}}" class="safe-card state-card">
    <view class="state-orbit"></view>
    <text class="state-title">正在同步工作台</text>
  </view>
  <view wx:elif="{{errorMessage}}" class="safe-card error-card">
    <text class="error-title">工作台暂时没有读取成功</text>
    <text class="error-copy">{{errorMessage}}</text>
    <text class="diagnostic-copy">请求编号：{{errorDiagnostic.requestId || '未返回'}}</text>
    <view class="error-actions">
      <button class="safe-primary-button" bindtap="loadWorkbench">重新同步</button>
      <button class="safe-outline-button" data-scope="workbench" bindtap="copyDiagnostic">复制诊断信息</button>
    </view>
  </view>

  <view wx:if="{{partialFailures.length}}" class="state-banner state-banner--partial">
    <text class="state-title">部分摘要暂未同步</text>
    <text class="state-copy">其余工作区仍可使用。失败模块：<text wx:for="{{partialFailures}}" wx:key="id">{{item.label}}{{index < partialFailures.length - 1 ? '、' : ''}}</text></text>
    <button class="inline-retry" bindtap="loadWorkbench">重试未完成同步</button>
  </view>

  <view wx:if="{{activeWorkspace === 'pending' && !errorMessage}}" class="workspace-panel">
    <view class="summary-grid">
      <view class="summary-card">
        <text class="summary-value">{{pendingTotal}}</text>
        <text class="summary-label">待办</text>
      </view>
      <view class="summary-card">
        <text class="summary-value {{urgentCount ? 'summary-value--urgent' : ''}}">{{urgentCount}}</text>
        <text class="summary-label">优先处理</text>
      </view>
      <view class="summary-card">
        <text class="summary-value">{{operations.notification_deliveries.failed || 0}}</text>
        <text class="summary-label">发送失败的消息</text>
      </view>
    </view>

    <view class="rd-section">
      <view class="rd-section__head">
        <text class="p3-item-title">现在需要留意</text>
        <button class="rd-link" bindtap="loadWorkbench" aria-label="刷新待处理列表">刷新</button>
      </view>
      <view wx:if="{{!pendingVisibleItems.length}}" class="rd-group rd-empty">
        <text class="p3-item-title">暂时没有待办</text>
        <text class="p3-meta">可以稍后回来，或到“项目与评估”看关系试点。</text>
      </view>
      <view wx:else class="rd-group">
        <view wx:for="{{pendingVisibleItems}}" wx:key="workItemId" class="queue-item queue-item--{{item.priority}} {{workItem && workItem.id === item.workItemId ? 'queue-item--active' : ''}} {{index < pendingVisibleItems.length - 1 ? 'rd-row--divided' : ''}}" data-id="{{item.workItemId}}" data-label="{{item.queueLabel}}" bindtap="openWorkItem" role="button" aria-label="处理{{item.queueLabel}}待办，{{item.priorityText}}，已等待{{item.waitText}}">
          <view class="priority-dot priority-dot--{{item.priority}}"></view>
          <view class="queue-main">
            <text class="queue-title">{{item.queueLabel}}</text>
            <text class="queue-meta">{{item.priorityText}} · 已等待 {{item.waitText}}<text wx:if="{{item.dueText}}" class="queue-due {{item.overdue ? 'queue-due--overdue' : ''}}"> · {{item.dueText}}</text></text>
          </view>
          <text wx:if="{{workItem && workItem.id === item.workItemId}}" class="queue-active">正在查看</text>
        </view>
      </view>
      <button wx:if="{{pendingHasMore}}" class="p3-btn p3-btn--quiet list-more" bindtap="showMorePending">继续查看</button>
      <text class="p3-meta">点开一条可以领取和处理。这里只显示类型、紧急程度和等了多久，不显示参与者写的原文。</text>
    </view>

    <view wx:if="{{workItemLoading || workItem || workItemError}}" class="rd-card work-item-panel">
      <view class="rd-section__head">
        <text class="p3-item-title">{{workItem ? workItem.queueLabel : '待办详情'}}</text>
        <button class="rd-link" bindtap="closeWorkItem" aria-label="收起待办详情">收起</button>
      </view>
      <text wx:if="{{workItemLoading}}" class="p3-meta">正在读取待办…</text>
      <text wx:if="{{workItemError}}" class="p3-form-message p3-form-message--error work-item-error" aria-live="polite">{{workItemError}}</text>
      <block wx:if="{{workItem}}">
        <view class="work-item-lines">
          <text class="work-item-line">状态：{{workItem.statusText}} · {{workItem.priorityText}}</text>
          <text class="work-item-line work-item-line--muted {{workItem.overdue ? 'work-item-line--overdue' : ''}}">负责人：{{workItem.assigneeText}} · 截止：{{workItem.dueText}}</text>
        </view>
        <view class="work-item-actions">
          <button wx:if="{{workItem.canClaim}}" class="p3-chip small-action primary" data-action="claim" bindtap="runWorkItemAction" disabled="{{workItemBusy}}">领取</button>
          <block wx:if="{{workItem.canWork}}">
            <button class="p3-chip small-action" data-action="start_processing" bindtap="runWorkItemAction" disabled="{{workItemBusy}}">开始处理</button>
            <button class="p3-chip small-action" data-action="wait" bindtap="runWorkItemAction" disabled="{{workItemBusy}}">等待补充</button>
            <button class="p3-chip small-action" data-action="renew" bindtap="runWorkItemAction" disabled="{{workItemBusy}}">延长处理时间</button>
            <button class="p3-chip small-action" data-action="return" bindtap="runWorkItemAction" disabled="{{workItemBusy}}">放回待办</button>
          </block>
          <button wx:if="{{workItem.canClose}}" class="p3-chip small-action" data-action="close" bindtap="runWorkItemAction" disabled="{{workItemBusy}}">关闭</button>
          <button wx:if="{{workItem.canReopen}}" class="p3-chip small-action" data-action="reopen" bindtap="runWorkItemAction" disabled="{{workItemBusy}}">重新打开</button>
          <block wx:if="{{workItem.isNotification}}">
            <button class="p3-chip small-action" data-action="retry_notification" bindtap="runWorkItemAction" disabled="{{workItemBusy}}">重新发送</button>
            <button wx:if="{{workItem.canRecover}}" class="p3-chip small-action" data-action="recover_notification" bindtap="runWorkItemAction" disabled="{{workItemBusy}}">恢复这条消息</button>
          </block>
        </view>
        <view class="p3-field">
          <text class="p3-field__label">内部处理说明</text>
          <textarea class="p3-field__input p3-field__input--multi" value="{{workItemNote}}" data-key="workItemNote" bindinput="onWorkItemInput" maxlength="2000" placeholder="只记录必要的处理信息，不复制参与者原文。" placeholder-class="p3-field__placeholder"></textarea>
        </view>
        <view wx:if="{{workItem.canWork || workItem.canClose}}" class="p3-field">
          <text class="p3-field__label">处理结果</text>
          <picker mode="selector" range="{{resolutionLabels}}" value="{{workItemResolutionIndex}}" data-key="workItemResolutionIndex" bindchange="onWorkItemPicker">
            <view class="rd-select" role="button" aria-label="处理结果：{{resolutionLabels[workItemResolutionIndex]}}">
              <text class="rd-select__value">{{resolutionLabels[workItemResolutionIndex]}}</text>
              <p3-icon name="chevron-down" size="24" tone="muted" />
            </view>
          </picker>
        </view>
        <view class="rd-pair">
          <button class="p3-btn p3-btn--secondary" data-action="add_note" bindtap="runWorkItemAction" disabled="{{workItemBusy}}">保存内部说明</button>
          <button wx:if="{{workItem.canWork}}" class="p3-btn p3-btn--primary" data-action="complete" bindtap="runWorkItemAction" disabled="{{workItemBusy}}">标记完成</button>
        </view>

        <view wx:if="{{workItem.isRiskReview}}" class="work-item-section">
          <text class="rd-label">风险复核结论</text>
          <text wx:if="{{!workItem.privileged}}" class="p3-meta">风险复核仅由督导或管理员处理。</text>
          <block wx:else>
            <view class="p3-field">
              <text class="p3-field__label">结论</text>
              <picker mode="selector" range="{{riskReviewLabels}}" value="{{riskReviewIndex}}" data-key="riskReviewIndex" bindchange="onWorkItemPicker">
                <view class="rd-select" role="button" aria-label="结论：{{riskReviewLabels[riskReviewIndex]}}">
                  <text class="rd-select__value">{{riskReviewLabels[riskReviewIndex]}}</text>
                  <p3-icon name="chevron-down" size="24" tone="muted" />
                </view>
              </picker>
            </view>
            <view class="p3-field">
              <text class="p3-field__label">已采取的最小处置动作（可选）</text>
              <input class="p3-field__input" value="{{riskReviewAction}}" data-key="riskReviewAction" bindinput="onWorkItemInput" maxlength="1000" placeholder="例如：已发送现实支持资源说明" placeholder-class="p3-field__placeholder" />
            </view>
            <button class="p3-btn p3-btn--secondary" bindtap="submitRiskReview" disabled="{{workItemBusy}}">提交复核结论</button>
            <text class="p3-meta">复核说明使用上方的内部处理说明；提交后这条会从待办中移出。</text>
          </block>
        </view>

        <view wx:if="{{workItem.canMessage}}" class="work-item-section">
          <text class="rd-label">发送参与者可见消息</text>
          <input class="p3-field__input" value="{{workItemMessageTitle}}" data-key="workItemMessageTitle" bindinput="onWorkItemInput" maxlength="60" placeholder="标题（60字以内）" placeholder-class="p3-field__placeholder" />
          <textarea class="p3-field__input p3-field__input--multi" value="{{workItemMessageBody}}" data-key="workItemMessageBody" bindinput="onWorkItemInput" maxlength="2000" placeholder="正文（2000字以内）" placeholder-class="p3-field__placeholder"></textarea>
          <button class="p3-btn p3-btn--secondary" data-action="send_participant_message" bindtap="runWorkItemAction" disabled="{{workItemBusy}}">发送到消息中心</button>
        </view>

        <view class="work-item-section work-item-section--trail">
          <text class="rd-label">处理轨迹</text>
          <text wx:for="{{workItem.trail}}" wx:key="*this" class="p3-meta">{{item}}</text>
          <text wx:if="{{!workItem.trail.length}}" class="p3-meta">尚无处理动作。</text>
        </view>
        <text wx:if="{{workItem.boundaryNotice}}" class="p3-meta">{{workItem.boundaryNotice}}</text>
      </block>
    </view>

    <block wx:if="{{assessmentQueueRuntime || publicationCandidateSummary || assessmentLifecycleSummary}}">
      <button class="engineering-toggle" bindtap="toggleEngineering" aria-label="{{showEngineering ? '收起运行状态' : '展开运行状态'}}">{{showEngineering ? '收起运行状态' : '运行状态（技术检查用）'}}</button>
      <view wx:if="{{showEngineering}}" class="rd-group status-group" aria-label="运行状态">
        <view wx:if="{{assessmentQueueRuntime}}" class="status-row {{assessmentQueueRuntime.paused ? 'status-row--paused' : 'status-row--ok'}}">
          <text class="status-row__eyebrow">评估人工队列</text>
          <text class="status-row__title">{{assessmentQueueRuntime.paused ? '已暂停领取' : '值班和队列正常'}}</text>
          <text class="status-row__meta">待处理 {{assessmentQueueRuntime.pending_count}} · 超时 {{assessmentQueueRuntime.overdue_count}} · 没人值班的紧急项 {{assessmentQueueRuntime.unattended_urgent_count}} · {{assessmentDutyShifts.length}} 个班次</text>
        </view>
        <view wx:if="{{publicationCandidateSummary}}" class="status-row">
          <text class="status-row__eyebrow">发给参与者前的核对</text>
          <text class="status-row__title">消息和反馈的发布核对</text>
          <text class="status-row__meta">待发布 {{publicationCandidateSummary.approved}} · 已发布 {{publicationCandidateSummary.published}} · 已拦下 {{publicationCandidateSummary.blocked}}</text>
        </view>
        <view wx:if="{{assessmentLifecycleSummary}}" class="status-row">
          <text class="status-row__eyebrow">评估反馈流程</text>
          <text class="status-row__title">{{assessmentLifecycleSummary.enabled ? '流程记录可用' : '这个模块已关闭'}}</text>
          <text class="status-row__meta">协作记录 {{assessmentLifecycleSummary.process_quality.case_count || 0}} · 送达回执 {{assessmentLifecycleSummary.process_quality.delivery_receipt_count || 0}} · 撤回没同步到的 {{assessmentLifecycleSummary.implementation_quality.withdrawal_propagation_failures || 0}} · 未结事件 {{assessmentLifecycleSummary.harm_incidents.open || 0}}</text>
        </view>
      </view>
    </block>
  </view>

  <view wx:if="{{activeWorkspace === 'participants'}}" class="workspace-panel">
    <view class="rd-search">
      <text class="p3-meta">{{scopeText || '分配给我的参与者'}}</text>
      <text class="p3-item-title">查找参与者</text>
      <view class="search-box">
        <p3-icon name="search" size="24" tone="muted" />
        <input class="search-input" value="{{participantQuery}}" bindinput="onParticipantQueryInput" placeholder="输入昵称或用户 ID" placeholder-class="p3-field__placeholder" confirm-type="search" aria-label="搜索参与者" />
      </view>
      <text class="p3-meta">列表仅展示最小活动摘要。</text>
    </view>
    <view wx:if="{{participantError}}" class="safe-card error-card">
      <text class="error-title">参与者列表暂时无法读取</text>
      <text class="error-copy">{{participantError}}</text>
      <text class="diagnostic-copy">请求编号：{{participantDiagnostic.requestId || '未返回'}}</text>
      <view class="error-actions">
        <button class="safe-primary-button" bindtap="retryParticipants">重新加载</button>
        <button class="safe-outline-button" data-scope="participants" bindtap="copyDiagnostic">复制诊断信息</button>
      </view>
    </view>
    <view wx:if="{{participantLoading && !participantItems.length}}" class="safe-card state-card">
      <text class="state-title">正在读取参与者摘要</text>
    </view>
    <view wx:elif="{{!participantItems.length && !participantError}}" class="safe-card empty-state">
      <text class="state-title">没有找到参与者</text>
      <text class="state-copy">请检查关键词，或确认当前账号的分配范围与研究授权。</text>
    </view>
    <block wx:if="{{participantItems.length}}">
      <view class="rd-group participant-list">
        <view wx:for="{{participantItems}}" wx:key="user_id" class="participant-card {{index < participantItems.length - 1 ? 'rd-row--divided' : ''}}" data-id="{{item.user_id}}" bindtap="selectParticipantDossier" role="button" aria-label="查看{{item.displayName}}的参与者档案">
          <view class="participant-avatar" aria-hidden="true">{{item.displayInitial}}</view>
          <view class="participant-main">
            <text class="participant-name">{{item.displayName}}</text>
            <text class="participant-meta">{{item.anonymousId}} · {{item.activityCount}} 条活动摘要 · {{item.relationship_count}} 个关系试点</text>
          </view>
          <text wx:if="{{item.unread_message_count}}" class="participant-count">{{item.unread_message_count}} 未读</text>
        </view>
      </view>
      <button wx:if="{{participantHasMore}}" class="p3-btn p3-btn--quiet list-more" loading="{{participantLoading}}" bindtap="loadMoreParticipants">加载下一页</button>
    </block>
    <view wx:if="{{participantDossier}}" class="rd-card participant-dossier-panel">
      <view class="rd-section__head rd-section__head--top">
        <view class="rd-titles">
          <text class="p3-meta">参与者档案{{dossierPilot ? ' · 关系试点' : ''}}</text>
          <text class="p3-item-title">{{participantDossier.participant.nickname || '匿名参与者'}}</text>
          <text class="p3-meta">{{participantDossier.participant.anonymous_id}}</text>
        </view>
        <button class="rd-link" bindtap="closeParticipantDossier" aria-label="关闭参与者档案">关闭</button>
      </view>
      <view wx:if="{{dossierPilot}}" class="dossier-tools">
        <view class="chip-row">
          <button class="p3-chip {{dossierComposer === 'message' ? 'p3-chip--selected active' : ''}}" data-composer="message" bindtap="toggleDossierComposer">发消息</button>
          <button class="p3-chip {{dossierComposer === 'note' ? 'p3-chip--selected active' : ''}}" data-composer="note" bindtap="toggleDossierComposer">写备注</button>
        </view>
        <view wx:if="{{dossierComposer === 'message'}}" class="dossier-composer">
          <input class="p3-field__input" value="{{dossierMessageTitle}}" data-key="dossierMessageTitle" bindinput="onDossierInput" maxlength="60" placeholder="标题（60 字以内）" placeholder-class="p3-field__placeholder" aria-label="消息标题" />
          <textarea class="p3-field__input p3-field__input--multi" value="{{dossierMessageBody}}" data-key="dossierMessageBody" bindinput="onDossierInput" maxlength="2000" placeholder="参与者会在“我的 → 消息”里看到" placeholder-class="p3-field__placeholder" aria-label="消息正文"></textarea>
          <button class="p3-btn p3-btn--primary" loading="{{dossierBusy === 'message'}}" disabled="{{!!dossierBusy}}" bindtap="sendDossierMessage">发送</button>
        </view>
        <view wx:if="{{dossierComposer === 'note'}}" class="dossier-composer">
          <text class="p3-meta">备注只有研究团队能看到，参与者看不到。</text>
          <text wx:for="{{dossierNotes}}" wx:key="id" class="detail-line">{{item.timeText}} · {{item.note}}</text>
          <textarea class="p3-field__input p3-field__input--multi" value="{{dossierNote}}" data-key="dossierNote" bindinput="onDossierInput" maxlength="1000" placeholder="写下要核对的问题或访谈线索" placeholder-class="p3-field__placeholder" aria-label="研究备注"></textarea>
          <button class="p3-btn p3-btn--secondary" loading="{{dossierBusy === 'note'}}" disabled="{{!!dossierBusy || !dossierNote}}" bindtap="saveDossierNote">保存备注</button>
        </view>
      </view>
      <text wx:else class="p3-meta">直接发消息和写备注只对关系试点参与者开放，他们报名时同意了研究人员联系。其他参与者发来的人工支持请求，在“待办”里回复。</text>
      <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="dossier-tabs" aria-label="参与者档案标签">
        <view class="chip-row">
          <button wx:for="{{participantDossier.modules}}" wx:key="key" class="p3-chip dossier-tab {{participantModule && participantModule.module === item.key ? 'p3-chip--selected active' : ''}}" data-key="{{item.key}}" bindtap="loadParticipantModule">{{item.label}} {{item.count}}</button>
        </view>
      </scroll-view>
      <text wx:if="{{participantModuleLoading}}" class="p3-meta">正在按需读取当前标签…</text>
      <view wx:elif="{{participantModule}}" class="module-result-list">
        <text class="rd-label">{{participantModule.module_label}}</text>
        <text wx:if="{{!participantModule.items.length}}" class="p3-meta">这一类还没有记录。</text>
        <view wx:for="{{participantModule.items}}" wx:for-item="record" wx:key="id" class="module-result-card">
          <view wx:if="{{record.timeline}}" class="timeline-row" data-key="{{record.module}}" bindtap="loadParticipantModule" role="button" aria-label="查看{{record.module_label}}">
            <text class="module-line module-line--lead">{{record.module_label}}</text>
            <text class="participant-meta">{{record.timeText}} · 点开看这一类</text>
          </view>
          <view wx:elif="{{record.exploratoryAnalysis}}" class="participant-analysis-result">
            <view class="participant-analysis-head">
              <text class="participant-analysis-status">{{record.statusText}}</text>
              <text class="participant-meta">{{record.record_count}} 条结构化记录</text>
            </view>
            <text wx:if="{{record.reason}}" class="detail-line">{{record.reason}}</text>
            <view wx:if="{{record.availability === 'available'}}" class="participant-analysis-groups">
              <view>
                <text class="participant-analysis-label">情感计算</text>
                <text wx:if="{{record.affectSummary}}" class="detail-line">{{record.affectSummary}}</text>
                <text wx:for="{{record.affectRows}}" wx:key="*this" class="detail-line">{{item}}</text>
                <text wx:if="{{record.trendSummary}}" class="detail-line">{{record.trendSummary}}</text>
                <text wx:if="{{record.affectNextCheck}}" class="boundary-line">{{record.affectNextCheck}}</text>
              </view>
              <view>
                <text class="participant-analysis-label">场景—情绪网络</text>
                <text wx:if="{{record.networkSummary}}" class="detail-line">{{record.networkSummary}}</text>
                <text wx:for="{{record.networkRows}}" wx:key="*this" class="detail-line">{{item}}</text>
                <text wx:if="{{!record.networkRows.length}}" class="detail-line">暂无支持度达到 2 的共现边。</text>
                <text wx:if="{{record.networkNextCheck}}" class="boundary-line">{{record.networkNextCheck}}</text>
              </view>
              <view wx:if="{{record.parentChildSummary}}">
                <text class="participant-analysis-label">家长—孩子情绪组合</text>
                <text class="detail-line">{{record.parentChildSummary}}</text>
                <text wx:for="{{record.parentChildRows}}" wx:key="*this" class="detail-line">{{item}}</text>
                <text wx:if="{{record.parentChildNextCheck}}" class="boundary-line">{{record.parentChildNextCheck}}</text>
              </view>
            </view>
            <text class="boundary-line">{{record.boundary_notice}}</text>
          </view>
          <block wx:else>
            <text wx:for="{{record.displayLines}}" wx:for-item="line" wx:key="*this" class="module-line {{index === 0 ? 'module-line--lead' : ''}}">{{line}}</text>
          </block>
        </view>
