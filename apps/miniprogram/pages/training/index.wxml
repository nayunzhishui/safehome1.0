<view class="safe-page safe-page--with-tabbar training-page">
  <view class="training-hero safe-card safe-card--hero">
    <view class="hero-copy">
      <text class="hero-title">从先稳定自己开始</text>
      <text class="hero-summary">每天选一个小练习，不需要一次做很多。先让身体慢下来，再进入沟通。</text>
      <view class="hero-steps">
        <text>看见情绪</text>
        <text>慢下来</text>
        <text>再回应</text>
      </view>
    </view>
  </view>

  <view class="training-entry-panel safe-card">
    <text class="entry-kicker">训练入口</text>
    <view class="entry-grid">
      <button class="entry-item entry-item--active">
        <text class="entry-title">通用训练</text>
        <text class="entry-desc">按阶段浏览训练卡</text>
      </button>
      <button class="entry-item" bindtap="openPersonalizedPlan">
        <text class="entry-title">个性化方案</text>
        <text class="entry-desc">根据测评推荐练习</text>
      </button>
      <button class="entry-item" bindtap="openProgramList">
        <text class="entry-title">项目测试</text>
        <text class="entry-desc">暑期试点练习包</text>
      </button>
    </view>
  </view>

  <view wx:if="{{latestRecommendation}}" class="recommendation-card safe-card">
    <view class="recommendation-head">
      <view class="recommendation-copy">
        <text class="recommendation-kicker">{{latestRecommendation.sourceLabel}}</text>
        <text class="recommendation-title">今天可以先练这个方向</text>
      </view>
      <button class="recommendation-action" bindtap="openLatestRecommendation">查看练习</button>
    </view>
    <text wx:if="{{latestRecommendation.reason}}" class="recommendation-label">推荐理由</text>
    <text wx:if="{{latestRecommendation.reason}}" class="recommendation-text">{{latestRecommendation.reason}}</text>
    <text wx:if="{{latestRecommendation.todaySuggestion}}" class="recommendation-label">今日建议</text>
    <text wx:if="{{latestRecommendation.todaySuggestion}}" class="recommendation-text">{{latestRecommendation.todaySuggestion}}</text>
    <view class="recommendation-list">
      <view wx:for="{{latestRecommendation.cards}}" wx:key="id" class="recommendation-item">
        <text class="recommendation-role">{{item.role}}</text>
        <view class="recommendation-item-copy">
          <text class="recommendation-card-title">{{item.title}}</text>
          <text wx:if="{{item.purpose}}" class="recommendation-purpose">{{item.purpose}}</text>
        </view>
      </view>
    </view>
    <text wx:if="{{latestRecommendation.boundaryNotice}}" class="recommendation-boundary">{{latestRecommendation.boundaryNotice}}</text>
  </view>

  <view wx:if="{{threeDayPlan}}" class="plan-card safe-card">
    <view class="plan-head">
      <text class="plan-kicker">{{threeDayPlan.sourceTitle}}</text>
      <text class="plan-title">3 天轻量练习</text>
      <text class="plan-summary">{{threeDayPlan.longTermSuggestion}}</text>
    </view>
    <view class="plan-days">
      <button
        wx:for="{{threeDayPlan.days}}"
        wx:key="day"
        class="plan-day"
        data-card-id="{{item.cardId}}"
        bindtap="openPlanDay"
      >
        <text class="plan-day-index">{{item.title}}</text>
        <text class="plan-day-role">{{item.role}}</text>
        <text class="plan-day-card">{{item.cardTitle}}</text>
        <text class="plan-day-suggestion">{{item.suggestion}}</text>
      </button>
    </view>
    <text class="plan-boundary">{{threeDayPlan.boundaryNotice}}</text>
  </view>

  <view class="starter-card safe-card">
    <view class="starter-head">
      <text class="starter-icon">先</text>
      <view class="starter-copy">
        <text class="starter-title">新手推荐路径</text>
        <text class="starter-text">如果不知道从哪张卡开始，先按这三个小练习走一遍。</text>
      </view>
    </view>
    <view class="starter-steps">
      <view class="starter-step">
        <text class="step-name">情绪觉察</text>
        <text class="step-desc">先看见自己</text>
      </view>
      <view class="starter-step">
        <text class="step-name">身体调节</text>
        <text class="step-desc">让反应慢下来</text>
      </view>
      <view class="starter-step">
        <text class="step-name">暂停训练</text>
        <text class="step-desc">再回应孩子</text>
      </view>
    </view>
  </view>

  <view class="path-card">
    <view class="path-item">
        <text class="path-index">1</text>
      <text class="path-text">认识和稳定情绪</text>
    </view>
    <view class="path-line"></view>
    <view class="path-item">
        <text class="path-index">2</text>
      <text class="path-text">改变想法和行为</text>
    </view>
    <view class="path-line"></view>
    <view class="path-item">
        <text class="path-index">3</text>
      <text class="path-text">改善亲子关系</text>
    </view>
  </view>

  <view wx:for="{{trainingStages}}" wx:key="title" class="safe-section stage-section">
    <section-title title="{{item.title}}" subtitle="{{item.subtitle}}" />
    <view class="task-list">
      <view wx:for="{{item.tasks}}" wx:for-item="task" wx:key="id">
        <training-task-card
          data-id="{{task.id}}"
          data-tags="{{task.tagsText}}"
          title="{{task.title}}"
          subtitle="{{task.subtitle}}"
          stage="{{task.stage}}"
          duration="{{task.duration}}"
          scenario="{{task.scenario}}"
          tag="{{task.tag}}"
          bind:tapcard="openTrainingCard"
        />
      </view>
    </view>
  </view>

  <view class="safe-section">
    <bottom-tip-card text="先稳定自己，再清晰地陪伴孩子。" subtext="每张训练卡都是一个可以当天完成的小练习。" />
  </view>
</view>
