.training-page {
  padding-bottom: 48rpx;
}

.page-head {
  padding: 32rpx;
}

.page-title,
.page-subtitle {
  display: block;
}

.page-subtitle {
  margin-top: 12rpx;
}

.starter-card {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  margin-top: 28rpx;
  padding: 26rpx 28rpx;
  border: 1rpx solid #cddfc5;
  border-radius: 16rpx;
  background: #edf6e8;
}

.starter-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--safe-primary);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
}

.starter-title,
.starter-text {
  display: block;
}

.starter-title {
  color: var(--safe-title);
  font-size: 28rpx;
  font-weight: 800;
}

.starter-text {
  margin-top: 8rpx;
  color: var(--safe-primary-deep);
  font-size: 26rpx;
  line-height: 1.6;
}

.stage-section {
  scroll-margin-top: 24rpx;
}

.task-list {
  display: grid;
  gap: 18rpx;
  margin-top: 20rpx;
}
