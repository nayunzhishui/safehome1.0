.training-page {
  display: flex;
  flex-direction: column;
  gap: 34rpx;
  overflow-x: hidden;
}

.training-hero {
  padding: 24rpx 0 32rpx;
  text-align: center;
}

.hero-title,
.hero-summary,
.entry-kicker,
.entry-title,
.entry-desc,
.recommendation-kicker,
.recommendation-title,
.recommendation-label,
.recommendation-text,
.recommendation-role,
.recommendation-card-title,
.recommendation-purpose,
.repeat-hint,
.recommendation-boundary,
.plan-kicker,
.plan-title,
.plan-summary,
.plan-day-index,
.plan-day-role,
.plan-day-card,
.plan-day-suggestion,
.plan-boundary,
.starter-title,
.starter-text,
.step-name,
.step-desc {
  display: block;
}

.hero-title {
  color: var(--safe-title);
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.2;
}

.hero-summary {
  margin-top: 16rpx;
  color: var(--safe-muted);
  font-size: 28rpx;
  line-height: 1.65;
}

.hero-steps {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: 28rpx;
  padding: 20rpx 0 0;
  border-top: 1rpx solid var(--safe-border);
}

.hero-steps text {
  position: relative;
  color: var(--safe-primary-deep);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.4;
  text-align: center;
}

.hero-steps text + text {
  border-left: 1rpx solid var(--safe-border);
}

.training-entry-panel,
.relationship-pilot-entry,
.plan-card,
.starter-card,
.stage-section {
  padding-top: 30rpx;
  border-top: 1rpx solid var(--safe-border);
}

.entry-kicker,
.recommendation-kicker,
.plan-kicker {
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.4;
}

.entry-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: 18rpx;
  border-bottom: 1rpx solid var(--safe-border);
}

.entry-item {
  min-width: 0;
  min-height: 112rpx;
  margin: 0;
  padding: 18rpx 10rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--safe-title);
}

.entry-item::after {
  border: 0;
}

.entry-item--active {
  border-bottom: 4rpx solid var(--safe-primary);
  color: var(--safe-primary-deep);
  background: var(--safe-primary-pale);
}

.entry-title {
  font-size: 28rpx;
  font-weight: 850;
  line-height: 1.35;
}

.entry-desc {
  margin-top: 6rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.4;
}

.recommendation-card {
  padding: 30rpx;
  border-radius: var(--safe-radius-md);
  background: var(--safe-primary-pale);
}

.recommendation-head,
.recommendation-copy,
.plan-head,
.starter-copy {
  min-width: 0;
}

.recommendation-title,
.plan-title,
.starter-title,
.relationship-pilot-entry > .entry-title {
  margin-top: 8rpx;
  color: var(--safe-title);
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.35;
}

.recommendation-label {
  margin-top: 22rpx;
  color: var(--safe-title);
  font-size: 26rpx;
  font-weight: 850;
  line-height: 1.4;
}

.recommendation-text,
.recommendation-boundary,
.plan-summary,
.plan-boundary,
.starter-text,
.relationship-pilot-entry > .entry-desc {
  margin-top: 8rpx;
  color: var(--safe-muted);
  font-size: 28rpx;
  line-height: 1.6;
}

.recommendation-list {
  margin-top: 22rpx;
}

.recommendation-item {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 22rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-sm);
  background: var(--safe-card);
}

.recommendation-role {
  flex: 0 0 auto;
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 850;
}

.recommendation-item-copy {
  min-width: 0;
  flex: 1;
}

.recommendation-card-title {
  color: var(--safe-title);
  font-size: 30rpx;
  font-weight: 850;
  line-height: 1.4;
}

.recommendation-purpose,
.repeat-hint {
  margin-top: 6rpx;
  color: var(--safe-muted);
  font-size: 26rpx;
  line-height: 1.5;
}

.recommendation-action,
.relationship-action,
.plan-toggle,
.library-toggle {
  width: 100%;
  min-height: 88rpx;
  margin: 24rpx 0 0;
  border-radius: var(--safe-radius-sm);
  font-size: 28rpx;
  font-weight: 850;
}

.recommendation-action::after,
.relationship-action::after,
.plan-toggle::after,
.library-toggle::after,
.plan-day::after {
  border: 0;
}

.plan-toggle,
.library-toggle {
  border: 2rpx solid var(--safe-primary);
  background: transparent;
  color: var(--safe-primary-deep);
}

.plan-days {
  display: grid;
  gap: 0;
  margin-top: 18rpx;
  border-top: 1rpx solid var(--safe-border);
}

.plan-day {
  width: 100%;
  min-height: 88rpx;
  margin: 0;
  padding: 22rpx 0;
  border: 0;
  border-bottom: 1rpx solid var(--safe-border);
  border-radius: 0;
  background: transparent;
  text-align: left;
}

.plan-day-index,
.plan-day-role {
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 800;
}

.plan-day-card {
  margin-top: 6rpx;
  color: var(--safe-title);
  font-size: 30rpx;
  font-weight: 850;
  line-height: 1.4;
}

.plan-day-suggestion {
  margin-top: 6rpx;
  color: var(--safe-muted);
  font-size: 26rpx;
  line-height: 1.5;
}

.starter-head {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.starter-icon {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 52rpx;
  border-radius: 50%;
  background: var(--safe-primary-soft);
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 900;
}

.starter-title {
  margin-top: 0;
}

.starter-steps {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 22rpx;
}

.starter-step {
  min-width: 0;
  padding: 18rpx 14rpx;
  border-radius: var(--safe-radius-sm);
  background: var(--safe-primary-pale);
}

.step-name {
  color: var(--safe-primary-deep);
  font-size: 26rpx;
  font-weight: 850;
  line-height: 1.35;
}

.step-desc {
  margin-top: 6rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.4;
}

.task-list {
  display: grid;
  gap: 18rpx;
  margin-top: 18rpx;
}

.repeat-hint,
.recommendation-boundary,
.plan-boundary {
  font-size: 24rpx;
}

@media (max-width: 360px) {
  .entry-grid,
  .starter-steps {
    grid-template-columns: 1fr;
  }

  .entry-item {
    min-height: 88rpx;
    text-align: left;
  }

  .entry-item--active {
    border-right: 0;
    border-bottom-width: 2rpx;
  }
}
