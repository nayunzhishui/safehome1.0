.training-page {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.training-hero {
  position: relative;
  min-height: 258rpx;
  overflow: hidden;
}

.hero-copy {
  max-width: 470rpx;
}

.hero-title {
  display: block;
  color: var(--safe-title);
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.28;
  letter-spacing: 0;
}

.hero-summary {
  display: block;
  margin-top: 14rpx;
  color: var(--safe-text);
  font-size: 27rpx;
  line-height: 1.62;
}

.hero-steps {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.hero-steps text {
  min-height: 44rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 16rpx;
  border: 1rpx solid rgba(87, 139, 95, 0.16);
  border-radius: var(--safe-radius-pill);
  background: rgba(255, 253, 248, 0.78);
  color: var(--safe-primary-deep);
  font-size: 22rpx;
  font-weight: 800;
}

.hero-badge {
  position: absolute;
  right: 30rpx;
  bottom: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 142rpx;
  height: 142rpx;
  border: 1rpx solid rgba(87, 139, 95, 0.18);
  border-radius: 50%;
  background: rgba(255, 253, 248, 0.82);
}

.hero-badge-number {
  color: var(--safe-primary-deep);
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1;
}

.hero-badge-text {
  margin-top: 8rpx;
  color: var(--safe-muted);
  font-size: 20rpx;
}

.training-entry-panel {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.entry-kicker {
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 850;
}

.entry-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.entry-item {
  min-height: 128rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  gap: 8rpx;
  padding: 18rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-sm);
  background: #fffdf8;
  text-align: left;
}

.entry-item--active {
  border-color: var(--safe-primary);
  background: var(--safe-primary-pale);
}

.entry-title,
.entry-desc {
  display: block;
}

.entry-title {
  color: var(--safe-title);
  font-size: 26rpx;
  font-weight: 850;
  line-height: 1.3;
}

.entry-desc {
  color: var(--safe-muted);
  font-size: 22rpx;
  line-height: 1.4;
}

.recommendation-card {
  margin-top: 0;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(52, 66, 58, 0.06);
}

.recommendation-head {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  margin-bottom: 20rpx;
}

.recommendation-copy {
  flex: 1;
  min-width: 0;
}

.recommendation-kicker {
  display: block;
  margin-bottom: 8rpx;
  color: var(--safe-primary);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.4;
}

.recommendation-title {
  display: block;
  color: var(--safe-title);
  font-size: 30rpx;
  font-weight: 850;
  line-height: 1.45;
}

.recommendation-action {
  min-width: 120rpx;
  min-height: 64rpx;
  margin: 0;
  padding: 0 22rpx;
  border-radius: var(--safe-radius-pill);
  background: var(--safe-primary);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 850;
  line-height: 64rpx;
}

.recommendation-action::after {
  border: 0;
}

.recommendation-label {
  display: block;
  margin-top: 16rpx;
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.45;
}

.recommendation-label:first-of-type {
  margin-top: 0;
}

.recommendation-text,
.recommendation-boundary {
  display: block;
  margin-top: 8rpx;
  color: var(--safe-text);
  font-size: 25rpx;
  line-height: 1.7;
}

.recommendation-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 18rpx;
}

.recommendation-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(87, 139, 95, 0.16);
  border-radius: var(--safe-radius-sm);
  background: var(--safe-primary-pale);
}

.recommendation-role {
  flex: 0 0 auto;
  padding: 6rpx 12rpx;
  border-radius: var(--safe-radius-pill);
  background: var(--safe-card);
  color: var(--safe-primary-deep);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.35;
}

.recommendation-item-copy {
  flex: 1;
  min-width: 0;
}

.recommendation-card-title {
  display: block;
  color: var(--safe-title);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.45;
}

.recommendation-purpose {
  display: block;
  margin-top: 6rpx;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.6;
}

.recommendation-boundary {
  color: var(--safe-muted);
}

.plan-card {
  margin-top: 0;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(52, 66, 58, 0.06);
}

.plan-head {
  margin-bottom: 20rpx;
}

.plan-kicker {
  display: block;
  margin-bottom: 8rpx;
  color: var(--safe-primary);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.45;
}

.plan-title {
  display: block;
  color: var(--safe-title);
  font-size: 30rpx;
  font-weight: 850;
  line-height: 1.45;
}

.plan-summary {
  display: block;
  margin-top: 10rpx;
  color: var(--safe-text);
  font-size: 25rpx;
  line-height: 1.7;
}

.plan-days {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.plan-day {
  display: block;
  width: 100%;
  min-height: 0;
  margin: 0;
  padding: 20rpx;
  border: 1rpx solid rgba(111, 143, 184, 0.22);
  border-radius: var(--safe-radius-sm);
  background: var(--safe-blue-soft);
  text-align: left;
  line-height: 1.5;
}

.plan-day::after {
  border: 0;
}

.plan-day-index,
.plan-day-role,
.plan-day-card,
.plan-day-suggestion {
  display: block;
}

.plan-day-index {
  color: var(--safe-info);
  font-size: 22rpx;
  font-weight: 850;
}

.plan-day-role {
  margin-top: 6rpx;
  color: var(--safe-primary-deep);
  font-size: 23rpx;
  font-weight: 800;
}

.plan-day-card {
  margin-top: 6rpx;
  color: var(--safe-title);
  font-size: 27rpx;
  font-weight: 850;
}

.plan-day-suggestion {
  margin-top: 8rpx;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.65;
}

.plan-boundary {
  display: block;
  margin-top: 16rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.7;
}

.starter-card {
  margin-top: 0;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(52, 66, 58, 0.06);
}

.starter-head {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.starter-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 46rpx;
  flex: 0 0 60rpx;
  border-radius: var(--safe-radius-pill);
  background: var(--safe-primary-soft);
  color: var(--safe-primary-deep);
  font-size: 23rpx;
  font-weight: 800;
  line-height: 46rpx;
}

.starter-copy {
  flex: 1;
  min-width: 0;
}

.starter-title {
  display: block;
  color: var(--safe-title);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.4;
}

.starter-text {
  display: block;
  margin-top: 8rpx;
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.65;
}

.starter-steps {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 24rpx;
}

.starter-step {
  min-height: 112rpx;
  padding: 18rpx 14rpx;
  border: 1rpx solid rgba(87, 139, 95, 0.16);
  border-radius: var(--safe-radius-sm);
  background: var(--safe-primary-pale);
}

.step-name,
.step-desc {
  display: block;
  text-align: center;
}

.step-name {
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.4;
}

.step-desc {
  margin-top: 8rpx;
  color: var(--safe-text);
  font-size: 22rpx;
  line-height: 1.45;
}

.path-card {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: 24rpx;
  background: rgba(255, 253, 248, 0.9);
  box-shadow: 0 8rpx 18rpx rgba(52, 66, 58, 0.05);
}

.path-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.path-index {
  color: var(--safe-primary);
  font-size: 22rpx;
  font-weight: 800;
}

.path-text {
  margin-top: 6rpx;
  color: var(--safe-title);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.35;
  text-align: center;
}

.path-line {
  width: 34rpx;
  height: 2rpx;
  flex: 0 0 34rpx;
  background: var(--safe-border-strong);
}

.stage-section {
  margin-top: 8rpx;
  scroll-margin-top: 24rpx;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 20rpx;
}
.relationship-pilot-entry {
  display: grid;
  gap: 14rpx;
  border-left: 6rpx solid var(--safe-primary);
}
