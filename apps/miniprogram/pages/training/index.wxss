.training-page {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.training-hero {
  position: relative;
  min-height: 284rpx;
  overflow: hidden;
}

.hero-copy {
  max-width: 470rpx;
}

.hero-kicker {
  display: block;
  margin-bottom: 10rpx;
  color: var(--safe-primary);
  font-size: 24rpx;
  font-weight: 700;
}

.hero-title {
  display: block;
  color: var(--safe-title);
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.28;
  letter-spacing: 0;
}

.hero-summary {
  display: block;
  margin-top: 16rpx;
  color: var(--safe-text);
  font-size: 28rpx;
  line-height: 1.7;
}

.hero-badge {
  position: absolute;
  right: 30rpx;
  bottom: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 142rpx;
  height: 142rpx;
  border: 1rpx solid rgba(87, 139, 95, 0.18);
  border-radius: 50%;
  background: rgba(255, 253, 248, 0.82);
}

.hero-badge-number {
  color: var(--safe-primary-deep);
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1;
}

.hero-badge-text {
  margin-top: 8rpx;
  color: var(--safe-muted);
  font-size: 20rpx;
}

.starter-card {
  margin-top: 0;
}

.starter-head {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.starter-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  flex: 0 0 52rpx;
  border-radius: 18rpx;
  background: var(--safe-primary);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 52rpx;
}

.starter-copy {
  flex: 1;
  min-width: 0;
}

.starter-title {
  display: block;
  color: var(--safe-title);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.4;
}

.starter-text {
  display: block;
  margin-top: 8rpx;
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.65;
}

.starter-steps {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 24rpx;
}

.starter-step {
  min-height: 112rpx;
  padding: 18rpx 14rpx;
  border: 1rpx solid rgba(87, 139, 95, 0.16);
  border-radius: var(--safe-radius-sm);
  background: var(--safe-primary-pale);
}

.step-name,
.step-desc {
  display: block;
  text-align: center;
}

.step-name {
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.4;
}

.step-desc {
  margin-top: 8rpx;
  color: var(--safe-text);
  font-size: 22rpx;
  line-height: 1.45;
}

.path-card {
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-lg);
  background: rgba(255, 253, 248, 0.9);
  box-shadow: var(--safe-shadow-card);
}

.path-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.path-index {
  color: var(--safe-primary);
  font-size: 22rpx;
  font-weight: 800;
}

.path-text {
  margin-top: 6rpx;
  color: var(--safe-title);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.35;
  text-align: center;
}

.path-line {
  width: 34rpx;
  height: 2rpx;
  flex: 0 0 34rpx;
  background: var(--safe-border-strong);
}

.stage-section {
  margin-top: 8rpx;
  scroll-margin-top: 24rpx;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 20rpx;
}
