/* 训练（Figma 643:636）：TabHero；分段切换；今天推荐（全页唯一实心按钮）；3 天竹节时间线；训练库三阶段类别。 */
page {
  background: var(--p3-paper);
}

.training-page {
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--p3-paper);
  overflow-x: hidden;
}

.training-content {
  display: flex;
  flex-direction: column;
  gap: var(--p3-section);
  padding: 8rpx var(--p3-page-x) 56rpx;
}

.training-today__kicker {
  display: block;
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

.training-today__title-row {
  display: flex;
  align-items: center;
  gap: var(--p3-tight);
}

.training-today__title {
  flex: 1 0 0;
  min-width: 0;
  display: block;
  color: var(--p3-ink);
  font-size: 40rpx;
  line-height: 56rpx;
  font-weight: 500;
  overflow-wrap: anywhere;
}

.training-today__pill {
  flex: 0 0 auto;
}

.training-today__body {
  display: block;
  color: var(--p3-muted);
  font-size: 28rpx;
  line-height: 44rpx;
}

.training-today__meta {
  display: flex;
  align-items: center;
  gap: var(--p3-tight);
}

.training-today__meta-text {
  flex: 1 0 0;
  min-width: 0;
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

.training-today__why {
  flex: 0 0 auto;
  width: auto;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  color: var(--p3-primary);
  font-size: 26rpx;
  line-height: 40rpx;
  white-space: nowrap;
}

.training-today__reason {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 28rpx 32rpx;
  border-radius: 32rpx;
  background: var(--p3-mist);
}

.training-today__reason-row {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.training-today__reason-label {
  color: var(--p3-primary);
  font-size: 26rpx;
  line-height: 40rpx;
}

.training-today__reason-text {
  color: var(--p3-ink);
  font-size: 28rpx;
  line-height: 44rpx;
}

.training-today__boundary {
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

.training-pilot {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
  padding: 36rpx;
  border-radius: var(--p3-radius-group);
  background: var(--p3-surface);
}

.training-pilot__kicker {
  color: var(--p3-primary);
  font-size: 26rpx;
  line-height: 40rpx;
}

.training-pilot__title {
  color: var(--p3-ink);
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: 500;
}

.training-pilot__desc {
  color: var(--p3-muted);
  font-size: 28rpx;
  line-height: 44rpx;
}

.training-pilot .p3-btn {
  margin-top: 8rpx;
}

.training-section {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
}

.training-timeline {
  display: flex;
  flex-direction: column;
}

.training-timeline__item {
  display: block;
  width: 100%;
  min-height: 0;
  text-align: left;
}

.training-stage {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
  padding: 36rpx;
  border-radius: var(--p3-radius-group);
  background: var(--p3-surface);
}

.training-stage__chips {
  display: flex;
  flex-wrap: wrap;
  gap: var(--p3-tight);
}

.training-stage__chip {
  width: auto;
  flex: 0 0 auto;
}
