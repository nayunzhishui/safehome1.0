.task-detail-page {
  padding-bottom: calc(52rpx + env(safe-area-inset-bottom));
}

.detail-nav {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 8rpx 0 8rpx;
}

.back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--safe-card);
  color: var(--safe-primary);
  font-size: 48rpx;
  line-height: 64rpx;
  box-shadow: var(--safe-shadow-card);
}

.back-button::after {
  border: 0;
}

.nav-title {
  color: var(--safe-title);
  font-size: 32rpx;
  font-weight: 800;
}

.overview-card {
  position: relative;
  overflow: hidden;
  text-align: center;
}

.task-tag,
.task-title,
.task-subtitle,
.overview-label,
.overview-value,
.today-title,
.today-text {
  display: block;
}

.task-tag {
  min-height: 42rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 16rpx;
  border-radius: var(--safe-radius-pill);
  background: var(--safe-primary-soft);
  color: var(--safe-primary);
  font-size: 22rpx;
  font-weight: 800;
}

.task-title {
  margin-top: 2rpx;
  color: var(--safe-title);
  font-size: 42rpx;
  font-weight: 850;
  line-height: 1.28;
  letter-spacing: 0;
}

.task-subtitle {
  margin-top: 10rpx;
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.6;
}

.overview-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 26rpx;
}

.overview-item {
  padding: 22rpx;
  border: 1rpx solid rgba(228, 220, 207, 0.78);
  border-radius: var(--safe-radius-md);
  background: rgba(255, 255, 255, 0.68);
}

.overview-item--full {
  grid-column: 1 / -1;
}

.overview-label {
  color: var(--safe-muted);
  font-size: 24rpx;
  font-weight: 700;
}

.overview-value {
  margin-top: 8rpx;
  color: var(--safe-title);
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.55;
}

.today-card {
  margin-top: 28rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid rgba(244, 127, 69, 0.2);
  border-radius: var(--safe-radius-md);
  background: var(--safe-orange-soft);
}

.today-title {
  color: var(--safe-orange);
  font-size: 26rpx;
  font-weight: 900;
}

.today-text {
  margin-top: 8rpx;
  color: var(--safe-text);
  font-size: 25rpx;
  line-height: 1.7;
}

.step-list,
.script-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 20rpx;
}

.step-card {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 22rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: 22rpx;
  background: var(--safe-card);
  box-shadow: 0 8rpx 18rpx rgba(52, 66, 58, 0.05);
}

.step-index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  flex: 0 0 44rpx;
  border-radius: 50%;
  background: var(--safe-primary-soft);
  color: var(--safe-primary);
  font-size: 22rpx;
  font-weight: 900;
  line-height: 44rpx;
}

.step-text {
  flex: 1;
  min-width: 0;
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.65;
}

.script-card,
.record-card {
  padding: 24rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: 22rpx;
  background: var(--safe-card);
  box-shadow: 0 8rpx 18rpx rgba(52, 66, 58, 0.05);
}

.script-card {
  background: #fffaf3;
  border-color: rgba(244, 127, 69, 0.22);
}

.script-card text {
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.7;
}

.field-label {
  display: block;
  margin-bottom: 14rpx;
  color: var(--safe-title);
  font-size: 26rpx;
  font-weight: 800;
}

.field-label:not(:first-child) {
  margin-top: 24rpx;
}

.reflection-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 166rpx;
  padding: 22rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: var(--safe-bg);
  color: var(--safe-title);
  font-size: 25rpx;
  line-height: 1.6;
}

.action-bar {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 32rpx;
}

.action-button {
  width: 100%;
  min-height: 82rpx;
  font-size: 26rpx;
}

.secondary-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.soft-action-button {
  min-height: 72rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-pill);
  background: rgba(255, 253, 248, 0.84);
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 72rpx;
}

.soft-action-button::after {
  border: 0;
}
