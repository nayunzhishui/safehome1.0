/* 练习（Figma 655:1784）：概览卡 → 练习步骤（节号竖轨）→ 示例话术 → 练习后记录 → 说明 → 操作。 */
.task-page {
  display: flex;
  flex-direction: column;
  gap: var(--p3-section);
  padding-top: 16rpx;
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
}

.task-page--state {
  gap: var(--p3-stack);
}

.task-overview {
  gap: var(--p3-stack);
}

.task-facts {
  display: flex;
  align-items: flex-start;
  gap: var(--p3-stack);
}

.task-fact {
  display: flex;
  flex: 1 0 0;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.task-goal {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 28rpx 32rpx;
  border-radius: var(--p3-radius-group);
  background: var(--p3-soft);
}

.task-goal__label {
  color: var(--p3-primary);
  font-size: 26rpx;
  line-height: 40rpx;
}

.task-goal__text {
  color: var(--p3-ink);
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: 500;
}

.task-section {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
}

/* 步骤：22px 节号（第一步实心青瓷，其余浅底）+ 2px 竖线（22% 青瓷）连到下一步 */
.task-steps {
  display: flex;
  flex-direction: column;
}

.task-step {
  display: flex;
  align-items: stretch;
  gap: var(--p3-stack);
}

.task-step--linked {
  padding-bottom: 28rpx;
}

.task-step__rail {
  display: flex;
  flex: 0 0 44rpx;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.task-step__number {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 44rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: var(--p3-soft);
  color: var(--p3-primary);
  font-size: 26rpx;
  line-height: 40rpx;
}

.task-step__number--first {
  background: var(--p3-primary);
  color: var(--p3-surface);
}

.task-step__line {
  flex: 1 0 0;
  width: 4rpx;
  min-height: 0;
  background: var(--p3-primary);
  opacity: 0.22;
}

.task-step__text {
  flex: 1 0 0;
  min-width: 0;
  color: var(--p3-ink);
  font-size: 30rpx;
  line-height: 52rpx;
}

.task-quote {
  padding-left: 28rpx;
  border-left: 4rpx solid var(--p3-primary);
}

.task-intensity,
.task-consent {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
}

.task-intensity__label {
  color: var(--p3-ink);
  font-size: 28rpx;
  line-height: 44rpx;
}

.task-actions {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
}

.task-actions__row {
  display: flex;
  gap: var(--p3-stack);
}

.task-actions__quiet {
  flex: 1 0 0;
  min-width: 0;
}
