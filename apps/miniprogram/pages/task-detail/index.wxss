.task-detail-page {
  padding-bottom: 48rpx;
}

.detail-nav {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 8rpx 0 24rpx;
}

.back-button {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #ffffff;
  color: #4caf7d;
  font-size: 48rpx;
  box-shadow: 0 8rpx 20rpx rgba(80, 64, 45, 0.08);
}

.nav-title {
  color: #333333;
  font-size: 32rpx;
  font-weight: 800;
}

.overview-card {
  padding: 32rpx;
  border: 1rpx solid #efe7dc;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #ffffff 0%, #fff7e8 100%);
  box-shadow: 0 12rpx 32rpx rgba(80, 64, 45, 0.08);
}

.task-tag {
  min-height: 42rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 16rpx;
  border-radius: 21rpx;
  background: #eef8e9;
  color: #4caf7d;
  font-size: 22rpx;
  font-weight: 700;
}

.task-title,
.task-subtitle {
  display: block;
}

.task-title {
  margin-top: 18rpx;
  color: #333333;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.3;
}

.task-subtitle {
  margin-top: 10rpx;
  color: #555555;
  font-size: 26rpx;
  line-height: 1.55;
}

.overview-grid {
  display: grid;
  gap: 18rpx;
  margin-top: 26rpx;
}

.overview-grid view {
  padding: 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.76);
}

.overview-label,
.overview-value {
  display: block;
}

.overview-label {
  color: #888888;
  font-size: 22rpx;
}

.overview-value {
  margin-top: 8rpx;
  color: #333333;
  font-size: 25rpx;
  line-height: 1.55;
}

.step-list,
.script-list {
  display: grid;
  gap: 16rpx;
  margin-top: 20rpx;
}

.step-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx;
  border: 1rpx solid #efe7dc;
  border-radius: 20rpx;
  background: #ffffff;
}

.step-index {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  border-radius: 50%;
  background: #6fbc6b;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 800;
}

.step-text {
  color: #333333;
  font-size: 26rpx;
  line-height: 1.55;
}

.script-card,
.record-card {
  padding: 24rpx;
  border: 1rpx solid #efe7dc;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(80, 64, 45, 0.06);
}

.script-card text {
  color: #555555;
  font-size: 26rpx;
  line-height: 1.6;
}

.field-label {
  display: block;
  margin-bottom: 14rpx;
  color: #333333;
  font-size: 26rpx;
  font-weight: 700;
}

.field-label:not(:first-child) {
  margin-top: 24rpx;
}

.reflection-input {
  width: 100%;
  min-height: 166rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #fffaf3;
  color: #333333;
  font-size: 25rpx;
  line-height: 1.55;
}

.action-bar {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 32rpx;
}

.action-button {
  min-height: 78rpx;
  padding: 0 12rpx;
  font-size: 24rpx;
}
