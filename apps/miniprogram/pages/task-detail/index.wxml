<view wx:if="{{!task}}" class="p3-page task-page task-page--state">
  <page-state kind="{{loading ? 'loading' : 'error'}}" title="{{loading ? '正在读取可用练习' : '暂时无法打开这张训练卡'}}" description="{{errorMessage}}" action-label="{{loading ? '' : '重新读取'}}" bind:action="loadTask" />
  <button class="p3-btn p3-btn--quiet" bindtap="goBack">返回选择练习</button>
</view>
<view wx:else class="p3-page task-page" role="main" aria-label="训练任务详情">
  <view class="p3-card task-overview">
    <text class="p3-action-title" role="heading" aria-level="1">{{task.title}}</text>
    <text wx:if="{{task.subtitle}}" class="p3-body-compact">{{task.subtitle}}</text>
    <view class="task-facts">
      <view class="task-fact">
        <text class="p3-meta">适用情境</text>
        <text class="p3-item-title">{{task.scenario}}</text>
      </view>
      <view class="task-fact">
        <text class="p3-meta">预计用时</text>
        <text class="p3-item-title">{{task.duration}}</text>
      </view>
    </view>
    <view wx:if="{{task.goal}}" class="task-goal">
      <text class="task-goal__label">今天的小目标</text>
      <text class="task-goal__text">{{task.goal}}</text>
    </view>
  </view>

  <view class="task-section">
    <p3-section-header title="练习步骤" />
    <view class="task-steps">
      <view wx:for="{{task.steps}}" wx:key="*this" class="task-step {{index < task.steps.length - 1 ? 'task-step--linked' : ''}}">
        <view class="task-step__rail" aria-hidden="true">
          <text class="task-step__number {{index === 0 ? 'task-step__number--first' : ''}}">{{index + 1}}</text>
          <view wx:if="{{index < task.steps.length - 1}}" class="task-step__line"></view>
        </view>
        <text class="task-step__text">{{item}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{task.scripts.length}}" class="task-section">
    <p3-section-header title="示例话术" />
    <view wx:for="{{task.scripts}}" wx:key="*this" class="task-quote">
      <text class="p3-quote">“{{item}}”</text>
    </view>
  </view>

  <view class="task-section">
    <p3-section-header title="练习后记录" />
    <block wx:if="{{serviceReady}}">
      <view class="p3-field">
        <label for="task-reflection" class="p3-field__label">今日感受</label>
        <textarea
          id="task-reflection"
          class="p3-field__input p3-field__input--multi"
          aria-label="今日感受，仅保留在本页"
          placeholder-class="p3-field__placeholder"
          value="{{reflection}}"
          placeholder="例如：我先停了一下，说话比刚才慢了一点。"
          bindinput="onReflectionInput"
        />
        <text class="p3-field__hint">仅保留在本页，打卡页需要另行填写</text>
      </view>
      <view class="task-intensity">
        <text class="task-intensity__label">当前情绪强度 {{emotionLevel}} / 10</text>
        <p3-intensity-slider min="0" max="10" value="{{emotionLevel}}" aria-label="调整当前情绪强度" bind:change="onEmotionLevelChange" />
      </view>
    </block>
    <view wx:else class="task-consent">
      <text class="p3-field__label">今日感受</text>
      <button class="p3-btn p3-btn--secondary" bindtap="beginReflection">阅读知情说明后记录感受</button>
      <text class="p3-field__hint">感受仅保留在本页，打卡页需要另行填写</text>
    </view>
    <page-state wx:if="{{serviceEntryError}}" kind="error" title="{{serviceEntryError}}" action-label="返回首页阅读隐私说明" bind:action="returnToPrivacyHome" />
  </view>

  <view class="task-section">
    <view wx:if="{{task.stopText}}" class="p3-notice p3-notice--warm">
      <text class="p3-notice__title">何时暂停</text>
      <text class="p3-notice__body">{{task.stopText}}</text>
    </view>
  </view>

  <view class="task-actions">
    <button class="p3-btn p3-btn--primary" bindtap="finishPractice">去填写打卡</button>
    <view class="task-actions__row">
      <button class="p3-btn p3-btn--quiet task-actions__quiet" bindtap="startPractice">练习提示</button>
      <button class="p3-btn p3-btn--quiet task-actions__quiet" bindtap="recordFeeling">查看填写状态</button>
    </view>
  </view>
</view>
<service-consent notice="{{serviceConsent}}" bind:decision="onServiceConsent" />
