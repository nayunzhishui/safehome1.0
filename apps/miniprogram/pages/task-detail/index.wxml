<view class="safe-page task-detail-page" wx:if="{{task}}">
  <view class="detail-nav">
    <button class="back-button" bindtap="goBack">‹</button>
    <text class="nav-title">训练卡详情</text>
  </view>

  <view class="overview-card safe-card safe-card--hero">
    <text class="task-tag">UP 任务卡</text>
    <text class="task-title">{{task.title}}</text>
    <text class="task-subtitle">{{task.subtitle}}</text>
    <view class="overview-grid">
      <view class="overview-item">
        <text class="overview-label">适用情境</text>
        <text class="overview-value">{{task.scenario}}</text>
      </view>
      <view class="overview-item">
        <text class="overview-label">预计用时</text>
        <text class="overview-value">{{task.duration}}</text>
      </view>
      <view class="overview-item overview-item--full">
        <text class="overview-label">今天的小目标</text>
        <text class="overview-value">{{task.goal}}</text>
      </view>
    </view>
  </view>

  <view class="today-card">
    <text class="today-title">今天先练这一小步</text>
    <text class="today-text">先按下面 3 个小动作走一遍。做不到完整也没关系，能停一下就算开始了。</text>
  </view>

  <view class="safe-section">
    <section-title title="三步练习" subtitle="按顺序完成三个小动作" />
    <view class="step-list">
      <view wx:for="{{task.steps}}" wx:key="*this" class="step-card">
        <text class="step-index">{{index + 1}}</text>
        <text class="step-text">{{item}}</text>
      </view>
    </view>
  </view>

  <view class="safe-section">
    <section-title title="示例话术" subtitle="可以照着说，也可以换成自己的表达" />
    <view class="script-list">
      <view wx:for="{{task.scripts}}" wx:key="*this" class="script-card">
        <text>“{{item}}”</text>
      </view>
    </view>
  </view>

  <view class="safe-section">
    <section-title title="练习后记录" subtitle="简单记录今天的感受即可" />
    <view class="record-card">
      <text class="field-label">今日感受</text>
      <textarea class="reflection-input" value="{{reflection}}" placeholder="例如：我先停了一下，说话比刚才慢了一点。" bindinput="onReflectionInput" />
      <text class="field-label">当前情绪强度：{{emotionLevel}} / 10</text>
      <slider min="0" max="10" step="1" value="{{emotionLevel}}" activeColor="#578B5F" block-color="#578B5F" bindchange="onEmotionLevelChange" />
    </view>
  </view>

  <view class="safe-section">
    <alert-card type="info" title="练习说明" content="这里提供的是陪伴练习和自我观察建议，不替代专业咨询或紧急帮助。" />
  </view>

  <view class="action-bar">
    <button class="safe-primary-button action-button" bindtap="finishPractice">完成并打卡</button>
    <view class="secondary-actions">
      <button class="soft-action-button" bindtap="startPractice">从第一步开始</button>
      <button class="soft-action-button" bindtap="recordFeeling">暂存感受</button>
    </view>
  </view>

  <view class="safe-section">
    <bottom-tip-card text="一次小练习，也是在给关系留一点空间。" />
  </view>
</view>
