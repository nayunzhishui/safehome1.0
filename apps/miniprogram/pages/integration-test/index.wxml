<view class="page" role="main" aria-label="接口联调测试">
  <view class="panel">
    <text class="title">最小联调测试</text>

    <view class="diagnostics">
      <text class="diagnostic-line">env：{{diagnostics.env}}</text>
      <text class="diagnostic-line">service：{{diagnostics.service}}</text>
      <text class="diagnostic-line">healthz：{{diagnostics.path}}</text>
    </view>

    <button class="primary-button" bindtap="runSmokeTest" disabled="{{status === 'running'}}">
      {{status === 'running' ? '联调中...' : '运行联调测试'}}
    </button>

    <view class="status {{status}}">
      <text>{{message}}</text>
    </view>

    <view wx:if="{{diary}}" class="result-block">
      <text class="block-title">情绪事件记录</text>
      <text>{{diary.event_description}}</text>
    </view>

    <view wx:if="{{feedback}}" class="result-block">
      <text class="block-title">即时反馈</text>
      <text>{{feedback.supportive_feedback}}</text>
      <text class="muted">标签：{{feedback.labels}}</text>
    </view>

    <view wx:if="{{cards.length}}" class="result-block">
      <text class="block-title">推荐训练卡</text>
      <block wx:for="{{cards}}" wx:key="id">
        <text class="list-item">{{item.title}}</text>
      </block>
    </view>
  </view>
</view>
