.page {
  min-height: 100vh;
  padding: 32rpx;
}

.panel {
  padding: 32rpx;
  border: 1rpx solid #dce6db;
  border-radius: 8rpx;
  background: #ffffff;
}

.eyebrow {
  display: block;
  margin-bottom: 12rpx;
  color: #3c7a49;
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  display: block;
  margin-bottom: 14rpx;
  color: #1d2b22;
  font-size: 38rpx;
  font-weight: 700;
}

.summary,
.muted {
  display: block;
  color: #5b6b60;
  font-size: 28rpx;
  line-height: 1.6;
}

.primary-button {
  margin: 28rpx 0;
  background: #2f7d45;
  color: #ffffff;
  border-radius: 8rpx;
}

.status {
  margin-bottom: 24rpx;
  padding: 20rpx;
  border: 1rpx solid #dce6db;
  border-radius: 8rpx;
  background: #eef3ed;
  color: #1d2b22;
}

.status.success {
  background: #edf8ee;
  border-color: #b8dfbe;
}

.status.error {
  background: #fff1f1;
  border-color: #efb4b4;
}

.result-block {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #e6eee5;
}

.block-title {
  display: block;
  margin-bottom: 10rpx;
  color: #1d2b22;
  font-size: 30rpx;
  font-weight: 700;
}

.list-item {
  display: block;
  margin-top: 8rpx;
  color: #1d2b22;
  font-size: 28rpx;
}
