.page {
  min-height: 100vh;
  padding: 32rpx;
}

.panel {
  padding: 32rpx;
  border: 1rpx solid #dce6db;
  border-radius: 24rpx;
  background: #ffffff;
}

.eyebrow {
  display: block;
  margin-bottom: 12rpx;
  color: #3c7a49;
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  display: block;
  margin-bottom: 14rpx;
  color: #1d2b22;
  font-size: 46rpx;
  font-weight: 700;
  text-align: center;
}

.summary,
.muted {
  display: block;
  color: #5b6b60;
  font-size: 28rpx;
  line-height: 1.6;
}

.primary-button {
  margin: 28rpx 0;
  background: #2f7d45;
  color: #ffffff;
  border-radius: 999rpx;
}

.diagnostics {
  margin-top: 24rpx;
  padding: 18rpx;
  border: 1rpx solid #e1eadf;
  border-radius: 18rpx;
  background: #f7faf6;
}

.diagnostic-line {
  display: block;
  color: #5b6b60;
  font-size: 24rpx;
  line-height: 1.6;
  word-break: break-all;
}

.status {
  margin-bottom: 24rpx;
  padding: 20rpx;
  border: 1rpx solid #dce6db;
  border-radius: 8rpx;
  background: #eef3ed;
  color: #1d2b22;
}

.status.success {
  background: #edf8ee;
  border-color: #b8dfbe;
}

.status.error {
  background: #fff1f1;
  border-color: #efb4b4;
}

.result-block {
  position: relative;
  margin-top: 24rpx;
  padding: 24rpx;
  border: 1rpx solid #e1eadf;
  border-radius: 18rpx;
  background: #ffffff;
}

.result-block::before {
  content: "";
  display: block;
  width: 42rpx;
  height: 6rpx;
  margin-bottom: 14rpx;
  border-radius: 999rpx;
  background: #2f7d45;
}

.block-title {
  display: block;
  margin-bottom: 10rpx;
  color: #1d2b22;
  font-size: 30rpx;
  font-weight: 700;
}

.list-item {
  display: block;
  margin-top: 8rpx;
  color: #1d2b22;
  font-size: 28rpx;
}
