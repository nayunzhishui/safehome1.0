.page {
  min-height: 100vh;
  padding: 32rpx;
}

.panel {
  padding: 32rpx;
  border: 1rpx solid #dce6db;
  border-radius: 24rpx;
  background: #ffffff;
}

.eyebrow {
  display: block;
  margin-bottom: 12rpx;
  color: #3c7a49;
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  display: block;
  margin-bottom: 14rpx;
  color: #1d2b22;
  font-size: 46rpx;
  font-weight: 700;
  text-align: center;
}

.summary,
.muted {
  display: block;
  color: #5b6b60;
  font-size: 28rpx;
  line-height: 1.6;
}

.primary-button {
  margin: 28rpx 0;
  background: #2f7d45;
  color: #ffffff;
  border-radius: 999rpx;
}

.diagnostics {
  margin-top: 24rpx;
  padding: 18rpx;
  border: 1rpx solid #e1eadf;
  border-radius: 18rpx;
  background: #f7faf6;
}

.diagnostic-line {
  display: block;
  color: #5b6b60;
  font-size: 24rpx;
  line-height: 1.6;
  word-break: break-all;
}

.status {
  margin-bottom: 24rpx;
  padding: 20rpx;
  border: 1rpx solid #dce6db;
  border-radius: 8rpx;
  background: #eef3ed;
  color: #1d2b22;
}

.status.success {
  background: #edf8ee;
  border-color: #b8dfbe;
}

.status.error {
  background: #fff1f1;
  border-color: #efb4b4;
}

.result-block {
  position: relative;
  margin-top: 24rpx;
  padding: 24rpx;
  border: 1rpx solid #e1eadf;
  border-radius: 18rpx;
  background: #ffffff;
}

.result-block::before {
  content: "";
  display: block;
  width: 42rpx;
  height: 6rpx;
  margin-bottom: 14rpx;
  border-radius: 999rpx;
  background: #2f7d45;
}

.block-title {
  display: block;
  margin-bottom: 10rpx;
  color: #1d2b22;
  font-size: 30rpx;
  font-weight: 700;
}

.list-item {
  display: block;
  margin-top: 8rpx;
  color: #1d2b22;
  font-size: 28rpx;
}

/* UIproduct2: task-scoped visual refinement, no business behavior. */
.ui2-page { --ui2-section-accent-display:none; --safe-shadow-card:none; --safe-shadow-float:none; box-sizing:border-box; background:var(--ui2-canvas); padding:48rpx 40rpx calc(64rpx + env(safe-area-inset-bottom)); }
.ui2-page .page-title,.ui2-page .hero-title,.ui2-page .history-title,.ui2-page .result-title { font-size:44rpx; line-height:1.6; font-weight:700; text-align:center; color:var(--ui2-ink); }
.ui2-page .safe-primary-button,.ui2-page .safe-outline-button { min-height:96rpx; padding:22rpx 24rpx; border-radius:24rpx; font-size:30rpx; line-height:1.6; box-shadow:none; }
.ui2-page .ui2-placeholder { color:var(--ui2-muted); }
.ui2-page.page { min-height:100vh; }
.ui2-page .panel { padding:0; border:0; border-radius:0; background:transparent; }
.ui2-page .title { font-size:44rpx; font-weight:700; line-height:1.6; color:var(--ui2-ink); }
.ui2-page .dev-notice { display:block; margin:24rpx 0; padding:24rpx; background:var(--ui2-warm); border-radius:24rpx; color:#765323; font-size:28rpx; line-height:1.7; }
.ui2-page .section,.ui2-page .diagnostics,.ui2-page .result-block { padding:24rpx 0; border:0; border-top:1rpx solid var(--ui2-line); border-radius:0; background:transparent; }
.ui2-page .result-block::before { display:none; }
.ui2-page .section-title,.ui2-page .block-title { font-size:32rpx; line-height:1.6; color:var(--ui2-ink); }
.ui2-page .line,.ui2-page .pre,.ui2-page .diagnostic-line { font-size:26rpx; line-height:1.7; color:var(--ui2-muted); white-space:pre-wrap; word-break:break-all; }
.ui2-page .primary-button,.ui2-page .secondary-button { width:100%; min-height:96rpx; padding:22rpx 24rpx; border-radius:24rpx; font-size:30rpx; line-height:1.6; }
.ui2-page .primary-button { background:var(--ui2-primary); color:white; }
.ui2-page .secondary-button { background:transparent; border:2rpx solid var(--ui2-control-border); color:var(--ui2-primary); }
.ui2-page button[disabled] { background:var(--ui2-soft); color:var(--ui2-muted); }
.ui2-page .status { border:1rpx solid var(--ui2-line); background:var(--ui2-soft); font-size:28rpx; line-height:1.7; word-break:break-word; }
.ui2-page .status.error,.ui2-page .error-card { background:#fff4f1; color:#a5453f; border-color:#a5453f; }

.ui2-page .line,.ui2-page .pre,.ui2-page .diagnostic-line { font-size:28rpx; }
