.page {
  min-height: 100vh;
  padding: 32rpx;
  background: #f6f8f4;
}

.hero {
  padding: 24rpx 4rpx 34rpx;
  text-align: center;
}

.title {
  display: block;
  color: #1d2b22;
  font-size: 46rpx;
  font-weight: 900;
}

.panel {
  padding: 0;
  background: transparent;
}

.step-card {
  position: relative;
  margin-bottom: 28rpx;
  padding: 28rpx;
  border: 1rpx solid #dce6db;
  border-radius: 16rpx;
  background: #ffffff;
}

.step-card:last-of-type {
  border-bottom: 1rpx solid #dce6db;
}

.step-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 12rpx;
}

.step-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  width: auto;
  height: auto;
  border-radius: 0;
  background: transparent;
  color: #2f7d45;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
  line-height: 1.3;
}

.step-card::before {
  content: "";
  display: block;
  width: 52rpx;
  height: 8rpx;
  margin-bottom: 16rpx;
  border-radius: 999rpx;
  background: #2f7d45;
}

.step-title {
  color: #1d2b22;
  font-size: 30rpx;
  font-weight: 700;
}

.tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 18rpx;
}

.tag {
  margin: 0;
  padding: 0 22rpx;
  min-height: 64rpx;
  border: 1rpx solid #c9d9c8;
  border-radius: 8rpx;
  background: #f9fbf8;
  color: #2f4a38;
  font-size: 26rpx;
  line-height: 64rpx;
}

.tag.active {
  border-color: #2f7d45;
  background: #edf8ee;
  color: #2f7d45;
  font-weight: 700;
}

.input,
.textarea {
  box-sizing: border-box;
  width: 100%;
  margin-top: 18rpx;
  padding: 20rpx;
  border: 1rpx solid #dce6db;
  border-radius: 8rpx;
  background: #f9fbf8;
  color: #1d2b22;
  font-size: 28rpx;
  line-height: 1.6;
}

.input {
  min-height: 80rpx;
}

.textarea {
  min-height: 170rpx;
}

.error-box {
  margin-bottom: 24rpx;
  padding: 20rpx;
  border: 1rpx solid #efb4b4;
  border-radius: 8rpx;
  background: #fff1f1;
  color: #8a2f2f;
  font-size: 26rpx;
  line-height: 1.6;
}

.primary-button {
  margin-top: 8rpx;
  background: #2f7d45;
  color: #ffffff;
  border-radius: 8rpx;
}

.draft-status {
  display: block;
  margin: 0 0 14rpx;
  color: #5b6b60;
  font-size: 24rpx;
  line-height: 1.55;
}

.draft-status--slow {
  color: #8a5a2f;
}
