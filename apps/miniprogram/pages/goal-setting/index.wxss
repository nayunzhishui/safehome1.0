.page {
  min-height: 100vh;
  padding: 32rpx;
  background: #f6f8f4;
}

.hero {
  padding: 24rpx 4rpx 34rpx;
  text-align: center;
}

.title {
  display: block;
  color: #1d2b22;
  font-size: 46rpx;
  font-weight: 900;
}

.panel {
  padding: 0;
  background: transparent;
}

.step-card {
  position: relative;
  margin-bottom: 28rpx;
  padding: 28rpx;
  border: 1rpx solid #dce6db;
  border-radius: 16rpx;
  background: #ffffff;
}

.step-card:last-of-type {
  border-bottom: 1rpx solid #dce6db;
}

.step-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 12rpx;
}

.step-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  width: auto;
  height: auto;
  border-radius: 0;
  background: transparent;
  color: #2f7d45;
  font-size: 24rpx;
  font-weight: 700;
  text-align: center;
  line-height: 1.3;
}

.step-card::before {
  content: "";
  display: block;
  width: 52rpx;
  height: 8rpx;
  margin-bottom: 16rpx;
  border-radius: 999rpx;
  background: #2f7d45;
}

.step-title {
  color: #1d2b22;
  font-size: 30rpx;
  font-weight: 700;
}

.tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 18rpx;
}

.tag {
  margin: 0;
  padding: 0 22rpx;
  min-height: 64rpx;
  border: 1rpx solid #c9d9c8;
  border-radius: 8rpx;
  background: #f9fbf8;
  color: #2f4a38;
  font-size: 26rpx;
  line-height: 64rpx;
}

.tag.active {
  border-color: #2f7d45;
  background: #edf8ee;
  color: #2f7d45;
  font-weight: 700;
}

.input,
.textarea {
  box-sizing: border-box;
  width: 100%;
  margin-top: 18rpx;
  padding: 20rpx;
  border: 1rpx solid #dce6db;
  border-radius: 8rpx;
  background: #f9fbf8;
  color: #1d2b22;
  font-size: 28rpx;
  line-height: 1.6;
}

.input {
  min-height: 80rpx;
}

.textarea {
  min-height: 170rpx;
}

.error-box {
  margin-bottom: 24rpx;
  padding: 20rpx;
  border: 1rpx solid #efb4b4;
  border-radius: 8rpx;
  background: #fff1f1;
  color: #8a2f2f;
  font-size: 26rpx;
  line-height: 1.6;
}

.primary-button {
  margin-top: 8rpx;
  background: #2f7d45;
  color: #ffffff;
  border-radius: 8rpx;
}

.draft-status {
  display: block;
  margin: 0 0 14rpx;
  color: #5b6b60;
  font-size: 24rpx;
  line-height: 1.55;
}

.draft-status--slow {
  color: #8a5a2f;
}
.ui2-page.page { box-sizing:border-box; background:var(--ui2-canvas); padding:48rpx 40rpx calc(64rpx + env(safe-area-inset-bottom)); }
.ui2-page .hero { padding:0 0 40rpx; text-align:center; }
.ui2-page .title { font-size:44rpx; font-weight:700; line-height:1.6; color:var(--ui2-ink); }
.ui2-page .panel { display:flex; flex-direction:column; gap:0; }
.ui2-page .step-card { margin:0 0 40rpx; padding:32rpx 0 40rpx; border:0; border-bottom:1rpx solid var(--ui2-line); border-radius:0; background:transparent; }
.ui2-page .step-card::before { display:none; }
.ui2-page .step-head { gap:24rpx; align-items:baseline; }
.ui2-page .step-icon { display:block; flex:0 0 48rpx; color:var(--ui2-primary); font-size:26rpx; }
.ui2-page .step-title { font-size:32rpx; line-height:1.6; color:var(--ui2-ink); }
.ui2-page .tag-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16rpx; }
.ui2-page .tag { box-sizing:border-box; width:100%; min-width:0; min-height:96rpx; padding:20rpx 24rpx; border:2rpx solid var(--ui2-control-border); border-radius:24rpx; background:transparent; color:var(--ui2-ink); font-size:30rpx; line-height:1.6; text-align:left; transition:background-color 160ms ease-out,border-color 160ms ease-out; }
.ui2-page .tag::after { border:0; }
.ui2-page .tag.active { background:var(--ui2-soft); border-color:var(--ui2-primary); color:var(--ui2-primary); }
.ui2-page .tag.active::before { content:''; display:inline-block; width:10rpx; height:18rpx; margin-right:12rpx; border:solid currentColor; border-width:0 3rpx 3rpx 0; transform:rotate(45deg); vertical-align:3rpx; }
.ui2-page .field-label { display:block; margin-top:24rpx; color:var(--ui2-ink); font-size:28rpx; line-height:1.6; }
.ui2-page .input,.ui2-page .textarea { min-height:96rpx; border:2rpx solid var(--ui2-control-border); border-radius:24rpx; background:var(--ui2-surface); color:var(--ui2-ink); font-size:30rpx; line-height:1.6; }
.ui2-page .input { height:104rpx; margin-top:12rpx; }
.ui2-page .textarea { min-height:280rpx; }
.ui2-page .ui2-placeholder { color:var(--ui2-muted); }
.ui2-page .primary-button { width:100%; min-height:96rpx; padding:22rpx 24rpx; border-radius:24rpx; background:var(--ui2-primary); color:var(--ui2-surface); font-size:30rpx; line-height:1.6; }
.ui2-page .primary-button[disabled] { background:var(--ui2-soft); color:var(--ui2-muted); }
.ui2-page .error-box { font-size:30rpx; }
.ui2-page .draft-status { color:var(--ui2-muted); font-size:26rpx; }
.ui2-page .draft-status--slow { color:#765323; font-size:28rpx; }
@media (prefers-reduced-motion: reduce) { .ui2-page .tag { transition:none; } }

.ui2-page { --ui2-section-accent-display:none; }
