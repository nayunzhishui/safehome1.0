<view wx:if="{{!serviceReady}}" class="goal-page" role="main" aria-label="功能知情说明">
  <page-state kind="error" title="使用前请阅读本功能说明" description="{{errorMessage || '确认数据用途后，再填写和保存；暂不同意可以返回。'}}" action-label="重新确认" bind:action="retryServiceEntry" />
  <button class="p3-btn p3-btn--primary" bindtap="returnToPrivacyHome">返回首页阅读隐私说明</button>
</view>
<block wx:if="{{serviceReady}}">
<view class="goal-page" role="main" aria-label="目标设定">
  <text class="goal-intro">一周只练一个小改变，越具体越容易做到。</text>

  <view class="goal-step">
    <view class="goal-step__head">
      <view class="goal-step__joint" aria-hidden="true"></view>
      <text class="goal-step__number" aria-hidden="true">01</text>
      <text class="goal-step__title" role="heading" aria-level="2">高频亲子冲突场景</text>
    </view>
    <view class="goal-chips" role="radiogroup" aria-label="高频亲子冲突场景">
      <button
        wx:for="{{sceneOptions}}"
        wx:key="*this"
        class="p3-chip {{selectedScene === item ? 'p3-chip--selected' : ''}}"
        data-value="{{item}}"
        bindtap="selectScene"
        aria-pressed="{{selectedScene === item}}"
      >{{item}}</button>
    </view>
    <view class="p3-field">
      <label for="custom-scene" class="p3-field__label">其他场景（可不填，填写后优先使用）</label>
      <input id="custom-scene" class="p3-field__input" aria-label="其他场景" placeholder-class="p3-field__placeholder" value="{{customScene}}" placeholder="其他场景，可不填" bindinput="onTextInput" data-key="customScene" />
    </view>
  </view>

  <view class="goal-step">
    <view class="goal-step__head">
      <view class="goal-step__joint" aria-hidden="true"></view>
      <text class="goal-step__number" aria-hidden="true">02</text>
      <text class="goal-step__title" role="heading" aria-level="2">希望减少的旧反应</text>
    </view>
    <view class="goal-chips" role="radiogroup" aria-label="希望减少的旧反应">
      <button
        wx:for="{{oldReactionOptions}}"
        wx:key="*this"
        class="p3-chip {{oldReaction === item ? 'p3-chip--selected' : ''}}"
        data-value="{{item}}"
        bindtap="selectOldReaction"
        aria-pressed="{{oldReaction === item}}"
      >{{item}}</button>
    </view>
  </view>

  <view class="goal-step">
    <view class="goal-step__head">
      <view class="goal-step__joint" aria-hidden="true"></view>
      <text class="goal-step__number" aria-hidden="true">03</text>
      <text class="goal-step__title" role="heading" aria-level="2">希望练习的新反应</text>
    </view>
    <view class="goal-chips" role="radiogroup" aria-label="希望练习的新反应">
      <button
        wx:for="{{newReactionOptions}}"
        wx:key="*this"
        class="p3-chip {{newReaction === item ? 'p3-chip--selected' : ''}}"
        data-value="{{item}}"
        bindtap="selectNewReaction"
        aria-pressed="{{newReaction === item}}"
      >{{item}}</button>
    </view>
  </view>

  <view class="goal-step">
    <view class="goal-step__head">
      <view class="goal-step__joint" aria-hidden="true"></view>
      <text class="goal-step__number" aria-hidden="true">04</text>
      <text class="goal-step__title" role="heading" aria-level="2">本周 SMART 小目标</text>
    </view>
    <view class="p3-field">
      <text class="p3-field__label">用一句话写下这周的目标</text>
      <textarea
        class="p3-field__input p3-field__input--multi"
        aria-label="本周SMART小目标"
        placeholder-class="p3-field__placeholder"
        value="{{smartGoal}}"
        placeholder="例如：这周遇到作业拖延时，我先停三秒，再用一句话说明期待，至少练习 3 次。"
        bindinput="onTextInput"
        data-key="smartGoal"
      />
      <text class="p3-field__hint">具体场景 · 一个做法 · 次数</text>
    </view>
  </view>

  <view class="goal-save">
    <text wx:if="{{errorMessage}}" class="p3-form-message p3-form-message--error" role="alert">{{errorMessage}}</text>
    <text class="goal-save__status" aria-live="polite">{{draftRestored ? '已恢复：' : ''}}{{saveStatus}}</text>
    <text wx:if="{{slowSubmitting}}" class="p3-form-message">网络响应较慢；草稿仍在本机，请不要重复点击。</text>
    <button class="p3-btn p3-btn--primary" bindtap="submitGoal" disabled="{{submitting}}">{{submitting ? '保存中...' : '保存目标并开始记录'}}</button>
  </view>
</view>
</block>
