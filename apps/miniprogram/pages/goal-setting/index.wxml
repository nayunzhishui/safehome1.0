<view class="page" role="main" aria-label="目标设定">
  <view class="hero">
    <text class="title">本周小目标</text>
  </view>

  <view class="panel">
    <view class="step-card">
      <view class="step-head">
        <text class="step-icon">01</text>
        <text class="step-title">高频亲子冲突场景</text>
      </view>
      <view class="tag-grid">
        <button
          wx:for="{{sceneOptions}}"
          wx:key="*this"
          class="tag {{selectedScene === item ? 'active' : ''}}"
          data-value="{{item}}"
          bindtap="selectScene"
        >
          {{item}}
        </button>
      </view>
      <input class="input" value="{{customScene}}" placeholder="其他场景，可不填" bindinput="onTextInput" data-key="customScene" />
    </view>

    <view class="step-card">
      <view class="step-head">
        <text class="step-icon">02</text>
        <text class="step-title">希望减少的旧反应</text>
      </view>
      <view class="tag-grid">
        <button
          wx:for="{{oldReactionOptions}}"
          wx:key="*this"
          class="tag {{oldReaction === item ? 'active' : ''}}"
          data-value="{{item}}"
          bindtap="selectOldReaction"
        >
          {{item}}
        </button>
      </view>
    </view>

    <view class="step-card">
      <view class="step-head">
        <text class="step-icon">03</text>
        <text class="step-title">希望练习的新反应</text>
      </view>
      <view class="tag-grid">
        <button
          wx:for="{{newReactionOptions}}"
          wx:key="*this"
          class="tag {{newReaction === item ? 'active' : ''}}"
          data-value="{{item}}"
          bindtap="selectNewReaction"
        >
          {{item}}
        </button>
      </view>
    </view>

    <view class="step-card">
      <view class="step-head">
        <text class="step-icon">04</text>
        <text class="step-title">本周 SMART 小目标</text>
      </view>
      <textarea
        class="textarea"
        value="{{smartGoal}}"
        placeholder="例如：这周遇到作业拖延时，我先停三秒，再用一句话说明期待，至少练习 3 次。"
        bindinput="onTextInput"
        data-key="smartGoal"
      />
    </view>

    <view wx:if="{{errorMessage}}" class="error-box">
      <text>{{errorMessage}}</text>
    </view>

    <text class="draft-status" aria-live="polite">{{draftRestored ? '已恢复：' : ''}}{{saveStatus}}</text>
    <text wx:if="{{slowSubmitting}}" class="draft-status draft-status--slow">网络响应较慢；草稿仍在本机，请不要重复点击。</text>

    <button class="primary-button" bindtap="submitGoal" disabled="{{submitting}}">
      {{submitting ? '保存中...' : '保存目标并开始记录'}}
    </button>
  </view>
</view>
