.page {
  min-height: 100vh;
  padding: 32rpx;
  background: #f6f8f4;
}

.hero {
  padding: 20rpx 4rpx 28rpx;
}

.eyebrow,
.card-type {
  display: block;
  margin-bottom: 10rpx;
  color: #3c7a49;
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  display: block;
  margin-bottom: 14rpx;
  color: #1d2b22;
  font-size: 40rpx;
  font-weight: 700;
}

.summary,
.body-text {
  display: block;
  color: #5b6b60;
  font-size: 28rpx;
  line-height: 1.7;
}

.panel,
.status,
.card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  border: 1rpx solid #dce6db;
  border-radius: 8rpx;
  background: #ffffff;
}

.status.success {
  border-color: #b8dfbe;
  background: #edf8ee;
  color: #1d2b22;
}

.status.error {
  border-color: #efb4b4;
  background: #fff1f1;
  color: #8a2f2f;
}

.card-title {
  display: block;
  margin-bottom: 14rpx;
  color: #1d2b22;
  font-size: 34rpx;
  font-weight: 700;
}

.result-block {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #e6eee5;
}

.block-title {
  display: block;
  margin-bottom: 12rpx;
  color: #1d2b22;
  font-size: 30rpx;
  font-weight: 700;
}

.list-item {
  display: block;
  margin-bottom: 10rpx;
  color: #5b6b60;
  font-size: 28rpx;
  line-height: 1.6;
}

.primary-button {
  margin-top: 28rpx;
  background: #2f7d45;
  color: #ffffff;
  border-radius: 8rpx;
}
