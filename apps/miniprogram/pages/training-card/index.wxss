.training-card-page {
  padding-bottom: calc(52rpx + env(safe-area-inset-bottom));
}

.detail-hero {
  position: relative;
  min-height: 252rpx;
  overflow: hidden;
}

.hero-copy {
  max-width: 480rpx;
}

.hero-title,
.hero-summary,
.hero-mark-main,
.hero-mark-sub,
.card-type,
.card-title,
.body-text,
.state-title,
.state-text,
.match-label,
.match-text,
.today-label,
.today-text,
.tip-title,
.tip-text,
.list-note {
  display: block;
}

.hero-title {
  color: var(--safe-title);
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.28;
  letter-spacing: 0;
}

.hero-summary,
.body-text {
  margin-top: 14rpx;
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.7;
}

.hero-mark {
  position: absolute;
  right: 30rpx;
  bottom: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 132rpx;
  border: 1rpx solid rgba(87, 139, 95, 0.2);
  border-radius: 50%;
  background: rgba(255, 253, 248, 0.86);
}

.hero-mark-main {
  color: var(--safe-primary-deep);
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1;
}

.hero-mark-sub {
  margin-top: 8rpx;
  color: var(--safe-muted);
  font-size: 22rpx;
}

.card-content {
  display: flex;
  flex-direction: column;
}

.state-card,
.match-card,
.task-card {
  margin-top: 28rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: 24rpx;
  background: var(--safe-card);
  box-shadow: 0 10rpx 24rpx rgba(52, 66, 58, 0.06);
}

.state-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 30rpx;
}

.loading-dot {
  width: 34rpx;
  height: 34rpx;
  margin-bottom: 18rpx;
  border: 6rpx solid var(--safe-primary-soft);
  border-top-color: var(--safe-primary);
  border-radius: 50%;
}

.state-title {
  color: var(--safe-title);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.45;
}

.state-text {
  margin-top: 10rpx;
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.65;
}

.error-card {
  border-color: rgba(215, 111, 103, 0.3);
  background: rgba(255, 244, 240, 0.94);
  box-shadow: none;
}

.outline-button {
  min-height: 72rpx;
  margin-top: 24rpx;
  padding: 0 30rpx;
  border: 1rpx solid var(--safe-orange);
  border-radius: var(--safe-radius-pill);
  background: var(--safe-card);
  color: var(--safe-orange);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 72rpx;
}

.outline-button::after {
  border: 0;
}

.match-card {
  padding: 24rpx 28rpx;
  background: var(--safe-primary-pale);
}

.match-label {
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 800;
}

.match-text {
  margin-top: 8rpx;
  color: var(--safe-text);
  font-size: 25rpx;
  line-height: 1.6;
}

.list-note {
  margin-top: 22rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid rgba(87, 139, 95, 0.16);
  border-radius: 20rpx;
  background: rgba(233, 242, 223, 0.52);
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  line-height: 1.58;
}

.task-card {
  overflow: hidden;
}

.task-head {
  display: flex;
  gap: 20rpx;
  padding: 28rpx 28rpx 22rpx;
  background: rgba(255, 253, 248, 0.96);
}

.task-number {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 46rpx;
  flex: 0 0 64rpx;
  border-radius: var(--safe-radius-pill);
  background: var(--safe-primary-soft);
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 46rpx;
}

.task-title-wrap {
  min-width: 0;
  flex: 1;
}

.task-title-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.card-type {
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 800;
}

.duration-pill,
.tag-pill {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 18rpx;
  border-radius: var(--safe-radius-pill);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.35;
}

.duration-pill {
  flex: 0 0 auto;
  background: var(--safe-orange-soft);
  color: var(--safe-orange);
}

.card-title {
  color: var(--safe-title);
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.35;
}

.today-step,
.tip-box {
  margin: 0 28rpx 22rpx;
  padding: 24rpx;
  border-radius: 22rpx;
}

.today-step {
  border: 1rpx solid rgba(244, 127, 69, 0.2);
  background: var(--safe-orange-soft);
}

.today-label {
  color: var(--safe-orange);
  font-size: 24rpx;
  font-weight: 900;
}

.today-text {
  margin-top: 8rpx;
  color: var(--safe-title);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.65;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  padding: 0 28rpx 22rpx;
}

.tag-pill {
  background: var(--safe-blue-soft);
  color: var(--safe-info);
}

.tip-box {
  border: 1rpx solid rgba(87, 139, 95, 0.18);
  background: var(--safe-primary-pale);
}

.tip-title {
  color: var(--safe-primary-deep);
  font-size: 27rpx;
  font-weight: 900;
}

.tip-text {
  margin-top: 8rpx;
  color: var(--safe-text);
  font-size: 25rpx;
  line-height: 1.65;
}

.primary-button {
  min-height: 88rpx;
  margin: 4rpx 28rpx 28rpx;
  border-radius: var(--safe-radius-pill);
  background: var(--safe-primary);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 88rpx;
  box-shadow: 0 8rpx 18rpx rgba(87, 139, 95, 0.18);
}

.primary-button::after {
  border: 0;
}
