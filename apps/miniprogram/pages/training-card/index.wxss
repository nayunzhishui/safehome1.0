.page {
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: #fff7ec;
}

.hero {
  margin-bottom: 28rpx;
  padding: 32rpx;
  border: 1rpx solid #efe7dc;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f7faf4 100%);
  box-shadow: 0 12rpx 32rpx rgba(80, 64, 45, 0.08);
}

.eyebrow,
.card-type {
  display: block;
  margin-bottom: 10rpx;
  color: #4caf7d;
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  display: block;
  margin-bottom: 14rpx;
  color: #333333;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.32;
}

.summary,
.body-text {
  display: block;
  color: #555555;
  font-size: 28rpx;
  line-height: 1.7;
}

.panel,
.status,
.card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  border: 1rpx solid #efe7dc;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(80, 64, 45, 0.08);
}

.status.success {
  border-color: #b8dfbe;
  background: #edf8ee;
  color: #1d2b22;
  box-shadow: none;
}

.status.error {
  border-color: #efb4b4;
  background: #fff1f1;
  color: #8a2f2f;
  box-shadow: none;
}

.card-title {
  display: block;
  margin-bottom: 14rpx;
  color: #333333;
  font-size: 34rpx;
  font-weight: 700;
}

.meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 20rpx;
}

.meta-pill {
  display: inline-block;
  padding: 8rpx 16rpx;
  border: 1rpx solid #dbeed6;
  border-radius: 999rpx;
  background: #eef8e9;
  color: #4caf7d;
  font-size: 24rpx;
  line-height: 1.4;
}

.tip-box {
  margin-top: 24rpx;
  padding: 22rpx;
  border: 1rpx solid #efe7dc;
  border-radius: 20rpx;
  background: #fffdf9;
}

.tip-title {
  display: block;
  margin-bottom: 8rpx;
  color: #4caf7d;
  font-size: 28rpx;
  font-weight: 700;
}

.tip-text {
  display: block;
  color: #555555;
  font-size: 26rpx;
  line-height: 1.7;
}

.result-block {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #efe7dc;
}

.block-title {
  display: block;
  margin-bottom: 12rpx;
  color: #333333;
  font-size: 30rpx;
  font-weight: 700;
}

.list-item {
  display: block;
  margin-bottom: 10rpx;
  color: #555555;
  font-size: 28rpx;
  line-height: 1.6;
}

.primary-button {
  min-height: 88rpx;
  margin-top: 28rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #7ccb8a, #4caf7d);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 26rpx rgba(76, 175, 125, 0.22);
}
