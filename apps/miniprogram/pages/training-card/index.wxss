/* 训练卡（Figma 652:1612）：推荐依据浅底条 → 唯一优先卡（唯一实心按钮）→ 也可以改练。 */
.training-card-page {
  display: flex;
  flex-direction: column;
  gap: var(--p3-section);
  padding-top: 16rpx;
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
}

.card-basis,
.card-goal {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 28rpx 32rpx;
  border-radius: var(--p3-radius-group);
  background: var(--p3-soft);
}

.card-basis__label,
.card-goal__label {
  color: var(--p3-primary);
  font-size: 26rpx;
  line-height: 40rpx;
}

.card-basis__text {
  color: var(--p3-ink);
  font-size: 28rpx;
  line-height: 44rpx;
}

.card-goal__text {
  color: var(--p3-ink);
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: 500;
}

.card-main {
  gap: var(--p3-stack);
}

.card-main__head {
  display: flex;
  align-items: center;
  gap: var(--p3-tight);
}

.card-main__title {
  flex: 1 0 0;
  min-width: 0;
}

/* 适用与安全说明：标题行 + 收起/展开；三行“标签 · 内容”；“可以这样说”左侧青瓷竖线 */
.card-details {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
}

.card-details__toggle {
  display: flex;
  align-items: center;
  gap: var(--p3-tight);
  width: 100%;
  min-height: 0;
  text-align: left;
}

.card-details__title {
  flex: 1 0 0;
  min-width: 0;
  color: var(--p3-ink);
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: 500;
}

.card-details__action {
  flex: 0 0 auto;
  color: var(--p3-primary);
  font-size: 26rpx;
  line-height: 40rpx;
}

.card-details__row {
  display: flex;
  align-items: flex-start;
  gap: var(--p3-stack);
}

.card-details__label {
  flex: 0 0 auto;
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
  white-space: nowrap;
}

.card-details__value {
  flex: 1 0 0;
  min-width: 0;
  color: var(--p3-ink);
  font-size: 28rpx;
  line-height: 44rpx;
}

.card-say {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
  padding-left: 28rpx;
  border-left: 4rpx solid var(--p3-primary);
}

.card-say__label {
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

.card-section {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
}

.card-alt {
  display: block;
  width: 100%;
  min-height: 0;
  text-align: left;
}
