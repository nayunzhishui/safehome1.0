.training-card-page {
  padding-bottom: 48rpx;
}

.detail-hero {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  padding: 32rpx;
  border: 1rpx solid #efe7dc;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f7faf4 100%);
  box-shadow: 0 12rpx 32rpx rgba(80, 64, 45, 0.08);
}

.hero-copy {
  min-width: 0;
  flex: 1;
}

.eyebrow,
.title,
.summary,
.card-type,
.card-title,
.body-text,
.state-title,
.state-text,
.match-label,
.match-text,
.overview-label,
.overview-value,
.tip-title,
.tip-text,
.block-title,
.example-text {
  display: block;
}

.eyebrow {
  margin-bottom: 10rpx;
  color: #4caf7d;
  font-size: 24rpx;
  font-weight: 800;
}

.title {
  color: #333333;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.3;
}

.summary,
.body-text {
  margin-top: 12rpx;
  color: #555555;
  font-size: 26rpx;
  line-height: 1.65;
}

.hero-mark {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  border-radius: 48rpx;
  background: #eef8e9;
  color: #4caf7d;
  font-size: 28rpx;
  font-weight: 900;
}

.hero-leaf {
  position: absolute;
  right: 18rpx;
  top: 18rpx;
  width: 22rpx;
  height: 12rpx;
  border-radius: 20rpx 20rpx 20rpx 4rpx;
  background: #ffb26b;
  transform: rotate(-28deg);
}

.state-card,
.match-card,
.task-card {
  margin-top: 24rpx;
  padding: 30rpx;
  border: 1rpx solid #efe7dc;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(80, 64, 45, 0.08);
}

.state-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.loading-dot {
  width: 36rpx;
  height: 36rpx;
  margin-bottom: 18rpx;
  border: 6rpx solid #e1efd8;
  border-top-color: #4caf7d;
  border-radius: 50%;
}

.state-title {
  color: #333333;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.45;
}

.state-text {
  margin-top: 10rpx;
  color: #666666;
  font-size: 26rpx;
  line-height: 1.6;
}

.error-card {
  border-color: #ffd0d0;
  background: #fff8f7;
  box-shadow: none;
}

.outline-button {
  min-height: 72rpx;
  margin-top: 24rpx;
  padding: 0 30rpx;
  border: 1rpx solid #ffb26b;
  border-radius: 36rpx;
  background: #ffffff;
  color: #f28b38;
  font-size: 26rpx;
  font-weight: 800;
}

.match-card {
  background: #f7faf4;
}

.match-label {
  color: #4caf7d;
  font-size: 22rpx;
  font-weight: 800;
}

.match-text {
  margin-top: 8rpx;
  color: #555555;
  font-size: 25rpx;
  line-height: 1.55;
}

.task-card {
  padding: 0;
  overflow: hidden;
}

.task-head {
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
  background: #fffdf9;
}

.task-number {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  border-radius: 28rpx;
  background: #4caf7d;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
}

.task-title-wrap {
  min-width: 0;
  flex: 1;
}

.task-title-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.card-type {
  color: #4caf7d;
  font-size: 24rpx;
  font-weight: 800;
}

.duration-pill,
.tag-pill {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 18rpx;
  border-radius: 21rpx;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.35;
}

.duration-pill {
  flex: 0 0 auto;
  background: #fff2df;
  color: #f28b38;
}

.card-title {
  color: #333333;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.35;
}

.overview-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  padding: 0 30rpx 26rpx;
}

.overview-item {
  min-height: 150rpx;
  padding: 22rpx;
  border: 1rpx solid #efe7dc;
  border-radius: 22rpx;
  background: #ffffff;
}

.overview-label {
  color: #888888;
  font-size: 22rpx;
  font-weight: 700;
}

.overview-value {
  margin-top: 12rpx;
  color: #333333;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.5;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  padding: 0 30rpx 26rpx;
}

.tag-pill {
  background: #eef6ff;
  color: #2f86df;
}

.tip-box,
.detail-block {
  margin: 0 30rpx 26rpx;
  padding: 24rpx;
  border-radius: 22rpx;
}

.tip-box {
  border: 1rpx solid #e1efd8;
  background: #f2faec;
}

.tip-title {
  color: #4caf7d;
  font-size: 27rpx;
  font-weight: 900;
}

.tip-text {
  margin-top: 8rpx;
  color: #4d6b48;
  font-size: 25rpx;
  line-height: 1.65;
}

.detail-block {
  border: 1rpx solid #efe7dc;
  background: #ffffff;
}

.block-title {
  color: #333333;
  font-size: 29rpx;
  font-weight: 900;
}

.step-list {
  display: grid;
  gap: 18rpx;
  margin-top: 18rpx;
}

.step-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.step-number {
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  border-radius: 21rpx;
  background: #eef8e9;
  color: #4caf7d;
  font-size: 22rpx;
  font-weight: 900;
}

.step-text {
  min-width: 0;
  flex: 1;
  color: #555555;
  font-size: 26rpx;
  line-height: 1.6;
}

.example-block {
  border-color: #ffe0b7;
  background: #fffaf3;
}

.example-text {
  margin-top: 16rpx;
  color: #555555;
  font-size: 26rpx;
  line-height: 1.7;
}

.reflection-block {
  background: #f9fbf8;
}

.primary-button {
  min-height: 88rpx;
  margin: 4rpx 30rpx 30rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #7ccb8a, #4caf7d);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  box-shadow: 0 12rpx 26rpx rgba(76, 175, 125, 0.22);
}
