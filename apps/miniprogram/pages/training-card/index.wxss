.training-card-page {
  padding-bottom: calc(52rpx + env(safe-area-inset-bottom));
}

.detail-hero {
  position: relative;
  min-height: 286rpx;
  overflow: hidden;
}

.hero-copy {
  max-width: 480rpx;
}

.hero-kicker,
.hero-title,
.hero-summary,
.hero-mark-main,
.hero-mark-sub,
.card-type,
.card-title,
.body-text,
.state-title,
.state-text,
.match-label,
.match-text,
.overview-label,
.overview-value,
.today-label,
.today-text,
.tip-title,
.tip-text,
.block-title,
.example-text {
  display: block;
}

.hero-kicker {
  margin-bottom: 10rpx;
  color: var(--safe-primary);
  font-size: 24rpx;
  font-weight: 800;
}

.hero-title {
  color: var(--safe-title);
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.28;
  letter-spacing: 0;
}

.hero-summary,
.body-text {
  margin-top: 14rpx;
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.7;
}

.hero-mark {
  position: absolute;
  right: 30rpx;
  bottom: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 132rpx;
  border: 1rpx solid rgba(87, 139, 95, 0.2);
  border-radius: 50%;
  background: rgba(255, 253, 248, 0.86);
}

.hero-mark-main {
  color: var(--safe-primary-deep);
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1;
}

.hero-mark-sub {
  margin-top: 8rpx;
  color: var(--safe-muted);
  font-size: 22rpx;
}

.card-content {
  display: flex;
  flex-direction: column;
}

.state-card,
.match-card,
.task-card {
  margin-top: 28rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-lg);
  background: var(--safe-card);
  box-shadow: var(--safe-shadow-card);
}

.state-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 30rpx;
}

.loading-dot {
  width: 34rpx;
  height: 34rpx;
  margin-bottom: 18rpx;
  border: 6rpx solid var(--safe-primary-soft);
  border-top-color: var(--safe-primary);
  border-radius: 50%;
}

.state-title {
  color: var(--safe-title);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.45;
}

.state-text {
  margin-top: 10rpx;
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.65;
}

.error-card {
  border-color: rgba(215, 111, 103, 0.3);
  background: rgba(255, 244, 240, 0.94);
  box-shadow: none;
}

.outline-button {
  min-height: 72rpx;
  margin-top: 24rpx;
  padding: 0 30rpx;
  border: 1rpx solid var(--safe-orange);
  border-radius: var(--safe-radius-pill);
  background: var(--safe-card);
  color: var(--safe-orange);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 72rpx;
}

.outline-button::after {
  border: 0;
}

.match-card {
  padding: 24rpx 28rpx;
  background: var(--safe-primary-pale);
}

.match-label {
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 800;
}

.match-text {
  margin-top: 8rpx;
  color: var(--safe-text);
  font-size: 25rpx;
  line-height: 1.6;
}

.task-card {
  overflow: hidden;
}

.task-head {
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
  background: rgba(255, 253, 248, 0.96);
}

.task-number {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  flex: 0 0 56rpx;
  border-radius: 20rpx;
  background: var(--safe-primary);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 56rpx;
}

.task-title-wrap {
  min-width: 0;
  flex: 1;
}

.task-title-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.card-type {
  color: var(--safe-primary);
  font-size: 24rpx;
  font-weight: 800;
}

.duration-pill,
.tag-pill {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 18rpx;
  border-radius: var(--safe-radius-pill);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.35;
}

.duration-pill {
  flex: 0 0 auto;
  background: var(--safe-orange-soft);
  color: var(--safe-orange);
}

.card-title {
  color: var(--safe-title);
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.35;
}

.overview-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  padding: 0 30rpx 26rpx;
}

.overview-item {
  min-height: 136rpx;
  padding: 22rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: var(--safe-card-strong);
}

.overview-label {
  color: var(--safe-muted);
  font-size: 22rpx;
  font-weight: 700;
}

.overview-value {
  margin-top: 12rpx;
  color: var(--safe-title);
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1.5;
}

.today-step,
.tip-box,
.detail-block {
  margin: 0 30rpx 26rpx;
  padding: 24rpx;
  border-radius: var(--safe-radius-md);
}

.today-step {
  border: 1rpx solid rgba(244, 127, 69, 0.2);
  background: var(--safe-orange-soft);
}

.today-label {
  color: var(--safe-orange);
  font-size: 24rpx;
  font-weight: 900;
}

.today-text {
  margin-top: 8rpx;
  color: var(--safe-title);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.65;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  padding: 0 30rpx 26rpx;
}

.tag-pill {
  background: var(--safe-blue-soft);
  color: var(--safe-info);
}

.tip-box {
  border: 1rpx solid rgba(87, 139, 95, 0.18);
  background: var(--safe-primary-pale);
}

.tip-title {
  color: var(--safe-primary-deep);
  font-size: 27rpx;
  font-weight: 900;
}

.tip-text {
  margin-top: 8rpx;
  color: var(--safe-text);
  font-size: 25rpx;
  line-height: 1.65;
}

.detail-block {
  border: 1rpx solid var(--safe-border);
  background: var(--safe-card-strong);
}

.block-title {
  color: var(--safe-title);
  font-size: 29rpx;
  font-weight: 900;
}

.step-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 18rpx;
}

.step-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.step-number {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  flex: 0 0 42rpx;
  border-radius: 50%;
  background: var(--safe-primary-soft);
  color: var(--safe-primary);
  font-size: 22rpx;
  font-weight: 900;
  line-height: 42rpx;
}

.step-text {
  min-width: 0;
  flex: 1;
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.65;
}

.example-block {
  border-color: rgba(244, 127, 69, 0.24);
  background: #fffaf3;
}

.example-text {
  margin-top: 16rpx;
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.75;
}

.reflection-block {
  background: var(--safe-bg-leaf);
}

.primary-button {
  min-height: 88rpx;
  margin: 4rpx 30rpx 30rpx;
  border-radius: var(--safe-radius-pill);
  background: linear-gradient(135deg, var(--safe-primary), var(--safe-primary-deep));
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 88rpx;
  box-shadow: 0 14rpx 28rpx rgba(87, 139, 95, 0.24);
}

.primary-button::after {
  border: 0;
}
