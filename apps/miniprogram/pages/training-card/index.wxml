<view class="safe-page training-card-page">
  <view class="detail-hero safe-card safe-card--hero">
    <view class="hero-copy">
      <text class="hero-title">今天先练这一小步</text>
      <text class="hero-summary">每次选一张卡就可以。重点不是做完整，而是多一个能暂停、观察和回应的机会。</text>
    </view>
    <view class="hero-mark">
      <text class="hero-mark-main">1</text>
      <text class="hero-mark-sub">张即可</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="state-card safe-card">
    <view class="loading-dot"></view>
    <text class="state-title">正在整理适合今天的小练习</text>
    <text class="state-text">请稍等一下。</text>
  </view>

  <view wx:elif="{{errorMessage}}" class="state-card error-card">
    <text class="state-title">{{errorMessage}}</text>
    <text class="state-text">{{errorDetail}}</text>
    <button class="outline-button" bindtap="retryLoadCards">重新加载</button>
  </view>

  <view wx:else class="card-content">
    <view wx:if="{{tagsText}}" class="match-card">
      <text class="match-label">这次推荐依据</text>
      <text class="match-text">{{tagsText}}</text>
    </view>

    <view class="list-note"><text>先看第一张；不合适时，再从下面两张里换一张。</text></view>

    <view wx:for="{{cards}}" wx:key="id" class="task-card {{item.isPrimary ? 'task-card--primary' : 'task-card--alternative'}}">
      <view class="task-head">
        <view class="task-title-wrap">
          <view class="task-title-line">
            <text class="card-type">{{item.isPrimary ? '优先推荐 · ' : ''}}{{item.typeLabel}}</text>
            <text class="duration-pill">{{item.durationText}}</text>
          </view>
          <text class="card-title">{{item.title}}</text>
          <text class="body-text">{{item.purpose}}</text>
        </view>
      </view>

      <view wx:if="{{item.isPrimary}}" class="today-step today-step--primary">
        <text class="today-label">今天的小目标</text>
        <text class="today-text">{{item.todayGoal}}</text>
      </view>

      <button wx:if="{{item.isPrimary}}" class="detail-toggle" data-id="{{item.id}}" bindtap="toggleCardDetails">
        <text>{{expandedCardId === item.id ? '收起适用与安全说明' : '查看适用与安全说明'}}</text>
        <text class="detail-toggle-icon">{{expandedCardId === item.id ? '−' : '+'}}</text>
      </button>

      <view wx:if="{{item.isPrimary && expandedCardId === item.id}}" class="details-panel">
        <view class="detail-row"><text class="detail-label">适合</text><text class="detail-text">{{item.scenarioText}}</text></view>
        <view class="detail-row"><text class="detail-label">节奏</text><text class="detail-text">{{item.doseText}}</text></view>
        <view class="detail-row"><text class="detail-label">完成</text><text class="detail-text">{{item.completionText}}</text></view>
        <view wx:if="{{item.examplePhrase}}" class="example-box"><text class="today-label">可以这样说</text><text class="today-text">“{{item.examplePhrase}}”</text></view>
        <view wx:if="{{item.stopText}}" class="tip-box"><text class="tip-title">这些情况先停下来</text><text class="tip-text">{{item.stopText}}</text></view>
        <text class="boundary-text">{{item.boundaryNotice}}</text>
      </view>

      <button class="primary-button {{item.isPrimary ? '' : 'primary-button--secondary'}}" data-id="{{item.id}}" data-title="{{item.title}}" bindtap="choosePractice">{{item.isPrimary ? '开始这张练习' : '改练这张'}}</button>
      <feedback-rating
        wx:if="{{item.isPrimary}}"
        value="{{item.feedbackEvaluation}}"
        disabled="{{feedbackEvaluationSaving}}"
        prompt="这张建议适合你吗？"
        compact="{{true}}"
        data-id="{{item.id}}"
        bind:select="submitTrainingFeedback"
      />
    </view>

    <view wx:if="{{cards.length === 0}}" class="state-card safe-card">
      <text class="state-title">暂时没有匹配到训练卡</text>
      <text class="state-text">可以先回到记录页，补充更具体的事件细节。</text>
    </view>
  </view>
</view>
