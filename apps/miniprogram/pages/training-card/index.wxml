<view class="p3-page training-card-page" role="main" aria-label="训练卡">
  <page-state wx:if="{{loading}}" kind="loading" title="正在整理适合今天的小练习" description="每次只优先呈现一张卡。" />

  <page-state wx:elif="{{errorMessage}}" kind="error" title="训练建议暂时没有读取成功" description="{{errorMessage}} {{errorDetail}}" action-label="重新加载" bind:action="retryLoadCards" />

  <block wx:elif="{{primaryCard}}">
    <view wx:if="{{tagsText}}" class="card-basis">
      <text class="card-basis__label">{{librarySource ? '来自训练库' : '这次推荐依据'}}</text>
      <text class="card-basis__text">{{tagsText}}</text>
    </view>

    <view class="p3-card card-main">
      <view class="card-main__head">
        <text class="p3-action-title card-main__title" role="heading" aria-level="1">{{primaryCard.title}}</text>
        <status-pill wx:if="{{!librarySource}}" label="优先" tone="success" />
      </view>
      <text wx:if="{{primaryCard.purpose}}" class="p3-body-compact">{{primaryCard.purpose}}</text>
      <text class="p3-meta">{{primaryCard.metaText}}</text>

      <view class="card-goal">
        <text class="card-goal__label">今天的小目标</text>
        <text class="card-goal__text">{{primaryCard.todayGoal}}</text>
      </view>

      <view class="card-details">
        <button class="card-details__toggle" aria-expanded="{{expandedCardId === primaryCard.id}}" data-id="{{primaryCard.id}}" bindtap="toggleCardDetails">
          <text class="card-details__title">适用与安全说明</text>
          <text class="card-details__action">{{expandedCardId === primaryCard.id ? '收起 −' : '展开 +'}}</text>
        </button>
        <block wx:if="{{expandedCardId === primaryCard.id}}">
          <view class="card-details__row"><text class="card-details__label">适合</text><text class="card-details__value">{{primaryCard.scenarioText}}</text></view>
          <view class="card-details__row"><text class="card-details__label">节奏</text><text class="card-details__value">{{primaryCard.doseText}}</text></view>
          <view class="card-details__row"><text class="card-details__label">完成</text><text class="card-details__value">{{primaryCard.completionText}}</text></view>
          <view wx:if="{{primaryCard.examplePhrase}}" class="card-say">
            <text class="card-say__label">可以这样说</text>
            <text class="p3-quote">“{{primaryCard.examplePhrase}}”</text>
          </view>
          <view wx:if="{{primaryCard.stopText}}" class="p3-notice p3-notice--warm">
            <text class="p3-notice__title">这些情况先停下来</text>
            <text class="p3-notice__body">{{primaryCard.stopText}}</text>
          </view>
          <text class="p3-footnote">{{primaryCard.boundaryNotice}}</text>
        </block>
      </view>

      <button class="p3-btn p3-btn--primary" data-id="{{primaryCard.id}}" data-title="{{primaryCard.title}}" bindtap="choosePractice">开始这张练习</button>
      <feedback-rating
        value="{{primaryCard.feedbackEvaluation}}"
        disabled="{{feedbackEvaluationSaving}}"
        prompt="{{librarySource ? '这张练习适合你吗？' : '这张建议适合你吗？'}}"
        compact="{{true}}"
        data-id="{{primaryCard.id}}"
        bind:select="submitTrainingFeedback"
      />
    </view>

    <view wx:if="{{alternativeCards.length}}" class="card-section">
      <p3-section-header title="{{librarySource ? '同一类还有' : '也可以改练'}}" />
      <view class="p3-group p3-group--course">
        <button
          wx:for="{{alternativeCards}}"
          wx:key="id"
          class="card-alt"
          data-id="{{item.id}}"
          data-title="{{item.title}}"
          aria-label="改练：{{item.title}}"
          bindtap="choosePractice"
        >
          <p3-course-row title="{{item.title}}" scene="{{item.altScene}}" meta="{{item.altMetaText}}" show-divider="{{index < alternativeCards.length - 1}}" />
        </button>
      </view>
    </view>
  </block>

  <page-state wx:else kind="empty" title="暂时没有可用的训练卡" description="训练卡开放后会显示在这里，可以先继续记录具体事件。" action-label="去记录一件事" bind:action="goDiary" />
</view>
