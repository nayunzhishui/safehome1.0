<view class="safe-page training-card-page">
  <view class="detail-hero">
    <view class="hero-copy">
      <text class="eyebrow">第三步</text>
      <text class="title">UP 训练卡推荐</text>
      <text class="summary">选择一张卡，先做一次小练习。完成后可以进入轻打卡，记录练习前后的感受。</text>
    </view>
    <view class="hero-mark">
      <view class="hero-leaf"></view>
      <text>UP</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="state-card">
    <view class="loading-dot"></view>
    <text class="state-title">正在整理适合今天的小练习</text>
    <text class="state-text">请稍等一下。</text>
  </view>

  <view wx:elif="{{errorMessage}}" class="state-card error-card">
    <text class="state-title">{{errorMessage}}</text>
    <text class="state-text">{{errorDetail}}</text>
    <button class="outline-button" bindtap="retryLoadCards">重新加载</button>
  </view>

  <view wx:else>
    <view wx:if="{{tagsText}}" class="match-card">
      <text class="match-label">当前推荐线索</text>
      <text class="match-text">{{tagsText}}</text>
    </view>

    <view wx:for="{{cards}}" wx:key="id" class="task-card">
      <view class="task-head">
        <view class="task-number">{{item.orderText}}</view>
        <view class="task-title-wrap">
          <view class="task-title-line">
            <text class="card-type">{{item.typeLabel}}</text>
            <text class="duration-pill">{{item.durationText}}</text>
          </view>
          <text class="card-title">{{item.title}}</text>
          <text class="body-text">{{item.purpose}}</text>
        </view>
      </view>

      <view class="overview-grid">
        <view class="overview-item">
          <text class="overview-label">适用情境</text>
          <text class="overview-value">{{item.scenarioText}}</text>
        </view>
        <view class="overview-item">
          <text class="overview-label">今日目标</text>
          <text class="overview-value">{{item.todayGoal}}</text>
        </view>
      </view>

      <view wx:if="{{item.tagsText}}" class="tag-row">
        <text class="tag-pill">匹配：{{item.tagsText}}</text>
      </view>

      <view class="tip-box">
        <text class="tip-title">练习前先提醒自己</text>
        <text class="tip-text">这张卡只是帮助你练一个更小的回应动作，不需要一次做得很完整。</text>
      </view>

      <view class="detail-block">
        <text class="block-title">练习步骤</text>
        <view class="step-list">
          <view wx:for="{{item.stepsList}}" wx:for-item="step" wx:key="numberText" class="step-item">
            <text class="step-number">{{step.numberText}}</text>
            <text class="step-text">{{step.text}}</text>
          </view>
        </view>
      </view>

      <view class="detail-block example-block">
        <text class="block-title">示例话术</text>
        <text class="example-text">{{item.example}}</text>
      </view>

      <view class="detail-block reflection-block">
        <text class="block-title">练习后可以记一句</text>
        <text class="body-text">{{item.reflectionPrompt}}</text>
      </view>

      <button class="primary-button" data-id="{{item.id}}" data-title="{{item.title}}" bindtap="choosePractice">开始这张训练卡</button>
    </view>

    <view wx:if="{{cards.length === 0}}" class="state-card">
      <text class="state-title">暂时没有匹配到训练卡</text>
      <text class="state-text">可以先回到记录页，补充更具体的事件细节。</text>
    </view>
  </view>
</view>
