.history-page {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
}

.history-head {
  padding: 24rpx 0 34rpx;
  border-bottom: 1rpx solid var(--safe-border);
  text-align: center;
}

.page-kicker,
.page-title,
.page-summary,
.total-value,
.total-label,
.state-title,
.state-text,
.diagnostic-copy,
.record-status,
.record-time,
.record-title,
.record-change,
.record-meta,
.record-reflection,
.list-end,
.load-error {
  display: block;
}

.page-kicker {
  color: var(--safe-primary-deep);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.4;
}

.page-title {
  margin-top: 10rpx;
  color: var(--safe-title);
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.25;
  text-align: center;
}

.page-summary {
  margin-top: 18rpx;
  color: var(--safe-muted);
  font-size: 28rpx;
  line-height: 1.65;
}

.total-badge {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 22rpx;
  justify-content: center;
}

.total-value,
.total-label {
  color: var(--safe-primary-deep);
  font-size: 28rpx;
  font-weight: 850;
}

.state-card {
  margin-top: 28rpx;
  padding: 28rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-sm);
  background: var(--safe-primary-pale);
}

.state-card--error {
  border-color: #edd7d4;
  background: #fff7f5;
}

.state-title {
  color: var(--safe-title);
  font-size: 32rpx;
  font-weight: 850;
  line-height: 1.4;
}

.state-text,
.diagnostic-copy {
  margin-top: 12rpx;
  color: var(--safe-text);
  font-size: 28rpx;
  line-height: 1.6;
}

.diagnostic-copy {
  color: var(--safe-muted);
  font-size: 24rpx;
  overflow-wrap: anywhere;
}

.state-action,
.load-more {
  width: 100%;
  min-height: 88rpx;
  margin: 22rpx 0 0;
  border-radius: var(--safe-radius-sm);
}

.diagnostic-action,
.repeat-action {
  min-height: 88rpx;
  margin: 12rpx 0 0;
  padding: 0 24rpx;
  border: 0;
  background: transparent;
  color: var(--safe-primary-deep);
  font-size: 26rpx;
  font-weight: 800;
}

.diagnostic-action::after,
.repeat-action::after {
  border: 0;
}

.record-list {
  margin-top: 10rpx;
}

.record-card {
  position: relative;
  padding: 30rpx 0;
  border-bottom: 1rpx solid var(--safe-border);
}

.record-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.record-status,
.record-time {
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.4;
}

.record-time {
  color: var(--safe-muted);
  font-weight: 500;
}

.record-title {
  margin-top: 14rpx;
  color: var(--safe-title);
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.35;
}

.record-change,
.record-meta,
.record-reflection {
  margin-top: 10rpx;
  color: var(--safe-text);
  font-size: 28rpx;
  line-height: 1.6;
}

.record-meta {
  color: var(--safe-primary-deep);
}

.record-reflection {
  color: var(--safe-muted);
}

.repeat-action {
  min-width: 168rpx;
  margin-top: 18rpx;
  border: 2rpx solid var(--safe-primary);
  border-radius: var(--safe-radius-sm);
}

.load-more-area {
  padding: 28rpx 0 0;
  text-align: center;
}

.list-end,
.load-error {
  color: var(--safe-muted);
  font-size: 26rpx;
  line-height: 1.5;
}

.load-error {
  margin-top: 12rpx;
  color: var(--safe-danger);
}

@media (max-width: 360px) {
  .record-head {
    align-items: flex-start;
    flex-direction: column;
    gap: 6rpx;
  }
}
