/* 训练记录（Figma 652:1704）：衬线合计数 → 每次练习一张纸白卡 → 列表结束说明。 */
.history-page {
  display: flex;
  flex-direction: column;
  gap: var(--p3-section);
  padding-top: 16rpx;
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
}

.history-error,
.history-more {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
}

.history-total {
  display: flex;
  align-items: center;
  gap: var(--p3-tight);
}

.history-total__label {
  flex: 1 0 0;
  min-width: 0;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
}

.history-record {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
  padding: 32rpx 36rpx;
  border-radius: var(--p3-radius-group);
  background: var(--p3-surface);
}

.history-record__head {
  display: flex;
  align-items: center;
  gap: var(--p3-tight);
}

.history-record__time {
  flex: 1 0 0;
  min-width: 0;
}

.history-record__change {
  color: var(--p3-primary);
  font-size: 26rpx;
  line-height: 40rpx;
}

/* “再次练习 ›”：文字链大小（13/20），上下各补 12rpx 触控区，不改变排版位置 */
.history-record__repeat {
  align-self: flex-start;
  width: auto;
  min-height: 0;
  margin: -12rpx 0;
  padding: 12rpx 0;
  color: var(--p3-primary);
  font-size: 26rpx;
  line-height: 40rpx;
  text-align: left;
}
