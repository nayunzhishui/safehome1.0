<view class="safe-page history-page" role="main" aria-label="训练记录">
  <view class="history-head">
    <view>
      <text class="page-title">看见已经完成的小练习</text>
    </view>
    <view class="total-badge">
      <text class="total-value">{{total}}</text>
      <text class="total-label">次记录</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="state-card">
    <text class="state-title">正在读取训练记录</text>
  </view>

  <view wx:elif="{{errorMessage && !items.length}}" class="state-card state-card--error">
    <text class="state-title">记录暂时没有加载成功</text>
    <text class="state-text">{{errorMessage}}</text>
    <text class="diagnostic-copy">请求编号：{{errorDiagnostic.requestId || '未返回'}} · 服务版本：{{errorDiagnostic.serviceVersion || '未知'}}</text>
    <button class="safe-outline-button state-action" bindtap="retry">重新加载</button>
    <button class="diagnostic-action" bindtap="copyDiagnostic">复制诊断信息</button>
  </view>

  <view wx:elif="{{items.length}}" class="record-list">
    <view wx:for="{{items}}" wx:key="id" class="record-card">
      <view class="record-head">
        <text class="record-status">{{item.statusText}}</text>
        <text class="record-time">{{item.createdAtText}}</text>
      </view>
      <text class="record-title">{{item.cardTitle}}</text>
      <text class="record-change">{{item.changeText}}</text>
      <text wx:if="{{item.helpfulnessText}}" class="record-meta">{{item.helpfulnessText}}</text>
      <text wx:if="{{item.reflection}}" class="record-reflection">“{{item.reflection}}”</text>
      <button class="repeat-action" data-card-id="{{item.card_id}}" bindtap="openCard">再次练习</button>
    </view>
    <view class="load-more-area">
      <button wx:if="{{hasMore}}" class="safe-outline-button load-more" loading="{{loadingMore}}" disabled="{{loadingMore}}" bindtap="loadMore">{{loadingMore ? '加载中' : '加载更多'}}</button>
      <text wx:else class="list-end">已显示全部 {{total}} 次记录</text>
      <text wx:if="{{errorMessage}}" class="load-error">{{errorMessage}}</text>
      <button wx:if="{{errorMessage && errorDiagnostic}}" class="diagnostic-action" bindtap="copyDiagnostic">复制诊断信息</button>
    </view>
  </view>

  <view wx:else class="state-card">
    <text class="state-title">还没有训练记录</text>
    <text class="state-text">完成一张训练卡并打卡后，记录会出现在这里。</text>
    <button class="safe-primary-button state-action" bindtap="goTraining">去训练中心</button>
  </view>
</view>
