<view class="p3-page history-page" role="main" aria-label="训练记录">
  <page-state wx:if="{{loading}}" kind="loading" title="正在读取训练记录" />

  <view wx:elif="{{errorMessage && !items.length}}" class="history-error">
    <page-state kind="error" title="记录暂时没有加载成功" description="{{errorMessage}}" action-label="重新加载" bind:action="retry" />
    <text class="p3-footnote">请求编号：{{errorDiagnostic.requestId || '未返回'}} · 服务版本：{{errorDiagnostic.serviceVersion || '未知'}}</text>
    <button class="p3-link" bindtap="copyDiagnostic">复制诊断信息</button>
  </view>

  <block wx:elif="{{items.length}}">
    <view class="history-total">
      <text class="p3-greeting">{{total}}</text>
      <text class="p3-meta history-total__label">次练习记录</text>
    </view>

    <view class="history-list">
      <view wx:for="{{items}}" wx:key="id" class="history-record">
        <view class="history-record__head">
          <status-pill label="{{item.statusText}}" tone="success" />
          <text class="p3-meta history-record__time">{{item.createdAtText}}</text>
        </view>
        <text class="p3-item-title">{{item.cardTitle}}</text>
        <text class="history-record__change">{{item.changeText}}</text>
        <text wx:if="{{item.quoteText}}" class="p3-body-compact">“{{item.quoteText}}”</text>
        <button class="history-record__repeat" data-card-id="{{item.card_id}}" aria-label="再次练习：{{item.cardTitle}}" bindtap="openCard">再次练习 ›</button>
      </view>
    </view>

    <view class="history-more">
      <button wx:if="{{hasMore}}" class="p3-btn p3-btn--secondary" loading="{{loadingMore}}" disabled="{{loadingMore}}" bindtap="loadMore">{{loadingMore ? '加载中' : '加载更多'}}</button>
      <text wx:else class="p3-meta">已显示全部 {{total}} 次记录</text>
      <text wx:if="{{errorMessage}}" class="p3-form-message p3-form-message--error" role="alert">{{errorMessage}}</text>
      <button wx:if="{{errorMessage && errorDiagnostic}}" class="p3-link" bindtap="copyDiagnostic">复制诊断信息</button>
    </view>
  </block>

  <page-state wx:else kind="empty" title="还没有训练记录" description="完成一次练习后，前后感受和一句观察会记在这里。" action-label="去训练中心" bind:action="goTraining" />
</view>
