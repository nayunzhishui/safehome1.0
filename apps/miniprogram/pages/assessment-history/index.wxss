.history-page {
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}

.history-head {
  position: relative;
  padding: 12rpx 0 8rpx;
  text-align: center;
}

.page-kicker,
.page-title,
.page-summary,
.total-value,
.total-label,
.record-title,
.record-summary,
.state-title,
.state-text,
.list-end,
.load-error {
  display: block;
}

.page-kicker {
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 850;
}

.page-title {
  color: var(--safe-title);
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.35;
}

.history-total {
  margin-top: 18rpx;
  text-align: left;
}

.total-value {
  color: var(--safe-primary-deep);
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1;
}

.total-label {
  color: var(--safe-muted);
  font-size: 25rpx;
  line-height: 1.4;
}

.history-list {
  margin-top: 26rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: var(--safe-card);
  overflow: hidden;
  box-shadow: var(--safe-shadow-card);
}

.history-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  width: 100%;
  min-height: 154rpx;
  margin: 0;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--safe-border);
  border-radius: 0;
  background: var(--safe-card);
  text-align: left;
}

.history-row::after {
  border: 0;
}

.record-mark {
  flex: 0 0 8rpx;
  width: 8rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: var(--safe-primary);
}

.record-copy {
  min-width: 0;
  flex: 1;
}

.record-title {
  color: var(--safe-title);
  font-size: 29rpx;
  font-weight: 850;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.record-summary {
  display: -webkit-box;
  margin-top: 7rpx;
  overflow: hidden;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.55;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.record-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 20rpx;
  margin-top: 10rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.45;
}

.record-arrow {
  flex: 0 0 auto;
  color: var(--safe-primary);
  font-size: 42rpx;
  font-weight: 500;
}

.state-card {
  margin-top: 28rpx;
}

.state-card--error {
  border-color: rgba(215, 111, 103, 0.3);
}

.state-title {
  color: var(--safe-title);
  font-size: 29rpx;
  font-weight: 850;
}

.state-text,
.load-error {
  margin-top: 8rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.6;
}

.state-action,
.load-more {
  margin-top: 22rpx;
}

.load-more-area {
  padding: 24rpx;
  text-align: center;
}

.load-more {
  width: 100%;
  margin: 0;
}

.list-end {
  color: var(--safe-muted);
  font-size: 24rpx;
}
