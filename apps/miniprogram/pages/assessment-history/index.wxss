.history-page {
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}

.history-head {
  position: relative;
  padding: 12rpx 0 8rpx;
  text-align: center;
}

.page-kicker,
.page-title,
.page-summary,
.total-value,
.total-label,
.record-title,
.record-summary,
.state-title,
.state-text,
.list-end,
.load-error {
  display: block;
}

.page-kicker {
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 850;
}

.page-title {
  color: var(--safe-title);
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.35;
}

.history-total {
  margin-top: 18rpx;
  text-align: left;
}

.total-value {
  color: var(--safe-primary-deep);
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1;
}

.total-label {
  color: var(--safe-muted);
  font-size: 25rpx;
  line-height: 1.4;
}

.history-list {
  display: grid;
  gap: 20rpx;
  margin-top: 26rpx;
  overflow: visible;
}

.history-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  width: 100%;
  min-height: 154rpx;
  margin: 0;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--safe-border);
  border-radius: 0;
  background: var(--safe-card);
  text-align: left;
}

.history-row::after {
  border: 0;
}

.record-mark {
  flex: 0 0 8rpx;
  width: 8rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: var(--safe-primary);
}

.record-copy {
  min-width: 0;
  flex: 1;
}

.record-title {
  color: var(--safe-title);
  font-size: 29rpx;
  font-weight: 850;
  line-height: 1.45;
  overflow-wrap: anywhere;
}

.record-summary {
  display: -webkit-box;
  margin-top: 7rpx;
  overflow: hidden;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.55;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.record-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 20rpx;
  margin-top: 10rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.45;
}

.record-arrow {
  flex: 0 0 auto;
  color: var(--safe-primary);
  font-size: 42rpx;
  font-weight: 500;
}

.state-card {
  margin-top: 28rpx;
}

.state-card--error {
  border-color: rgba(215, 111, 103, 0.3);
}

.state-title {
  color: var(--safe-title);
  font-size: 29rpx;
  font-weight: 850;
}

.state-text,
.load-error {
  margin-top: 8rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.6;
}

.state-action,
.load-more {
  margin-top: 22rpx;
}

.load-more-area {
  padding: 4rpx 0 24rpx;
  text-align: center;
}

.load-more {
  width: 100%;
  margin: 0;
}

.list-end {
  color: var(--safe-muted);
  font-size: 24rpx;
}

/* UIproduct2: task-scoped visual refinement, no business behavior. */
.ui2-page { --ui2-section-accent-display:none; --safe-shadow-card:none; --safe-shadow-float:none; box-sizing:border-box; background:var(--ui2-canvas); padding:48rpx 40rpx calc(64rpx + env(safe-area-inset-bottom)); }
.ui2-page .page-title,.ui2-page .hero-title,.ui2-page .history-title,.ui2-page .result-title { font-size:44rpx; line-height:1.6; font-weight:700; text-align:center; color:var(--ui2-ink); }
.ui2-page .safe-primary-button,.ui2-page .safe-outline-button { min-height:96rpx; padding:22rpx 24rpx; border-radius:24rpx; font-size:30rpx; line-height:1.6; box-shadow:none; }
.ui2-page .ui2-placeholder { color:var(--ui2-muted); }
.ui2-page .history-head { padding:0 0 24rpx; }
.ui2-page .total-label,.ui2-page .list-end { font-size:26rpx; line-height:1.6; }
.ui2-page .state-card { padding:24rpx 0; border:0; background:transparent; }
.ui2-page .state-title { font-size:32rpx; line-height:1.6; }
.ui2-page .state-text,.ui2-page .load-error { font-size:30rpx; line-height:1.7; }
.ui2-page { --ui2-worksheet-height:0; --ui2-worksheet-padding:24rpx 0; --ui2-worksheet-radius:0; --ui2-worksheet-bg:transparent; --ui2-worksheet-border:0; --ui2-worksheet-bottom:1rpx; --ui2-worksheet-description-size:30rpx; --ui2-worksheet-description-display:block; --ui2-worksheet-description-overflow:visible; --ui2-worksheet-description-clamp:unset; }
