<view class="history-page" role="main" aria-label="测评历史记录">
  <page-state wx:if="{{loading}}" kind="loading" title="正在读取测评记录" />

  <page-state wx:elif="{{errorMessage && !items.length}}" kind="error" title="记录暂时没有加载成功" description="{{errorMessage}}" action-label="重新加载" bind:action="retry" />

  <block wx:elif="{{items.length}}">
    <text class="history-total">共 {{total}} 份记录</text>
    <view class="history-group" role="list" aria-label="测评记录">
      <button
        wx:for="{{items}}"
        wx:key="id"
        class="history-row"
        role="listitem"
        aria-label="查看结果：{{item.worksheetTitle}}，{{item.createdAtText}}"
        data-id="{{item.id}}"
        bindtap="openResult"
      >
        <p3-course-row title="{{item.worksheetTitle}}" scene="{{item.summaryText}}" meta="{{item.rowMeta}}" show-divider="{{index < items.length - 1}}" />
      </button>
    </view>
    <view class="history-more">
      <button wx:if="{{hasMore}}" class="p3-btn p3-btn--secondary" loading="{{loadingMore}}" disabled="{{loadingMore}}" bindtap="loadMore">{{loadingMore ? '加载中' : '加载更多'}}</button>
      <text wx:else class="history-end">已显示全部 {{total}} 份记录</text>
      <text wx:if="{{errorMessage}}" class="p3-form-message p3-form-message--error">{{errorMessage}}</text>
    </view>
  </block>

  <page-state wx:else kind="empty" title="还没有测评记录" description="完成一次测一测后，记录会保存在这里。" action-label="去测一测" bind:action="goAssessment" />
</view>
