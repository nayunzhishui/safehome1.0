.settings-detail-page {
  padding-bottom: calc(44rpx + env(safe-area-inset-bottom));
}

.hero-card {
  min-height: 260rpx;
}

.hero-kicker,
.hero-title,
.hero-summary,
.notice-text {
  display: block;
}

.hero-kicker {
  color: var(--safe-primary);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.4;
}

.hero-title {
  margin-top: 10rpx;
  color: var(--safe-title);
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.3;
}

.hero-summary {
  margin-top: 14rpx;
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.7;
}

.notice-card {
  padding: 24rpx 28rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: var(--safe-card);
  box-shadow: var(--safe-shadow-card);
}

.notice-row {
  display: flex;
  gap: 14rpx;
  padding: 12rpx 0;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  flex: 0 0 10rpx;
  margin-top: 18rpx;
  border-radius: 50%;
  background: var(--safe-primary);
}

.notice-text {
  flex: 1;
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.7;
}

.back-button {
  margin-top: 24rpx;
}
