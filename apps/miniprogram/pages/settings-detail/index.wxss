/* 设置与说明（Figma 672:3306 知情与边界 / 672:3363 隐私说明 / 672:3502 参与者保护）：宋体标题、圆点条目章节，长文后半折叠；隐私与保护的操作区沿用纸白卡与分组。 */
.sd-page {
  display: flex;
  flex-direction: column;
  gap: var(--p3-section);
  padding-top: 16rpx;
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
}

.sd-head {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.sd-subtitle {
  color: var(--p3-muted);
  font-size: 30rpx;
  line-height: 52rpx;
}

.sd-sections {
  display: flex;
  flex-direction: column;
  gap: var(--p3-section);
}

.sd-section {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
}

/* 长文后半折叠（Figma 672:3412）：每章一行标题 + 下拉箭头，章与章之间一条细线 */
.sd-folds {
  display: flex;
  flex-direction: column;
}

.sd-fold-section {
  border-top: 2rpx solid var(--p3-hairline);
}

.sd-fold {
  display: flex;
  align-items: center;
  gap: var(--p3-tight);
  width: 100%;
  min-height: 0;
  padding: 28rpx 0;
  text-align: left;
}

.sd-fold__title {
  flex: 1 0 0;
  min-width: 0;
  color: var(--p3-ink);
  font-size: 28rpx;
  line-height: 44rpx;
}

.sd-fold__chevron {
  display: flex;
  transition: transform 0.2s ease;
}

.sd-fold__chevron--open {
  transform: rotate(180deg);
}

.sd-fold__body {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
  padding-bottom: 28rpx;
}

/* 条目：4px 青瓷圆点 + 正文；待负责人填写的字段用暖棕字提示 */
.sd-item {
  display: flex;
  align-items: flex-start;
  gap: var(--p3-tight);
}

.sd-item__dot {
  flex: 0 0 auto;
  width: 8rpx;
  height: 8rpx;
  margin-top: 20rpx;
  border-radius: 50%;
  background: var(--p3-primary);
}

.sd-item__text {
  flex: 1 0 0;
  min-width: 0;
  color: var(--p3-ink);
  font-size: 30rpx;
  line-height: 52rpx;
  overflow-wrap: anywhere;
}

.sd-item__text--pending {
  color: var(--p3-warm-ink);
}

.sd-block {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
}

.sd-card {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
  padding: var(--p3-card);
  border-radius: var(--p3-radius-card);
  background: var(--p3-surface);
}

.sd-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--p3-tight);
}

.sd-card__text {
  color: var(--p3-muted);
  font-size: 30rpx;
  line-height: 52rpx;
}

.sd-status {
  flex: 0 0 auto;
  color: var(--p3-warm-ink);
  font-size: 26rpx;
  line-height: 40rpx;
}

.sd-status--done {
  color: var(--p3-primary);
}

/* 两个同等样式的选项（不暗示哪个是“正确”答案） */
.sd-pair {
  display: flex;
  gap: var(--p3-tight);
}

.sd-pair .p3-btn {
  flex: 1 0 0;
  min-width: 0;
  padding: 0 16rpx;
}

.sd-paper {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 28rpx 32rpx;
  border-radius: var(--p3-radius-group);
  background: var(--p3-paper);
}

/* 决定与申请列表：纸白分组，行间细线 */
.sd-list {
  display: flex;
  flex-direction: column;
  padding: 0 32rpx;
  border-radius: var(--p3-radius-group);
  background: var(--p3-surface);
}

.sd-row {
  display: flex;
  align-items: center;
  gap: var(--p3-tight);
  padding: 28rpx 0;
}

.sd-row--divided {
  border-bottom: 2rpx solid var(--p3-hairline);
}

.sd-row__text {
  display: flex;
  flex: 1 0 0;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.sd-row__action {
  flex: 0 0 auto;
  width: auto;
  min-height: var(--safe-touch, 88rpx);
  margin: -16rpx 0;
  padding: 0;
  color: var(--p3-warm-ink);
  font-size: 28rpx;
  line-height: 44rpx;
  text-align: right;
}

.sd-row__action--primary {
  color: var(--p3-primary);
}

.sd-request {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 8rpx;
  padding: 28rpx 0;
}

.sd-request .sd-row__action {
  align-self: flex-start;
  margin: 0;
  text-align: left;
}

.sd-proof {
  overflow-wrap: anywhere;
}
