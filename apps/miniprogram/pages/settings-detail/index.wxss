.settings-detail-page {
  padding-bottom: calc(44rpx + env(safe-area-inset-bottom));
}

.hero-card {
  padding: 24rpx 0 12rpx;
  text-align: center;
}

.hero-kicker,
.hero-title,
.notice-text {
  display: block;
}

.hero-kicker {
  color: var(--safe-primary);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.4;
}

.hero-title {
  margin-top: 10rpx;
  color: var(--safe-title);
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.3;
}

.notice-card {
  position: relative;
  padding: 24rpx 28rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: var(--safe-card);
  box-shadow: var(--safe-shadow-card);
}

.notice-card::before {
  content: "";
  display: block;
  width: 52rpx;
  height: 8rpx;
  margin-bottom: 14rpx;
  border-radius: 999rpx;
  background: var(--safe-primary-deep);
}

.notice-row {
  display: flex;
  gap: 14rpx;
  padding: 12rpx 0;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  flex: 0 0 10rpx;
  margin-top: 18rpx;
  border-radius: 50%;
  background: var(--safe-primary);
}

.notice-text {
  flex: 1;
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.7;
}

.back-button {
  margin-top: 24rpx;
}

.privacy-control-section {
  display: grid;
  gap: 20rpx;
}

.privacy-request-list {
  display: grid;
  gap: 16rpx;
}

.privacy-request-card {
  display: grid;
  gap: 8rpx;
  padding: 24rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: var(--safe-card);
  box-shadow: var(--safe-shadow-card);
}

.privacy-request-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.privacy-request-title {
  color: var(--safe-title);
  font-size: 28rpx;
  font-weight: 900;
}

.privacy-request-meta,
.privacy-boundary {
  display: block;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.6;
}

.privacy-request-notice,
.privacy-request-proof {
  display: block;
  margin-top: 12rpx;
  color: #49685e;
  font-size: 24rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
}

.privacy-request-proof {
  color: #6c7772;
  font-size: 24rpx;
}

.privacy-appeal-button {
  margin-left: 12rpx;
  color: #2f6e5b;
  border-color: #9fc7b9;
}

.privacy-cancel-button {
  min-height: 88rpx;
  margin-top: 8rpx;
  border: 1rpx solid var(--safe-border-strong);
  border-radius: 999rpx;
  background: var(--safe-card);
  color: var(--safe-primary-deep);
  font-size: 26rpx;
  font-weight: 800;
}

.privacy-submit-button {
  margin-top: 0;
}

.privacy-boundary {
  padding: 0 8rpx;
}
.ui2-page.settings-detail-page { background:var(--ui2-canvas); padding-top:48rpx; }
.ui2-page .hero-card { padding:0 0 32rpx; }
.ui2-page .hero-title { font-size:44rpx; font-weight:700; line-height:1.6; text-align:center; }
.ui2-page .hero-kicker { color:var(--ui2-muted); font-size:26rpx; font-weight:500; }
.ui2-page .safe-section { padding:24rpx 0 32rpx; border-bottom:1rpx solid var(--ui2-line); }
.ui2-page .notice-card,.ui2-page .privacy-request-card { padding:16rpx 0; border:0; border-radius:0; box-shadow:none; background:transparent; }
.ui2-page .notice-card::before { display:none; }
.ui2-page .notice-text,.ui2-page .privacy-request-notice,.ui2-page .privacy-boundary { font-size:30rpx; line-height:1.7; color:var(--ui2-ink); }
.ui2-page .notice-text { min-width:0; }
.ui2-page .privacy-request-title { font-size:32rpx; font-weight:700; }
.ui2-page .privacy-request-heading { flex-wrap:wrap; }
.ui2-page .privacy-request-meta,.ui2-page .privacy-request-proof { font-size:26rpx; color:var(--ui2-muted); }
.ui2-page .privacy-request-proof { word-break:break-all; }
.ui2-page .privacy-request-card { border-bottom:1rpx solid var(--ui2-line); gap:16rpx; }
.ui2-page button { box-sizing:border-box; min-height:96rpx; padding:22rpx 24rpx; font-size:30rpx; line-height:1.6; border-radius:24rpx; white-space:normal; }
.ui2-page .back-button { background:transparent; border:2rpx solid var(--ui2-control-border); color:var(--ui2-primary); }
.ui2-page .privacy-appeal-button { margin-left:0; }
.ui2-page .privacy-submit-button { background:var(--safe-danger); }
.ui2-page .privacy-submit-button[disabled] { background:var(--ui2-soft); color:var(--ui2-muted); }
.ui2-page .safe-input { min-height:104rpx; background:var(--ui2-surface); border:2rpx solid var(--ui2-control-border); }
.ui2-page .ui2-placeholder { color:var(--ui2-muted); }

.ui2-page { --ui2-section-accent-display:none; }

.ui2-page .privacy-submit-button:not([disabled]) { background:#a5453f; }
