.thermometer-page {
  display: flex;
  flex-direction: column;
  gap: 34rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
}

.page-head {
  padding: 22rpx 0 8rpx;
  text-align: center;
}

.page-title,
.page-subtitle,
.section-title,
.section-meta,
.level-text,
.step-label,
.micro-title,
.micro-label,
.micro-value,
.field-limit,
.receipt-kicker,
.receipt-title,
.receipt-message,
.receipt-boundary,
.selected-title,
.selected-desc,
.state-title,
.state-text,
.row-title,
.row-level,
.row-meta,
.row-desc {
  display: block;
}

.page-title {
  color: var(--safe-title);
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.2;
}

.page-subtitle {
  margin-top: 14rpx;
  color: var(--safe-muted);
  font-size: 28rpx;
  line-height: 1.6;
}

.record-section,
.curve-section,
.list-section {
  padding-top: 30rpx;
  border-top: 1rpx solid var(--safe-border);
}

.panel-top,
.receipt-heading,
.record-heading,
.micro-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.section-title {
  color: var(--safe-title);
  font-size: 34rpx;
  font-weight: 850;
  line-height: 1.35;
}

.level-text {
  color: var(--safe-primary-deep);
  font-size: 64rpx;
  font-weight: 900;
  line-height: 1;
}

.level-range {
  font-size: 34rpx;
  font-weight: 600;
}

.thermometer-control {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 210rpx;
  align-items: center;
  gap: 32rpx;
  margin-top: 28rpx;
  padding-bottom: 34rpx;
}

.thermometer-visual {
  display: flex;
  align-items: stretch;
  justify-content: center;
  gap: 18rpx;
  min-width: 0;
}

.thermometer-scale {
  height: 396rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  align-items: flex-end;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1;
}

.thermometer-shell {
  width: 108rpx;
  min-height: 396rpx;
  display: flex;
  justify-content: center;
  touch-action: none;
}

.thermometer-track {
  position: relative;
  width: 58rpx;
  height: 396rpx;
  overflow: visible;
  border: 1rpx solid var(--safe-border);
  border-radius: 30rpx;
  background: var(--safe-bg-leaf);
}

.thermometer-fill {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  min-height: 10%;
  border-radius: 30rpx;
  background: var(--safe-primary);
}

.thermometer-marker {
  position: absolute;
  left: 50%;
  width: 70rpx;
  height: 70rpx;
  margin-bottom: -35rpx;
  margin-left: -35rpx;
  border: 6rpx solid #ffffff;
  border-radius: 50%;
  background: var(--safe-primary);
  box-shadow: 0 4rpx 12rpx rgba(52, 66, 58, 0.12);
}

.thermometer-actions {
  padding-left: 30rpx;
  border-left: 1rpx solid var(--safe-border);
}

.step-label {
  color: var(--safe-muted);
  font-size: 26rpx;
  line-height: 1.5;
}

.step-button-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 22rpx;
}

.step-button {
  width: 88rpx;
  height: 88rpx;
  min-height: 88rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--safe-primary);
  border-radius: 50%;
  background: transparent;
  color: var(--safe-primary-deep);
  font-size: 42rpx;
  font-weight: 500;
  line-height: 1;
}

.step-button::after,
.receipt-close::after,
.refresh-button::after {
  border: 0;
}

.step-button:active,
.receipt-close:active,
.refresh-button:active {
  opacity: 0.75;
  transform: scale(0.97);
}

.micro-panel {
  padding-top: 30rpx;
  border-top: 1rpx solid var(--safe-border);
}

.micro-title {
  color: var(--safe-title);
  font-size: 30rpx;
  font-weight: 850;
  line-height: 1.4;
}

.micro-row {
  padding: 24rpx 0 18rpx;
  border-bottom: 1rpx solid var(--safe-border);
}

.micro-label,
.micro-value {
  color: var(--safe-text);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
}

.micro-value {
  color: var(--safe-primary-deep);
}

.micro-slider {
  width: 100%;
  margin: 12rpx 0 0;
  padding: 0;
}

.text-field {
  position: relative;
  margin-top: 20rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-sm);
  background: var(--safe-card);
}

.emotion-input,
.brief-input {
  box-sizing: border-box;
  width: 100%;
  padding-right: 112rpx;
  padding-left: 22rpx;
  color: var(--safe-title);
  font-size: 28rpx;
  line-height: 1.55;
}

.emotion-input {
  min-height: 88rpx;
}

.brief-input {
  min-height: 168rpx;
  padding-top: 22rpx;
  padding-bottom: 22rpx;
}

.field-limit {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.4;
}

.save-button {
  width: 100%;
  min-height: 92rpx;
  margin: 26rpx 0 0;
  border-radius: var(--safe-radius-sm);
}

.receipt-panel,
.error-panel,
.selected-point,
.quiet-state {
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-sm);
  background: var(--safe-primary-pale);
}

.receipt-panel,
.error-panel {
  padding: 26rpx;
}

.receipt-title-group {
  min-width: 0;
  flex: 1;
}

.receipt-kicker {
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 800;
}

.receipt-title,
.state-title,
.selected-title {
  margin-top: 6rpx;
  color: var(--safe-title);
  font-size: 30rpx;
  font-weight: 850;
  line-height: 1.4;
}

.receipt-close {
  width: 88rpx;
  height: 88rpx;
  min-height: 88rpx;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--safe-muted);
  font-size: 38rpx;
}

.receipt-message,
.receipt-boundary,
.state-text,
.selected-desc {
  margin-top: 14rpx;
  color: var(--safe-text);
  font-size: 28rpx;
  line-height: 1.6;
}

.receipt-boundary {
  color: var(--safe-muted);
}

.receipt-action,
.retry-button {
  width: 100%;
  min-height: 88rpx;
  margin: 22rpx 0 0;
  border-radius: var(--safe-radius-sm);
}

.curve-heading {
  align-items: flex-start;
}

.section-meta {
  margin-top: 8rpx;
  color: var(--safe-muted);
  font-size: 26rpx;
  line-height: 1.4;
}

.refresh-button {
  min-width: 96rpx;
  min-height: 88rpx;
  padding: 0 18rpx;
  border: 0;
  background: transparent;
  color: var(--safe-primary-deep);
  font-size: 26rpx;
  font-weight: 800;
}

.curve-canvas {
  width: 100%;
  height: 340rpx;
  margin-top: 20rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-sm);
  background: #ffffff;
}

.selected-point,
.quiet-state {
  margin-top: 18rpx;
  padding: 22rpx;
}

.error-panel {
  border-color: #edd7d4;
  background: #fff7f5;
}

.list-section > .section-title {
  margin-bottom: 8rpx;
}

.record-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--safe-border);
}

.record-badge {
  width: 58rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 58rpx;
  border-radius: 50%;
  background: var(--safe-primary-soft);
  color: var(--safe-primary-deep);
  font-size: 26rpx;
  font-weight: 900;
}

.record-copy {
  min-width: 0;
  flex: 1;
}

.row-title,
.row-level {
  color: var(--safe-title);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.4;
}

.row-level {
  color: var(--safe-primary-deep);
}

.row-meta,
.row-desc {
  margin-top: 8rpx;
  color: var(--safe-muted);
  font-size: 26rpx;
  line-height: 1.5;
}

.list-empty {
  margin-top: 18rpx;
}

.boundary-note {
  padding: 24rpx 0 0;
  border-top: 1rpx solid var(--safe-border);
  color: var(--safe-muted);
  font-size: 26rpx;
  line-height: 1.65;
}

@media (max-width: 360px) {
  .thermometer-control {
    grid-template-columns: minmax(0, 1fr) 176rpx;
    gap: 20rpx;
  }

  .thermometer-actions {
    padding-left: 20rpx;
  }

  .step-button-row {
    gap: 10rpx;
  }

  .step-button {
    width: 78rpx;
    height: 88rpx;
  }

  .record-heading {
    align-items: flex-start;
    flex-direction: column;
    gap: 4rpx;
  }
}
