.thermometer-page {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.page-head {
  padding: 28rpx 0 6rpx;
  border: 0;
  box-shadow: none;
  background: transparent;
}

.record-panel,
.curve-panel,
.list-panel {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.panel-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.level-text {
  color: var(--safe-primary-deep);
  font-size: 36rpx;
  font-weight: 900;
}

.brief-input {
  width: 100%;
  min-height: 164rpx;
  box-sizing: border-box;
  padding: 22rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-sm);
  background: #fffdf8;
  color: var(--safe-title);
  font-size: 26rpx;
  line-height: 1.6;
}

.refresh-button {
  padding: 12rpx 24rpx;
  border: 1rpx solid var(--safe-border-strong);
  border-radius: var(--safe-radius-pill);
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 800;
}

.curve-canvas {
  width: 100%;
  height: 360rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-sm);
  background: #ffffff;
}

.selected-point,
.empty-tip,
.boundary-note {
  padding: 22rpx;
  border-radius: var(--safe-radius-sm);
  background: var(--safe-primary-pale);
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.6;
}

.record-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--safe-border);
}

.record-row:first-of-type {
  border-top: 0;
}

.record-badge {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--safe-primary-soft);
  color: var(--safe-primary-deep);
  font-weight: 900;
}

.record-copy {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.row-title {
  color: var(--safe-title);
  font-size: 26rpx;
  font-weight: 800;
}

.row-desc {
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.5;
}
