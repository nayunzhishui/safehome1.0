/* 情绪温度计（Figma 647:955）：强度卡（衬线数字、横放温度计、±微调）；补充观察；记录一次；今日曲线；今天的记录。 */
page {
  background: var(--p3-paper);
}

.thermo-page {
  display: flex;
  flex-direction: column;
  gap: var(--p3-section);
  box-sizing: border-box;
  min-height: 100vh;
  padding: 16rpx var(--p3-page-x) calc(72rpx + env(safe-area-inset-bottom));
  background: var(--p3-paper);
  overflow-x: hidden;
}

.thermo-now {
  gap: var(--p3-stack);
}

.thermo-now__head {
  display: flex;
  align-items: baseline;
  gap: var(--p3-tight);
}

.thermo-now__title {
  flex: 1 0 0;
  min-width: 0;
  color: var(--p3-ink);
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: 500;
}

.thermo-now__value {
  color: var(--p3-ink);
  font-family: var(--p3-font-serif);
  font-size: 60rpx;
  line-height: 80rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.thermo-now__range {
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

.thermo-now__steps {
  display: flex;
  justify-content: center;
  gap: var(--p3-stack);
}

.thermo-step {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  min-height: 96rpx;
  border-radius: 50%;
  background: var(--p3-surface);
  box-shadow: inset 0 0 0 2rpx var(--p3-hairline);
  color: var(--p3-primary);
  font-size: 40rpx;
  line-height: 56rpx;
  font-weight: 500;
}

.thermo-section {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
  min-width: 0;
}

.thermo-section__head {
  display: flex;
  align-items: flex-start;
  gap: var(--p3-tight);
}

.thermo-section__header {
  flex: 1 0 0;
  min-width: 0;
}

.thermo-section__head .p3-link {
  min-height: 40rpx;
}

.thermo-save {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
}

.thermo-micro {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
}

.micro-value {
  display: block;
  color: var(--p3-ink);
  font-size: 28rpx;
  line-height: 44rpx;
}

.micro-slider {
  display: block;
  width: 100%;
}

.thermo-receipt__head {
  display: flex;
  align-items: center;
  gap: var(--p3-tight);
}

.thermo-receipt__head .p3-notice__title {
  flex: 1 0 0;
}

.thermo-receipt__close {
  width: 72rpx;
  height: 72rpx;
  min-height: 72rpx;
  color: var(--p3-muted);
  font-size: 36rpx;
  line-height: 72rpx;
}

.thermo-receipt__boundary {
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

.thermo-receipt__action {
  margin-top: 8rpx;
}

.thermo-curve {
  position: relative;
  overflow: hidden;
  border-radius: var(--p3-radius-group);
  background: var(--p3-surface);
}

.thermo-curve__grid {
  position: absolute;
  left: 5.71%;
  right: 5.71%;
  height: 2rpx;
  background: var(--p3-hairline);
}

.thermo-curve__segment {
  position: absolute;
  height: 5rpx;
  margin-top: -2.5rpx;
  border-radius: 3rpx;
  background: var(--p3-primary);
  transform-origin: 0 50%;
}

.thermo-curve__point {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  min-height: 64rpx;
  margin: -32rpx 0 0 -32rpx;
}

.thermo-curve__dot {
  box-sizing: border-box;
  width: 28rpx;
  height: 28rpx;
  border: 6rpx solid var(--p3-surface);
  border-radius: 50%;
}

.thermo-curve__label {
  position: absolute;
  width: 96rpx;
  margin-left: -48rpx;
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
  text-align: center;
}

.thermo-selected {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 24rpx 32rpx;
  border-radius: 32rpx;
  background: var(--p3-mist);
}

.thermo-selected__title {
  color: var(--p3-ink);
  font-size: 28rpx;
  line-height: 44rpx;
  font-weight: 500;
}

.thermo-selected__body {
  color: var(--p3-muted);
  font-size: 28rpx;
  line-height: 44rpx;
}

.thermo-record {
  display: flex;
  align-items: center;
  gap: var(--p3-stack);
  padding: 24rpx 0;
}

.thermo-record--divided {
  box-shadow: inset 0 -2rpx 0 var(--p3-hairline);
}

.thermo-record__badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  flex: 0 0 auto;
  border-radius: 50%;
  color: var(--p3-ink);
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: 500;
}

.thermo-record__text {
  flex: 1 0 0;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  overflow-wrap: anywhere;
}

.thermo-record__head {
  display: flex;
  align-items: flex-start;
  gap: var(--p3-tight);
}

.thermo-record__time {
  flex: 1 0 0;
  color: var(--p3-ink);
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: 500;
}

.thermo-record__level,
.thermo-record__meta {
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

.thermo-record__brief {
  color: var(--p3-ink);
  font-size: 28rpx;
  line-height: 44rpx;
}
