.feedback-page {
  padding-bottom: calc(52rpx + env(safe-area-inset-bottom));
}

.feedback-hero {
  position: relative;
  min-height: 258rpx;
  overflow: hidden;
}

.hero-copy {
  position: relative;
  z-index: 1;
  max-width: 470rpx;
}

.hero-title {
  display: block;
  color: var(--safe-title);
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.28;
  letter-spacing: 0;
}

.hero-summary {
  display: block;
  margin-top: 14rpx;
  color: var(--safe-text);
  font-size: 27rpx;
  line-height: 1.62;
}

.hero-steps {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.hero-steps text {
  min-height: 44rpx;
  display: inline-flex;
  align-items: center;
  padding: 0 16rpx;
  border: 1rpx solid rgba(87, 139, 95, 0.16);
  border-radius: var(--safe-radius-pill);
  background: rgba(255, 253, 248, 0.78);
  color: var(--safe-primary-deep);
  font-size: 22rpx;
  font-weight: 800;
}

.feedback-content {
  display: flex;
  flex-direction: column;
}

.loading-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 32rpx;
  color: var(--safe-text);
  font-size: 28rpx;
  line-height: 1.6;
}

.loading-dot {
  width: 18rpx;
  height: 18rpx;
  flex: 0 0 18rpx;
  border-radius: 50%;
  background: var(--safe-primary);
  opacity: 0.72;
}

.error-state {
  margin-top: 24rpx;
}

.error-action-button {
  width: 100%;
  min-height: 80rpx;
  margin-top: 20rpx;
  border-radius: var(--safe-radius-pill);
  background: var(--safe-primary);
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 850;
  line-height: 80rpx;
}

.error-action-button::after {
  border: 0;
}

.boundary-card {
  margin-top: 22rpx;
  padding: 22rpx 26rpx;
  border: 1rpx solid rgba(87, 139, 95, 0.18);
  border-radius: 22rpx;
  background: rgba(233, 242, 223, 0.6);
}

.boundary-title {
  display: block;
  margin-bottom: 8rpx;
  color: var(--safe-primary-deep);
  font-size: 26rpx;
  font-weight: 800;
}

.boundary-text {
  display: block;
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.7;
}

.support-card {
  margin-top: 28rpx;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(52, 66, 58, 0.06);
}

.support-label {
  display: block;
  margin-bottom: 14rpx;
  color: var(--safe-primary);
  font-size: 24rpx;
  font-weight: 800;
}

.support-text {
  display: block;
  color: var(--safe-title);
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.75;
}

.overview-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 20rpx;
}

.overview-item {
  min-height: 132rpx;
  padding: 24rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: 22rpx;
  background: var(--safe-card);
  box-shadow: 0 8rpx 18rpx rgba(52, 66, 58, 0.05);
}

.overview-label {
  display: block;
  margin-bottom: 12rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.4;
}

.overview-value {
  display: block;
  color: var(--safe-title);
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.45;
}

.trigger-card {
  margin-top: 20rpx;
  color: var(--safe-title);
  font-size: 28rpx;
  line-height: 1.75;
}

.not-diagnosis-card {
  margin-top: 20rpx;
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.75;
}

.pattern-list,
.training-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 20rpx;
}

.pattern-card {
  padding: 26rpx 28rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: 22rpx;
  background: var(--safe-card);
  box-shadow: 0 8rpx 18rpx rgba(52, 66, 58, 0.05);
}

.pattern-title {
  display: block;
  margin-bottom: 10rpx;
  color: var(--safe-primary-deep);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.4;
}

.pattern-text {
  display: block;
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.75;
}

.today-suggestion-card {
  margin-top: 20rpx;
}

.today-suggestion-label {
  display: block;
  margin-bottom: 10rpx;
  color: var(--safe-primary);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.45;
}

.today-suggestion-text {
  display: block;
  color: var(--safe-title);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.65;
}

.today-suggestion-reason,
.today-suggestion-boundary {
  display: block;
  margin-top: 12rpx;
  color: var(--safe-text);
  font-size: 25rpx;
  line-height: 1.7;
}

.today-suggestion-boundary {
  color: var(--safe-muted);
}

.practice-card {
  margin-top: 20rpx;
  border-color: rgba(244, 127, 69, 0.22);
  background: var(--safe-card);
  box-shadow: 0 10rpx 24rpx rgba(121, 84, 48, 0.06);
}

.practice-title {
  display: block;
  margin-bottom: 10rpx;
  color: var(--safe-title);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.45;
}

.practice-text {
  display: block;
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.75;
}

.practice-main-button {
  min-height: 78rpx;
  margin: 22rpx 0 0;
  border-radius: var(--safe-radius-pill);
  background: var(--safe-primary);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 850;
  line-height: 78rpx;
}

.more-training-button {
  min-height: 72rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-pill);
  background: rgba(255, 253, 248, 0.86);
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 72rpx;
}

.more-training-button::after {
  border: 0;
}

.training-more-row {
  margin-top: 0;
}

.practice-main-button::after {
  border: 0;
}

.risk-support-card {
  padding: 26rpx 28rpx;
  border: 1rpx solid rgba(179, 82, 65, 0.24);
  border-radius: var(--safe-radius-md);
  background: rgba(255, 243, 238, 0.88);
  box-shadow: var(--safe-shadow-card);
}

.risk-support-title {
  display: block;
  margin-bottom: 10rpx;
  color: #9f3d2e;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.45;
}

.risk-support-text,
.risk-support-note {
  display: block;
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.75;
}

.risk-support-note {
  margin-top: 10rpx;
  color: var(--safe-muted);
}

.supervision-entry {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 40rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid rgba(111, 143, 184, 0.22);
  border-radius: var(--safe-radius-md);
  background: var(--safe-blue-soft);
}

.supervision-copy {
  flex: 1;
  min-width: 0;
}

.supervision-title {
  display: block;
  color: var(--safe-title);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1.45;
}

.supervision-text {
  display: block;
  margin-top: 6rpx;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.65;
}

.supervision-link {
  min-width: 150rpx;
  min-height: 64rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(111, 143, 184, 0.34);
  border-radius: var(--safe-radius-pill);
  background: var(--safe-card);
  color: var(--safe-info);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 64rpx;
}

.supervision-link::after {
  border: 0;
}

.action-grid {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 32rpx;
}

.action-button {
  width: 100%;
}
