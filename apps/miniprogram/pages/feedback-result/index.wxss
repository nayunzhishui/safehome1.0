.page {
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: #fff7ec;
}

.hero {
  margin-bottom: 28rpx;
  padding: 32rpx;
  border: 1rpx solid #efe7dc;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f7faf4 100%);
  box-shadow: 0 12rpx 32rpx rgba(80, 64, 45, 0.08);
}

.eyebrow {
  display: block;
  margin-bottom: 10rpx;
  color: #4caf7d;
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  display: block;
  margin-bottom: 14rpx;
  color: #333333;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.32;
}

.summary,
.body-text,
.muted {
  display: block;
  color: #555555;
  font-size: 28rpx;
  line-height: 1.7;
}

.panel,
.status {
  padding: 32rpx;
  border: 1rpx solid #efe7dc;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(80, 64, 45, 0.08);
}

.status.error {
  border-color: #efb4b4;
  background: #fff1f1;
  color: #8a2f2f;
  box-shadow: none;
}

.notice-box {
  margin-bottom: 28rpx;
  padding: 22rpx;
  border: 1rpx solid #dbeed6;
  border-radius: 20rpx;
  background: #eef8e9;
}

.notice-title {
  display: block;
  margin-bottom: 8rpx;
  color: #4caf7d;
  font-size: 28rpx;
  font-weight: 700;
}

.notice-text {
  display: block;
  color: #555555;
  font-size: 26rpx;
  line-height: 1.7;
}

.result-block {
  margin-bottom: 28rpx;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid #efe7dc;
}

.block-title {
  display: block;
  margin-bottom: 12rpx;
  color: #333333;
  font-size: 30rpx;
  font-weight: 700;
}

.pattern-card {
  margin-top: 18rpx;
  padding: 22rpx;
  border: 1rpx solid #efe7dc;
  border-radius: 20rpx;
  background: #fffdf9;
}

.pattern-title {
  display: block;
  margin-bottom: 8rpx;
  color: #4caf7d;
  font-size: 26rpx;
  font-weight: 700;
}

.primary-button {
  min-height: 88rpx;
  margin-top: 8rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #7ccb8a, #4caf7d);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 26rpx rgba(76, 175, 125, 0.22);
}

.secondary-button {
  min-height: 88rpx;
  margin-top: 20rpx;
  border: 1rpx solid #ffb26b;
  border-radius: 44rpx;
  background: #ffffff;
  color: #f28b38;
  font-size: 28rpx;
  font-weight: 700;
}
