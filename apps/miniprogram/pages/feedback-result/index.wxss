.page {
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: #fff7ec;
}

.hero {
  margin-bottom: 28rpx;
  padding: 32rpx;
  border: 1rpx solid #efe7dc;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f7faf4 100%);
  box-shadow: 0 12rpx 32rpx rgba(80, 64, 45, 0.08);
}

.eyebrow {
  display: block;
  margin-bottom: 10rpx;
  color: #4caf7d;
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  display: block;
  margin-bottom: 14rpx;
  color: #333333;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.32;
}

.summary,
.body-text,
.muted {
  display: block;
  color: #555555;
  font-size: 28rpx;
  line-height: 1.7;
}

.panel,
.status {
  padding: 32rpx;
  border: 1rpx solid #efe7dc;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(80, 64, 45, 0.08);
}

.status.error {
  border-color: #efb4b4;
  background: #fff1f1;
  color: #8a2f2f;
  box-shadow: none;
}

.notice-box {
  margin-bottom: 28rpx;
  padding: 22rpx;
  border: 1rpx solid #dbeed6;
  border-radius: 20rpx;
  background: #eef8e9;
}

.notice-title {
  display: block;
  margin-bottom: 8rpx;
  color: #4caf7d;
  font-size: 28rpx;
  font-weight: 700;
}

.notice-text {
  display: block;
  color: #555555;
  font-size: 26rpx;
  line-height: 1.7;
}

.result-block {
  margin-bottom: 28rpx;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid #efe7dc;
}

.block-title {
  display: block;
  margin-bottom: 12rpx;
  color: #333333;
  font-size: 30rpx;
  font-weight: 700;
}

.pattern-card {
  margin-top: 18rpx;
  padding: 22rpx;
  border: 1rpx solid #efe7dc;
  border-radius: 20rpx;
  background: #fffdf9;
}

.pattern-title {
  display: block;
  margin-bottom: 8rpx;
  color: #4caf7d;
  font-size: 26rpx;
  font-weight: 700;
}

.primary-button {
  min-height: 88rpx;
  margin-top: 8rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #7ccb8a, #4caf7d);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 26rpx rgba(76, 175, 125, 0.22);
}

.secondary-button {
  min-height: 88rpx;
  margin-top: 20rpx;
  border: 1rpx solid #ffb26b;
  border-radius: 44rpx;
  background: #ffffff;
  color: #f28b38;
  font-size: 28rpx;
  font-weight: 700;
}

.feedback-page {
  padding-bottom: 48rpx;
}

.page-head {
  padding: 32rpx;
  border: 1rpx solid #efe7dc;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f7faf4 100%);
  box-shadow: 0 12rpx 32rpx rgba(80, 64, 45, 0.08);
}

.page-title,
.page-subtitle {
  display: block;
}

.page-title {
  color: #333333;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.32;
}

.page-subtitle {
  margin-top: 12rpx;
  color: #555555;
  font-size: 26rpx;
  line-height: 1.65;
}

.head-image {
  width: 100%;
  height: 300rpx;
  display: block;
  margin-top: 24rpx;
  overflow: hidden;
  border-radius: 22rpx;
  background: #fffaf3;
}

.loading-card,
.overview-card,
.feedback-card,
.reminder-card {
  border: 1rpx solid #efe7dc;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(80, 64, 45, 0.08);
}

.loading-card {
  margin-top: 32rpx;
  padding: 32rpx;
  color: #555555;
  font-size: 28rpx;
  line-height: 1.6;
}

.overview-card {
  margin-top: 20rpx;
  padding: 24rpx;
}

.overview-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #efe7dc;
}

.overview-row:last-child {
  border-bottom: 0;
}

.overview-label {
  flex: 0 0 auto;
  color: #777777;
  font-size: 24rpx;
}

.overview-value {
  min-width: 0;
  color: #333333;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.5;
  text-align: right;
}

.pattern-list,
.training-list {
  display: grid;
  gap: 18rpx;
  margin-top: 20rpx;
}

.feedback-card,
.reminder-card {
  margin-top: 20rpx;
  padding: 24rpx;
  color: #555555;
  font-size: 26rpx;
  line-height: 1.7;
}

.reminder-card {
  background: #fff9e8;
  color: #735b21;
}

.action-grid {
  display: grid;
  gap: 18rpx;
  margin-top: 32rpx;
}

.action-button {
  width: 100%;
}
