.page {
  min-height: 100vh;
  padding: 32rpx;
  background: #f6f8f4;
}

.hero {
  padding: 20rpx 4rpx 28rpx;
}

.eyebrow {
  display: block;
  margin-bottom: 10rpx;
  color: #3c7a49;
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  display: block;
  margin-bottom: 14rpx;
  color: #1d2b22;
  font-size: 40rpx;
  font-weight: 700;
}

.summary,
.body-text,
.muted {
  display: block;
  color: #5b6b60;
  font-size: 28rpx;
  line-height: 1.7;
}

.panel,
.status {
  padding: 32rpx;
  border: 1rpx solid #dce6db;
  border-radius: 8rpx;
  background: #ffffff;
}

.status.error {
  border-color: #efb4b4;
  background: #fff1f1;
  color: #8a2f2f;
}

.notice-box {
  margin-bottom: 28rpx;
  padding: 22rpx;
  border: 1rpx solid #cfe1cf;
  border-radius: 8rpx;
  background: #edf8ee;
}

.notice-title {
  display: block;
  margin-bottom: 8rpx;
  color: #245b34;
  font-size: 28rpx;
  font-weight: 700;
}

.notice-text {
  display: block;
  color: #466650;
  font-size: 26rpx;
  line-height: 1.7;
}

.result-block {
  margin-bottom: 28rpx;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid #e6eee5;
}

.block-title {
  display: block;
  margin-bottom: 12rpx;
  color: #1d2b22;
  font-size: 30rpx;
  font-weight: 700;
}

.pattern-card {
  margin-top: 18rpx;
  padding: 22rpx;
  border: 1rpx solid #dce6db;
  border-radius: 8rpx;
  background: #f9fbf8;
}

.pattern-title {
  display: block;
  margin-bottom: 8rpx;
  color: #2f7d45;
  font-size: 26rpx;
  font-weight: 700;
}

.primary-button {
  margin-top: 8rpx;
  background: #2f7d45;
  color: #ffffff;
  border-radius: 8rpx;
}

.secondary-button {
  margin-top: 20rpx;
  border: 1rpx solid #c9d9c8;
  background: #eef3ed;
  color: #2f7d45;
  border-radius: 8rpx;
}
