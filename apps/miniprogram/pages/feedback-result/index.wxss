.page {
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: var(--safe-bg);
}

.hero {
  margin-bottom: 28rpx;
  padding: 32rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: 16rpx;
  background: linear-gradient(135deg, #fffdf8 0%, #f6faf2 100%);
  box-shadow: 0 14rpx 34rpx rgba(52, 66, 58, 0.08);
}

.eyebrow {
  display: block;
  margin-bottom: 10rpx;
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  display: block;
  margin-bottom: 14rpx;
  color: var(--safe-title);
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.32;
}

.summary,
.body-text,
.muted {
  display: block;
  color: var(--safe-text);
  font-size: 28rpx;
  line-height: 1.7;
}

.panel,
.status {
  padding: 32rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: 16rpx;
  background: var(--safe-card);
  box-shadow: 0 14rpx 34rpx rgba(52, 66, 58, 0.08);
}

.status.error {
  border-color: #efd0cc;
  background: #fbe8e2;
  color: #8a2f2f;
  box-shadow: none;
}

.notice-box {
  margin-bottom: 28rpx;
  padding: 22rpx;
  border: 1rpx solid #cddfc5;
  border-radius: 16rpx;
  background: #edf6e8;
}

.notice-title {
  display: block;
  margin-bottom: 8rpx;
  color: var(--safe-primary-deep);
  font-size: 28rpx;
  font-weight: 700;
}

.notice-text {
  display: block;
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.7;
}

.result-block {
  margin-bottom: 28rpx;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid var(--safe-border);
}

.block-title {
  display: block;
  margin-bottom: 12rpx;
  color: var(--safe-title);
  font-size: 30rpx;
  font-weight: 700;
}

.pattern-card {
  margin-top: 18rpx;
  padding: 22rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: 16rpx;
  background: var(--safe-card);
}

.pattern-title {
  display: block;
  margin-bottom: 8rpx;
  color: var(--safe-primary-deep);
  font-size: 26rpx;
  font-weight: 700;
}

.primary-button {
  min-height: 88rpx;
  margin-top: 8rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, var(--safe-primary), var(--safe-primary-deep));
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 14rpx 28rpx rgba(78, 124, 107, 0.22);
}

.secondary-button {
  min-height: 88rpx;
  margin-top: 20rpx;
  border: 1rpx solid var(--safe-primary);
  border-radius: 44rpx;
  background: var(--safe-card);
  color: var(--safe-primary-deep);
  font-size: 28rpx;
  font-weight: 700;
}

.feedback-page {
  padding-bottom: 48rpx;
}

.page-title,
.page-subtitle {
  display: block;
}

.page-subtitle {
  margin-top: 12rpx;
}

.loading-card,
.overview-card,
.feedback-card,
.reminder-card {
  border: 1rpx solid var(--safe-border);
  border-radius: 16rpx;
  background: var(--safe-card);
  box-shadow: 0 14rpx 34rpx rgba(52, 66, 58, 0.08);
}

.loading-card {
  margin-top: 32rpx;
  padding: 32rpx;
  color: var(--safe-text);
  font-size: 28rpx;
  line-height: 1.6;
}

.overview-card {
  margin-top: 20rpx;
  padding: 24rpx;
}

.overview-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--safe-border);
}

.overview-row:last-child {
  border-bottom: 0;
}

.overview-label {
  flex: 0 0 auto;
  color: var(--safe-muted);
  font-size: 24rpx;
}

.overview-value {
  min-width: 0;
  color: var(--safe-title);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.5;
  text-align: right;
}

.pattern-list,
.training-list {
  display: grid;
  gap: 18rpx;
  margin-top: 20rpx;
}

.feedback-card,
.reminder-card {
  margin-top: 20rpx;
  padding: 24rpx;
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.7;
}

.reminder-card {
  background: #fff4e8;
  color: #6f5527;
}

.action-button {
  width: 100%;
}
