<view class="feedback-page" role="main" aria-label="支持性反馈">
  <page-state wx:if="{{loading}}" kind="loading" title="正在整理这次反馈" />

  <page-state wx:elif="{{errorMessage}}" kind="error" title="反馈暂时没有生成" description="{{errorMessage}}" action-label="{{missingDiaryId ? '去记录一次事件' : '重新生成'}}" bind:action="handleFeedbackStateAction" />

  <block wx:else>
    <view wx:if="{{isHighRisk}}" class="p3-notice p3-notice--risk feedback-risk" role="alert">
      <text class="p3-notice__title">优先联系现实支持</text>
      <text class="p3-notice__body">{{riskSupportText}}</text>
      <text class="feedback-risk__note">这里不是实时危机服务，也不替代线下专业支持或当地紧急服务。</text>
      <view class="feedback-risk__actions">
        <button class="p3-btn p3-btn--primary" bindtap="openEmergencyGuide">查看安全指引</button>
        <button class="p3-btn p3-btn--secondary" bindtap="openSupervision">提交人工关注</button>
      </view>
    </view>

    <view class="feedback-hold">
      <view class="feedback-hold__head">
        <image class="feedback-hold__art" src="/assets/art/empty-sprout.svg" aria-hidden="true" />
        <text class="feedback-hold__title" role="heading" aria-level="1">先接住这次感受</text>
      </view>
      <text class="feedback-hold__body">{{feedback.supportive_feedback}}</text>
    </view>

    <feedback-rating value="{{feedbackEvaluation}}" disabled="{{feedbackEvaluationSaving}}" bind:select="submitFeedbackEvaluation" />

    <view class="feedback-section">
      <p3-section-header title="本次情绪概览" />
      <view class="feedback-cells">
        <view class="feedback-cell">
          <text class="feedback-cell__value">{{emotionOverview.mainEmotion}}</text>
          <text class="feedback-cell__label">主要情绪</text>
        </view>
        <view class="feedback-cell">
          <text class="feedback-cell__value">{{emotionOverview.intensity}}</text>
          <text class="feedback-cell__label">情绪强度</text>
        </view>
      </view>
      <text class="feedback-trigger">{{emotionOverview.scene ? '场景：' + emotionOverview.scene + ' · ' : ''}}可能触发点：{{emotionOverview.trigger}}</text>
    </view>

    <view wx:if="{{!isHighRisk}}" class="feedback-section">
      <p3-section-header title="互动线索" />
      <view class="p3-group">
        <view wx:for="{{patternCards}}" wx:key="title" class="feedback-clue {{index < patternCards.length - 1 ? 'feedback-clue--divided' : ''}}">
          <text class="feedback-clue__title">{{item.title}}</text>
          <text class="feedback-clue__text">{{item.text}}</text>
        </view>
      </view>
    </view>

    <block wx:if="{{canShowTraining}}">
      <view wx:if="{{trainingRecommendation}}" class="p3-card feedback-today" aria-label="今天先做哪一步">
        <text class="feedback-today__kicker">今天先做 · 主练习</text>
        <text class="feedback-today__title">{{recommendedTrainings[0].title || "一个轻量练习"}}</text>
        <text class="feedback-today__body">{{trainingRecommendation.today_suggestion}}</text>
        <text wx:if="{{trainingRecommendation.reason}}" class="feedback-today__reason">推荐理由：{{trainingRecommendation.reason}}</text>
        <button class="p3-btn p3-btn--primary" bindtap="openTrainingCard">开始这个练习</button>
      </view>
      <view wx:else class="p3-card feedback-today" aria-label="今天先做哪一步">
        <text class="feedback-today__kicker">今天先做</text>
        <text class="feedback-today__body">这次记录暂时没有匹配到具体训练卡，可以先暂停几秒，再说出一个最明显的感受。</text>
        <text class="feedback-today__reason">今日建议只作为支持性练习参考，不构成诊断或治疗方案。</text>
      </view>
    </block>

    <view wx:if="{{!isHighRisk}}" class="p3-group" aria-label="也可以选择">
      <button
        wx:for="{{alternativeTrainings}}"
        wx:key="cardId"
        class="feedback-row"
        aria-label="备选练习：{{item.title}}"
        bindtap="openTrainingCard"
      >
        <p3-group-row icon="leaf" title="{{item.title}}" subtitle="{{item.rowSubtitle}}" />
      </button>
      <button class="feedback-row" aria-label="需要多一个人帮你看一看？提交给人工督导" bindtap="openSupervision">
        <p3-group-row icon="person" title="需要多一个人帮你看一看？" subtitle="反复出现或担心撑不住时，提交给人工督导" show-divider="{{false}}" />
      </button>
    </view>

    <text wx:if="{{trainingRecommendation && trainingRecommendation.boundary_notice}}" class="p3-footnote">{{trainingRecommendation.boundary_notice}}</text>

    <view class="p3-notice">
      <text class="p3-notice__title">怎样理解这份反馈</text>
      <text class="p3-notice__body">它只整理这一次记录中可观察的情绪、互动和练习位置，不代表固定问题，也不构成诊断、评分或治疗建议。</text>
    </view>

    <button class="p3-btn p3-btn--quiet" bindtap="saveFeedback">查看保存说明</button>
  </block>
</view>
