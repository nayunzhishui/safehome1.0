<view class="safe-page feedback-page">
  <view class="feedback-hero safe-card safe-card--hero">
    <view class="hero-copy">
      <text class="hero-title">先看见发生了什么</text>
      <text class="hero-summary">以下内容用于自我观察和练习参考，不评价谁对谁错。</text>
      <view class="hero-steps">
        <text>支持性总结</text>
        <text>一个小练习</text>
        <text>必要时找人看</text>
      </view>
    </view>
  </view>

  <page-state wx:if="{{loading}}" kind="loading" title="正在整理这次反馈" description="先保留事实，再给出一个可选择的小练习。" />

  <page-state wx:elif="{{errorMessage}}" kind="error" title="反馈暂时没有生成" description="{{errorMessage}}" action-label="{{missingDiaryId ? '去记录一次事件' : '重新生成'}}" bind:action="handleFeedbackStateAction" />

  <view wx:else class="feedback-content">
    <view class="support-card safe-card">
      <text class="support-label">先接住这次感受</text>
      <text class="support-text">{{feedback.supportive_feedback}}</text>
    </view>

    <view class="safe-section">
      <feedback-rating value="{{feedbackEvaluation}}" disabled="{{feedbackEvaluationSaving}}" bind:select="submitFeedbackEvaluation" />
    </view>

    <view class="safe-section">
      <section-title title="本次情绪概览" subtitle="先看见主要感受和强度，不急着下结论" />
      <view class="overview-grid">
        <view class="overview-item">
          <text class="overview-label">主要情绪</text>
          <text class="overview-value">{{emotionOverview.mainEmotion}}</text>
        </view>
        <view class="overview-item">
          <text class="overview-label">情绪强度</text>
          <text class="overview-value">{{emotionOverview.intensity}}</text>
        </view>
      </view>
    </view>

    <view class="safe-section">
      <section-title title="可能触发点" subtitle="用“可能”来看这次互动的起点" />
      <view class="trigger-card safe-card">
        <text>{{emotionOverview.trigger}}</text>
      </view>
    </view>

    <view class="safe-section">
      <section-title title="互动线索" subtitle="这些只是本次记录里可以复盘的位置" />
      <view class="pattern-list">
        <view class="pattern-card" wx:for="{{patternCards}}" wx:key="title">
          <text class="pattern-title">{{item.title}}</text>
          <text class="pattern-text">{{item.text}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{isHighRisk}}" class="safe-section">
      <view class="risk-support-card">
        <text class="risk-support-title">优先联系现实支持</text>
        <text class="risk-support-text">{{riskSupportText}}</text>
        <text class="risk-support-note">这里不是实时危机服务，也不替代线下专业支持或当地紧急服务。</text>
      </view>
    </view>

    <view wx:if="{{canShowTraining}}" class="safe-section">
      <section-title title="今天先做哪一步" subtitle="一个主练习，最多两个备用选择" />
      <view wx:if="{{trainingRecommendation}}" class="today-suggestion-card safe-card">
        <text class="today-suggestion-label">主练习 · {{recommendedTrainings[0].title || "一个轻量练习"}}</text>
        <text class="today-suggestion-text">{{trainingRecommendation.today_suggestion}}</text>
        <text class="today-suggestion-reason">推荐理由：{{trainingRecommendation.reason}}</text>
        <button class="practice-main-button" bindtap="openTrainingCard">开始这个练习</button>
      </view>
      <view wx:else class="today-suggestion-card safe-card">
        <text class="today-suggestion-label">今天先做</text>
        <text class="today-suggestion-text">这次记录暂时没有匹配到具体训练卡，可以先暂停几秒，再说出一个最明显的感受。</text>
        <text class="today-suggestion-boundary">今日建议只作为支持性练习参考，不构成诊断或治疗方案。</text>
      </view>
      <view wx:if="{{recommendedTrainings.length > 1}}" class="training-list">
        <text class="training-backup-title">也可以选择</text>
        <view wx:for="{{recommendedTrainings}}" wx:for-index="trainingIndex" wx:key="title">
          <training-task-card
            wx:if="{{trainingIndex > 0 && trainingIndex < 3}}"
            title="{{item.title}}"
            subtitle="{{item.subtitle}}"
            stage="{{item.stage}}"
            duration="{{item.duration}}"
            scenario="{{item.scenario}}"
            reason="{{item.reason}}"
            tag="{{item.tag}}"
            bind:tapcard="openTrainingCard"
          />
        </view>
      </view>
      <text wx:if="{{trainingRecommendation}}" class="today-suggestion-boundary">{{trainingRecommendation.boundary_notice}}</text>
    </view>

    <view wx:if="{{!isHighRisk}}" class="supervision-entry">
      <view class="supervision-copy">
        <text class="supervision-title">需要多一个人帮你看一看？</text>
        <text class="supervision-text">如果这类情况反复出现，或你担心自己撑不住，可以提交给人工督导补充反馈。</text>
      </view>
      <button class="supervision-link" bindtap="openSupervision">提交督导</button>
    </view>

    <view class="action-grid">
      <button class="safe-outline-button action-button" bindtap="saveFeedback">收藏这次反馈</button>
    </view>

    <view class="safe-section">
      <view class="boundary-card">
        <text class="boundary-title">怎样理解这份反馈</text>
        <text class="boundary-text">它只整理这一次记录中可观察的情绪、互动和练习位置，不代表固定问题，也不构成诊断、评分或治疗建议。</text>
      </view>
      <bottom-tip-card text="先观察，再练习；一次小调整也有意义。" />
    </view>
  </view>
</view>
