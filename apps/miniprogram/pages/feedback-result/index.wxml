<view class="safe-page feedback-page">
  <view class="feedback-hero safe-card safe-card--hero">
    <view class="hero-copy">
      <text class="hero-kicker">本次反馈</text>
      <text class="hero-title">先看见发生了什么</text>
      <text class="hero-summary">以下内容用于自我观察和练习参考，不评价谁对谁错。</text>
    </view>
    <image
      class="hero-image"
      src="/assets/illustrations/feedback-support.png"
      mode="aspectFill"
      aria-hidden="true"
    />
  </view>

  <view wx:if="{{loading}}" class="loading-card safe-card">
    <view class="loading-dot"></view>
    <text>正在生成反馈...</text>
  </view>

  <view wx:elif="{{errorMessage}}" class="error-state">
    <alert-card type="warning" title="反馈生成遇到问题" content="{{errorMessage}}" />
    <button wx:if="{{missingDiaryId}}" class="error-action-button" bindtap="goToDiaryForm">去记录一次事件</button>
  </view>

  <view wx:else class="feedback-content">
    <view class="boundary-card">
      <text class="boundary-title">温和说明</text>
      <text class="boundary-text">这不是诊断报告，也不是评分。它只是把这次记录拆成几个可以观察的位置，帮助你找到下一次能练的小动作。</text>
    </view>

    <view class="support-card safe-card">
      <text class="support-label">我看到了什么</text>
      <text class="support-text">{{feedback.supportive_feedback}}</text>
    </view>

    <view class="safe-section">
      <section-title title="这不代表什么" subtitle="反馈只看这一次记录，不给人贴标签" />
      <view class="not-diagnosis-card safe-card">
        <text>这不代表孩子、家长或家庭关系有固定问题，也不是诊断、评分或治疗建议。</text>
      </view>
    </view>

    <view class="safe-section">
      <section-title title="本次情绪概览" subtitle="先看见主要感受和强度，不急着下结论" />
      <view class="overview-grid">
        <view class="overview-item">
          <text class="overview-label">主要情绪</text>
          <text class="overview-value">{{emotionOverview.mainEmotion}}</text>
        </view>
        <view class="overview-item">
          <text class="overview-label">情绪强度</text>
          <text class="overview-value">{{emotionOverview.intensity}}</text>
        </view>
      </view>
    </view>

    <view class="safe-section">
      <section-title title="可能触发点" subtitle="用“可能”来看这次互动的起点" />
      <view class="trigger-card safe-card">
        <text>{{emotionOverview.trigger}}</text>
      </view>
    </view>

    <view class="safe-section">
      <section-title title="互动线索" subtitle="这些只是本次记录里可以复盘的位置" />
      <view class="pattern-list">
        <view class="pattern-card" wx:for="{{patternCards}}" wx:key="title">
          <text class="pattern-title">{{item.title}}</text>
          <text class="pattern-text">{{item.text}}</text>
        </view>
      </view>
    </view>

    <view class="safe-section">
      <section-title title="你可以先尝试什么" subtitle="先做一个很小的动作" />
      <view class="practice-card safe-card">
        <text class="practice-title">{{nextAction.title}}</text>
        <text class="practice-text">{{nextAction.text}}</text>
        <button wx:if="{{canShowTraining}}" class="practice-main-button" bindtap="openTrainingCard">开始一个小练习</button>
        <button wx:if="{{isHighRisk}}" class="practice-main-button" bindtap="openSupervision">提交人工关注</button>
      </view>
    </view>

    <view wx:if="{{isHighRisk}}" class="safe-section">
      <view class="risk-support-card">
        <text class="risk-support-title">优先联系现实支持</text>
        <text class="risk-support-text">{{riskSupportText}}</text>
        <text class="risk-support-note">这里不是实时危机服务，也不替代线下专业支持或当地紧急服务。</text>
      </view>
    </view>

    <view wx:if="{{canShowTraining}}" class="safe-section">
      <section-title title="今日建议" subtitle="来自这次情绪日记的轻量练习推荐" />
      <view wx:if="{{trainingRecommendation}}" class="today-suggestion-card safe-card">
        <text class="today-suggestion-label">今天先做</text>
        <text class="today-suggestion-text">{{trainingRecommendation.today_suggestion}}</text>
        <text class="today-suggestion-reason">推荐理由：{{trainingRecommendation.reason}}</text>
        <text class="today-suggestion-boundary">{{trainingRecommendation.boundary_notice}}</text>
      </view>
      <view wx:else class="today-suggestion-card safe-card">
        <text class="today-suggestion-label">今天先做</text>
        <text class="today-suggestion-text">这次记录暂时没有匹配到具体训练卡，可以先做一次暂停和情绪命名。</text>
        <text class="today-suggestion-boundary">今日建议只作为支持性练习参考，不构成诊断或治疗方案。</text>
      </view>
      <view class="training-list">
        <training-task-card
          wx:for="{{recommendedTrainings}}"
          wx:key="title"
          title="{{item.title}}"
          subtitle="{{item.subtitle}}"
          stage="{{item.stage}}"
          duration="{{item.duration}}"
          scenario="{{item.scenario}}"
          reason="{{item.reason}}"
          tag="{{item.tag}}"
          bind:tapcard="openTrainingCard"
        />
      </view>
    </view>

    <view class="supervision-entry">
      <view class="supervision-copy">
        <text class="supervision-title">需要多一个人帮你看一看？</text>
        <text class="supervision-text">如果这类情况反复出现，或你担心自己撑不住，可以提交给人工督导补充反馈。</text>
      </view>
      <button class="supervision-link" bindtap="openSupervision">提交督导</button>
    </view>

    <view class="action-grid">
      <button wx:if="{{canShowTraining}}" class="safe-primary-button action-button" bindtap="openTrainingCard">开始一个小练习</button>
      <button wx:if="{{isHighRisk}}" class="safe-primary-button action-button" bindtap="openSupervision">提交人工关注</button>
      <button class="safe-outline-button action-button" bindtap="saveFeedback">保存本次反馈</button>
    </view>

    <view class="safe-section">
      <bottom-tip-card text="先观察，再练习；一次小调整也有意义。" />
    </view>
  </view>
</view>
