<view class="safe-page growth-page">
  <view class="growth-hero">
    <text class="growth-title">关系探索成长记录</text>
  </view>

  <view wx:if="{{loading}}" class="safe-card loading-card">正在读取成长记录...</view>
  <view wx:elif="{{growth}}" class="growth-content">
    <view class="growth-summary-grid" aria-label="成长记录摘要">
      <view class="growth-summary-item" aria-label="累计记录{{growth.timeline.length}}条">
        <text class="growth-summary-value">{{growth.timeline.length}}</text>
        <text class="growth-summary-label">累计记录</text>
      </view>
      <view class="growth-summary-item" aria-label="可看指标组{{curveGroups.length}}组">
        <text class="growth-summary-value">{{curveGroups.length}}</text>
        <text class="growth-summary-label">指标组</text>
      </view>
      <view class="growth-summary-item" aria-label="阶段性反馈{{researcherConfirmations.length}}条">
        <text class="growth-summary-value">{{researcherConfirmations.length}}</text>
        <text class="growth-summary-label">阶段性反馈</text>
      </view>
    </view>

    <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="section-nav" aria-label="成长记录栏目">
      <view class="section-nav__row" role="tablist">
        <button wx:for="{{sectionTabs}}" wx:key="key" role="tab" aria-selected="{{activeSection === item.key}}" aria-label="查看{{item.label}}" class="section-nav__item {{activeSection === item.key ? 'section-nav__item--active' : ''}}" data-section="{{item.key}}" bindtap="selectSection">{{item.label}}</button>
      </view>
    </scroll-view>

    <view wx:if="{{activeSection === 'curve'}}" class="section-stack">
      <view class="section-card chart-card">
        <view class="section-heading">
          <view><text class="section-title">变化曲线</text><text class="section-note">每组数字含义不同，不合并成总分</text></view>
        </view>
        <view wx:if="{{curveGroups.length}}">
          <scroll-view scroll-x class="filter-scroll"><view class="filter-row"><button wx:for="{{curveGroups}}" wx:key="key" class="filter-chip {{selectedGroup === item.key ? 'filter-chip--active' : ''}}" data-key="{{item.key}}" bindtap="selectCurveGroup">{{item.label}}</button></view></scroll-view>
          <scroll-view scroll-x class="filter-scroll metric-scroll"><view class="filter-row"><button wx:for="{{selectedMetrics}}" wx:key="key" class="metric-chip {{selectedMetric === item.key ? 'metric-chip--active' : ''}}" data-key="{{item.key}}" bindtap="selectMetric">{{item.label}}</button></view></scroll-view>
          <text class="chart-title">{{selectedMetricLabel}}</text>
          <view class="chart-shell">
            <canvas wx:if="{{selectedPoints.length >= 2}}" canvas-id="growthChart" class="chart-canvas" width="620" height="300" aria-label="{{selectedMetricLabel}}变化折线图"></canvas>
            <view wx:else class="chart-empty" role="status" aria-live="polite">
              <text class="chart-empty__title">再记录 {{selectedPoints.length ? 1 : 2}} 次后可查看变化趋势</text>
              <text class="chart-empty__copy">持续记录，帮助你看见同一指标在不同时间的变化。</text>
              <view class="chart-empty__note">
                <text class="chart-empty__note-title">数据不足</text>
                <text>目前有 {{selectedPoints.length}} 个记录点；这里不会根据单次记录判断变化。</text>
              </view>
            </view>
          </view>
          <text wx:if="{{selectedPoints.length >= 2}}" class="trend-copy">{{trendText}}</text>
        </view>
        <visualization-state wx:else state="insufficient" message="还没有可绘制的数据。先完成一次测评或本周记录。"></visualization-state>
      </view>

      <view class="section-card recent-card">
        <view class="section-heading">
          <view><text class="section-title">最近时间线</text><text class="section-note">先看最近三条，再决定是否展开</text></view>
          <button class="text-action" bindtap="showAllTimeline">查看全部 ›</button>
        </view>
        <view wx:if="{{recentTimeline.length}}" class="timeline-list">
          <timeline-record wx:for="{{recentTimeline}}" wx:key="id" item="{{item}}" tone="relationship" />
        </view>
        <view wx:else class="empty-state">还没有时间线记录，可以先写下今天的一小步。</view>
      </view>
    </view>

    <view wx:elif="{{activeSection === 'timeline'}}" class="section-card">
      <view class="section-heading"><view><text class="section-title">成长时间线</text><text class="section-note">按记录类型查看，不急于解释趋势</text></view></view>
      <scroll-view scroll-x class="filter-scroll"><view class="filter-row"><button wx:for="{{timelineFilters}}" wx:key="key" class="filter-chip {{timelineFilter === item.key ? 'filter-chip--active' : ''}}" data-key="{{item.key}}" bindtap="selectTimelineFilter">{{item.label}}</button></view></scroll-view>
      <view wx:if="{{filteredTimeline.length}}" class="timeline-list timeline-list--full">
        <timeline-record wx:for="{{filteredTimeline}}" wx:key="id" item="{{item}}" tone="relationship" />
      </view>
      <view wx:else class="empty-state">这一类还没有记录。</view>
    </view>

    <view wx:elif="{{activeSection === 'feedback'}}" class="section-card source-card">
      <view class="section-heading"><view><text class="section-title">阶段性反馈</text><text class="section-note">系统汇总与研究者补充明确分开</text></view></view>
      <view class="source-block source-block--feedback"><text class="source-label">研究者补充</text><view wx:if="{{researcherConfirmations.length}}"><text wx:for="{{researcherConfirmations}}" wx:key="id" class="source-line">{{item.dateText}} · {{item.title}}</text></view><text wx:else class="source-empty">暂时还没有研究者阶段性反馈。</text></view>
      <view class="source-block source-block--system"><text class="source-label">系统汇总</text><text class="growth-copy">{{growth.growth_report.change_summary}}</text><text class="growth-copy">下一步建议：{{growth.growth_report.next_step}}</text></view>
      <view class="source-block"><button class="source-toggle" bindtap="toggleSelfNarratives">用户原话（仅你可见）{{showSelfNarratives ? '收起' : '展开'}}</button><view wx:if="{{showSelfNarratives}}"><view wx:for="{{selfNarratives}}" wx:key="id" class="self-narrative"><text class="source-label">{{item.date}} · {{item.typeLabel}}</text><text class="source-line">{{item.text}}</text></view><text wx:if="{{!selfNarratives.length}}" class="source-empty">目前没有开放文字记录。</text></view></view>
      <text class="boundary-copy">{{growth.growth_report.boundary_notice}}</text>
    </view>

    <view wx:elif="{{activeSection === 'records'}}" class="section-stack">
      <view wx:if="{{!canRecord}}" class="record-gate">
        <text class="record-gate__title">先建立关系探索起点</text>
        <text class="record-gate__copy">成长记录需要关联一份已完成的关系测评和报名记录，避免内容写入错误档案。</text>
        <button class="safe-primary-button" bindtap="goRelationshipPilot">前往关系探索</button>
      </view>

      <view wx:if="{{canRecord}}" class="record-disclosure">
        <button class="record-disclosure__head" data-panel="weekly" bindtap="toggleRecordPanel"><view><text class="section-title">本周补充记录</text><text class="section-note">次数、感受和一段开放记录</text></view><text class="disclosure-icon">{{showWeeklyForm ? '−' : '+'}}</text></button>
        <view wx:if="{{showWeeklyForm}}" class="record-form">
          <label class="field-label">主动社交次数<input type="number" data-key="active_social_count" value="{{form.active_social_count}}" bindinput="onFieldInput" /></label>
          <label class="field-label">真实表达次数<input type="number" data-key="authentic_expression_count" value="{{form.authentic_expression_count}}" bindinput="onFieldInput" /></label>
          <label class="field-label">挫折后怎样应对<textarea maxlength="300" data-key="setback_coping" value="{{form.setback_coping}}" bindinput="onFieldInput" /></label>
          <label class="field-label"><view class="slider-heading"><text>当前关系靠近意愿</text><text class="value-badge">{{form.approach_willingness}} / 5</text></view><slider min="1" max="5" step="1" data-key="approach_willingness" value="{{form.approach_willingness}}" bindchange="onSliderChange" /></label>
          <label class="field-label"><view class="slider-heading"><text>当前担忧强度</text><text class="value-badge">{{form.worry_intensity}} / 5</text></view><slider min="1" max="5" step="1" data-key="worry_intensity" value="{{form.worry_intensity}}" bindchange="onSliderChange" /></label>
          <label class="field-label">最近一周最有成就感的事<textarea maxlength="500" data-key="achievement" value="{{form.achievement}}" bindinput="onFieldInput" /></label>
          <label class="field-label">最近一周最挫败的事<textarea maxlength="500" data-key="setback" value="{{form.setback}}" bindinput="onFieldInput" /></label>
          <text class="draft-status" aria-live="polite">{{draftRestored ? '已恢复：' : ''}}{{saveStatus}}</text>
          <text wx:if="{{slowSaving}}" class="draft-status draft-status--slow">网络响应较慢；草稿和提交标识仍在本机，请不要重复点击。</text>
          <button class="safe-primary-button" loading="{{savingWeekly}}" disabled="{{savingWeekly}}" bindtap="saveWeekly">保存本周记录</button>
        </view>
      </view>

      <view wx:if="{{canRecord}}" class="record-disclosure">
        <button class="record-disclosure__head" data-panel="event" bindtap="toggleRecordPanel"><view><text class="section-title">记录一个关键事件</text><text class="section-note">只写一件具体发生的小事</text></view><text class="disclosure-icon">{{showEventForm ? '−' : '+'}}</text></button>
        <view wx:if="{{showEventForm}}" class="record-form">
          <textarea class="event-input" maxlength="500" data-key="event_summary" value="{{form.event_summary}}" bindinput="onFieldInput" placeholder="例如：一次靠近、被拒绝、表达边界或感到被理解的时刻"></textarea>
          <text class="draft-status">{{saveStatus}}</text>
          <button class="safe-outline-button" loading="{{savingEvent}}" disabled="{{savingEvent}}" bindtap="saveEvent">加入时间线</button>
        </view>
      </view>
    </view>

    <view class="growth-actions">
      <button class="safe-outline-button" bindtap="goTherapeuticAssessment">共同理解一次关系体验</button>
      <button class="safe-primary-button growth-actions__primary" bindtap="openRecordSection">记录今天的一小步</button>
      <button class="growth-actions__secondary" bindtap="showFeedbackSection">查看阶段性反馈</button>
    </view>
  </view>
  <visualization-state wx:if="{{errorMessage}}" state="error" message="{{errorMessage}}"></visualization-state>
</view>
