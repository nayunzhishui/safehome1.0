<view class="p3-page growth-page" role="main" aria-label="关系探索成长记录">
  <page-state wx:if="{{loading}}" kind="loading" title="正在读取成长记录" />
  <view wx:elif="{{growth}}" class="growth-content">
    <view class="growth-summary" aria-label="成长记录摘要">
      <view class="growth-summary-item" aria-label="累计记录{{growth.timeline.length}}条">
        <text class="growth-summary-value">{{growth.timeline.length}}</text>
        <text class="growth-summary-label">累计记录</text>
      </view>
      <view class="growth-summary-item" aria-label="可看指标组{{curveGroups.length}}组">
        <text class="growth-summary-value">{{curveGroups.length}}</text>
        <text class="growth-summary-label">指标组</text>
      </view>
      <view class="growth-summary-item" aria-label="阶段性反馈{{researcherConfirmations.length}}条">
        <text class="growth-summary-value">{{researcherConfirmations.length}}</text>
        <text class="growth-summary-label">阶段性反馈</text>
      </view>
    </view>

    <view class="section-nav" aria-label="成长记录栏目">
      <view class="p3-segment p3-segment--paper section-nav__row" role="tablist">
        <button wx:for="{{sectionTabs}}" wx:key="key" role="tab" aria-selected="{{activeSection === item.key}}" aria-label="查看{{item.label}}" class="p3-segment__item section-nav__item {{activeSection === item.key ? 'p3-segment__item--active section-nav__item--active' : ''}}" data-section="{{item.key}}" bindtap="selectSection">{{item.label}}</button>
      </view>
    </view>

    <block wx:if="{{activeSection === 'curve'}}">
      <view class="growth-card">
        <view class="growth-card__titles">
          <text class="p3-item-title">变化曲线</text>
          <text class="p3-meta">每组数字含义不同，不合并成总分</text>
        </view>
        <block wx:if="{{curveGroups.length}}">
          <view class="growth-chips" role="radiogroup" aria-label="指标组">
            <button wx:for="{{curveGroups}}" wx:key="key" class="p3-chip {{selectedGroup === item.key ? 'p3-chip--selected' : ''}}" role="radio" aria-checked="{{selectedGroup === item.key}}" data-key="{{item.key}}" bindtap="selectCurveGroup">{{item.label}}</button>
          </view>
          <view class="growth-chips" role="radiogroup" aria-label="指标">
            <button wx:for="{{selectedMetrics}}" wx:key="key" class="p3-chip {{selectedMetric === item.key ? 'p3-chip--selected' : ''}}" role="radio" aria-checked="{{selectedMetric === item.key}}" data-key="{{item.key}}" bindtap="selectMetric">{{item.label}}</button>
          </view>
          <text class="growth-chart__title">{{selectedMetricLabel}}</text>
          <canvas wx:if="{{selectedPoints.length >= 2}}" canvas-id="growthChart" class="growth-chart__canvas" aria-label="{{selectedMetricLabel}}变化折线图：{{trendText}}"></canvas>
          <view wx:else class="growth-chart__empty" role="status" aria-live="polite">
            <text class="p3-item-title">再记录 {{selectedPoints.length ? 1 : 2}} 次后可查看变化趋势</text>
            <text class="p3-meta">数据不足：目前有 {{selectedPoints.length}} 个记录点；这里不会根据单次记录判断变化。</text>
          </view>
          <view wx:if="{{selectedPoints.length >= 2}}" class="growth-chart__dates" aria-hidden="true">
            <text wx:for="{{chartDates}}" wx:key="*this">{{item}}</text>
          </view>
          <text wx:if="{{selectedPoints.length >= 2}}" class="growth-trend">{{trendText}}</text>
        </block>
        <visualization-state wx:else state="insufficient" message="还没有可绘制的数据。先完成一次测评或本周记录。"></visualization-state>
      </view>

      <view class="growth-card">
        <view class="growth-card__head">
          <text class="p3-item-title">最近时间线</text>
          <button class="growth-link" bindtap="showAllTimeline">查看全部 ›</button>
        </view>
        <view wx:if="{{recentTimeline.length}}" class="growth-timeline" role="list">
          <p3-timeline-item wx:for="{{recentTimeline}}" wx:key="id" role="listitem" state="done" kicker="{{item.kicker}}" title="{{item.title}}" body="{{item.summary}}" show-line="{{index < recentTimeline.length - 1}}" />
        </view>
        <text wx:else class="p3-meta">还没有时间线记录，可以先写下今天的一小步。</text>
      </view>
    </block>

    <view wx:elif="{{activeSection === 'timeline'}}" class="growth-card">
      <view class="growth-card__titles">
        <text class="p3-item-title">成长时间线</text>
        <text class="p3-meta">按记录类型查看，不急于解释趋势</text>
      </view>
      <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="growth-filter">
        <view class="growth-filter__row" role="radiogroup" aria-label="记录类型">
          <button wx:for="{{timelineFilters}}" wx:key="key" class="p3-chip {{timelineFilter === item.key ? 'p3-chip--selected' : ''}}" role="radio" aria-checked="{{timelineFilter === item.key}}" data-key="{{item.key}}" bindtap="selectTimelineFilter">{{item.label}}</button>
        </view>
      </scroll-view>
      <view wx:if="{{filteredTimeline.length}}" class="growth-timeline" role="list">
        <p3-timeline-item wx:for="{{filteredTimeline}}" wx:key="id" role="listitem" state="done" kicker="{{item.kicker}}" title="{{item.title}}" body="{{item.summary}}" show-line="{{index < filteredTimeline.length - 1}}" />
      </view>
      <text wx:else class="p3-meta">这一类还没有记录。</text>
    </view>

    <view wx:elif="{{activeSection === 'feedback'}}" class="growth-card">
      <view class="growth-card__titles">
        <text class="p3-item-title">阶段性反馈</text>
        <text class="p3-meta">系统汇总与研究者补充明确分开</text>
      </view>
      <view class="growth-source growth-source--researcher">
        <text class="growth-source__label">研究者补充</text>
        <block wx:if="{{researcherConfirmations.length}}">
          <text wx:for="{{researcherConfirmations}}" wx:key="id" class="growth-source__line">{{item.dateText}} · {{item.title}}</text>
        </block>
        <text wx:else class="p3-meta">暂时还没有研究者阶段性反馈。</text>
      </view>
      <view class="growth-source">
        <text class="growth-source__label">系统汇总</text>
        <text class="growth-source__line">{{growth.growth_report.change_summary}}</text>
        <text class="growth-source__line">下一步建议：{{growth.growth_report.next_step}}</text>
      </view>
      <view class="growth-source growth-source--plain">
        <button class="growth-disclosure" aria-expanded="{{showSelfNarratives}}" bindtap="toggleSelfNarratives">
          <text class="growth-source__label">用户原话（仅你可见）</text>
          <text class="p3-meta">{{showSelfNarratives ? '收起' : '展开'}}</text>
        </button>
        <block wx:if="{{showSelfNarratives}}">
          <view wx:for="{{selfNarratives}}" wx:key="id" class="growth-narrative">
            <text class="p3-meta">{{item.date}} · {{item.typeLabel}}</text>
            <text class="growth-source__line">{{item.text}}</text>
          </view>
          <text wx:if="{{!selfNarratives.length}}" class="p3-meta">目前没有开放文字记录。</text>
        </block>
      </view>
      <text class="p3-meta">{{growth.growth_report.boundary_notice}}</text>
    </view>

    <block wx:elif="{{activeSection === 'records'}}">
      <view wx:if="{{!canRecord}}" class="growth-card">
        <text class="p3-item-title">先建立关系探索起点</text>
        <text class="growth-trend">成长记录需要关联一份已完成的关系测评和报名记录，避免内容写入错误档案。</text>
        <button class="p3-btn p3-btn--primary" bindtap="goRelationshipPilot">前往关系探索</button>
      </view>

      <view wx:if="{{canRecord}}" class="growth-card">
        <button class="growth-disclosure" aria-expanded="{{showWeeklyForm}}" data-panel="weekly" bindtap="toggleRecordPanel">
          <view class="growth-card__titles">
            <text class="p3-item-title">本周补充记录</text>
            <text class="p3-meta">次数、感受和一段开放记录</text>
          </view>
          <view class="growth-disclosure__chevron {{showWeeklyForm ? 'growth-disclosure__chevron--open' : ''}}" aria-hidden="true">
            <p3-icon name="chevron-down" size="24" tone="ink" />
          </view>
        </button>
        <view wx:if="{{showWeeklyForm}}" class="growth-form">
          <view class="growth-form__pair">
            <view class="p3-field">
              <text class="p3-field__label">主动社交次数</text>
              <input class="p3-field__input" type="number" aria-label="主动社交次数" data-key="active_social_count" value="{{form.active_social_count}}" bindinput="onFieldInput" />
            </view>
            <view class="p3-field">
              <text class="p3-field__label">真实表达次数</text>
              <input class="p3-field__input" type="number" aria-label="真实表达次数" data-key="authentic_expression_count" value="{{form.authentic_expression_count}}" bindinput="onFieldInput" />
            </view>
          </view>
          <view class="p3-field">
            <text class="p3-field__label">挫折后怎样应对</text>
            <textarea class="p3-field__input p3-field__input--auto" auto-height placeholder-class="p3-field__placeholder" maxlength="300" aria-label="挫折后怎样应对" data-key="setback_coping" value="{{form.setback_coping}}" bindinput="onFieldInput" />
          </view>
          <view class="p3-field">
            <view class="slider-heading"><text class="p3-field__label">当前关系靠近意愿</text><text class="value-badge">{{form.approach_willingness}} / 5</text></view>
            <slider class="growth-slider" activeColor="#23666e" backgroundColor="#e7e1d6" block-size="24" block-color="#fffdf9" min="1" max="5" step="1" aria-label="当前关系靠近意愿，1至5" data-key="approach_willingness" value="{{form.approach_willingness}}" bindchange="onSliderChange" />
          </view>
          <view class="p3-field">
            <view class="slider-heading"><text class="p3-field__label">当前担忧强度</text><text class="value-badge">{{form.worry_intensity}} / 5</text></view>
            <slider class="growth-slider" activeColor="#23666e" backgroundColor="#e7e1d6" block-size="24" block-color="#fffdf9" min="1" max="5" step="1" aria-label="当前担忧强度，1至5" data-key="worry_intensity" value="{{form.worry_intensity}}" bindchange="onSliderChange" />
          </view>
          <view class="p3-field">
            <text class="p3-field__label">最近一周最有成就感的事</text>
            <textarea class="p3-field__input p3-field__input--auto" auto-height placeholder-class="p3-field__placeholder" maxlength="500" aria-label="最近一周最有成就感的事" data-key="achievement" value="{{form.achievement}}" bindinput="onFieldInput" />
          </view>
          <view class="p3-field">
            <text class="p3-field__label">最近一周最挫败的事</text>
            <textarea class="p3-field__input p3-field__input--auto" auto-height placeholder-class="p3-field__placeholder" maxlength="500" aria-label="最近一周最挫败的事" data-key="setback" value="{{form.setback}}" bindinput="onFieldInput" />
          </view>
          <text class="p3-meta" aria-live="polite">{{draftRestored ? '已恢复：' : ''}}{{saveStatus}}</text>
          <text wx:if="{{slowSaving}}" class="p3-form-message p3-form-message--error">网络响应较慢；草稿和提交标识仍在本机，请不要重复点击。</text>
          <button class="p3-btn p3-btn--primary" loading="{{savingWeekly}}" disabled="{{savingWeekly}}" bindtap="saveWeekly">保存本周记录</button>
        </view>
      </view>

      <view wx:if="{{canRecord}}" class="growth-card">
        <button class="growth-disclosure" aria-expanded="{{showEventForm}}" data-panel="event" bindtap="toggleRecordPanel">
          <view class="growth-card__titles">
            <text class="p3-item-title">记录一个关键事件</text>
            <text class="p3-meta">只写一件具体发生的小事</text>
          </view>
          <view class="growth-disclosure__chevron {{showEventForm ? 'growth-disclosure__chevron--open' : ''}}" aria-hidden="true">
            <p3-icon name="chevron-down" size="24" tone="ink" />
          </view>
        </button>
        <view wx:if="{{showEventForm}}" class="growth-form">
          <textarea class="p3-field__input p3-field__input--multi" placeholder-class="p3-field__placeholder" maxlength="500" aria-label="关键事件记录" data-key="event_summary" value="{{form.event_summary}}" bindinput="onFieldInput" placeholder="例如：一次靠近、被拒绝、表达边界或感到被理解的时刻"></textarea>
          <text class="p3-meta">{{saveStatus}}</text>
          <button class="p3-btn p3-btn--secondary" loading="{{savingEvent}}" disabled="{{savingEvent}}" bindtap="saveEvent">加入时间线</button>
        </view>
      </view>
    </block>

    <view class="growth-actions">
      <button class="p3-btn {{activeSection === 'records' ? 'p3-btn--secondary' : 'p3-btn--primary'}}" bindtap="openRecordSection">记录今天的一小步</button>
      <button class="p3-btn p3-btn--secondary" bindtap="goTherapeuticAssessment">共同理解一次关系体验</button>
      <button class="p3-btn p3-btn--quiet" bindtap="showFeedbackSection">查看阶段性反馈</button>
    </view>
  </view>
  <visualization-state wx:if="{{errorMessage}}" state="error" message="{{errorMessage}}"></visualization-state>
</view>
