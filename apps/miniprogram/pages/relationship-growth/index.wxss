.growth-page { display: grid; gap: 22rpx; padding-bottom: 56rpx; }
.growth-kicker, .growth-title, .growth-copy, .section-title, .chart-title, .chart-state, .trend-copy, .timeline-title, .timeline-meta, .boundary-copy, .source-label, .source-line, .source-empty, .error-text { display: block; }
.growth-kicker { color: var(--safe-primary-deep); font-size: 22rpx; font-weight: 800; }
.growth-title { margin-top: 8rpx; color: var(--safe-title); font-size: 36rpx; font-weight: 900; }
.growth-copy { margin-top: 8rpx; color: var(--safe-text); font-size: 24rpx; line-height: 1.65; }
.section-card { display: grid; gap: 16rpx; margin-top: 20rpx; }
.section-title { color: var(--safe-title); font-size: 29rpx; font-weight: 850; }
.record-gate { display: grid; gap: 16rpx; margin-top: 20rpx; padding: 28rpx; border: 1rpx solid var(--safe-border-strong); border-radius: var(--safe-radius-sm); background: var(--safe-primary-pale); }
.record-gate__title, .record-gate__copy { display: block; }
.record-gate__title { color: var(--safe-title); font-size: 28rpx; font-weight: 800; }
.record-gate__copy { color: var(--safe-text); font-size: 24rpx; line-height: 1.65; }
.record-section { gap: 22rpx; }
.slider-heading { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.value-badge { flex: 0 0 auto; min-width: 92rpx; padding: 6rpx 12rpx; border-radius: var(--safe-radius-xs); background: var(--safe-primary-soft); color: var(--safe-primary-deep); text-align: center; font-weight: 800; }
.filter-scroll { width: 100%; white-space: nowrap; }
.filter-row { display: inline-flex; gap: 10rpx; padding: 2rpx 2rpx 8rpx; }
.filter-chip, .metric-chip { min-height: 72rpx; margin: 0; padding: 10rpx 20rpx; border: 1rpx solid var(--safe-border); border-radius: 999rpx; background: var(--safe-card); color: var(--safe-text); font-size: 21rpx; line-height: 1.2; }
.filter-chip::after, .metric-chip::after, .source-toggle::after { border: 0; }
.filter-chip--active, .metric-chip--active { border-color: var(--safe-primary); background: var(--safe-primary-soft); color: var(--safe-primary-deep); font-weight: 800; }
.metric-scroll { margin-top: -6rpx; }
.chart-title { color: var(--safe-title); font-size: 24rpx; font-weight: 800; }
.chart-canvas { box-sizing: border-box; display: block; width: 100%; height: 300rpx; border: 1rpx solid var(--safe-border); border-radius: var(--safe-radius-sm); background: #fbfcfb; }
.chart-state, .trend-copy { color: var(--safe-muted); font-size: 21rpx; line-height: 1.55; }
.trend-copy { color: var(--safe-primary-deep); }
.empty-state { padding: 24rpx 0; color: var(--safe-muted); font-size: 22rpx; line-height: 1.6; text-align: center; }
.timeline-list { display: grid; }
.timeline-row { position: relative; display: flex; gap: 14rpx; min-height: 92rpx; padding: 10rpx 0; }
.timeline-row:not(:last-child)::after { position: absolute; top: 34rpx; bottom: 0; left: 6rpx; width: 2rpx; background: var(--safe-border); content: ""; }
.timeline-dot { z-index: 1; flex: none; width: 14rpx; height: 14rpx; margin-top: 8rpx; border-radius: 50%; background: var(--safe-primary); }
.timeline-content { flex: 1; }
.timeline-head { display: flex; justify-content: space-between; gap: 12rpx; }
.timeline-title { color: var(--safe-title); font-size: 24rpx; font-weight: 750; }
.timeline-type { flex: none; color: var(--safe-primary-deep); font-size: 19rpx; }
.timeline-meta { margin-top: 4rpx; color: var(--safe-muted); font-size: 21rpx; line-height: 1.5; }
.source-block { padding: 18rpx; border: 1rpx solid var(--safe-border); border-radius: var(--safe-radius-sm); }
.source-block--system { background: #fbfcfb; }
.source-label { color: var(--safe-primary-deep); font-size: 21rpx; font-weight: 850; }
.source-line, .source-empty { margin-top: 8rpx; color: var(--safe-text); font-size: 22rpx; line-height: 1.6; }
.source-empty { color: var(--safe-muted); }
.source-toggle { min-height: 76rpx; margin: 0; padding: 0; border: 0; background: transparent; color: var(--safe-primary-deep); font-size: 22rpx; font-weight: 800; text-align: left; }
.self-narrative { margin-top: 14rpx; padding-top: 14rpx; border-top: 1rpx solid var(--safe-border); }
.field-label { display: grid; gap: 8rpx; color: var(--safe-text); font-size: 23rpx; }
.field-label input, .field-label textarea, .event-input { box-sizing: border-box; width: 100%; min-height: 88rpx; padding: 14rpx; border: 1rpx solid var(--safe-border); border-radius: var(--safe-radius-sm); background: #fff; }
.field-label textarea, .event-input { min-height: 140rpx; }
.boundary-copy { padding: 16rpx; border: 1rpx solid rgba(184, 127, 45, 0.3); border-radius: var(--safe-radius-sm); background: var(--safe-orange-soft); color: var(--safe-text); font-size: 22rpx; line-height: 1.6; }
.error-text { color: var(--safe-danger); font-size: 24rpx; }
