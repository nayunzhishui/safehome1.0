.growth-dashboard-page {
  display: grid;
  gap: 32rpx;
  padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
}

.growth-kicker,
.growth-title,
.section-eyebrow,
.next-step-copy,
.section-title,
.section-copy,
.rail-count,
.rail-label,
.assessment-title,
.assessment-value,
.assessment-note,
.timeline-title,
.timeline-summary,
.timeline-date,
.relationship-title,
.fact-value,
.fact-label {
  display: block;
}

.growth-hero {
  padding: 16rpx 0 4rpx;
  text-align: center;
}

.growth-kicker {
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.growth-title {
  margin-top: 8rpx;
  color: var(--safe-title);
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1.25;
  text-align: center;
}

.meaning-boundary {
  padding: 20rpx 24rpx;
  border-radius: var(--safe-radius-sm);
  background: var(--safe-primary-soft);
  color: var(--safe-text);
  font-size: 26rpx;
  line-height: 1.55;
  text-align: center;
}

.growth-content,
.section-stack {
  display: grid;
  gap: 32rpx;
}

.growth-rail {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  border-bottom: 1rpx solid var(--safe-border);
}

.rail-tab {
  min-width: 0;
  min-height: 112rpx;
  padding: 18rpx 6rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  border-bottom: 5rpx solid transparent;
  color: var(--safe-text);
}

.rail-tab::after {
  border: 0;
}

.rail-tab--active {
  border-bottom-color: var(--safe-primary);
  color: var(--safe-primary-deep);
}

.rail-count {
  color: inherit;
  font-size: 28rpx;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
}

.rail-label {
  color: inherit;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.35;
  text-align: center;
}

.next-step-card,
.dashboard-section,
.relationship-card,
.feedback-summary-card {
  padding-bottom: 32rpx;
  border-bottom: 1rpx solid var(--safe-border);
}

.section-eyebrow {
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 800;
}

.next-step-copy {
  margin-top: 10rpx;
  color: var(--safe-title);
  font-size: 28rpx;
  line-height: 1.65;
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 22rpx;
}

.section-action {
  min-height: 88rpx;
  padding: 16rpx 24rpx;
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  border-radius: var(--safe-radius-md);
  background: var(--safe-primary);
  color: #fff;
  font-size: 28rpx;
  font-weight: 800;
}

.section-action::after {
  border: 0;
}

.section-action--quiet {
  border: 1rpx solid var(--safe-primary);
  background: transparent;
  color: var(--safe-primary-deep);
}

.section-heading,
.feedback-summary-card {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.section-title {
  color: var(--safe-title);
  font-size: 34rpx;
  font-weight: 850;
  line-height: 1.4;
}

.section-copy {
  margin-top: 8rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.55;
}

.thermometer-list,
.assessment-list,
.timeline-list {
  display: grid;
  gap: 20rpx;
  margin-top: 24rpx;
}

.thermometer-row {
  display: grid;
  gap: 12rpx;
}

.thermometer-meta {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  color: var(--safe-text);
  font-size: 24rpx;
}

.bar-track {
  height: 12rpx;
  overflow: hidden;
  border-radius: var(--safe-radius-pill);
  background: var(--safe-primary-soft);
}

.bar-fill {
  height: 100%;
  border-radius: inherit;
  background: var(--safe-primary);
}

.assessment-group {
  padding: 24rpx 0;
  border-top: 1rpx solid var(--safe-border);
}

.assessment-title {
  color: var(--safe-title);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.5;
}

.assessment-values {
  display: grid;
  gap: 8rpx;
  margin-top: 14rpx;
}

.assessment-value,
.assessment-note {
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.55;
}

.assessment-note {
  margin-top: 12rpx;
  color: var(--safe-muted);
}

.relationship-title {
  margin-top: 8rpx;
  color: var(--safe-title);
  font-size: 30rpx;
  font-weight: 850;
  line-height: 1.5;
}

.relationship-facts {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 24rpx;
}

.fact-cell {
  min-width: 0;
  padding: 20rpx 8rpx;
  border-top: 4rpx solid var(--safe-primary);
  background: var(--safe-primary-pale);
  text-align: center;
}

.fact-value {
  color: var(--safe-primary-deep);
  font-size: 36rpx;
  font-weight: 900;
}

.fact-label {
  margin-top: 6rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
}

.relationship-action,
.feedback-action {
  width: 100%;
  margin-top: 22rpx;
}

.timeline-item {
  position: relative;
  display: grid;
  grid-template-columns: 32rpx minmax(0, 1fr);
  gap: 16rpx;
}

.timeline-dot {
  position: relative;
  width: 18rpx;
  height: 18rpx;
  margin: 12rpx 0 0 6rpx;
  border-radius: 50%;
  background: var(--safe-primary);
}

.timeline-dot::before,
.timeline-dot::after {
  position: absolute;
  left: 7rpx;
  width: 4rpx;
  height: 18rpx;
  border-radius: 4rpx;
  background: var(--safe-primary);
  content: "";
}

.timeline-dot::before {
  bottom: 22rpx;
}

.timeline-dot::after {
  top: 22rpx;
}

.timeline-dot--relationship {
  background: var(--safe-blue);
}

.timeline-dot--feedback {
  background: var(--safe-orange);
}

.timeline-body {
  min-width: 0;
  padding-bottom: 20rpx;
}

.timeline-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14rpx;
}

.timeline-title {
  color: var(--safe-title);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.5;
}

.timeline-type,
.timeline-summary,
.timeline-date {
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.55;
}

.timeline-type {
  flex: none;
  color: var(--safe-primary-deep);
}

.timeline-summary,
.timeline-date {
  margin-top: 6rpx;
}

.timeline-date {
  color: var(--safe-muted);
}

.boundary-card {
  padding: 24rpx;
  border-top: 2rpx solid var(--safe-orange);
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.65;
}

@media (max-width: 360px) {
  .growth-rail {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .action-row {
    flex-direction: column;
  }
}
