<view class="safe-page growth-dashboard-page">
  <view class="growth-hero">
    <text class="growth-kicker">四类线索</text>
    <text class="growth-title">我的成长</text>
  </view>

  <view class="meaning-boundary">四类线索分别查看，不合成总分</view>

  <page-state wx:if="{{loading}}" kind="loading" title="正在整理已保存的线索" description="四类信息会分别读取，不会合并成总分。" />
  <page-state wx:elif="{{errorMessage}}" kind="error" title="成长线索暂时没有读取成功" description="{{errorMessage}}" action-label="重新读取" action-aria-label="重新读取成长线索" bind:action="loadGrowth" />

  <view wx:elif="{{growth}}" class="growth-content">
    <view class="growth-rail" aria-label="成长线索分类">
      <button
        wx:for="{{sectionTabs}}"
        wx:key="key"
        class="rail-tab {{item.active ? 'rail-tab--active' : ''}}"
        data-key="{{item.key}}"
        aria-label="查看{{item.label}}，当前{{item.count}}条线索"
        bindtap="selectSection"
      >
        <text class="rail-count">{{item.count}}</text>
        <text class="rail-label">{{item.label}}</text>
      </button>
    </view>

    <view wx:if="{{activeSection === 'activity'}}" class="section-stack">
      <view class="next-step-card">
        <text class="section-eyebrow">现在可以做什么</text>
        <text class="next-step-copy">{{growth.summary.next_step}}</text>
        <view class="action-row">
          <button class="section-action" bindtap="startDiary">记录一件小事</button>
          <button class="section-action section-action--quiet" bindtap="openTraining">查看练习</button>
        </view>
      </view>

      <view class="dashboard-section">
        <view class="section-heading">
          <view><text class="section-title">情绪温度</text><text class="section-copy">1—10分，只与同一量尺的记录比较</text></view>
          <status-pill label="{{thermometer.length}} 次" tone="info" aria-label="情绪温度记录{{thermometer.length}}次" />
        </view>
        <view wx:if="{{thermometer.length}}" class="thermometer-list">
          <view wx:for="{{thermometer}}" wx:key="id" class="thermometer-row">
            <view class="thermometer-meta"><text>{{item.dateText}}</text><text>{{item.emotion_label || "一次温度记录"}} · {{item.intensity_level}}</text></view>
            <view class="bar-track"><view class="bar-fill" style="width: {{item.width}};"></view></view>
          </view>
        </view>
        <page-state wx:else kind="empty" title="还没有温度记录" description="第一次记录只作为起点，不判断趋势。" />
      </view>

      <view class="dashboard-section">
        <view class="section-heading"><view><text class="section-title">记录与练习时间线</text><text class="section-copy">只呈现做过的事情，不把次数写成改善</text></view></view>
        <view wx:if="{{activityTimeline.length}}" class="timeline-list">
          <view wx:for="{{activityTimeline}}" wx:key="id" class="timeline-item">
            <view class="timeline-dot"></view>
            <view class="timeline-body"><view class="timeline-head"><text class="timeline-title">{{item.title}}</text><text class="timeline-type">{{item.type_label}}</text></view><text class="timeline-summary">{{item.summary}}</text><text class="timeline-date">{{item.dateText}}</text></view>
          </view>
        </view>
        <page-state wx:else kind="empty" title="还没有记录或练习" description="可以先留下一件具体小事，形成第一条时间线。" action-label="开始记录" bind:action="startDiary" />
      </view>
    </view>

    <view wx:elif="{{activeSection === 'assessments'}}" class="section-stack">
      <view class="dashboard-section">
        <view class="section-heading"><view><text class="section-title">支持性测评</text><text class="section-copy">每份量表独立成组，不把不同分值放在同一条曲线上</text></view></view>
        <view wx:if="{{assessmentGroups.length}}" class="assessment-list">
          <view wx:for="{{assessmentGroups}}" wx:key="worksheet_id" class="assessment-group">
            <text class="assessment-title">{{item.title}}</text>
            <view class="assessment-values">
              <text wx:for="{{item.items}}" wx:for-item="score" wx:key="id" class="assessment-value">{{score.dateText}} · 记录值 {{score.value}}</text>
            </view>
            <text class="assessment-note">只在同一量尺再次填写后观察变化，不自动解释好坏。</text>
          </view>
        </view>
        <page-state wx:else kind="empty" title="还没有支持性测评" description="完成一次测评后，这里会按量表分别保留结果。" action-label="去测一测" bind:action="openAssessment" />
      </view>
    </view>

    <view wx:elif="{{activeSection === 'relationship'}}" class="section-stack">
      <view class="relationship-card">
        <text class="section-eyebrow">关系探索单独呈现</text>
        <text class="relationship-title">不与日记次数或测评分值合并</text>
        <view class="relationship-facts">
          <view class="fact-cell"><text class="fact-value">{{relationshipSummary.task_count || 0}}</text><text class="fact-label">探索任务</text></view>
          <view class="fact-cell"><text class="fact-value">{{relationshipSummary.longitudinal_count || 0}}</text><text class="fact-label">连续记录</text></view>
          <view class="fact-cell"><text class="fact-value">{{relationshipSummary.report_count || 0}}</text><text class="fact-label">阶段报告</text></view>
        </view>
        <button class="section-action relationship-action" bindtap="openRelationship">{{relationshipSummary.available ? '查看关系探索详情' : '了解关系探索'}}</button>
      </view>
      <view class="dashboard-section">
        <view class="section-heading"><view><text class="section-title">关系探索时间线</text><text class="section-copy">这里只显示任务、连续记录和阶段报告的事实</text></view></view>
        <view wx:if="{{relationshipTimeline.length}}" class="timeline-list">
          <view wx:for="{{relationshipTimeline}}" wx:key="id" class="timeline-item">
            <view class="timeline-dot timeline-dot--relationship"></view>
            <view class="timeline-body"><view class="timeline-head"><text class="timeline-title">{{item.title}}</text><text class="timeline-type">{{item.type_label}}</text></view><text class="timeline-summary">{{item.summary}}</text><text class="timeline-date">{{item.dateText}}</text></view>
          </view>
        </view>
        <page-state wx:else kind="empty" title="还没有关系探索记录" description="是否参与由你决定；没有记录时不生成关系结论。" />
      </view>
    </view>

    <view wx:else class="section-stack">
      <view class="feedback-summary-card">
        <view><text class="section-eyebrow">共同核对</text><text class="relationship-title">研究者反馈 {{feedbackSummary.count || 0}} 条</text></view>
        <status-pill label="{{feedbackSummary.unread_count || 0}} 条未读" tone="warning" aria-label="研究者反馈未读{{feedbackSummary.unread_count || 0}}条" />
      </view>
      <view class="dashboard-section">
        <view wx:if="{{feedbackTimeline.length}}" class="timeline-list">
          <view wx:for="{{feedbackTimeline}}" wx:key="id" class="timeline-item">
            <view class="timeline-dot timeline-dot--feedback"></view>
            <view class="timeline-body"><view class="timeline-head"><text class="timeline-title">{{item.title}}</text><text class="timeline-type">{{item.type_label}}</text></view><text class="timeline-summary">{{item.summary}}</text><text class="timeline-date">{{item.dateText}}</text></view>
          </view>
        </view>
        <page-state wx:else kind="empty" title="暂时没有研究者反馈" description="没有反馈不代表好或不好；需要人工支持时可从消息或人工支持入口联系。" />
        <button class="section-action feedback-action" bindtap="openMessages">打开消息列表</button>
      </view>
    </view>

    <view class="boundary-card"><text>{{growth.boundary_notice}}</text></view>
  </view>
</view>
