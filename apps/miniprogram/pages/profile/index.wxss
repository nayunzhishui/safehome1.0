.profile-page {
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.user-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  overflow: hidden;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  flex: 0 0 92rpx;
  border-radius: 50%;
  background: var(--safe-orange-soft);
  color: #9E6626;
  font-size: 34rpx;
  font-weight: 900;
}

.user-copy {
  min-width: 0;
  flex: 1;
}

.user-name,
.user-state,
.user-role,
.streak-text,
.growth-level,
.profile-note,
.auth-title,
.auth-text,
.row-title,
.row-subtitle,
.safety-title,
.safety-text {
  display: block;
}

.user-name {
  color: var(--safe-title);
  font-size: 34rpx;
  font-weight: 850;
  line-height: 1.35;
}

.user-state {
  margin-top: 8rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.45;
}

.user-role {
  margin-top: 6rpx;
  color: var(--safe-primary-deep);
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.4;
}

.streak-text {
  margin-top: 10rpx;
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 800;
}

.growth-level {
  max-width: 140rpx;
  padding: 8rpx 14rpx;
  border-radius: var(--safe-radius-pill);
  background: var(--safe-primary-soft);
  color: var(--safe-primary-deep);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.35;
  text-align: center;
}

.auth-panel {
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
}

.claim-card {
  margin-top: 24rpx;
  padding: 26rpx 28rpx;
  border-color: rgba(87, 139, 95, 0.34);
  background: linear-gradient(135deg, rgba(244, 249, 239, 0.98), rgba(255, 253, 248, 0.98));
}

.claim-marker {
  display: inline-flex;
  padding: 7rpx 14rpx;
  border-radius: var(--safe-radius-pill);
  background: var(--safe-primary-soft);
  color: var(--safe-primary-deep);
  font-size: 21rpx;
  font-weight: 850;
}

.claim-title,
.claim-text,
.claim-boundary {
  display: block;
}

.claim-title {
  margin-top: 14rpx;
  color: var(--safe-title);
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.45;
}

.claim-text,
.claim-boundary {
  margin-top: 10rpx;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.65;
}

.claim-boundary {
  color: var(--safe-muted);
  font-size: 22rpx;
}

.claim-modules {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.claim-module {
  padding: 8rpx 14rpx;
  border: 1rpx solid rgba(87, 139, 95, 0.2);
  border-radius: var(--safe-radius-pill);
  background: rgba(255, 255, 255, 0.76);
  color: var(--safe-primary-deep);
  font-size: 22rpx;
  font-weight: 750;
}

.claim-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.auth-title {
  color: var(--safe-title);
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.45;
}

.auth-text {
  margin-top: 8rpx;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.65;
}

.auth-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.identity-summary {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--safe-border);
}

.identity-heading,
.identity-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.identity-title,
.identity-note,
.identity-label,
.identity-state,
.identity-boundary {
  display: block;
}

.identity-title {
  color: var(--safe-title);
  font-size: 25rpx;
  font-weight: 850;
}

.identity-note,
.identity-state,
.identity-boundary {
  color: var(--safe-muted);
  font-size: 21rpx;
  line-height: 1.5;
}

.identity-row {
  min-height: 84rpx;
  border-bottom: 1rpx solid rgba(87, 139, 95, 0.12);
}

.identity-copy {
  min-width: 0;
  flex: 1;
}

.identity-label {
  color: var(--safe-text);
  font-size: 24rpx;
  font-weight: 750;
}

.identity-action {
  min-width: 112rpx;
  min-height: 64rpx;
  margin: 0;
  border: 1rpx solid rgba(155, 65, 55, 0.3);
  border-radius: var(--safe-radius-pill);
  background: #ffffff;
  color: #8b3d35;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 64rpx;
}

.identity-action::after {
  border: 0;
}

.identity-boundary {
  margin-top: 14rpx;
}

.auth-primary,
.auth-secondary {
  min-height: 72rpx;
  margin: 0;
  border-radius: var(--safe-radius-pill);
  font-size: 26rpx;
  font-weight: 850;
  line-height: 72rpx;
}

.auth-primary {
  flex: 1;
  background: var(--safe-primary);
  color: #ffffff;
}

.auth-secondary {
  flex: 1;
  border: 1rpx solid rgba(87, 139, 95, 0.28);
  background: #ffffff;
  color: var(--safe-primary-deep);
}

.auth-primary::after,
.auth-secondary::after {
  border: 0;
}

.profile-note {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid rgba(87, 139, 95, 0.18);
  border-radius: var(--safe-radius-md);
  background: rgba(233, 242, 223, 0.64);
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.65;
}

.plain-list {
  display: flex;
  flex-direction: column;
  margin-top: 20rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: rgba(255, 253, 248, 0.94);
  box-shadow: var(--safe-shadow-card);
  overflow: hidden;
}

.safety-list {
  border-color: rgba(215, 111, 103, 0.2);
  background: rgba(255, 248, 244, 0.9);
}

.plain-row,
.support-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 112rpx;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid var(--safe-border);
  border-radius: 0;
  background: var(--safe-card);
  text-align: left;
}

.plain-row:last-child,
.support-row:last-child {
  border-bottom: 0;
}

.plain-row::after,
.support-row::after {
  border: 0;
}

.plain-row:active,
.support-row:active {
  transform: scale(0.99);
}

.row-copy {
  min-width: 0;
  flex: 1;
}

.row-title {
  color: var(--safe-title);
  font-size: 28rpx;
  font-weight: 850;
  line-height: 1.4;
}

.row-subtitle {
  margin-top: 8rpx;
  color: var(--safe-muted);
  font-size: 23rpx;
  line-height: 1.45;
}

.row-arrow {
  color: var(--safe-primary);
  font-size: 40rpx;
}

.safety-card {
  margin-top: 20rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid rgba(215, 111, 103, 0.24);
  border-radius: var(--safe-radius-md);
  background: rgba(255, 244, 240, 0.9);
}

.safety-title {
  color: #9F3E38;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.45;
}

.safety-text {
  margin-top: 8rpx;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.7;
}
.researcher-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  border-left: 5rpx solid var(--safe-primary);
}
