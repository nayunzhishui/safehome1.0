.profile-page {
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.user-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  overflow: hidden;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  flex: 0 0 92rpx;
  border-radius: 50%;
  background: var(--safe-orange-soft);
  color: #9E6626;
  font-size: 34rpx;
  font-weight: 900;
}

.user-copy {
  min-width: 0;
  flex: 1;
}

.user-name,
.user-state,
.streak-text,
.growth-level,
.profile-note,
.row-title,
.row-subtitle,
.safety-title,
.safety-text {
  display: block;
}

.user-name {
  color: var(--safe-title);
  font-size: 34rpx;
  font-weight: 850;
  line-height: 1.35;
}

.user-state {
  margin-top: 8rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.45;
}

.streak-text {
  margin-top: 10rpx;
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 800;
}

.growth-level {
  max-width: 140rpx;
  padding: 8rpx 14rpx;
  border-radius: var(--safe-radius-pill);
  background: var(--safe-primary-soft);
  color: var(--safe-primary-deep);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.35;
  text-align: center;
}

.profile-note {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid rgba(87, 139, 95, 0.18);
  border-radius: var(--safe-radius-md);
  background: rgba(233, 242, 223, 0.64);
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.65;
}

.entry-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 20rpx;
}

.support-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 20rpx;
  padding: 14rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: rgba(255, 253, 248, 0.94);
  box-shadow: var(--safe-shadow-card);
}

.safety-list {
  border-color: rgba(215, 111, 103, 0.2);
  background: rgba(255, 248, 244, 0.9);
}

.support-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 112rpx;
  padding: 18rpx;
  border-radius: var(--safe-radius-sm);
  background: var(--safe-card);
  text-align: left;
}

.support-row::after {
  border: 0;
}

.support-row:active {
  transform: scale(0.99);
}

.row-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  flex: 0 0 64rpx;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 900;
}

.row-copy {
  min-width: 0;
  flex: 1;
}

.row-title {
  color: var(--safe-title);
  font-size: 28rpx;
  font-weight: 850;
  line-height: 1.4;
}

.row-subtitle {
  margin-top: 8rpx;
  color: var(--safe-muted);
  font-size: 23rpx;
  line-height: 1.45;
}

.row-arrow {
  color: var(--safe-primary);
  font-size: 40rpx;
}

.safety-card {
  margin-top: 20rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid rgba(215, 111, 103, 0.24);
  border-radius: var(--safe-radius-md);
  background: rgba(255, 244, 240, 0.9);
}

.safety-title {
  color: #9F3E38;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.45;
}

.safety-text {
  margin-top: 8rpx;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.7;
}
