.profile-page {
  padding-bottom: 48rpx;
}

.user-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: 16rpx;
  background: linear-gradient(135deg, rgba(255, 253, 248, 0.96), rgba(237, 246, 232, 0.9));
  box-shadow: 0 16rpx 38rpx rgba(52, 66, 58, 0.08);
}

.avatar {
  width: 92rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  border-radius: 50%;
  background: #ffe8ca;
  color: #9e6626;
  font-size: 34rpx;
  font-weight: 800;
}

.user-copy {
  min-width: 0;
  flex: 1;
}

.user-name,
.user-state,
.streak-text,
.growth-level {
  display: block;
}

.user-name {
  color: var(--safe-title);
  font-size: 32rpx;
  font-weight: 800;
}

.user-state {
  margin-top: 8rpx;
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.45;
}

.streak-text {
  margin-top: 10rpx;
  color: var(--safe-primary-deep);
  font-size: 23rpx;
  font-weight: 700;
}

.growth-level {
  max-width: 132rpx;
  color: var(--safe-primary-deep);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.35;
  text-align: right;
}

.entry-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 20rpx;
}

.support-list {
  display: grid;
  gap: 14rpx;
  margin-top: 20rpx;
  padding: 14rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: 16rpx;
  background: rgba(255, 253, 248, 0.94);
  box-shadow: 0 12rpx 30rpx rgba(52, 66, 58, 0.08);
}

.safety-list {
  border-color: #efd0cc;
  background: #fff7f3;
}

.support-row {
  min-height: 112rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #fff7f0;
  text-align: left;
}

.support-row:active {
  transform: scale(0.99);
}

.row-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.row-copy {
  min-width: 0;
  flex: 1;
}

.row-title,
.row-subtitle {
  display: block;
}

.row-title {
  color: var(--safe-title);
  font-size: 28rpx;
  font-weight: 800;
}

.row-subtitle {
  margin-top: 8rpx;
  color: var(--safe-muted);
  font-size: 23rpx;
  line-height: 1.45;
}

.row-arrow {
  color: var(--safe-primary);
  font-size: 40rpx;
}

.crisis-card {
  margin-top: 16rpx;
  padding: 22rpx;
  border: 1rpx solid #efd0cc;
  border-radius: 16rpx;
  background: #fbe8e2;
  color: #b94a3c;
  font-size: 24rpx;
  line-height: 1.65;
}
