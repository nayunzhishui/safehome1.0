<view class="safe-page safe-page--with-tabbar profile-page">
  <view class="profile-heading">我的</view>
  <view class="user-card safe-card">
    <view class="avatar">家</view>
    <view class="user-copy">
      <text class="user-name">{{user.nickname}}</text>
      <text class="user-state">{{user.loginState}}</text>
      <text wx:if="{{user.roleText}}" class="user-role">{{user.roleText}}</text>
      <text class="streak-text">{{user.streakText}}</text>
    </view>
    <text class="growth-level">{{user.growthLevel}}</text>
  </view>

  <view class="auth-panel safe-card">
    <text class="auth-title">{{loggedIn ? '账号已连接' : '先登录后保存记录'}}</text>
    <text class="auth-text">登录后，你的记录只会用于本工具内的复盘、训练建议和必要的人工补充反馈。</text>
    <view wx:if="{{loggedIn}}" class="auth-actions">
      <button class="auth-secondary" bindtap="doLogout" loading="{{logoutBusy}}" disabled="{{logoutBusy}}">退出登录</button>
    </view>
    <view wx:else class="auth-actions">
      <button class="auth-primary" bindtap="goLogin">去登录</button>
      <button class="auth-secondary" bindtap="goRegister">注册账号</button>
    </view>
    <view wx:if="{{identityStatus}}" class="identity-summary" aria-label="登录方式">
      <view class="identity-heading">
        <text class="identity-title">登录方式</text>
        <text class="identity-note">只显示连接状态，不显示身份值</text>
      </view>
      <view class="identity-row">
        <view class="identity-copy">
          <text class="identity-label">微信登录</text>
          <text class="identity-state">{{identityStatus.identities.wechat.state === 'unbound' ? '未连接' : '已连接'}}</text>
        </view>
        <button wx:if="{{identityStatus.identities.wechat.can_unbind}}" class="identity-action" data-identity="wechat" bindtap="requestIdentityUnbind" disabled="{{identityBusy}}">撤销</button>
      </view>
      <view class="identity-row">
        <view class="identity-copy">
          <text class="identity-label">手机号登录</text>
          <text class="identity-state">{{identityStatus.identities.phone.state === 'unbound' ? '未连接' : '已连接'}}</text>
        </view>
        <button wx:if="{{identityStatus.identities.phone.can_unbind}}" class="identity-action" data-identity="phone" bindtap="requestIdentityUnbind" disabled="{{identityBusy}}">撤销</button>
      </view>
      <text class="identity-boundary">撤销登录方式会退出所有设备，但不会删除你的记录。</text>
    </view>
  </view>

  <view wx:if="{{dataClaim}}" class="claim-card safe-card" aria-label="找回本机试用记录">
    <view class="claim-marker">可找回</view>
    <text class="claim-title">把本机试用记录放进当前账号</text>
    <text class="claim-text">找到 {{dataClaim.total_records}} 条本机试用记录。确认后，测评、日记和练习记录会归到当前账号；暂不处理也不会删除。</text>
    <view class="claim-modules">
      <text wx:for="{{dataClaim.modules}}" wx:key="module" class="claim-module">{{item.label}} {{item.count}}</text>
    </view>
    <text class="claim-boundary">{{dataClaim.boundary_notice}}</text>
    <view class="claim-actions">
      <button class="auth-primary" bindtap="confirmDataClaim" loading="{{claimBusy}}" disabled="{{claimBusy}}">确认合并</button>
      <button class="auth-secondary" bindtap="dismissDataClaim" disabled="{{claimBusy}}">暂不处理</button>
    </view>
  </view>

  <view class="safe-card researcher-entry">
    <view class="row-copy">
      <text class="row-title">{{isResearcher ? '研究者评估仪表盘' : '研究者登录'}}</text>
      <text class="row-subtitle">{{isResearcher ? '查看报名、报告、任务材料和人工备注' : '仅限由管理员创建的研究者账号'}}</text>
    </view>
    <button class="auth-secondary" bindtap="goResearcher">{{isResearcher ? '进入仪表盘' : '账号登录'}}</button>
  </view>

  <view class="safe-section">
    <section-title title="我的记录" />
    <view class="plain-list">
      <button wx:for="{{recordEntries}}" wx:key="title" class="plain-row" data-group="recordEntries" data-index="{{index}}" bindtap="openEntry">
        <view class="row-copy">
          <text class="row-title">{{item.title}}</text>
          <text class="row-subtitle">{{item.subtitle}}</text>
        </view>
        <text class="row-arrow">›</text>
      </button>
    </view>
  </view>

  <view class="safe-section">
    <section-title title="专业支持" />
    <view class="plain-list">
      <button wx:for="{{supportEntries}}" wx:key="title" class="support-row" data-group="supportEntries" data-index="{{index}}" bindtap="openEntry">
        <view class="row-copy">
          <text class="row-title">{{item.title}}</text>
          <text class="row-subtitle">{{item.subtitle}}</text>
        </view>
        <text class="row-arrow">›</text>
      </button>
    </view>
  </view>

  <view class="safe-section">
    <section-title title="安全支持" />
    <view class="safety-card">
      <text class="safety-title">如果出现紧急安全风险</text>
      <text class="safety-text">请先联系身边可信赖的人、学校老师、当地紧急医疗或心理危机支持。本小程序不能提供实时危机干预。</text>
    </view>
    <view class="plain-list safety-list">
      <button wx:for="{{safetyEntries}}" wx:key="title" class="support-row" data-group="safetyEntries" data-index="{{index}}" bindtap="openEntry">
        <view class="row-copy">
          <text class="row-title">{{item.title}}</text>
          <text class="row-subtitle">{{item.subtitle}}</text>
        </view>
        <text class="row-arrow">›</text>
      </button>
    </view>
  </view>

  <view class="safe-section">
    <section-title title="设置与说明" />
    <view class="plain-list">
      <button wx:for="{{settingsEntries}}" wx:key="title" class="support-row" data-group="settingsEntries" data-index="{{index}}" bindtap="openEntry">
        <view class="row-copy">
          <text class="row-title">{{item.title}}</text>
          <text class="row-subtitle">{{item.subtitle}}</text>
        </view>
        <text class="row-arrow">›</text>
      </button>
    </view>
  </view>

  <view class="safe-section">
    <bottom-tip-card text="安心陪伴，先照顾好自己，再慢慢陪孩子往前走。" />
  </view>
</view>
