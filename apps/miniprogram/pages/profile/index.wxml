<view class="safe-page safe-page--with-tabbar profile-page">
  <view class="user-card safe-card safe-card--hero">
    <view class="avatar">家</view>
    <view class="user-copy">
      <text class="user-name">{{user.nickname}}</text>
      <text class="user-state">{{user.loginState}}</text>
      <text wx:if="{{user.roleText}}" class="user-role">{{user.roleText}}</text>
      <text class="streak-text">{{user.streakText}}</text>
    </view>
    <text class="growth-level">{{user.growthLevel}}</text>
  </view>

  <view class="auth-panel safe-card">
    <text class="auth-title">{{loggedIn ? '账号已连接' : '先登录后保存记录'}}</text>
    <text class="auth-text">登录后，你的记录只会用于本工具内的复盘、训练建议和必要的人工补充反馈。</text>
    <view wx:if="{{loggedIn}}" class="auth-actions">
      <button class="auth-secondary" bindtap="doLogout">退出登录</button>
    </view>
    <view wx:else class="auth-actions">
      <button class="auth-primary" bindtap="goLogin">去登录</button>
      <button class="auth-secondary" bindtap="goRegister">注册账号</button>
    </view>
  </view>

  <view class="profile-note">
    <text>这里用于查看记录、复盘和支持入口。当前不做诊断，也不替代专业咨询或紧急帮助。</text>
  </view>

  <view class="safe-card researcher-entry">
    <view class="row-copy">
      <text class="row-title">{{isResearcher ? '研究者评估仪表盘' : '研究者登录'}}</text>
      <text class="row-subtitle">{{isResearcher ? '查看报名、报告、任务材料和人工备注' : '仅限由管理员创建的研究者账号'}}</text>
    </view>
    <button class="auth-secondary" bindtap="goResearcher">{{isResearcher ? '进入仪表盘' : '账号登录'}}</button>
  </view>

  <view class="safe-section">
    <section-title title="我的记录" subtitle="查看复盘、反馈、训练和测评记录" />
    <view class="plain-list">
      <button wx:for="{{recordEntries}}" wx:key="title" class="plain-row" data-group="recordEntries" data-index="{{index}}" bindtap="openEntry">
        <view class="row-copy">
          <text class="row-title">{{item.title}}</text>
          <text class="row-subtitle">{{item.subtitle}}</text>
        </view>
        <text class="row-arrow">›</text>
      </button>
    </view>
  </view>

  <view class="safe-section">
    <section-title title="专业支持" subtitle="需要时获得进一步补充反馈" />
    <view class="plain-list">
      <button wx:for="{{supportEntries}}" wx:key="title" class="support-row" data-group="supportEntries" data-index="{{index}}" bindtap="openEntry">
        <view class="row-copy">
          <text class="row-title">{{item.title}}</text>
          <text class="row-subtitle">{{item.subtitle}}</text>
        </view>
        <text class="row-arrow">›</text>
      </button>
    </view>
  </view>

  <view class="safe-section">
    <section-title title="安全支持" subtitle="入口明显，但只提供现实帮助指引" />
    <view class="safety-card">
      <text class="safety-title">如果出现紧急安全风险</text>
      <text class="safety-text">请先联系身边可信赖的人、学校老师、当地紧急医疗或心理危机支持。本小程序不能提供实时危机干预。</text>
    </view>
    <view class="plain-list safety-list">
      <button wx:for="{{safetyEntries}}" wx:key="title" class="support-row" data-group="safetyEntries" data-index="{{index}}" bindtap="openEntry">
        <view class="row-copy">
          <text class="row-title">{{item.title}}</text>
          <text class="row-subtitle">{{item.subtitle}}</text>
        </view>
        <text class="row-arrow">›</text>
      </button>
    </view>
  </view>

  <view class="safe-section">
    <section-title title="设置与说明" subtitle="了解工具边界和后续说明" />
    <view class="plain-list">
      <button wx:for="{{settingsEntries}}" wx:key="title" class="support-row" data-group="settingsEntries" data-index="{{index}}" bindtap="openEntry">
        <view class="row-copy">
          <text class="row-title">{{item.title}}</text>
          <text class="row-subtitle">{{item.subtitle}}</text>
        </view>
        <text class="row-arrow">›</text>
      </button>
    </view>
  </view>

  <view class="safe-section">
    <bottom-tip-card text="安心陪伴，先照顾好自己，再慢慢陪孩子往前走。" />
  </view>
</view>
