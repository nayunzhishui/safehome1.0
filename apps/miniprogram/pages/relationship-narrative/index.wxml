<view class="p3-page narrative-page" role="main" aria-label="关系探索手记">
  <page-state wx:if="{{loading}}" kind="loading" title="正在读取关系探索手记" />
  <page-state wx:elif="{{errorMessage}}" kind="error" title="手记暂时无法读取" description="{{errorMessage}}" action-label="重新读取" bind:action="retryLoad" />
  <block wx:else>
    <view class="narrative-start">
      <status-pill label="{{isConfirmed ? '研究者已确认 · 可共同修订' : '研究者工作草稿 · 尚未发送'}}" tone="{{isConfirmed ? 'success' : 'neutral'}}" />
      <view class="narrative-box narrative-box--tight">
        <text class="p3-meta">起点画像</text>
        <text class="p3-item-title">{{narrative.draft.starting_profile.profile_name}}</text>
      </view>
    </view>

    <view wx:if="{{narrative.draft.selected_assessment_questions.length}}" class="narrative-section">
      <p3-section-header title="一起讨论的问题" />
      <view class="narrative-box">
        <text wx:for="{{narrative.draft.selected_assessment_questions}}" wx:key="*this" class="narrative-copy">{{index + 1}}. {{item}}</text>
      </view>
    </view>

    <view wx:if="{{taskRows.length}}" class="narrative-section">
      <p3-section-header title="线上任务材料" />
      <view class="narrative-box">
        <text wx:for="{{taskRows}}" wx:key="rowKey" class="narrative-copy">{{item.taskTypeLabel}}：{{item.detailText}}</text>
      </view>
    </view>

    <view wx:if="{{isResearcherView && noteRows.length}}" class="narrative-section">
      <p3-section-header title="研究者备注" />
      <view class="narrative-box">
        <text wx:for="{{noteRows}}" wx:key="*this" class="narrative-copy">{{item}}</text>
      </view>
    </view>

    <view class="narrative-next">
      <p3-stage-header level="2" title="下一步项目任务" />
      <text class="narrative-copy">{{narrative.draft.next_project_task}}</text>
    </view>

    <text class="p3-footnote">{{narrative.draft.boundary_notice}}</text>
  </block>
</view>
