<view class="safe-page narrative-page" role="main" aria-label="关系探索手记">
  <page-state wx:if="{{loading}}" kind="loading" title="正在读取关系探索手记" description="只展示已经通过状态门控的内容。" />
  <page-state wx:elif="{{errorMessage}}" kind="error" title="手记暂时无法读取" description="{{errorMessage}}" action-label="重新读取" bind:action="retryLoad" />
  <view wx:else>
    <view class="narrative-head">
      <text class="narrative-kicker">{{isConfirmed ? '研究者已确认 · 可共同修订' : '研究者工作草稿 · 尚未发送'}}</text>
      <text class="narrative-title">关系探索手记</text>
    </view>
    <view class="starting-profile"><text class="starting-label">起点画像</text><text class="narrative-copy">{{narrative.draft.starting_profile.profile_name}}</text></view>
    <view class="narrative-card">
      <text class="section-title">一起讨论的问题</text>
      <text wx:for="{{narrative.draft.selected_assessment_questions}}" wx:key="*this" class="narrative-copy">{{index + 1}}. {{item}}</text>
    </view>
    <view class="narrative-card">
      <text class="section-title">线上任务材料</text>
      <text wx:for="{{taskRows}}" wx:key="task_type" class="narrative-copy">{{item.task_type}}：{{item.narration || item.review_status}}</text>
    </view>
    <view wx:if="{{isResearcherView && noteRows.length}}" class="narrative-card">
      <text class="section-title">研究者备注</text>
      <text wx:for="{{noteRows}}" wx:key="*this" class="narrative-copy">{{item}}</text>
    </view>
    <view class="narrative-card next-task-card">
      <view class="next-task-heading"><view class="bamboo-corner" aria-hidden="true"></view><text class="section-title">下一步项目任务</text></view>
      <text class="narrative-copy">{{narrative.draft.next_project_task}}</text>
    </view>
    <view class="boundary-card">{{narrative.draft.boundary_notice}}</view>
  </view>
</view>
