.narrative-page { display: grid; gap: 20rpx; padding-bottom: 48rpx; }
.narrative-card { display: grid; gap: 12rpx; margin-bottom: 18rpx; }
.narrative-kicker, .narrative-title, .narrative-copy, .section-title { display: block; }
.narrative-kicker { color: var(--safe-primary-deep); font-size: 22rpx; font-weight: 800; }
.narrative-title { color: var(--safe-title); font-size: 36rpx; font-weight: 900; }
.section-title { margin-top: 8rpx; color: var(--safe-title); font-size: 28rpx; font-weight: 850; }
.narrative-copy { color: var(--safe-text); font-size: 24rpx; line-height: 1.65; }
.boundary-card { padding: 20rpx; border: 1rpx solid rgba(184, 127, 45, 0.3); border-radius: var(--safe-radius-sm); background: var(--safe-orange-soft); color: var(--safe-text); font-size: 23rpx; line-height: 1.6; }
.error-card { color: var(--safe-danger); }
