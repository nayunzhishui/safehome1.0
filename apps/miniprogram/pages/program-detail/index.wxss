.program-detail-page {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.program-detail-page .hero-card,
.program-detail-page .protocol-card,
.program-detail-page .measurement-card,
.program-detail-page .session-card,
.program-detail-page .history-card {
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.hero-card,
.protocol-card,
.measurement-card,
.session-card,
.history-card {
  display: flex;
  flex-direction: column;
}

.hero-card {
  gap: 16rpx;
  padding-top: 34rpx !important;
  padding-bottom: 38rpx !important;
  border-bottom: 1rpx solid var(--safe-border) !important;
  text-align: center;
}

.program-kicker {
  color: var(--safe-primary-deep);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.4;
}

.program-title {
  color: var(--safe-title);
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: -1rpx;
  text-align: center;
}

.program-boundary {
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--safe-border);
  color: var(--safe-text);
  font-size: 28rpx;
  line-height: 1.65;
}

.program-meta-row {
  display: grid;
  gap: 14rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--safe-border);
}

.program-summary,
.session-objective {
  color: var(--safe-text);
  font-size: 28rpx;
  line-height: 1.65;
}

.protocol-status {
  color: var(--safe-primary-deep);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.5;
}

.construct-row,
.outcome-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 16rpx;
}

.construct-chip,
.outcome-chip {
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: var(--safe-muted);
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.5;
}

.construct-chip + .construct-chip::before,
.outcome-chip + .outcome-chip::before {
  margin-right: 16rpx;
  color: var(--safe-border-strong, #b7c3bc);
  content: "·";
}

.preview-readonly {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin: 28rpx 0 0;
  padding: 26rpx 28rpx 26rpx 20rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-sm);
  background: var(--safe-primary-soft);
}

.editorial-marker {
  flex: 0 0 auto;
  width: 6rpx;
  height: 82rpx;
  border-radius: var(--safe-radius-pill);
  background: var(--safe-primary);
}

.preview-readonly-copy {
  min-width: 0;
  flex: 1;
  color: var(--safe-text);
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.6;
}

.protocol-card,
.measurement-card,
.history-card {
  gap: 18rpx;
  padding-top: 38rpx !important;
  padding-bottom: 38rpx !important;
  border-bottom: 1rpx solid var(--safe-border) !important;
}

.protocol-card .safe-h3,
.measurement-card .safe-h3,
.history-card .safe-h3 {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
}

.protocol-line,
.protocol-label,
.protocol-warning,
.measurement-description,
.measurement-boundary {
  display: block;
  color: var(--safe-text);
  font-size: 28rpx;
  line-height: 1.65;
}

.protocol-label {
  margin-top: 10rpx;
  color: var(--safe-title);
  font-weight: 700;
}

.protocol-warning {
  margin-top: 4rpx;
  padding: 24rpx 26rpx;
  border-left: 6rpx solid var(--safe-orange);
  border-radius: 0 var(--safe-radius-sm) var(--safe-radius-sm) 0;
  background: var(--safe-orange-soft);
}

.measurement-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.measurement-head > view {
  min-width: 0;
  flex: 1;
}

.measurement-status {
  flex: 0 0 auto;
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.5;
}

.measurement-timeline {
  display: flex;
  flex-direction: column;
}

.measurement-point {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--safe-border);
}

.measurement-label {
  width: 108rpx;
  flex: 0 0 auto;
  color: var(--safe-primary-deep);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.6;
}

.measurement-description {
  min-width: 0;
  flex: 1;
}

.measurement-boundary {
  color: var(--safe-muted);
  font-size: 26rpx;
}

.session-tabs {
  box-sizing: border-box;
  width: 100%;
  margin-top: 34rpx;
  padding-bottom: 4rpx;
  white-space: nowrap;
}

.session-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 150rpx;
  min-height: 88rpx;
  margin-right: 14rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-sm) var(--safe-radius-sm) 0 0;
  background: var(--safe-card);
  color: var(--safe-text);
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.4;
}

.session-tab--active {
  border-color: var(--safe-primary);
  border-bottom-color: var(--safe-bg);
  background: var(--safe-primary-soft);
  color: var(--safe-primary-deep);
}

.session-card {
  gap: 22rpx;
  padding-top: 32rpx !important;
  padding-bottom: 38rpx !important;
}

.session-title {
  color: var(--safe-title);
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.4;
}

.session-meta {
  align-self: flex-start;
  color: var(--safe-muted);
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.5;
}

.section-block {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding-top: 14rpx;
}

.section-title {
  color: var(--safe-primary-deep);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.4;
}

.step-row {
  display: flex;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--safe-border);
  background: transparent;
}

.step-index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--safe-primary);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
}

.step-text,
.question-row,
.session-disclaimer {
  min-width: 0;
  flex: 1;
  color: var(--safe-text);
  font-size: 28rpx;
  line-height: 1.65;
}

.prompt-box,
.question-row,
.session-disclaimer {
  padding: 0;
  border-radius: 0;
  background: transparent;
}

.draft-input,
.reflection-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 220rpx;
  padding: 24rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-sm);
  background: var(--safe-card);
  color: var(--safe-title);
  font-size: 28rpx;
  line-height: 1.6;
}

.reflection-field {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 18rpx 0 8rpx;
  border-bottom: 1rpx solid var(--safe-border);
}

.reflection-input {
  min-height: 160rpx;
}

.session-disclaimer {
  padding: 20rpx 0;
  border-top: 1rpx solid var(--safe-border);
  font-size: 26rpx;
}

.submit-block {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  margin-top: 10rpx;
  padding: 30rpx 26rpx;
  border: 0;
  border-radius: var(--safe-radius-sm);
  background: var(--safe-primary-soft);
}

.consent-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  color: var(--safe-text);
  font-size: 27rpx;
  line-height: 1.6;
}

.status {
  padding: 20rpx 22rpx;
  border-radius: var(--safe-radius-sm);
  font-size: 26rpx;
  line-height: 1.6;
}

.status.success {
  background: var(--safe-bg-leaf);
  color: var(--safe-primary-deep);
}

.status.error {
  background: var(--safe-error-soft, #fff4f0);
  color: var(--safe-error, #9f3e38);
}

.history-card {
  padding-bottom: 8rpx !important;
  border-bottom: 0 !important;
}

.history-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid var(--safe-border);
}

.history-copy {
  min-width: 0;
  flex: 1;
}

.history-title,
.history-text {
  display: block;
}

.history-title {
  color: var(--safe-title);
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.5;
}

.history-text {
  margin-top: 8rpx;
  color: var(--safe-muted);
  font-size: 26rpx;
  line-height: 1.6;
}

.history-status {
  flex: 0 0 auto;
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.5;
}
