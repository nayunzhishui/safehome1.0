.program-detail-page {
  display: flex;
  flex-direction: column;
  gap: 26rpx;
}

.hero-card,
.session-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.program-kicker {
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 850;
}

.program-title {
  color: var(--safe-title);
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.28;
}

.program-summary,
.session-objective,
.session-disclaimer {
  color: var(--safe-text);
  font-size: 25rpx;
  line-height: 1.65;
}

.construct-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.construct-chip {
  padding: 6rpx 14rpx;
  border-radius: var(--safe-radius-pill);
  background: var(--safe-primary-soft);
  color: var(--safe-primary-deep);
  font-size: 22rpx;
  font-weight: 800;
}

.session-tabs {
  width: 100%;
  white-space: nowrap;
}

.session-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 146rpx;
  min-height: 70rpx;
  margin-right: 14rpx;
  padding: 0 22rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-pill);
  background: #fffdf8;
  color: var(--safe-text);
  font-size: 25rpx;
  font-weight: 800;
}

.session-tab--active {
  border-color: var(--safe-primary);
  background: var(--safe-primary-pale);
  color: var(--safe-primary-deep);
}

.session-title {
  color: var(--safe-title);
  font-size: 32rpx;
  font-weight: 900;
  line-height: 1.35;
}

.session-meta {
  align-self: flex-start;
  padding: 6rpx 14rpx;
  border-radius: var(--safe-radius-pill);
  background: var(--safe-orange-soft);
  color: var(--safe-orange);
  font-size: 23rpx;
  font-weight: 850;
}

.section-block {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.section-title {
  color: var(--safe-primary-deep);
  font-size: 27rpx;
  font-weight: 850;
}

.step-row {
  display: flex;
  gap: 16rpx;
  padding: 18rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-sm);
  background: var(--safe-bg-leaf);
}

.step-index {
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  border-radius: 50%;
  background: var(--safe-primary-soft);
  color: var(--safe-primary-deep);
  font-size: 22rpx;
  font-weight: 900;
}

.step-text {
  flex: 1;
  min-width: 0;
  color: var(--safe-text);
  font-size: 25rpx;
  line-height: 1.6;
}

.prompt-box,
.question-row,
.session-disclaimer {
  padding: 20rpx;
  border-radius: var(--safe-radius-sm);
  background: var(--safe-orange-soft);
  color: var(--safe-text);
  font-size: 25rpx;
  line-height: 1.65;
}

.draft-input {
  width: 100%;
  min-height: 220rpx;
  box-sizing: border-box;
  padding: 22rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-sm);
  background: #fffdf8;
  color: var(--safe-title);
  font-size: 26rpx;
  line-height: 1.6;
}

.question-row {
  background: var(--safe-bg-leaf);
}

.session-disclaimer {
  background: var(--safe-primary-pale);
}

.protocol-status,
.protocol-line,
.protocol-label,
.protocol-warning {
  display: block;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.65;
}

.protocol-status {
  color: var(--safe-orange);
  font-weight: 850;
}

.protocol-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.protocol-label {
  margin-top: 8rpx;
  color: var(--safe-title);
  font-weight: 850;
}

.protocol-warning {
  padding: 18rpx;
  border-left: 6rpx solid var(--safe-orange);
  background: var(--safe-orange-soft);
}

.measurement-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.measurement-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.measurement-status {
  flex: 0 0 auto;
  padding: 6rpx 14rpx;
  border-radius: var(--safe-radius-pill);
  background: var(--safe-orange-soft);
  color: var(--safe-orange);
  font-size: 22rpx;
  font-weight: 800;
}

.measurement-timeline {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.measurement-point {
  display: grid;
  grid-template-columns: 116rpx minmax(0, 1fr);
  gap: 16rpx;
  padding: 18rpx;
  border-left: 6rpx solid var(--safe-primary);
  background: var(--safe-bg-leaf);
}

.measurement-label {
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 850;
}

.measurement-description,
.measurement-boundary {
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.6;
}

.outcome-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.outcome-chip {
  padding: 6rpx 14rpx;
  border-radius: var(--safe-radius-pill);
  background: var(--safe-blue-soft);
  color: var(--safe-blue);
  font-size: 22rpx;
  font-weight: 750;
}

.measurement-boundary {
  padding: 18rpx;
  border-radius: var(--safe-radius-sm);
  background: var(--safe-primary-pale);
}

.submit-block {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(87, 139, 95, 0.18);
  border-radius: var(--safe-radius-md);
  background: rgba(248, 251, 245, 0.86);
}

.preview-readonly {
  padding: 18rpx 20rpx;
  border: 1rpx dashed rgba(244, 127, 69, 0.34);
  border-radius: var(--safe-radius-sm);
  background: var(--safe-orange-soft);
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.65;
}

.consent-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.6;
}

.status {
  padding: 18rpx;
  border-radius: var(--safe-radius-sm);
  font-size: 24rpx;
  line-height: 1.6;
}

.status.success {
  border: 1rpx solid rgba(87, 139, 95, 0.22);
  background: var(--safe-bg-leaf);
  color: var(--safe-primary-deep);
}

.status.error {
  border: 1rpx solid rgba(215, 111, 103, 0.28);
  background: rgba(255, 244, 240, 0.9);
  color: #9f3e38;
}
.reflection-field {
  display: grid;
  gap: 12rpx;
  margin-top: 18rpx;
}

.reflection-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 150rpx;
  padding: 20rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-sm);
  background: var(--safe-card);
  color: var(--safe-title);
  font-size: 25rpx;
  line-height: 1.6;
}

.history-card {
  display: grid;
  gap: 16rpx;
}

.history-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid var(--safe-border);
}

.history-copy {
  min-width: 0;
  flex: 1;
}

.history-title,
.history-text {
  display: block;
}

.history-title {
  color: var(--safe-title);
  font-size: 25rpx;
  font-weight: 800;
}

.history-text {
  margin-top: 6rpx;
  color: var(--safe-muted);
  font-size: 23rpx;
  line-height: 1.55;
}

.history-status {
  flex: 0 0 auto;
  padding: 5rpx 12rpx;
  border-radius: var(--safe-radius-pill);
  background: var(--safe-primary-soft);
  color: var(--safe-primary-deep);
  font-size: 21rpx;
  font-weight: 800;
}
