<view class="safe-page program-detail-page" wx:if="{{program}}">
  <view class="safe-card hero-card">
    <text class="program-kicker">项目测试</text>
    <text class="program-title">{{program.title}}</text>
    <text class="program-summary">{{program.boundary_notice}}</text>
    <text class="protocol-status">{{program.previewLabel}} · 方案 {{program.protocol_version}}</text>
    <view class="construct-row">
      <text wx:for="{{program.target_constructs}}" wx:key="*this" class="construct-chip">{{item}}</text>
    </view>
  </view>

  <view class="safe-card protocol-card">
    <text class="safe-h3">参与前先了解</text>
    <text class="protocol-line">{{program.doseText}}</text>
    <text class="protocol-line">{{program.completion_definition}}</text>
    <text class="protocol-label">适合参加的基本条件</text>
    <text wx:for="{{program.inclusion_criteria}}" wx:key="*this" class="protocol-line">• {{item}}</text>
    <text class="protocol-label">这些情况先不要继续</text>
    <text wx:for="{{program.exclusion_criteria}}" wx:key="*this" class="protocol-line">• {{item}}</text>
    <text class="protocol-warning">{{program.safety_gate}}</text>
    <text wx:if="{{program.neutral_alternative}}" class="protocol-line">可选替代：{{program.neutral_alternative}}</text>
    <text wx:if="{{program.interpretation_boundary}}" class="protocol-line">{{program.interpretation_boundary}}</text>
    <text wx:if="{{program.clinical_boundary}}" class="protocol-line">{{program.clinical_boundary}}</text>
  </view>

  <view wx:if="{{program.measurementPlan}}" class="safe-card measurement-card">
    <view class="measurement-head">
      <view>
        <text class="safe-h3">项目记录节奏</text>
        <text class="safe-caption">用于安排开始前、练习中和完成后的阶段记录。</text>
      </view>
      <text class="measurement-status">{{program.measurementPlan.statusLabel}}</text>
    </view>
    <view class="measurement-timeline">
      <view wx:for="{{program.measurementPlan.measurement_points}}" wx:key="key" class="measurement-point">
        <text class="measurement-label">{{item.label}}</text>
        <text class="measurement-description">{{item.description}}</text>
      </view>
    </view>
    <view class="outcome-row">
      <text wx:for="{{program.measurementPlan.primary_outcomes}}" wx:key="*this" class="outcome-chip">{{item}}</text>
    </view>
    <text class="measurement-boundary">{{program.measurementPlan.boundary_notice}}</text>
  </view>

  <scroll-view class="session-tabs" scroll-x="true">
    <button
      wx:for="{{sessions}}"
      wx:key="session_no"
      class="session-tab {{item.isActive ? 'session-tab--active' : ''}}"
      data-session-no="{{item.session_no}}"
      bindtap="selectSession"
    >
      第 {{item.session_no}} 节
    </button>
  </scroll-view>

  <view class="safe-card session-card" wx:if="{{selectedSession}}">
    <text class="session-title">{{selectedSession.title}}</text>
    <text class="session-objective">{{selectedSession.objective}}</text>
    <text class="session-meta">预计 {{selectedSession.duration_minutes}} 分钟</text>

    <view class="section-block">
      <text class="section-title">练习步骤</text>
      <view wx:for="{{selectedSession.steps}}" wx:key="*this" class="step-row">
        <text class="step-index">{{index + 1}}</text>
        <text class="step-text">{{item}}</text>
      </view>
    </view>

    <view wx:if="{{selectedSession.writing_prompt}}" class="section-block">
      <text class="section-title">书写提示</text>
      <text class="prompt-box">{{selectedSession.writing_prompt}}</text>
      <textarea class="draft-input" value="{{draftText}}" placeholder="可以先写在这里。保存草稿只留在本机；点击正式提交后才会上传。" bindinput="onDraftInput" />
      <button class="safe-primary-button" bindtap="saveDraft">保存本机草稿</button>
    </view>

    <view class="section-block">
      <text class="section-title">反思问题</text>
      <view wx:for="{{selectedSession.reflection_questions}}" wx:key="*this" class="question-row">{{item}}</view>
    </view>

    <view class="session-disclaimer">{{selectedSession.disclaimer}}</view>
    <view class="session-disclaimer">完成标准：{{selectedSession.completion_criteria}}</view>
    <view class="session-disclaimer">停止提示：{{selectedSession.stop_rule}}</view>

    <view class="submit-block">
      <text class="protocol-label">练习前不适程度：{{distressBefore}} / 10</text>
      <slider min="0" max="10" step="1" value="{{distressBefore}}" bindchange="onDistressBeforeChange" activeColor="#4E7C6B" />
      <text class="protocol-label">练习后不适程度：{{distressAfter}} / 10</text>
      <slider min="0" max="10" step="1" value="{{distressAfter}}" bindchange="onDistressAfterChange" activeColor="#4E7C6B" />
      <checkbox-group bindchange="onAdverseResponseChange">
        <label class="consent-row">
          <checkbox value="yes" checked="{{adverseResponse}}" color="#4E7C6B" />
          <text>这次练习出现了明显不适或负面体验，需要后续关注。</text>
        </label>
      </checkbox-group>
      <checkbox-group bindchange="onAnalysisConsentChange">
        <label class="consent-row">
          <checkbox value="yes" checked="{{analysisConsent}}" color="#4E7C6B" />
          <text>允许将本次内容用于脱敏聚合分析，不默认展示原文。</text>
        </label>
      </checkbox-group>
      <view wx:if="{{successMessage}}" class="status success">{{successMessage}}</view>
      <view wx:if="{{errorMessage}}" class="status error">{{errorMessage}}</view>
      <button class="safe-primary-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitEntry">登录后正式提交</button>
    </view>
  </view>
</view>

<view class="safe-page program-detail-page" wx:else>
  <view class="safe-card" wx:if="{{loading}}">
    <text class="safe-body">正在读取项目内容...</text>
  </view>
  <view class="safe-card" wx:elif="{{errorMessage}}">
    <text class="safe-h3">暂时没能读取</text>
    <text class="safe-body">{{errorMessage}}</text>
    <button class="safe-primary-button" bindtap="retryLoad">重试</button>
  </view>
  <view class="safe-card" wx:else>
    <text class="safe-body">没有找到对应项目内容。</text>
  </view>
</view>
