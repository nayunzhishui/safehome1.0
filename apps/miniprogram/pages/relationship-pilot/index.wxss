/* 关系探索试点（Figma 665:2685）：边界提示、当前步骤卡（唯一实心按钮）、五阶段竹节路径、其它入口分组。 */
.pilot-page {
  display: flex;
  flex-direction: column;
  gap: var(--p3-section);
  padding-top: 16rpx;
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
}

.pilot-card {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
  padding: var(--p3-card);
  border-radius: var(--p3-radius-card);
  background: var(--p3-surface);
  box-shadow: var(--p3-shadow-float);
}

.pilot-card__head {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.pilot-card__text {
  color: var(--p3-muted);
  font-size: 30rpx;
  line-height: 52rpx;
}

.pilot-card__actions {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
}

.pilot-section {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
}

.pilot-path {
  display: flex;
  flex-direction: column;
  padding: 32rpx;
  border-radius: var(--p3-radius-group);
  background: var(--p3-surface);
}

.pilot-row {
  display: block;
  width: 100%;
  min-height: 0;
  text-align: left;
}
