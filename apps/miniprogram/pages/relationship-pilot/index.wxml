<view class="p3-page pilot-page" role="main" aria-label="关系探索试点">
  <view class="p3-notice" role="note">
    <text class="p3-notice__body">从起点测评到连续记录，每一步都可以暂停。这里不判断你是否“适合恋爱”，也不替代心理咨询。</text>
  </view>

  <page-state wx:if="{{loading}}" kind="loading" title="正在读取你的探索进度" />

  <view wx:elif="{{roleBlocked}}" class="pilot-card">
    <text class="p3-item-title">当前仅向学生试点账号开放</text>
    <text class="pilot-card__text">你仍可使用情绪记录、训练卡和其它支持功能。若需参加关系探索试点，请切换到已授权的学生账号。</text>
  </view>

  <view wx:elif="{{!enrollment}}" class="pilot-card">
    <view class="pilot-card__head">
      <text class="p3-meta">第一步 · 起点测评与报名</text>
      <text class="p3-item-title">确认是否进入第二阶段</text>
    </view>
    <text class="pilot-card__text">报名会关联你最近一份关系探索测评的维度、阶段性画像与报告。逐行研究数据不会显示给其他用户。</text>
    <checkbox-group class="p3-agreement" aria-label="研究用途确认" bindchange="toggleConsent">
      <label class="p3-agreement__box {{consent ? 'p3-agreement__box--checked' : ''}}">
        <checkbox class="p3-agreement__native" value="agree" checked="{{consent}}" aria-label="我已阅读并同意将本次测评用于关系探索试点的评估与复盘" />
        <image wx:if="{{consent}}" class="p3-agreement__tick" src="/assets/icons/p3/tick-14-white.svg" aria-hidden="true" />
      </label>
      <text class="p3-agreement__text" bindtap="flipConsent">我已阅读并同意将本次测评用于关系探索试点的评估与复盘。</text>
    </checkbox-group>
    <view class="pilot-card__actions">
      <button class="p3-btn p3-btn--primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="enroll">确认报名</button>
      <button class="p3-btn p3-btn--quiet" bindtap="goAssessment">还没测评？先完成关系测一测</button>
    </view>
  </view>

  <block wx:else>
    <journey-action-card
      class="current-action-entry"
      variant="stage"
      show-marker
      eyebrow="当前步骤"
      marker="{{currentStepNumber}}"
      region-aria-label="关系探索当前步骤"
      state="{{currentActionState}}"
      state-label="{{reportStatusText}}"
      title="{{currentStageTitle}}"
      description="{{currentStageLead}}"
      button-label="{{primaryLabel}}"
      action-aria-label="{{primaryLabel}}：{{currentStageTitle}}"
      bind:action="runPrimaryAction"
    />

    <view class="pilot-section">
      <p3-section-header title="五阶段探索路径" />
      <view class="pilot-path" role="list">
        <p3-timeline-item
          wx:for="{{journeySteps}}"
          wx:key="key"
          role="listitem"
          state="{{item.timelineState}}"
          kicker="第 {{item.number}} 步 · {{item.stateText}}"
          title="{{item.title}}"
          body="{{item.description}}"
          show-line="{{index < journeySteps.length - 1}}"
        />
      </view>
    </view>

    <view class="pilot-section">
      <p3-section-header title="其它入口" />
      <view class="p3-group">
        <button wx:for="{{secondaryActions}}" wx:key="key" class="pilot-row" data-action="{{item.key}}" aria-label="{{item.label}}：{{item.description}}" bindtap="runSecondaryAction">
          <p3-group-row icon="{{item.icon}}" title="{{item.label}}" subtitle="{{item.description}}" show-divider="{{index < secondaryActions.length - 1}}" />
        </button>
      </view>
    </view>
  </block>

  <text wx:if="{{errorMessage}}" class="p3-form-message p3-form-message--error" role="alert">{{errorMessage}}</text>
  <text class="p3-footnote">所有画像和报告都只作阶段性观察，不构成诊断、人格标签、关系能力评价或疗效证明。</text>
</view>
