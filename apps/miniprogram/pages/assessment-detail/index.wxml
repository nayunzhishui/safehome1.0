<view class="safe-page assessment-detail-page" role="main" aria-label="支持性测评填写">
  <view wx:if="{{loading}}" class="state-box">
    <text>正在读取测一测内容...</text>
  </view>

  <view wx:elif="{{worksheet}}">
    <view class="assessment-detail-head">
      <text class="page-title">{{worksheet.display_title}}</text>
    </view>

    <view class="instruction-block">
      <text>{{worksheet.instructions}}</text>
    </view>

    <view wx:if="{{worksheet.sensitive_category && worksheet.sensitive_category !== 'none'}}" class="sensitive-strip">
      <text>注意：本内容含敏感语义，结果只作为自我观察线索，不作为诊断建议。</text>
    </view>

    <view class="question-list">
      <view class="question-card" wx:for="{{worksheet.questions}}" wx:key="id" wx:for-index="qi">
        <view class="question-head">
          <text class="question-num">{{qi + 1}}</text>
          <text class="question-title">{{item.prompt}}<text wx:if="{{item.required}}" class="required"> *</text></text>
        </view>

        <view wx:if="{{item.type === 'scale'}}" class="option-row {{item.options.length === 9 ? 'option-row--nine' : ''}}">
          <view
            wx:for="{{item.options}}"
            wx:for-item="opt"
            wx:key="value"
            class="option-button {{item.answerValue === opt.value ? 'active' : ''}}"
            data-index="{{qi}}"
            data-value="{{opt.value}}"
            data-score="{{opt.score}}"
            role="button"
            aria-label="选择 {{opt.displayLabel}}"
            bindtap="selectOption"
          >
            <text class="option-value">{{opt.value}}</text>
            <text class="option-label">{{opt.displayLabel}}</text>
          </view>
        </view>

        <textarea
          wx:else
          class="answer-textarea"
          value="{{item.answerValue}}"
          placeholder="写下你观察到的情况，简短一点也可以"
          data-index="{{qi}}"
          bindinput="onTextInput"
        />
      </view>
    </view>

    <view wx:if="{{errorMessage}}" class="error-box">
      <text>{{errorMessage}}</text>
      <button wx:if="{{needsLogin}}" class="safe-primary-button login-button" bindtap="goLogin">去登录后继续</button>
    </view>

    <text class="draft-status" aria-live="polite">{{draftRestored ? '已恢复：' : ''}}{{saveStatus}}</text>
    <text wx:if="{{slowSubmitting}}" class="draft-status draft-status--slow">网络响应较慢；草稿仍在本机，请不要重复点击。</text>

    <button class="safe-primary-button submit-button" bindtap="submitWorksheet" disabled="{{submitting}}">
      {{submitting ? '保存中...' : (worksheet.isStudentProfile ? '生成阶段性画像' : '保存观察记录')}}
    </button>

    <view class="boundary-footer">
      <text>{{worksheet.boundary_notice}}</text>
    </view>
  </view>

  <view wx:else class="state-box error">
    <text>{{errorMessage || '没有找到工作表内容。'}}</text>
  </view>
</view>
