.assessment-detail-page {
  padding-bottom: 72rpx;
}

.assessment-detail-head {
  padding: 10rpx 0 8rpx;
  text-align: center;
}

.page-title,
.page-subtitle,
.state-box,
.error-box {
  display: block;
}

.page-title {
  color: var(--safe-title);
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.35;
}

.page-subtitle {
  margin-top: 10rpx;
  color: var(--safe-muted);
  font-size: 23rpx;
  line-height: 1.6;
}

.instruction-block {
  margin-top: 18rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid var(--safe-border);
  border-bottom: 1rpx solid var(--safe-border);
  color: var(--safe-text);
  font-size: 25rpx;
  line-height: 1.7;
}

.sensitive-strip {
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  border: 1rpx solid rgba(192, 131, 59, 0.28);
  border-radius: var(--safe-radius-sm);
  background: var(--safe-orange-soft);
  color: #7a4e1d;
  font-size: 24rpx;
  line-height: 1.6;
}

.question-list {
  margin-top: 12rpx;
}

.question-card {
  position: relative;
  margin-top: 20rpx;
  padding: 22rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: var(--safe-card);
  box-shadow: var(--safe-shadow-card);
}

.question-card::before {
  content: "";
  display: block;
  width: 42rpx;
  height: 6rpx;
  margin-bottom: 14rpx;
  border-radius: 999rpx;
  background: var(--safe-primary);
}

.question-head {
  display: flex;
  gap: 14rpx;
  align-items: flex-start;
}

.question-num {
  flex: 0 0 auto;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--safe-primary-soft);
  color: var(--safe-primary-deep);
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1;
  margin-top: 2rpx;
}

.question-title {
  display: block;
  flex: 1;
  color: var(--safe-title);
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.55;
}

.required {
  color: var(--safe-danger);
}

.option-row {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 18rpx;
}

.option-row--nine {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.option-row--nine .option-button {
  min-width: 0;
  min-height: 112rpx;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
  padding: 12rpx 8rpx;
}

.option-row--nine .option-label {
  flex: 0 1 auto;
  font-size: 24rpx;
  line-height: 1.35;
  text-align: center;
}

.option-button {
  width: 100%;
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  box-sizing: border-box;
  padding: 16rpx 20rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-sm);
  background: var(--safe-bg);
}

.option-value {
  flex: 0 0 48rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #fff;
  color: var(--safe-text);
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1;
  text-align: center;
}

.option-label {
  flex: 1;
  min-width: 0;
  display: block;
  color: var(--safe-text);
  font-size: 24rpx;
  line-height: 1.55;
  text-align: left;
  white-space: normal;
  word-break: break-word;
  overflow-wrap: break-word;
}

.option-button.active {
  border-color: var(--safe-primary);
  background: var(--safe-primary-soft);
  color: var(--safe-primary-deep);
  font-weight: 800;
}

.option-button.active .option-value {
  background: #fff;
  color: var(--safe-primary-deep);
}

.answer-textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 160rpx;
  margin-top: 16rpx;
  padding: 18rpx;
  border: 1rpx solid var(--safe-border);
  border-radius: var(--safe-radius-md);
  background: var(--safe-bg);
  color: var(--safe-title);
  font-size: 26rpx;
  line-height: 1.65;
}

.submit-button {
  margin-top: 32rpx;
}

.login-button {
  margin-top: 18rpx;
}

.boundary-footer {
  margin-top: 28rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--safe-border);
  color: var(--safe-muted);
  font-size: 24rpx;
  line-height: 1.6;
}

.state-box,
.error-box {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: var(--safe-radius-md);
  font-size: 26rpx;
  line-height: 1.7;
}

.state-box {
  color: var(--safe-text);
}

.state-box.error,
.error-box {
  border: 1rpx solid #efb4b4;
  background: #fff1f1;
  color: #8a2f2f;
}
