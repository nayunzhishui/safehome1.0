.ta-page { display: grid; gap: 24rpx; }
.ta-hero { display: grid; gap: 12rpx; padding: 22rpx 8rpx 8rpx; }
.ta-kicker { color: var(--safe-primary-deep); font-size: 22rpx; font-weight: 800; letter-spacing: 2rpx; }
.ta-title { color: var(--safe-title); font-size: 42rpx; font-weight: 900; line-height: 1.25; }
.ta-copy, .ta-feedback-copy, .ta-question, .ta-boundary, .ta-footer-boundary { color: var(--safe-text); font-size: 24rpx; line-height: 1.7; }
.ta-card { display: grid; gap: 20rpx; margin: 0; border-radius: 26rpx; box-shadow: var(--safe-shadow-float); }
.ta-section-title { color: var(--safe-title); font-size: 29rpx; font-weight: 850; }
.ta-textarea { box-sizing: border-box; width: 100%; min-height: 190rpx; padding: 20rpx; border: 1rpx solid var(--safe-border); border-radius: 20rpx; background: #fff; }
.ta-textarea--short { min-height: 140rpx; }
.ta-field-label, .ta-meta { color: var(--safe-muted); font-size: 21rpx; line-height: 1.5; }
.ta-scope-list { display: grid; gap: 18rpx; }
.ta-scope-list label { min-height: 72rpx; display: flex; align-items: center; gap: 12rpx; color: var(--safe-text); }
.ta-boundary, .ta-footer-boundary { padding: 18rpx; border-radius: 18rpx; background: var(--safe-orange-soft); font-size: 21rpx; }
.ta-notice, .ta-error { padding: 20rpx 24rpx; border-radius: 18rpx; font-size: 22rpx; line-height: 1.6; }
.ta-notice { border-left: 6rpx solid var(--safe-primary); background: var(--safe-primary-pale); color: var(--safe-primary-deep); }
.ta-error { border-left: 6rpx solid var(--safe-danger); background: #fff3f1; color: #8b3b36; }
.ta-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.ta-heading > view { display: grid; gap: 5rpx; }
.ta-version { flex: none; padding: 6rpx 14rpx; border-radius: 999rpx; background: var(--safe-primary-soft); color: var(--safe-primary-deep); font-size: 20rpx; }
.ta-question { color: var(--safe-title); font-weight: 750; }
.ta-feedback { display: grid; gap: 12rpx; padding: 22rpx; border: 1rpx solid var(--safe-border-strong); border-radius: 20rpx; background: var(--safe-primary-pale); }
.ta-waiting { padding: 22rpx; border-radius: 20rpx; background: var(--safe-bg-soft); color: var(--safe-muted); font-size: 23rpx; line-height: 1.65; }
.ta-secondary-actions { display: grid; grid-template-columns: 1fr auto; gap: 12rpx; align-items: center; }
.ta-withdraw { min-height: 80rpx; padding: 0 14rpx; border: 0; color: var(--safe-muted); font-size: 21rpx; }
.ta-footer-boundary { margin-bottom: 20rpx; text-align: center; }
