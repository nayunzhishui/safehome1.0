<view class="safe-page ta-page" role="main" aria-label="支持性评估">
  <view class="ta-hero">
    <text class="ta-kicker">{{activeCase ? activeCase.service_level.display_name : defaultServiceLevel.display_name}} · 可撤回</text>
    <text class="ta-title">共同理解一次关系体验</text>
    <text class="ta-copy">从你真正关心的问题出发，决定愿意共享什么。反馈是可讨论的版本，不是对你或关系的定论。</text>
  </view>

  <view wx:if="{{notice}}" class="ta-notice" role="status">{{notice}}</view>
  <view wx:if="{{errorMessage}}" class="ta-error" role="alert">{{errorMessage}}</view>
  <view wx:if="{{productionContract}}" class="ta-contract" aria-label="协作式评估机器契约">
    <view class="ta-contract-heading">
      <text class="ta-section-title">协作边界已对齐</text>
      <text class="ta-version">{{productionContract.version}}</text>
    </view>
    <text class="ta-meta">服务级别、人员胜任力、对象权限和安全状态分别判断；任一项未知都会暂停继续。</text>
  </view>

  <view wx:if="{{adultLaunchScope}}" class="safe-card ta-card" aria-label="低风险成人首发范围">
    <text class="ta-section-title">当前首发范围</text>
    <text class="ta-meta">仅面向自愿参加、单人资料、非紧急议题的成年人，提供L1/L2真人支持性协作。</text>
    <text class="ta-boundary">{{adultLaunchScope.boundary_notice}}</text>
    <view wx:if="{{activeCase && (!launchScreening || launchScreening.decision === 'screening_required')}}">
      <button class="safe-outline-button" loading="{{saving}}" disabled="{{saving}}" bindtap="confirmAdultLaunchScope">确认符合上述范围</button>
    </view>
    <text wx:elif="{{launchScreening}}" class="ta-kicker">范围记录：{{launchScreening.decision}}</text>
  </view>

  <view wx:if="{{childPolicy}}" class="safe-card ta-card" aria-label="未成年人亲子保护范围">
    <text class="ta-section-title">未成年人/亲子子线</text>
    <text class="ta-meta">当前入口未开放。监护人同意和儿童知情、同意或拒绝会分别记录。</text>
    <text class="ta-boundary">{{childPolicy.boundary_notice}}</text>
  </view>

  <view wx:if="{{multiPartyPolicy}}" class="safe-card ta-card" aria-label="伴侣与多人保护范围">
    <text class="ta-section-title">伴侣与多人子线</text>
    <text class="ta-meta">当前入口未开放。每个人的个别披露默认不会进入共同反馈。</text>
    <text class="ta-boundary">{{multiPartyPolicy.boundary_notice}}</text>
  </view>

  <view class="safe-card ta-card ta-flow-entry">
    <view>
      <text class="ta-section-title">八步协作流程</text>
      <text class="ta-meta">一屏只做一个主要决定，草稿会先保存在本机，登录后可跨设备继续。</text>
    </view>
    <button wx:if="{{activeCase}}" class="safe-primary-button" bindtap="continueParticipantFlow">继续最近一次协作</button>
    <button wx:else class="safe-primary-button" bindtap="startParticipantFlow">开始一次协作</button>
    <button wx:if="{{activeCase}}" class="safe-outline-button" bindtap="startParticipantFlow">开始新的议题</button>
  </view>

  <view class="safe-card ta-card">
    <text class="ta-section-title">1. 写下想共同理解的问题</text>
    <textarea class="ta-textarea" maxlength="1000" value="{{question}}" bindinput="onQuestionInput" placeholder="例如：为什么最近一次沟通让我既想靠近又想退开？"></textarea>
    <text class="ta-field-label">本次愿意共享</text>
    <checkbox-group class="ta-scope-list" bindchange="onScopeChange">
      <label><checkbox value="question" checked="{{shareQuestion}}" color="#4f7c6b" />上面的问题</label>
      <label><checkbox value="recent_record" checked="{{shareRecentRecord}}" color="#4f7c6b" />最近一次相关记录</label>
    </checkbox-group>
    <button class="safe-primary-button" loading="{{saving}}" disabled="{{saving}}" bindtap="createCase">提交协作问题</button>
    <text class="ta-boundary">提交后仍可调整共享范围、表达不同意见或撤回。高风险内容会优先进入人工支持，不生成普通自动建议。</text>
  </view>

  <view wx:if="{{loading}}" class="safe-card ta-card">正在读取协作记录…</view>
  <view wx:elif="{{activeCase}}" class="safe-card ta-card">
    <view class="ta-heading">
      <view><text class="ta-section-title">2. 查看当前协作</text><text class="ta-meta">{{activeCase.workflowLabel}} · {{activeCase.service_level.display_name}}</text></view>
      <text class="ta-version">版本 {{activeCase.version}}</text>
    </view>
    <text class="ta-question">{{activeCase.assessment_question}}</text>
    <text wx:if="{{activeCase.working_question && activeCase.working_question !== activeCase.assessment_question}}" class="ta-meta">当前改写：{{activeCase.working_question}}</text>
    <view class="ta-secondary-actions">
      <button class="safe-outline-button" data-action="generate_candidates" bindtap="updateQuestionAction">查看两个问题候选</button>
      <button class="safe-outline-button" data-action="none_fit" bindtap="updateQuestionAction">都不符合</button>
      <button class="safe-outline-button" data-action="pause" bindtap="updateQuestionAction">暂时停一下</button>
    </view>
    <text wx:for="{{activeCase.question_candidates}}" wx:key="id" class="ta-meta">{{item.text}}</text>
    <view wx:if="{{activeCase.latestFeedback}}" class="ta-feedback">
      <text class="ta-kicker">经人工复核的反馈</text>
      <text class="ta-feedback-copy">{{activeCase.latestFeedback.participant_content}}</text>
      <text class="ta-meta">不确定性：{{activeCase.latestFeedback.uncertainty}}</text>
      <text class="ta-meta">可讨论的下一步：{{activeCase.latestFeedback.next_step}}</text>
    </view>
    <view wx:else class="ta-waiting">研究者正在整理可讨论的草稿；未经人工复核的内容不会发送给你。</view>
    <view class="ta-feedback">
      <text class="ta-kicker">本次可见线索</text>
      <block wx:if="{{evidenceItems.length}}">
        <text wx:for="{{evidenceItems}}" wx:key="id" class="ta-meta">{{item.kind}} · {{item.content}}</text>
      </block>
      <text wx:else class="ta-meta">尚无可见线索；内部草稿不会提前展示。</text>
    </view>
    <view class="ta-secondary-actions">
      <button class="safe-outline-button" bindtap="disagree">这和我的体验不一致</button>
      <button class="ta-withdraw" bindtap="withdraw">撤回本次协作</button>
    </view>
    <button class="safe-outline-button" bindtap="openQualityRecord">查看或提交更正与投诉</button>
  </view>

  <view wx:if="{{activeCase && activeCase.latestFeedback}}" class="safe-card ta-card">
    <text class="ta-section-title">3. 选择一个愿意尝试的小行动</text>
    <textarea class="ta-textarea ta-textarea--short" maxlength="500" value="{{actionText}}" bindinput="onActionInput" placeholder="写下低压力、可退出、今天能完成的一小步"></textarea>
    <button class="safe-primary-button" loading="{{saving}}" disabled="{{saving}}" bindtap="chooseAction">记录下一小步</button>
  </view>

  <view class="safe-card ta-card">
    <text class="ta-section-title">资料与共享</text>
    <text class="ta-boundary">每条资料单独决定：仅自己、指定专业人员，或经所有相关人确认后用于共同反馈。账号绑定不会自动互看；授权可修改、到期或撤回。</text>
  </view>

  <text class="ta-footer-boundary">共同反馈只记录变化、讨论和行动线索，不生成疗效分数，也不替代心理咨询、诊断或危机支持。</text>
</view>
