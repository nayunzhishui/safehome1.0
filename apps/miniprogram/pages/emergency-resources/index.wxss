/* 现实支持资源（Figma 671:3273）：宋体大标题与说明、四个竹节方向、使用边界、返回指引。 */
.resources-page {
  display: flex;
  flex-direction: column;
  gap: var(--p3-section);
  padding-top: 16rpx;
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
}

.resources-head {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
}

/* UIproduct3/Greeting：宋体 30/40，字距 1 */
.resources-title {
  color: var(--p3-ink);
  font-family: var(--p3-font-serif);
  font-size: 60rpx;
  line-height: 80rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.resources-intro {
  color: var(--p3-muted);
  font-size: 30rpx;
  line-height: 52rpx;
}

.resources-list {
  display: flex;
  flex-direction: column;
}
