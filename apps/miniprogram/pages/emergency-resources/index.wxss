.emergency-page {
  padding: 80rpx 48rpx calc(40rpx + env(safe-area-inset-bottom));
}

.page-kicker,
.page-title,
.page-summary,
.resource-title,
.resource-text,
.boundary-title,
.boundary-text {
  display: block;
}

.emergency-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  text-align: center;
}

.page-kicker {
  color: var(--experience-primary);
  font-size: var(--experience-font-caption);
  font-weight: 600;
  line-height: 36rpx;
}

.page-title {
  color: var(--experience-ink);
  font-size: 56rpx;
  font-weight: 700;
  line-height: 72rpx;
  text-align: center;
}

.page-summary {
  color: var(--experience-muted);
  font-size: var(--experience-font-body);
  line-height: 44rpx;
}

.header-rule {
  width: 112rpx;
  height: 4rpx;
  background: var(--experience-primary);
}

.resource-intro {
  margin-top: 32rpx;
  padding: 24rpx 0;
  border-top: 1rpx solid var(--safe-border);
  border-bottom: 1rpx solid var(--safe-border);
  color: var(--experience-ink);
  font-size: 28rpx;
  line-height: 1.65;
}

.resource-list {
  display: flex;
  flex-direction: column;
  margin-top: 48rpx;
}

.resource-row {
  display: flex;
  align-items: flex-start;
  gap: 32rpx;
  padding-bottom: 32rpx;
  border-bottom: 1rpx solid var(--experience-line);
}

.resource-row + .resource-row {
  padding-top: 32rpx;
}

.resource-corner {
  position: relative;
  flex: 0 0 24rpx;
  width: 24rpx;
  height: 48rpx;
}

.resource-corner__vertical,
.resource-corner__top {
  position: absolute;
  top: 0;
  left: 0;
  background: var(--experience-primary);
}

.resource-corner__vertical {
  width: 4rpx;
  height: 48rpx;
  border-radius: 2rpx;
}

.resource-corner__top {
  width: 24rpx;
  height: 4rpx;
  border-radius: 2rpx;
}

.resource-copy {
  flex: 1;
  min-width: 0;
}

.resource-title {
  color: var(--experience-ink);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.resource-text {
  margin-top: 16rpx;
  color: var(--experience-muted);
  font-size: var(--experience-font-body);
  line-height: 44rpx;
  overflow-wrap: anywhere;
}

.boundary-note {
  margin-top: 48rpx;
}

.boundary-rule {
  width: 100%;
  height: 1rpx;
  margin-bottom: 16rpx;
  background: var(--experience-danger);
}

.boundary-title {
  color: var(--experience-danger);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.boundary-text {
  margin-top: 16rpx;
  color: var(--experience-muted);
  font-size: var(--experience-font-body);
  line-height: 44rpx;
}

.bottom-action {
  width: 100%;
  min-height: var(--experience-touch);
  margin-top: 48rpx;
  border-color: var(--experience-primary);
  border-radius: 32rpx;
  color: var(--experience-primary-deep);
  transition: background-color 120ms ease, transform 120ms ease;
}

@media (max-width: 340px) {
  .emergency-page {
    padding-right: 40rpx;
    padding-left: 40rpx;
  }

  .resource-row {
    gap: 24rpx;
  }
}

@media (prefers-reduced-motion: reduce) {
  .bottom-action {
    transition: none;
  }

  .bottom-action.safe-active {
    transform: none;
  }
}
