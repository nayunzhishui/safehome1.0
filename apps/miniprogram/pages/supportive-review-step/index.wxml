<view class="p3-page sr-page" role="main" aria-label="{{stepTitle}}">
  <view wx:if="{{step !== 'followup'}}" class="sr-progress" aria-label="第 {{stepNumber}} 步，共 {{stepTotal}} 步">
    <text class="sr-progress__text">第 {{stepNumber}} 步 / 共 {{stepTotal}} 步</text>
    <view class="sr-progress__track" aria-hidden="true">
      <view wx:for="{{progress}}" wx:key="id" class="sr-progress__node sr-progress__node--{{item.state}}"></view>
    </view>
  </view>

  <view class="sr-head">
    <text class="p3-serif-title" role="heading" aria-level="1">{{stepTitle}}</text>
    <text wx:if="{{prompt}}" class="sr-prompt">{{prompt}}</text>
    <text wx:if="{{note}}" class="p3-meta">{{note}}</text>
  </view>

  <page-state wx:if="{{loading}}" kind="loading" title="正在读取" />
  <page-state
    wx:elif="{{loadError}}"
    kind="error"
    title="暂时没有读取成功"
    description="{{loadError}}"
    action-label="重新读取"
    action-aria-label="重新读取这一步"
    bindaction="load"
  />

  <block wx:else>
    <view wx:if="{{risk && risk.show_emergency_resources}}" class="p3-notice {{risk.level === 'high' ? 'p3-notice--risk' : 'p3-notice--warm'}}" role="alert">
      <text class="p3-notice__body">{{risk.message}}</text>
      <button class="p3-btn {{risk.level === 'high' ? 'p3-btn--risk' : 'p3-btn--secondary'}} sr-risk-action" bindtap="openEmergencyResources">查看紧急求助资源</button>
    </view>

    <view wx:if="{{step === 'question'}}" class="sr-group">
      <text class="p3-meta">先选一个最接近的主题</text>
      <view class="sr-chips" role="radiogroup" aria-label="问题主题">
        <button
          wx:for="{{topics}}"
          wx:key="id"
          class="p3-chip {{topicId === item.id ? 'p3-chip--selected' : ''}}"
          role="radio"
          aria-checked="{{topicId === item.id}}"
          aria-label="{{item.title}}：{{item.hint}}"
          data-id="{{item.id}}"
          bindtap="onTopicTap"
        >{{item.title}}</button>
      </view>
      <view wx:if="{{topicExamples.length}}" class="sr-examples">
        <text class="p3-meta">点一下，用这个问题开头</text>
        <button wx:for="{{topicExamples}}" wx:key="*this" class="sr-example" data-text="{{item}}" bindtap="useExample">{{item}}</button>
      </view>
    </view>

    <text wx:if="{{step === 'question' && starters.length}}" class="sr-starters">试试这样开头：{{startersText}}</text>

    <view wx:for="{{fields}}" wx:key="key" class="p3-field">
      <text class="p3-field__label">{{item.label}}</text>
      <textarea
        wx:if="{{index === 0}}"
        class="p3-field__input p3-field__input--multi"
        maxlength="{{item.maxLength}}"
        value="{{values[item.key]}}"
        placeholder="{{item.placeholder}}"
        placeholder-class="p3-field__placeholder"
        data-key="{{item.key}}"
        aria-label="{{item.label}}"
        bindinput="onFieldInput"
      />
      <textarea
        wx:else
        class="p3-field__input p3-field__input--auto"
        auto-height
        maxlength="{{item.maxLength}}"
        value="{{values[item.key]}}"
        placeholder="{{item.placeholder}}"
        placeholder-class="p3-field__placeholder"
        data-key="{{item.key}}"
        aria-label="{{item.label}}"
        bindinput="onFieldInput"
      />
      <text wx:if="{{index === 0}}" class="p3-field__hint">{{values[item.key].length || 0}} / {{item.maxLength}}</text>
    </view>

    <view wx:if="{{step === 'question'}}" class="sr-disclosure">
      <button class="p3-btn p3-btn--quiet" aria-expanded="{{rewritesOpen}}" bindtap="toggleRewrites">{{rewritesOpen ? '收起问法示例 ⌃' : '怎样把问题问得更好 ⌄'}}</button>
      <view wx:if="{{rewritesOpen}}" class="sr-rewrites">
        <view wx:for="{{rewrites}}" wx:key="from" class="sr-rewrite">
          <text class="sr-rewrite__from">{{item.from}}</text>
          <text class="sr-rewrite__to">{{item.to}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{step === 'episode'}}" class="p3-field">
      <text class="p3-field__label">当时有多难受</text>
      <view class="sr-scale" role="radiogroup" aria-label="当时有多难受，0 到 10">
        <button
          wx:for="{{intensityItems}}"
          wx:key="value"
          class="sr-scale__cell {{item.selected ? 'sr-scale__cell--selected' : ''}}"
          role="radio"
          aria-checked="{{item.selected}}"
          aria-label="{{item.value}} 分"
          data-value="{{item.value}}"
          bindtap="onIntensityTap"
        >{{item.value}}</button>
      </view>
      <view class="sr-scale__ends" aria-hidden="true">
        <text>{{intensityMinLabel}}</text>
        <text>{{intensityMaxLabel}}</text>
      </view>
    </view>

    <view wx:if="{{step === 'scales'}}" class="sr-group">
      <view wx:if="{{scaleEmpty}}" class="p3-notice">
        <text class="p3-notice__body">暂时没有可以填写的问卷。可以先跳过这一步，回看信会根据你写下的内容整理。</text>
      </view>
      <view wx:else class="p3-group" role="list">
        <view wx:for="{{scaleRows}}" wx:key="worksheetId" class="sr-scale-row {{index < scaleRows.length - 1 ? 'sr-scale-row--divided' : ''}}" role="listitem">
          <view class="sr-scale-row__copy">
            <text class="p3-item-title">{{item.title}}</text>
            <text class="p3-meta">{{item.resultId ? item.resultDay + ' 完成' : item.questionCount + ' 题'}}</text>
          </view>
          <button
            wx:if="{{item.resultId}}"
            class="p3-chip {{item.selected ? 'p3-chip--selected' : ''}}"
            role="checkbox"
            aria-checked="{{item.selected}}"
            data-index="{{index}}"
            bindtap="onScaleTap"
          >{{item.selected ? '已加入' : '加入'}}</button>
          <button
            wx:elif="{{item.available}}"
            class="p3-link"
            data-id="{{item.worksheetId}}"
            bindtap="openAssessment"
          >去填写 ›</button>
        </view>
      </view>
      <text wx:if="{{!scaleEmpty}}" class="p3-meta">已加入 {{selectedResultIds.length}} / {{maxResults}} 份。做完问卷后回到这里即可看到结果。</text>
    </view>

    <view wx:if="{{step === 'inquiry'}}" class="sr-group">
      <view wx:for="{{inquiryRows}}" wx:key="resultId" class="sr-inquiry">
        <view class="sr-inquiry__head">
          <text class="p3-item-title sr-inquiry__title">{{item.title}}</text>
          <text class="p3-meta">{{item.day}}</text>
        </view>
        <view class="p3-field">
          <text class="p3-field__label">哪一两道题让你停下来想了想？为什么？</text>
          <textarea class="p3-field__input p3-field__input--auto" auto-height maxlength="300" value="{{item.stood_out}}" placeholder="可以写题目的大意" placeholder-class="p3-field__placeholder" data-index="{{index}}" data-key="stood_out" aria-label="{{item.title}}：让你停下来的题目" bindinput="onInquiryInput" />
        </view>
        <view class="p3-field">
          <text class="p3-field__label">结果里哪一点像你，哪一点不像？</text>
          <textarea class="p3-field__input p3-field__input--auto" auto-height maxlength="300" value="{{item.fit}}" placeholder="例如：说我容易担心很像，说我很少放松不太像" placeholder-class="p3-field__placeholder" data-index="{{index}}" data-key="fit" aria-label="{{item.title}}：像与不像" bindinput="onInquiryInput" />
        </view>
      </view>
    </view>

    <view wx:if="{{step === 'experiment'}}" class="sr-group">
      <view wx:if="{{cardOptions.length}}" class="p3-field">
        <text class="p3-field__label">也可以配一个现成练习</text>
        <view class="sr-options" role="radiogroup" aria-label="现成练习">
          <button
            wx:for="{{cardOptions}}"
            wx:key="id"
            class="sr-option {{cardId === item.id ? 'sr-option--selected' : ''}}"
            role="radio"
            aria-checked="{{cardId === item.id}}"
            data-id="{{item.id}}"
            bindtap="onCardTap"
          >
            <image class="sr-option__radio" src="{{cardId === item.id ? '/assets/icons/p3/radio-20-selected.svg' : '/assets/icons/p3/radio-20-default.svg'}}" aria-hidden="true" />
            <view class="sr-option__copy">
              <text class="sr-option__title">{{item.title}}</text>
              <text wx:if="{{item.durationText}}" class="p3-meta">{{item.durationText}}</text>
            </view>
          </button>
        </view>
      </view>
      <view class="p3-field">
        <text class="p3-field__label">打算哪天开始</text>
        <view class="sr-date">
          <picker class="sr-date__picker" mode="date" start="{{todayDate}}" value="{{plannedDate || todayDate}}" bindchange="onDateChange">
            <view class="sr-select" role="button" aria-label="选择开始日期">
              <text class="sr-select__value {{plannedDate ? '' : 'sr-select__value--empty'}}">{{plannedDate || '选择日期'}}</text>
              <p3-icon name="calendar" size="24" tone="field" />
            </view>
          </picker>
          <button wx:if="{{plannedDate}}" class="p3-link" bindtap="clearDate">清除</button>
        </view>
      </view>
    </view>

    <view wx:if="{{step === 'followup'}}" class="sr-group">
      <view class="p3-field">
        <text class="p3-field__label">现在再看你的问题</text>
        <view class="sr-options" role="radiogroup" aria-label="现在再看你的问题">
          <button wx:for="{{questionNowOptions}}" wx:key="value" class="sr-option {{questionNow === item.value ? 'sr-option--selected' : ''}}" role="radio" aria-checked="{{questionNow === item.value}}" data-group="questionNow" data-value="{{item.value}}" bindtap="onChoiceTap">
            <image class="sr-option__radio" src="{{questionNow === item.value ? '/assets/icons/p3/radio-20-selected.svg' : '/assets/icons/p3/radio-20-default.svg'}}" aria-hidden="true" />
            <view class="sr-option__copy"><text class="sr-option__title">{{item.label}}</text></view>
          </button>
        </view>
      </view>
      <view class="p3-field">
        <text class="p3-field__label">接下来</text>
        <view class="sr-options" role="radiogroup" aria-label="接下来的打算">
          <button wx:for="{{nextOptions}}" wx:key="value" class="sr-option {{nextChoice === item.value ? 'sr-option--selected' : ''}}" role="radio" aria-checked="{{nextChoice === item.value}}" data-group="nextChoice" data-value="{{item.value}}" bindtap="onChoiceTap">
            <image class="sr-option__radio" src="{{nextChoice === item.value ? '/assets/icons/p3/radio-20-selected.svg' : '/assets/icons/p3/radio-20-default.svg'}}" aria-hidden="true" />
            <view class="sr-option__copy"><text class="sr-option__title">{{item.label}}</text></view>
          </button>
        </view>
        <view wx:if="{{nextChoice === 'human_support'}}" class="p3-notice">
          <text class="p3-notice__body">可以先看看线下专业资源的说明，再决定找谁聊。</text>
          <button class="p3-link" bindtap="openEmergencyResources">查看专业资源说明 ›</button>
        </view>
      </view>
    </view>

    <text wx:if="{{errorMessage}}" class="p3-form-message p3-form-message--error" role="alert">{{errorMessage}}</text>

    <view class="sr-actions">
      <text wx:if="{{saveStatus}}" class="p3-meta" role="status">{{saveStatus}}</text>
      <button class="p3-btn p3-btn--primary" loading="{{saving}}" disabled="{{saving}}" bindtap="onSave">{{primaryLabel}}</button>
      <button wx:if="{{canSkip}}" class="p3-btn p3-btn--quiet" disabled="{{saving}}" bindtap="onSkip">这一步先跳过</button>
      <button wx:elif="{{stepDone || step === 'experiment' || step === 'question'}}" class="p3-btn p3-btn--quiet" disabled="{{saving}}" bindtap="goHub">回到目录</button>
    </view>
  </block>
</view>
