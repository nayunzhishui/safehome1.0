/* 自助整理步骤（Figma 657:2032）：竹节进度 → 衬线标题与提问 → 主题 → 开头提示 → 字段 → 问法示例 → 保存。 */
.sr-page {
  display: flex;
  flex-direction: column;
  gap: var(--p3-section);
  padding-top: 16rpx;
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
}

.sr-progress {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
}

.sr-progress__text {
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

.sr-progress__track {
  display: flex;
  gap: 8rpx;
}

.sr-progress__node {
  flex: 1 0 0;
  min-width: 0;
  height: 12rpx;
  border-radius: 999rpx;
  background: var(--p3-primary);
  opacity: 0.14;
}

.sr-progress__node--done {
  opacity: 0.55;
}

.sr-progress__node--current {
  opacity: 1;
}

.sr-head {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
}

.sr-prompt {
  color: var(--p3-muted);
  font-size: 30rpx;
  line-height: 52rpx;
}

.sr-group {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
}

.sr-chips {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--p3-tight);
}

.sr-examples {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
}

.sr-example {
  display: block;
  width: 100%;
  min-height: 88rpx;
  padding: 20rpx 28rpx;
  border-radius: 28rpx;
  background: var(--p3-soft);
  color: var(--p3-ink);
  font-size: 28rpx;
  line-height: 44rpx;
  text-align: left;
}

.sr-starters {
  color: var(--p3-primary);
  font-size: 26rpx;
  line-height: 40rpx;
}

/* 次要字段：单行起步，随内容增高（Figma P3/Field Single，最小 48） */
.sr-disclosure {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
}

.sr-rewrites {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
}

.sr-rewrite {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 24rpx 28rpx;
  border-radius: var(--p3-radius-group);
  background: var(--p3-surface);
}

.sr-rewrite__from {
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
  text-decoration: line-through;
}

.sr-rewrite__to {
  color: var(--p3-ink);
  font-size: 28rpx;
  line-height: 44rpx;
}

/* 难受程度 0–10：两行等宽格子，选中青瓷浅底 + 1.5 描边 */
.sr-scale {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: var(--p3-tight);
}

.sr-scale__cell {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  border-radius: 28rpx;
  background: var(--p3-surface);
  box-shadow: inset 0 0 0 2rpx var(--p3-hairline);
  color: var(--p3-ink);
  font-size: 28rpx;
  line-height: 44rpx;
}

.sr-scale__cell--selected {
  background: var(--p3-soft);
  box-shadow: inset 0 0 0 3rpx var(--p3-primary);
  color: var(--p3-primary);
}

.sr-scale__ends {
  display: flex;
  justify-content: space-between;
  color: var(--p3-muted);
  font-size: 26rpx;
  line-height: 40rpx;
}

.sr-scale-row {
  display: flex;
  align-items: center;
  gap: var(--p3-stack);
  padding: 26rpx 0;
}

.sr-scale-row--divided {
  border-bottom: 2rpx solid var(--p3-hairline);
}

.sr-scale-row__copy {
  display: flex;
  flex: 1 0 0;
  flex-direction: column;
  gap: 2rpx;
  min-width: 0;
}

.sr-inquiry {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
  padding: var(--p3-card);
  border-radius: var(--p3-radius-card);
  background: var(--p3-surface);
}

.sr-inquiry__head {
  display: flex;
  align-items: baseline;
  gap: var(--p3-tight);
}

.sr-inquiry__title {
  flex: 1 0 0;
  min-width: 0;
}

/* 单选块（Figma P3/ChoiceOption）：描边计入布局 */
.sr-options {
  display: flex;
  flex-direction: column;
  gap: var(--p3-tight);
}

.sr-option {
  display: flex;
  align-items: flex-start;
  gap: var(--p3-stack);
  box-sizing: border-box;
  width: 100%;
  min-height: 0;
  padding: 30rpx 34rpx;
  border-radius: var(--p3-radius-group);
  background: var(--p3-surface);
  box-shadow: inset 0 0 0 2rpx var(--p3-hairline);
  text-align: left;
}

.sr-option--selected {
  padding: 31rpx 35rpx;
  background: var(--p3-soft);
  box-shadow: inset 0 0 0 3rpx var(--p3-primary);
}

.sr-option__radio {
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
}

.sr-option__copy {
  display: flex;
  flex: 1 0 0;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.sr-option__title {
  color: var(--p3-ink);
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: 500;
}

.sr-date {
  display: flex;
  align-items: center;
  gap: var(--p3-stack);
}

.sr-date__picker {
  flex: 1 0 0;
  min-width: 0;
}

.sr-select {
  display: flex;
  align-items: center;
  gap: var(--p3-tight);
  box-sizing: border-box;
  min-height: 96rpx;
  padding: 22rpx 28rpx;
  border-radius: 28rpx;
  background: var(--p3-surface);
  box-shadow: inset 0 0 0 2rpx var(--p3-control);
}

.sr-select__value {
  flex: 1 0 0;
  min-width: 0;
  color: var(--p3-ink);
  font-size: 30rpx;
  line-height: 52rpx;
}

.sr-select__value--empty {
  color: var(--p3-muted);
}

.sr-risk-action {
  margin-top: var(--p3-tight);
}

.sr-actions {
  display: flex;
  flex-direction: column;
  gap: var(--p3-stack);
}
