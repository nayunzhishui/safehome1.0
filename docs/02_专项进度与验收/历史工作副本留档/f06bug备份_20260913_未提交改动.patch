diff --git a/backend/services/research_access_service.py b/backend/services/research_access_service.py
index 991e11e0..d661748f 100644
--- a/backend/services/research_access_service.py
+++ b/backend/services/research_access_service.py
@@ -135,6 +135,57 @@ def require_object_scope(conn, actor: dict, enrollment: dict, capability_id: str
     )
 
 
+def authorize_participant_target(
+    actor: dict,
+    participant_user_id: str,
+    capability_id: str = "research.participant.read",
+) -> None:
+    """Authorize a backend actor against an assigned participant.
+
+    Participant-facing routes often identify the resource by ``user_id``
+    rather than by an enrollment id.  Resolve that user to the existing
+    enrollment/assignment model instead of treating a backend role as global
+    object scope.
+    """
+
+    assert_capability(actor, capability_id)
+    actor_id = str(actor.get("id") or "")
+    role = str(actor.get("role") or "")
+    target_id = str(participant_user_id or "")
+    if role == "admin":
+        allowed = True
+    else:
+        with get_connection() as conn:
+            enrollments = rows_to_dicts(
+                conn.execute(
+                    """
+                    SELECT * FROM relationship_pilot_enrollments
+                    WHERE user_id = ? AND status IN ('enrolled', 'active')
+                    ORDER BY updated_at DESC
+                    """,
+                    (target_id,),
+                ).fetchall()
+            )
+            allowed = any(has_object_scope(conn, actor, enrollment) for enrollment in enrollments)
+    with get_connection() as audit_conn:
+        write_audit_log(
+            audit_conn,
+            "participant_object_scope_allowed" if allowed else "participant_object_scope_denied",
+            actor_id,
+            "participant_user",
+            target_id or "unknown",
+            {"role": role, "capability_id": capability_id},
+        )
+        audit_conn.commit()
+    if not allowed:
+        raise ResearchAccessError(
+            "forbidden",
+            "当前账号没有访问该参与者资料的范围权限。",
+            403,
+            {"required_capability": capability_id},
+        )
+
+
 def _enrollment(conn, enrollment_id: str) -> dict:
     row = conn.execute(
         "SELECT * FROM relationship_pilot_enrollments WHERE id = ?", (enrollment_id,)
