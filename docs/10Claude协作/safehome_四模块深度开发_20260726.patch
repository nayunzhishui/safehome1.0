+    low_labels = "、".join(short_label(labels, key) for key in low.index if low[key] < -0.25)
+    if high_labels and low_labels:
+        name = f"{high_labels}较高，{low_labels}较低"
+    elif high_labels:
+        name = f"{high_labels}较高"
+    elif low_labels:
