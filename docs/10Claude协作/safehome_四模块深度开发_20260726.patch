diff --git a/backend/tests/test_task36_therapeutic_assessment_hardening.py b/backend/tests/test_task36_therapeutic_assessment_hardening.py
new file mode 100644
index 0000000..b670942
--- /dev/null
+++ b/backend/tests/test_task36_therapeutic_assessment_hardening.py
@@ -0,0 +1,208 @@
+"""F16 治疗性评估:0726 正确性/安全硬化的回归测试。
+
+覆盖:证据非空硬约束、起草者/复核者分离、只有草稿可复核、
+撤回终态守卫、高风险进入 risk_review 队列。
+"""
+import importlib
+import sys
+from pathlib import Path
+
+
+ROOT = Path(__file__).resolve().parents[2]
+BACKEND = ROOT / "backend"
+
+
+def _fresh_app(tmp_path, monkeypatch):
+    sys.path.insert(0, str(BACKEND))
+    for name in list(sys.modules):
+        if name in {"app", "config", "database", "models"} or name.startswith("routes.") or name.startswith("services."):
+            sys.modules.pop(name, None)
+    monkeypatch.setenv("APP_ENV", "testing")
+    monkeypatch.setenv("DATABASE_PATH", str(tmp_path / "task36-f16-hard.sqlite3"))
+    monkeypatch.setenv("CONTENT_DIR", str(ROOT / "content"))
+    return importlib.import_module("app").app
+
+
+def _seed(app):
+    with app.app_context():
+        from database import get_connection, now_iso
+        from routes.auth_utils import generate_auth_token
+
+        now = now_iso()
+        actors = {
+            "participant-h": "parent",
+            "researcher-h": "researcher",
+            "supervisor-h": "supervisor",
+        }
+        with get_connection() as conn:
+            for actor_id, role in actors.items():
+                conn.execute(
+                    "INSERT INTO users (id, nickname, role, status, created_at, updated_at) VALUES (?, ?, ?, 'active', ?, ?)",
+                    (actor_id, actor_id, role, now, now),
+                )
+            conn.commit()
+        return {
+            actor_id: {"Authorization": f"Bearer {generate_auth_token({'id': actor_id, 'role': role})}"}
+            for actor_id, role in actors.items()
+        }
+
+
+def _create(client, headers, key="case-h", question="我想和研究者一起理解最近一次沟通中的感受。"):
+    return client.post(
+        "/api/therapeutic-assessment/cases",
+        headers={**headers["participant-h"], "Idempotency-Key": key},
+        json={
+            "assessment_question": question,
+            "shared_scope": ["question", "recent_record"],
+            "consent": True,
+            "assigned_researcher_id": "researcher-h",
+        },
+    )
+
+
+def _draft_payload(**overrides):
+    payload = {
+        "source": "human",
+        "observations": ["这次记录中可以看到你愿意停下来观察。"],
+        "evidence": ["参与者主动提出共同理解问题。"],
+        "alternatives": ["也可能与当时精力不足有关。"],
+        "uncertainty": "目前只有一次记录，需要与你核对。",
+        "next_step": "选择一次低压力沟通，先停顿三秒。",
+        "human_discussion": ["哪些描述与你的体验一致？"],
+        "participant_content": "这是待人工复核的共同理解草稿。",
+    }
+    payload.update(overrides)
+    return payload
+
+
+def test_evidence_and_alternatives_are_required(tmp_path, monkeypatch):
+    app = _fresh_app(tmp_path, monkeypatch)
+    headers = _seed(app)
+    client = app.test_client()
+    case_id = _create(client, headers).get_json()["data"]["id"]
+
+    no_evidence = client.post(
+        f"/api/therapeutic-assessment/cases/{case_id}/feedback-versions",
+        headers={**headers["researcher-h"], "Idempotency-Key": "no-ev"},
+        json=_draft_payload(evidence=[]),
+    )
+    assert no_evidence.status_code == 422
+    assert no_evidence.get_json()["error"]["code"] == "evidence_required"
+
+    no_alt = client.post(
+        f"/api/therapeutic-assessment/cases/{case_id}/feedback-versions",
+        headers={**headers["researcher-h"], "Idempotency-Key": "no-alt"},
+        json=_draft_payload(alternatives=[]),
+    )
+    assert no_alt.status_code == 422
+    assert no_alt.get_json()["error"]["code"] == "alternatives_required"
+
+
+def _bring_to_reviewable(client, headers, key_prefix="rv"):
+    case_id = _create(client, headers, key=f"{key_prefix}-case").get_json()["data"]["id"]
+    draft = client.post(
+        f"/api/therapeutic-assessment/cases/{case_id}/feedback-versions",
+        headers={**headers["researcher-h"], "Idempotency-Key": f"{key_prefix}-draft"},
+        json=_draft_payload(),
+    )
+    feedback_id = draft.get_json()["data"]["id"]
+    client.post(
+        f"/api/therapeutic-assessment/cases/{case_id}/readiness",
+        headers={**headers["supervisor-h"], "Idempotency-Key": f"{key_prefix}-ready"},
+        json={
+            "qualification_evidence_ref": "evidence://q",
+            "supervision_evidence_ref": "evidence://s",
+            "ethics_evidence_ref": "evidence://e",
+        },
+    )
+    return case_id, feedback_id
+
+
+def test_author_cannot_review_own_feedback(tmp_path, monkeypatch):
+    app = _fresh_app(tmp_path, monkeypatch)
+    headers = _seed(app)
+    client = app.test_client()
+    # 让研究者同时具备复核角色的做法不存在;这里用 supervisor 起草再由 supervisor 自复核来验证分离。
+    case_id = _create(client, headers, key="self-case").get_json()["data"]["id"]
+    draft = client.post(
+        f"/api/therapeutic-assessment/cases/{case_id}/feedback-versions",
+        headers={**headers["supervisor-h"], "Idempotency-Key": "self-draft"},
+        json=_draft_payload(),
+    )
+    feedback_id = draft.get_json()["data"]["id"]
+    client.post(
+        f"/api/therapeutic-assessment/cases/{case_id}/readiness",
+        headers={**headers["supervisor-h"], "Idempotency-Key": "self-ready"},
+        json={
+            "qualification_evidence_ref": "evidence://q",
+            "supervision_evidence_ref": "evidence://s",
+            "ethics_evidence_ref": "evidence://e",
+        },
+    )
+    self_review = client.post(
+        f"/api/therapeutic-assessment/feedback-versions/{feedback_id}/review",
+        headers={**headers["supervisor-h"], "Idempotency-Key": "self-review"},
+        json={"decision": "approved"},
+    )
+    assert self_review.status_code == 403
+    assert self_review.get_json()["error"]["code"] == "self_review_forbidden"
+
+
+def test_only_draft_can_be_reviewed(tmp_path, monkeypatch):
+    app = _fresh_app(tmp_path, monkeypatch)
+    headers = _seed(app)
+    client = app.test_client()
+    case_id, feedback_id = _bring_to_reviewable(client, headers, "draft-only")
+    first = client.post(
+        f"/api/therapeutic-assessment/feedback-versions/{feedback_id}/review",
+        headers={**headers["supervisor-h"], "Idempotency-Key": "review-1"},
+        json={"decision": "approved"},
+    )
+    assert first.get_json()["data"]["status"] == "reviewed"
+    # 已复核版本不能再次复核(避免打回已 sent/reviewed)。
+    again = client.post(
+        f"/api/therapeutic-assessment/feedback-versions/{feedback_id}/review",
+        headers={**headers["supervisor-h"], "Idempotency-Key": "review-2"},
+        json={"decision": "changes_requested"},
+    )
+    assert again.status_code == 409
+    assert again.get_json()["error"]["code"] == "invalid_state"
+
+
+def test_double_withdraw_is_rejected(tmp_path, monkeypatch):
+    app = _fresh_app(tmp_path, monkeypatch)
+    headers = _seed(app)
+    client = app.test_client()
+    case_id = _create(client, headers, key="wd-case").get_json()["data"]["id"]
+    first = client.post(
+        f"/api/therapeutic-assessment/cases/{case_id}/withdraw",
+        headers={**headers["participant-h"], "Idempotency-Key": "wd-1"},
+        json={"note": "暂时不继续。"},
+    )
+    assert first.status_code == 200
+    second = client.post(
+        f"/api/therapeutic-assessment/cases/{case_id}/withdraw",
+        headers={**headers["participant-h"], "Idempotency-Key": "wd-2"},
+        json={"note": "再撤回一次。"},
+    )
+    assert second.status_code == 409
+    assert second.get_json()["error"]["code"] == "withdrawn"
+
+
+def test_high_risk_case_enqueues_risk_review(tmp_path, monkeypatch):
+    app = _fresh_app(tmp_path, monkeypatch)
+    headers = _seed(app)
+    client = app.test_client()
+    risky = _create(client, headers, "risk-case", "我现在想自杀，需要你替我诊断。")
+    assert risky.status_code == 201
+    case_id = risky.get_json()["data"]["id"]
+    assert risky.get_json()["data"]["status"] == "support_required"
+    with app.app_context():
+        from database import get_connection
+
+        with get_connection() as conn:
+            row = conn.execute(
+                "SELECT COUNT(*) AS n FROM risk_review_records WHERE source_type = 'therapeutic_assessment_case' AND source_id = ?",
+                (case_id,),
+            ).fetchone()
+            assert row["n"] == 1
