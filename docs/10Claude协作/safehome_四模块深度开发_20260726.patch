@@ -0,0 +1,105 @@
+"""AI QA 受控提示词模板 + 输出契约 + grounding 校验(生产就绪骨架)。
+
+设计目标(即使当前 provider 是 fake,也让"受控"落在代码里):
+- PROMPT_VERSION 指向一个真实存在、可审计的模板实体(本模块),而不是一个空常量;
+- 明确 AI 只被允许做四类整理性输出(整理材料/草拟问题/提醒证据不足/生成待讨论清单),
+  不得自动形成临床结论;
+- 强制引用格式;
+- grounding 校验:回答的实词必须能在已批准引用里找到支撑,否则降级;
+- 结论性表述检测升级(补"诊断"及中英文变形)。
+
+切换真实 LLM 时:把 build_system_prompt() 作为 system 消息、build_user_prompt() 作为 user 消息,
+provider 侧只需保证按此契约调用即可;安全与 grounding 校验在服务层强制,不依赖模型自觉。
+"""
+
+from __future__ import annotations
+
+import re
+
+# 提示词模板版本;service 层的 PROMPT_VERSION 应与此一致。
+PROMPT_TEMPLATE_VERSION = "safehome-ai-qa-prompt-v2"
+
+# AI 被允许的四类意图(输出契约白名单)。
+ALLOWED_INTENTS = ("organize_material", "draft_question", "flag_insufficient_evidence", "discussion_checklist")
+
+SYSTEM_PROMPT = """你是"安心家"研究者侧的受控内容助手。严格遵守以下边界:
+1. 你只能做四件事:整理已批准材料、草拟可与参与者讨论的问题、提醒证据不足、生成待讨论清单。
+2. 你不得给出任何临床结论、诊断、预后、用药或法律判断,不得断言"确诊/一定/保证/属于某型人格"。
+3. 你只能引用下方"已批准来源"中的内容;每条关键说法都要标注来源编号 [S1]/[S2]。
+4. 如果已批准来源不足以回答,直接说明证据不足,并给出需要补充的材料,不要编造。
+5. 所有措辞保持非诊断、支持性、非评判。
+输出必须是可核对的整理性内容,而不是结论。"""
+
+# 结论性/越界表述:比旧 POST_BLOCK_TERMS 更全,含"诊断"与中英文变形。
+CONCLUSION_TERMS = (
+    "确诊", "诊断为", "可以诊断", "符合抑郁", "符合焦虑", "抑郁症", "焦虑症", "多动症", "自闭症",
+    "对立违抗", "回避型依恋", "焦虑型依恋", "人格障碍", "人格类型是", "一定会", "保证治愈", "保证改善",
+    "必然", "肯定是", "确定是", "typical of", "diagnos", "you have depression", "you have anxiety",
+    "personality disorder", "system prompt", "api key", "管理员密钥",
+)
+
+
+def build_system_prompt() -> str:
+    return SYSTEM_PROMPT
+
+
+def build_user_prompt(question: str, sources: list[dict]) -> str:
+    lines = ["【问题】", str(question or "").strip(), "", "【已批准来源】"]
+    for idx, src in enumerate(sources, 1):
+        title = str(src.get("title") or src.get("content_id") or f"来源{idx}")
+        excerpt = str(src.get("excerpt") or "").strip()[:360]
+        lines.append(f"[S{idx}] {title}: {excerpt}")
+    lines += ["", "请只基于以上来源,按边界要求整理输出,并对关键说法标注 [S编号]。"]
+    return "\n".join(lines)
+
+
+def _tokenize_cn(text: str) -> list[str]:
+    """粗分:抽取 2 字以上中文片段与英文单词,用于 grounding 重叠度估计。"""
+    text = str(text or "")
+    cn = re.findall(r"[一-鿿]{2,}", text)
+    en = re.findall(r"[a-zA-Z]{3,}", text.lower())
+    grams: list[str] = []
+    for seg in cn:
+        # 2-gram 覆盖,避免整段长词导致零重叠
+        for i in range(len(seg) - 1):
+            grams.append(seg[i : i + 2])
+    return grams + en
+
+
+def contains_conclusion(text: str) -> list[str]:
+    lowered = str(text or "").lower()
+    return [term for term in CONCLUSION_TERMS if term.lower() in lowered]
+
+
+def grounding_ratio(answer: str, sources: list[dict]) -> float:
+    """回答实词能在来源中找到支撑的比例(0~1)。来源为空则 0。"""
+    source_text = " ".join(str(s.get("excerpt") or s.get("title") or "") for s in sources)
+    source_grams = set(_tokenize_cn(source_text))
+    answer_grams = _tokenize_cn(answer)
+    if not answer_grams or not source_grams:
+        return 0.0
+    supported = sum(1 for g in answer_grams if g in source_grams)
+    return round(supported / len(answer_grams), 3)
+
+
+def validate_output(answer: str, sources: list[dict], *, min_grounding: float = 0.15) -> dict:
+    """服务层强制的输出契约 + grounding 校验。返回 ok/violations/grounding。"""
+    violations: list[str] = []
+    conclusion_hits = contains_conclusion(answer)
+    if conclusion_hits:
+        violations.append("conclusion_language")
+    if not sources:
+        violations.append("missing_approved_citation")
+    if not re.search(r"\[S\d+\]", str(answer or "")):
+        # 未标注任何来源编号:无法核对归因。
+        violations.append("missing_citation_marker")
+    ratio = grounding_ratio(answer, sources)
+    if ratio < min_grounding:
+        violations.append("low_grounding")
+    return {
+        "ok": not violations,
+        "violations": violations,
+        "grounding_ratio": ratio,
+        "conclusion_hits": conclusion_hits,
+        "prompt_template_version": PROMPT_TEMPLATE_VERSION,
+    }
