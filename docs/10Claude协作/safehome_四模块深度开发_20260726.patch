+import React from "react";
+
+interface ErrorBoundaryProps {
+  children: React.ReactNode;
+  /** 自定义兜底渲染;不传则用内置的非诊断、可恢复的默认界面。 */
+  fallback?: (error: Error, reset: () => void) => React.ReactNode;
+}
+
+interface ErrorBoundaryState {
+  error: Error | null;
+}
+
+/**
+ * 顶层错误边界:任一子组件(含 lazy chunk)抛错时,不再整站白屏,
+ * 而是显示可恢复的兜底界面。文案保持支持性、非诊断。
+ */
+export class ErrorBoundary extends React.Component<ErrorBoundaryProps, ErrorBoundaryState> {
+  constructor(props: ErrorBoundaryProps) {
+    super(props);
+    this.state = { error: null };
+  }
+
+  static getDerivedStateFromError(error: Error): ErrorBoundaryState {
+    return { error };
+  }
+
+  componentDidCatch(error: Error, info: React.ErrorInfo): void {
+    // 仅记录到控制台,不上报原文;避免把用户内容带入日志。
+    // eslint-disable-next-line no-console
+    console.error("[SafeHome] 页面渲染出错:", error.message, info.componentStack);
+  }
+
+  private reset = (): void => {
+    this.setState({ error: null });
+  };
+
+  render(): React.ReactNode {
+    const { error } = this.state;
+    if (error) {
+      if (this.props.fallback) {
+        return this.props.fallback(error, this.reset);
+      }
+      return (
+        <div
+          role="alert"
+          style={{
+            maxWidth: 520,
+            margin: "80px auto",
+            padding: "32px 28px",
+            borderRadius: 16,
+            border: "1px solid var(--safe-line, #e1d8cc)",
+            background: "var(--safe-card, #fffdfa)",
+            color: "var(--safe-ink, #242b27)",
+            lineHeight: 1.7,
+          }}
+        >
+          <h1 style={{ fontSize: 20, margin: "0 0 12px" }}>这个页面暂时没有加载出来</h1>
+          <p style={{ margin: "0 0 20px", color: "var(--safe-muted, #727a75)" }}>
+            可能是网络波动或页面资源加载失败。你的数据没有丢失,可以重试或返回首页。
+          </p>
+          <div style={{ display: "flex", gap: 12 }}>
+            <button
+              type="button"
+              onClick={this.reset}
+              style={{
+                minHeight: 44,
+                padding: "0 20px",
+                borderRadius: 10,
+                border: "none",
+                background: "var(--safe-green, #4e7c6b)",
+                color: "#fff",
+                cursor: "pointer",
+              }}
+            >
+              重试
+            </button>
+            <button
+              type="button"
+              onClick={() => {
+                window.location.href = "/";
+              }}
+              style={{
+                minHeight: 44,
+                padding: "0 20px",
+                borderRadius: 10,
+                border: "1px solid var(--safe-line, #e1d8cc)",
+                background: "transparent",
+                color: "inherit",
+                cursor: "pointer",
+              }}
+            >
+              返回首页
+            </button>
+          </div>
+        </div>
+      );
+    }
+    return this.props.children;
+  }
+}
+
+/**
+ * lazy 分包加载失败重试包装:某个 chunk 加载失败(如部署中途、网络抖动)时,
+ * 自动重试一次,仍失败再交给上层 ErrorBoundary。
+ */
+export function lazyWithRetry<T extends React.ComponentType<unknown>>(
+  factory: () => Promise<{ default: T }>,
+): React.LazyExoticComponent<T> {
+  return React.lazy(async () => {
+    try {
+      return await factory();
+    } catch (error) {
+      // 一次重试:清一次可能的缓存竞态后重新拉取。
+      await new Promise((resolve) => setTimeout(resolve, 300));
+      return factory();
+    }
+  });
+}
