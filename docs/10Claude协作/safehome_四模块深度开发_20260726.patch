+
+
+def write_cluster_summary(path: Path, model: dict) -> None:
+    lines = [
+        "各聚类类别样本分布",
+        "=" * 30,
+        f"模型：{model.get('standard_scale_name') or model.get('display_name')}",
+        f"来源：{model.get('source_dataset')}",
